<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <!-- The assembly remains AnyCPU. ShellFiles dispatches the packed x86 shell structure at runtime. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Axicultus.Win32.Packed32\Axicultus.Win32.Packed32.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>
</Project>
