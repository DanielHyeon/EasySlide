<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Axicultus.Core — 공통 도메인 어셈블리 (§9.4 / core-extraction-plan.md / 작업 B-3 Phase 1).
    legacy WinForms(Axicultuss.exe)와 신규 WPF(Axicultus.exe)가 함께 참조하는 순수 도메인.
    The TFM is the portable net11.0 (not -windows), so WinForms and System.Drawing.Common types (Bitmap, Font) fail at compile time; System.Drawing.Primitives (Color, Point) is in the base framework and CoreExtractionTests guards it.
    Core 는 어떤 앱도 참조하지 않는다(단방향 의존).
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 어셈블리명 명시 — CoreExtractionTests 가 "Axicultus.Core" 문자열에 의존하므로 못 박는다. -->
    <AssemblyName>Axicultus.Core</AssemblyName>
    <!-- 새 파일 기본 네임스페이스를 도메인 네임스페이스로 — 휴먼에러 방지(현 enum 은 명시 네임스페이스). -->
    <RootNamespace>Axicultus.Module</RootNamespace>
  </PropertyGroup>

  <!-- Menu texts of both apps: English (neutral) and Korean (ko satellite). The public MenuText class is generated at build. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\MenuText.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Axicultus.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>MenuText</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)MenuText.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
      <!-- the name the generated class looks for (not the RootNamespace one) -->
      <LogicalName>Axicultus.Localization.MenuText.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\MenuText.ko.resx">
      <LogicalName>Axicultus.Localization.MenuText.ko.resources</LogicalName>
    </EmbeddedResource>
    <!-- The legal texts both apps show (the EULA): the English original and its Korean translation. -->
    <EmbeddedResource Update="Localization\LegalText.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Axicultus.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>LegalText</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)LegalText.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
      <LogicalName>Axicultus.Localization.LegalText.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\LegalText.ko.resx">
      <LogicalName>Axicultus.Localization.LegalText.ko.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
