<Window x:Class="Axicultus.Wpf.Media.MediaAssignmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
    Title="{loc:Text MediaAssignmentWindow.Title}" Width="560" Height="570" MinWidth="440" MinHeight="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <DockPanel Margin="0,0,0,5"><TextBlock x:Name="SourceLabel" Text="{loc:Text MediaAssignmentWindow.Source}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModeBox" AutomationProperties.LabeledBy="{Binding ElementName=SourceLabel}">
                    <ComboBoxItem Content="{loc:Text MediaAssignmentWindow.ModeDefault}"/><ComboBoxItem Content="{loc:Text MediaAssignmentWindow.ModeNone}"/><ComboBoxItem Content="{loc:Text MediaAssignmentWindow.ModeTitle}"/>
                    <ComboBoxItem Content="{loc:Text MediaAssignmentWindow.ModeFile}"/><ComboBoxItem Content="{loc:Text MediaAssignmentWindow.ModeCamera}"/>
                </ComboBox></DockPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text MediaAssignmentWindow.Browse}" Click="Browse_Click" Margin="6,0,0,0"/>
            <TextBox x:Name="SourcePath" AutomationProperties.Name="미디어 파일" VerticalContentAlignment="Center" /></DockPanel>
            <WrapPanel Margin="0,6"><TextBlock Text="{loc:Text MediaAssignmentWindow.Volume}" VerticalAlignment="Center"/><TextBox x:Name="VolumeBox" Width="45" Margin="4,0,12,0" AutomationProperties.Name="음량 0부터 100"/>
                <TextBlock Text="{loc:Text MediaAssignmentWindow.Balance}" VerticalAlignment="Center"/><TextBox x:Name="BalanceBox" Width="45" Margin="4,0,12,0" AutomationProperties.Name="좌우 균형 -100부터 100"/>
                <TextBlock Text="{loc:Text MediaAssignmentWindow.Camera}" VerticalAlignment="Center"/><ComboBox x:Name="CameraBox" Width="46" Margin="4,0" AutomationProperties.Name="카메라 번호"/></WrapPanel>
            <WrapPanel><CheckBox x:Name="OverrideFlags" Content="{loc:Text MediaAssignmentWindow.OverrideFlags}"/><CheckBox x:Name="Mute" Content="{loc:Text MediaAssignmentWindow.Mute}" Margin="8,0" IsEnabled="{Binding IsChecked, ElementName=OverrideFlags}"/>
                <CheckBox x:Name="Repeat" Content="{loc:Text MediaAssignmentWindow.Repeat}" IsEnabled="{Binding IsChecked, ElementName=OverrideFlags}"/><CheckBox x:Name="Wide" Content="{loc:Text MediaAssignmentWindow.Wide}" Margin="8,0" IsEnabled="{Binding IsChecked, ElementName=OverrideFlags}"/></WrapPanel>
            <DockPanel Margin="0,5,0,0"><TextBlock x:Name="MonitorLabel" Text="{loc:Text MediaAssignmentWindow.Monitor}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="MonitorBox" IsEditable="True" AutomationProperties.LabeledBy="{Binding ElementName=MonitorLabel}"/></DockPanel>
            </StackPanel>
        <Border Grid.Row="1" Background="Black" Margin="0,8"><Grid><Image x:Name="CameraImage"/><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaFailed="PlaybackFailed" MediaEnded="PreviewEnded"/></Grid></Border>
        <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap"/>
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text MediaAssignmentWindow.OK}" Click="Save_Click" IsDefault="True" MinWidth="65" />
                <Button Content="{loc:Text MediaAssignmentWindow.Cancel}" IsCancel="True" MinWidth="65" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal"><Button Content="{loc:Text MediaAssignmentWindow.Play}" Click="Play_Click"/><Button Content="{loc:Text MediaAssignmentWindow.Pause}" Click="Pause_Click" Margin="4,0"/><Button Content="{loc:Text MediaAssignmentWindow.Stop}" Click="Stop_Click"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>
