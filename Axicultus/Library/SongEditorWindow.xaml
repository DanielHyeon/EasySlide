<Window x:Class="Axicultus.Wpf.Library.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Axicultus.Wpf.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="곡 편집기"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate x:Key="EditorActionCaption">
            <StackPanel Orientation="Horizontal">
                <controls:FrmIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Icon="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="곡 편집기"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding FolderName, StringFormat=폴더: {0}}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{DynamicResource Brush.Surface.Subtle}"
                    BorderBrush="{DynamicResource Brush.Status.Warning}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveEditWarningVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24"
                                   Foreground="{DynamicResource Brush.Status.Warning}"
                                   Margin="0,0,8,0" />
                    <TextBlock Text="라이브 출력 중입니다. 저장하려면 확인이 필요합니다."
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="LblTitle"
                                   Text="제목"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 Margin="0,4,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblTitle}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <DockPanel>
                            <Menu DockPanel.Dock="Right" Background="Transparent">
                                <MenuItem Header="가사 구분 삽입" Click="InsertSection_Click"
                                          AutomationProperties.Name="가사 구분 삽입">
                                    <MenuItem.Icon>
                                        <controls:FrmIcon Icon="text_bullet_list_add" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                    <MenuItem x:Name="VerseNumbers" Header="절 번호" />
                                    <MenuItem Header="프리코러스" Tag="[prechorus]" />
                                    <MenuItem Header="프리코러스 2" Tag="[prechorus 2]" />
                                    <MenuItem Header="후렴" Tag="[chorus]" />
                                    <MenuItem Header="후렴 2" Tag="[chorus 2]" />
                                    <MenuItem Header="브리지" Tag="[bridge]" />
                                    <MenuItem Header="브리지 2" Tag="[bridge 2]" />
                                    <MenuItem Header="엔딩" Tag="[ending]" />
                                    <Separator />
                                    <MenuItem Header="기본 가사 (Region 1)" Tag="[region 1]" />
                                    <MenuItem Header="보조 가사 (Region 2)" Tag="[region 2]" />
                                </MenuItem>
                            </Menu>
                            <TextBlock x:Name="LblLyrics" Text="가사" VerticalAlignment="Center"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </DockPanel>
                        <TextBox x:Name="LyricsEditor" Text="{Binding Lyrics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="280"
                                 Margin="0,4,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblLyrics}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Target="{Binding ElementName=SongSequence}" Content="절 순서" Padding="0,0,0,4" />
                            <TextBox x:Name="SongSequence" Text="{Binding Sequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="절 순서(Sequence)" MinHeight="46" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Target="{Binding ElementName=SongNotations}" Content="코드 표기" Padding="0,0,0,4" />
                            <TextBox x:Name="SongNotations" Text="{Binding Notations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="코드 표기(Notations)" MinHeight="46" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="곡 정보 · 저작권" IsExpanded="False"
                              Margin="0,0,0,8">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,14">
                                    <TextBlock x:Name="LblAlternateTitle"
                                       Text="다른 제목"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding AlternateTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblAlternateTitle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,0,14">
                                    <TextBlock x:Name="LblNumber"
                                       Text="번호"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding SongNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblNumber}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,14">
                                    <TextBlock x:Name="LblCategory"
                                       Text="분류"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblCategory}" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="LblKey"
                                           Text="키"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblKey}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="LblCapo"
                                           Text="카포"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBox Text="{Binding Capo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblCapo}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="LblWriter"
                                               Text="작사·작곡"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Writer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblWriter}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblCopyright"
                                               Text="저작권"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Copyright, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblCopyright}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblTiming"
                                               Text="타이밍"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Timing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblTiming}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblBookReference"
                                               Text="교단 참조"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding BookReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblBookReference}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblUserReference"
                                               Text="사용자 참조"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding UserReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblUserReference}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="라이선스 관리자"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LicenceAdmin1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="34"
                                                 AutomationProperties.Name="라이선스 관리자 1" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LicenceAdmin2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="34"
                                                 AutomationProperties.Name="라이선스 관리자 2" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Expander>

                    <Expander Header="고급 서식 데이터" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="서식 데이터" />
                            <TextBox Text="{Binding FormatData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="포맷 데이터"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="72"
                                     Margin="0,8,0,0" />
                            <TextBlock Text="곡 설정 데이터" Margin="0,8,0,0" />
                            <TextBox Text="{Binding SongSettingsData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="노래 설정 데이터"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="72"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- 영역별 스타일(Region 1=주 언어 / Region 2=보조 언어) — 이중 언어 곡의 두 본문에 글자색·정렬·굵게·기울임을
                         따로 지정한다. 빈 값/"상속"은 곡·전역 설정을 그대로 따른다. 출력 렌더가 FormatData 의 영역별 코드를 적용. -->
                    <Expander Header="기본 가사 · 보조 가사 서식"
                              IsExpanded="False"
                              Margin="0,0,0,8">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Region 1 -->
                            <StackPanel>
                                <TextBlock Text="기본 가사 (Region 1)"
                                           Style="{StaticResource Type.Caption.Style}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="LblR1Color"
                                           Text="글자색(#AARRGGBB, 비우면 상속)"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Margin="0,8,0,0" />
                                <TextBox Text="{Binding Region1ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="34"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblR1Color}" />
                                <TextBlock x:Name="LblR1Align"
                                           Text="정렬"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding AlignmentOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding Region1Alignment, Mode=TwoWay}"
                                          MinHeight="34"
                                          Margin="0,4,0,0"
                                          AutomationProperties.LabeledBy="{Binding ElementName=LblR1Align}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="굵게"
                                              IsChecked="{Binding Region1Bold, Mode=TwoWay}"
                                              AutomationProperties.Name="Region 1 굵게" />
                                    <CheckBox Content="기울임"
                                              IsChecked="{Binding Region1Italic, Mode=TwoWay}"
                                              Margin="16,0,0,0"
                                              AutomationProperties.Name="Region 1 기울임" />
                                    <CheckBox Content="밑줄"
                                              IsChecked="{Binding Region1Underline, Mode=TwoWay}"
                                              Margin="16,0,0,0"
                                              AutomationProperties.Name="Region 1 밑줄" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Region 2 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="보조 가사 (Region 2)"
                                           Style="{StaticResource Type.Caption.Style}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="LblR2Color"
                                           Text="글자색(#AARRGGBB, 비우면 상속)"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Margin="0,8,0,0" />
                                <TextBox Text="{Binding Region2ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="34"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblR2Color}" />
                                <TextBlock x:Name="LblR2Align"
                                           Text="정렬"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding AlignmentOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding Region2Alignment, Mode=TwoWay}"
                                          MinHeight="34"
                                          Margin="0,4,0,0"
                                          AutomationProperties.LabeledBy="{Binding ElementName=LblR2Align}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="굵게"
                                              IsChecked="{Binding Region2Bold, Mode=TwoWay}"
                                              AutomationProperties.Name="Region 2 굵게" />
                                    <CheckBox Content="기울임"
                                              IsChecked="{Binding Region2Italic, Mode=TwoWay}"
                                              Margin="16,0,0,0"
                                              AutomationProperties.Name="Region 2 기울임" />
                                    <CheckBox Content="밑줄"
                                              IsChecked="{Binding Region2Underline, Mode=TwoWay}"
                                              Margin="16,0,0,0"
                                              AutomationProperties.Name="Region 2 밑줄" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="미리보기"
                                   Style="{StaticResource Type.Title3.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding PreviewFormatStatus}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="글꼴" Target="{Binding ElementName=PreviewFont}" Padding="0,0,0,4" />
                            <Label Grid.Column="2" Content="가사 크기" Target="{Binding ElementName=PreviewSize}" Padding="0,0,0,4" />
                            <Label Grid.Column="4" Content="코드 크기" Target="{Binding ElementName=NotationSize}" Padding="0,0,0,4" />
                            <ComboBox Grid.Row="1" x:Name="PreviewFont" ItemsSource="{Binding PreviewFontFamilyOptions}"
                                      SelectedItem="{Binding PreviewFontFamilyName, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 글꼴" />
                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PreviewSize"
                                      ItemsSource="{Binding PreviewFontSizeOptions}"
                                      SelectedItem="{Binding PreviewMainFontSize, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 가사 글자 크기" />
                            <ComboBox Grid.Row="1" Grid.Column="4" x:Name="NotationSize"
                                      ItemsSource="{Binding PreviewFontSizeOptions}"
                                      SelectedItem="{Binding PreviewNotationFontSize, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 보조(메타·코드) 글자 크기" />
                        </Grid>

                        <!-- 코드 조옮김(레거시 Transpose Up/Down Semi-Tone) — 미리보기 코드만 ±반음 이동, 저장 가사 불변. -->
                        <DockPanel Margin="0,10,0,4">
                            <TextBlock Text="코드 조옮김" Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding TransposeLabel}" HorizontalAlignment="Right"
                                       Style="{StaticResource Type.Caption.Style}" />
                        </DockPanel>
                        <WrapPanel>
                            <Button Command="{Binding TransposeDownCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,0,6,4"
                                    Content="반음 내림" Tag="transpose_down" ContentTemplate="{StaticResource EditorActionCaption}"
                                    AutomationProperties.Name="반음 내림" />
                            <Button Command="{Binding TransposeUpCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,0,6,4"
                                    Content="반음 올림" Tag="transpose_up" ContentTemplate="{StaticResource EditorActionCaption}"
                                    AutomationProperties.Name="반음 올림" />
                            <Button Command="{Binding ResetTransposeCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,0,6,4"
                                    Content="원래 조" AutomationProperties.Name="조옮김 원조로" />
                            <Button Command="{Binding ToCapoZeroCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,0,0,4"
                                    Content="카포 없이" ToolTip="카포 없이 연주하는 코드로 미리보기"
                                    AutomationProperties.Name="To Capo 0" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{Binding PreviewBackgroundHex}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding PreviewTitle}"
                                       FontFamily="{Binding PreviewFontFamilyName}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding PreviewForegroundHex}" />
                            <!-- 가사 줄 단위 렌더(리치 per-line 1차): 본문은 메인 크기, '»' 뒤 코드/노테이션은 작게·흐리게.
                                 폰트/색은 TextElement 상속, 코드 크기만 노테이션 크기로 덮는다. 코드가 없으면 코드 칸은 숨김. -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding PreviewLyricLines}"
                                          TextElement.FontFamily="{Binding PreviewFontFamilyName}"
                                          TextElement.FontSize="{Binding PreviewMainFontSize}"
                                          TextElement.Foreground="{Binding PreviewForegroundHex}"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Notation}"
                                                       FontSize="{Binding DataContext.PreviewNotationFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Opacity="0.72"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <!-- 코드/노테이션이 없는 줄은 코드 칸을 숨겨 군더더기 여백 제거. -->
                                                            <DataTrigger Binding="{Binding Notation}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding PreviewMetadata}"
                                       FontFamily="{Binding PreviewFontFamilyName}"
                                       FontSize="{Binding PreviewNotationFontSize}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72"
                                       Foreground="{Binding PreviewForegroundHex}"
                                       Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="악보 편집…" Click="ScoreClick" Margin="0,0,8,0"
                        Style="{StaticResource EsButton.Secondary}" />
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="곡을 저장하고 닫기 (Ctrl+S)"
                        AutomationProperties.Name="곡 저장"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:FrmIcon Icon="save" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="저장 후 닫기" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="곡 편집기 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <!-- 중복 절 라벨 경고(저장은 막지 않는 비차단 안내). 비면 공백. -->
                <TextBlock Text="{Binding SectionWarning}"
                           TextWrapping="Wrap"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Warning}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
