<UserControl x:Class="Axicultus.Wpf.Library.BibleVersionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Axicultus.Wpf.Localization">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Text BibleVersionPanel.Intro}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <!-- 버전 목록 — 이름 표시. SelectedItem 을 VM 과 양방향 바인딩해 추가/삭제/이동 후 선택이 따라간다. -->
        <ListBox Grid.Row="1" x:Name="VersionList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="성경 버전 목록" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" />
        <!-- 검증/상태 메시지(이름 변경 결과·중복 안내). -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <WrapPanel Margin="0,0,0,10">
                <TextBlock x:Name="LblBibleFolder" Text="{loc:Text BibleVersionPanel.LinkedFolder}" VerticalAlignment="Center" />
                <TextBox x:Name="LinkedFolder" Text="{Binding SelectedVersion.SongFolderNo, Mode=OneWay}" Width="50" Margin="6,0,12,0" AutomationProperties.Name="성경 연결 폴더" />
                <TextBlock Text="{loc:Text BibleVersionPanel.FontSize}" VerticalAlignment="Center" />
                <TextBox x:Name="FontPoints" Text="{Binding SelectedVersion.Size, Mode=OneWay}" Width="50" Margin="6,0,12,0" AutomationProperties.Name="성경 글자 크기" />
                <Button Content="{loc:Text BibleVersionPanel.SaveToList}" Click="SaveLayout_Click" />
            </WrapPanel>
            <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 왼쪽: 순서 이동 + 추가/삭제. -->
            <StackPanel Orientation="Horizontal">
                <Button Click="MoveUp_Click" Style="{StaticResource EsButton.Secondary}" Margin="0,0,8,0" Content="{loc:Text BibleVersionPanel.MoveUp}" AutomationProperties.Name="선택 버전 위로 이동" />
                <Button Click="MoveDown_Click" Style="{StaticResource EsButton.Secondary}" Margin="0,0,8,0" Content="{loc:Text BibleVersionPanel.MoveDown}" AutomationProperties.Name="선택 버전 아래로 이동" />
                <Button Click="Add_Click" Style="{StaticResource EsButton.Secondary}" Margin="0,0,8,0" Content="{loc:Text BibleVersionPanel.Add}" AutomationProperties.Name="성경 버전 추가" />
                <Button Click="Delete_Click" Style="{StaticResource EsButton.Secondary}" Content="{loc:Text BibleVersionPanel.Delete}" AutomationProperties.Name="선택 버전 삭제(숨김)" />
            </StackPanel>
            <!-- 오른쪽: 이름 변경 + 닫기. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="Rename_Click" Style="{StaticResource EsButton.Secondary}" Margin="0,0,8,0" Content="{loc:Text BibleVersionPanel.Rename}" AutomationProperties.Name="선택 버전 이름 변경" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
