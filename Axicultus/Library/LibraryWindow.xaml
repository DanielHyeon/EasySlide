<Window x:Class="Axicultus.Wpf.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Title="{loc:Text LibraryWindow.Title}"
        Width="1060"
        Height="700"
        MinWidth="920"
        MinHeight="600"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Text LibraryWindow.Library}"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    ToolTip="{loc:Text LibraryWindow.RefreshTip}"
                    AutomationProperties.Name="라이브러리 새로 고침"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:Text LibraryWindow.Refresh}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,12">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Text LibraryWindow.Folders}"
                                       Style="{StaticResource Type.Title3.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <WrapPanel Margin="0,10,0,0">
                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Click="NewFolder_Click"
                                ToolTip="{loc:Text LibraryWindow.AddFolder}"
                                AutomationProperties.Name="폴더 추가"
                                Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="Add24" />
                        </Button>

                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Click="EditFolder_Click"
                                ToolTip="{loc:Text LibraryWindow.EditFolder}"
                                AutomationProperties.Name="선택 폴더 편집">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </Button>
                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Danger}"
                                Click="DeleteFolder_Click"
                                IsEnabled="{Binding CanDeleteFolder}"
                                ToolTip="{loc:Text LibraryWindow.DisableFolder}"
                                AutomationProperties.Name="Disable selected folder"
                                Margin="6,0,6,0">
                            <ui:SymbolIcon Symbol="Delete24" />
                        </Button>
                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Click="RecoverFolder_Click"
                                IsEnabled="{Binding CanRecoverFolder}"
                                ToolTip="{loc:Text LibraryWindow.RestoreFolder}"
                                AutomationProperties.Name="Restore selected folder"
                                Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </Button>
                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Command="{Binding MoveSelectedFolderUpCommand}"
                                ToolTip="{loc:Text LibraryWindow.MoveFolderUp}"
                                AutomationProperties.Name="Move folder up"
                                Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="ArrowUp24" />
                        </Button>
                        <Button
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Command="{Binding MoveSelectedFolderDownCommand}"
                                ToolTip="{loc:Text LibraryWindow.MoveFolderDown}"
                                AutomationProperties.Name="Move folder down">
                            <ui:SymbolIcon Symbol="ArrowDown24" />
                        </Button>
                        </WrapPanel>
                    </StackPanel>

                    <ListBox x:Name="FolderList"
                             ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="Reorder_PreviewMouseLeftButtonDown"
                             MouseMove="FolderList_MouseMove"
                             DragOver="Reorder_DragOver"
                             Drop="FolderList_Drop"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="42"
                                      Margin="0,2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Type.BodyLarge.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderNo, StringFormat={loc:Text LibraryWindow.FolderNumber}}"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SongCount}"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                     VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayedSongCount, StringFormat={}{0}곡 표시}"
                                       Style="{StaticResource Type.Title3.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Orientation="Horizontal">
                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="NewSong_Click"
                                    ToolTip="{loc:Text LibraryWindow.NewSongTip}"
                                    AutomationProperties.Name="새 곡 만들기"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.NewSong}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Primary}"
                                    Click="AddToLive_Click"
                                    ToolTip="{loc:Text LibraryWindow.AddToLiveTip}"
                                    AutomationProperties.Name="선택 곡 라이브에 추가"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.AddToLive}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="EditSong_Click"
                                    ToolTip="{loc:Text LibraryWindow.EditSongTip}"
                                    AutomationProperties.Name="선택 곡 편집"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Edit}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="CopySong_Click"
                                    ToolTip="{loc:Text LibraryWindow.CopySongTip}"
                                    AutomationProperties.Name="선택 곡 복사"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Copy}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="MoveSong_Click"
                                    ToolTip="{loc:Text LibraryWindow.MoveSongTip}"
                                    AutomationProperties.Name="선택 곡 이동"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Move}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Command="{Binding MoveSelectedSongUpCommand}"
                                    ToolTip="{loc:Text LibraryWindow.MoveSongUpTip}"
                                    AutomationProperties.Name="Move song up"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUp24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Up}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Command="{Binding MoveSelectedSongDownCommand}"
                                    ToolTip="{loc:Text LibraryWindow.MoveSongDownTip}"
                                    AutomationProperties.Name="Move song down"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDown24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Down}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Danger}"
                                    Click="DeleteSong_Click"
                                    ToolTip="{loc:Text LibraryWindow.DeleteSongTip}"
                                    AutomationProperties.Name="선택 곡 삭제"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Delete}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="RecoverSong_Click"
                                    ToolTip="{loc:Text LibraryWindow.RecoverTip}"
                                    AutomationProperties.Name="삭제 곡 복구"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUndo24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Recover}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="MergeSongs_Click"
                                    ToolTip="{loc:Text LibraryWindow.MergeTip}"
                                    AutomationProperties.Name="스마트 병합"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Text LibraryWindow.Merge}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Margin="0,0,0,12"
                             ToolTip="{loc:Text LibraryWindow.SearchTip}"
                             AutomationProperties.Name="라이브러리 검색" />

                    <DataGrid x:Name="SongsGrid"
                              Grid.Row="2"
                              AutomationProperties.Name="노래 목록"
                              ItemsSource="{Binding Songs}"
                              SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                              ToolTip="{loc:Text LibraryWindow.MultiSelectTip}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Text LibraryWindow.ColumnNumber}"
                                                Binding="{Binding SongNumber}"
                                                Width="70" />
                            <DataGridTextColumn Header="{loc:Text LibraryWindow.ColumnTitle}"
                                                Binding="{Binding Title}"
                                                Width="2*" />
                            <DataGridTextColumn Header="{loc:Text LibraryWindow.ColumnAlternateTitle}"
                                                Binding="{Binding AlternateTitle}"
                                                Width="*" />
                            <DataGridTextColumn Header="{loc:Text LibraryWindow.ColumnCategory}"
                                                Binding="{Binding Category}"
                                                Width="*" />
                            <DataGridTextColumn Header="{loc:Text LibraryWindow.ColumnKey}"
                                                Binding="{Binding Key}"
                                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Text LibraryWindow.Selection}"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedSong.Title}"
                                   Style="{StaticResource Type.BodyLarge.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedSong.Category}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedSong.Lyrics, Mode=OneWay}"
                             AutomationProperties.Name="선택한 노래 가사 미리보기"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="{DynamicResource Brush.Surface.Page}" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource EsButton.Secondary}"
                    Click="Close_Click"
                    ToolTip="{loc:Text LibraryWindow.CloseTip}"
                    AutomationProperties.Name="라이브러리 창 닫기"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:Text LibraryWindow.Close}" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
