<Window x:Class="Axicultus.Wpf.Library.FolderOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Title="{loc:Text FolderOrderWindow.Title}" Width="370" Height="430" MinWidth="280" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Text FolderOrderWindow.Ok}" IsDefault="True" Click="Accept_Click" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="{loc:Text FolderOrderWindow.Cancel}" IsCancel="True" Padding="12,4" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
            <Button Content="{loc:Text FolderOrderWindow.MoveUp}" Click="MoveUp_Click" Margin="0,0,0,6" Padding="8,4" />
            <Button Content="{loc:Text FolderOrderWindow.MoveDown}" Click="MoveDown_Click" Padding="8,4" />
        </StackPanel>
        <ListBox x:Name="FolderList" DisplayMemberPath="Name" AutomationProperties.Name="곡 폴더 순서" />
    </DockPanel>
</Window>
