<Window x:Class="Axicultus.Wpf.Library.FolderEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Axicultus.Wpf.Library" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Axicultus.Wpf.Localization" Title="{loc:Text FolderEditorWindow.Title}" Width="590" Height="630" MinWidth="460" MinHeight="320" Background="{DynamicResource Brush.Surface.Page}" WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{loc:Text FolderEditorWindow.Title}" Style="{StaticResource Type.Title1.Style}" Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding FolderNo, StringFormat={loc:Text FolderEditorWindow.FolderNumberFormat}}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="LblFolderNo" Text="{loc:Text FolderEditorWindow.FolderNumber}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding FolderNo, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Margin="0,4,0,0" AutomationProperties.LabeledBy="{Binding ElementName=LblFolderNo}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock x:Name="LblFolderName" Text="{loc:Text FolderEditorWindow.FolderName}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,4,0,0" AutomationProperties.LabeledBy="{Binding ElementName=LblFolderName}" />
                    </StackPanel>
                    <CheckBox Grid.Row="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{loc:Text FolderEditorWindow.Enabled}" AutomationProperties.Name="폴더 사용 여부" />
                </Grid>
                <local:FolderLayoutSample Height="126" Width="224" Margin="0,10,0,2" HorizontalAlignment="Left" AutomationProperties.Name="영역 위치 미리보기" />
                <ItemsControl ItemsSource="{Binding FormatFields}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Field.Label}" Width="180" VerticalAlignment="Center" />
                                <Grid>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Field.Label}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Flags.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ItemsControl ItemsSource="{Binding Flags}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Flags.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,6,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveCommand}" Style="{StaticResource EsButton.Primary}" ToolTip="{loc:Text FolderEditorWindow.SaveFolder}" AutomationProperties.Name="폴더 저장" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Text FolderEditorWindow.Save}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}" Click="Close_Click" ToolTip="{loc:Text FolderEditorWindow.Close}" AutomationProperties.Name="폴더 편집 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Text FolderEditorWindow.Close}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>