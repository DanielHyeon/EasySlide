<Window x:Class="Axicultus.Wpf.Library.SongCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:composites="clr-namespace:Axicultus.Wpf.Composites"
        Title="곡 복사"
        Width="560"
        Height="430"
        MinWidth="500"
        MinHeight="380"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="곡 복사"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding SongTitle}"
                       Style="{StaticResource Type.BodyLarge.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="LblSourceFolder"
                           Text="원본 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding SourceFolderName, Mode=OneWay}"
                         IsReadOnly="True"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblSourceFolder}" />
            </StackPanel>

            <composites:FolderComboBox Grid.Row="1"
                                       Margin="0,0,0,14"
                                       Label="대상 폴더"
                                       AutomationName="대상 폴더"
                                       ItemsSource="{Binding TargetFolders}"
                                       SelectedItem="{Binding SelectedTargetFolder, Mode=TwoWay}" />

            <!-- The title and the number are asked of one song only; several songs are copied as they are. -->
            <TextBlock Grid.Row="2"
                       Text="여러 곡을 복사하면 제목과 곡 번호는 그대로 유지됩니다."
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Type.Body.Style}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingleSong}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,14"
                        Visibility="{Binding IsSingleSong, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="LblCopyTitle"
                           Text="복사 제목"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding CopyTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblCopyTitle}" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Visibility="{Binding IsSingleSong, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="LblSongNumber"
                           Text="곡 번호"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding SongNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblSongNumber}" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding CopyCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="선택 곡 복사"
                        AutomationProperties.Name="선택 곡 복사"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" />
                        <TextBlock Text="복사" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="곡 복사 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
