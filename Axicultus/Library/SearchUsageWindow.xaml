<Window x:Class="Axicultus.Wpf.Library.SearchUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:composites="clr-namespace:Axicultus.Wpf.Composites"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Title="{loc:Text SearchUsageWindow.Title}"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Text SearchUsageWindow.Title}"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    VerticalAlignment="Top"
                    ToolTip="{loc:Text SearchUsageWindow.RefreshTip}"
                    AutomationProperties.Name="검색 데이터 새로고침">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:Text SearchUsageWindow.Refresh}" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="{loc:Text SearchUsageWindow.SongsTab}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 곡 검색 쿼리 폼 — 재사용 컴포지트로 분리(§5.2). DataContext 상속. -->
                    <composites:SongSearchQueryPanel x:Name="SongQuery" />

                    <DataGrid Grid.Column="2"
                              AutomationProperties.Name="검색 결과 목록"
                              ItemsSource="{Binding SearchResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnTitle}" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnFolder}" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnNumber}" Binding="{Binding SongNumber}" Width="70" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnKey}" Binding="{Binding Key}" Width="70" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnMatch}" Binding="{Binding MatchingFields[0]}" Width="110" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnSnippet}" Binding="{Binding Snippet}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="BibleFindTab" Header="{loc:Text SearchUsageWindow.BibleTab}" Visibility="Collapsed">
                <StackPanel Margin="12" MaxWidth="540" HorizontalAlignment="Left">
                    <Label Content="{loc:Text SearchUsageWindow.Version}" Target="{Binding ElementName=FindVersion}" />
                    <ComboBox x:Name="FindVersion" AutomationProperties.Name="검색할 성경 번역본" DisplayMemberPath="Name" SelectionChanged="FindVersion_Changed" />
                    <Label Content="{loc:Text SearchUsageWindow.SearchScope}" Target="{Binding ElementName=FindBook}" />
                    <ComboBox x:Name="FindBook" AutomationProperties.Name="검색할 성경 책" DisplayMemberPath="Name" />
                    <Label Content="{loc:Text SearchUsageWindow.SearchWords}" Target="{Binding ElementName=FindPassage}" />
                    <TextBox x:Name="FindPassage" AutomationProperties.Name="성경 검색어" MinWidth="320" KeyDown="FindPassage_KeyDown" />
                    <Label Content="{loc:Text SearchUsageWindow.MatchMode}" Target="{Binding ElementName=FindMode}" />
                    <ComboBox x:Name="FindMode" AutomationProperties.Name="성경 검색 일치 조건" SelectedIndex="0">
                        <ComboBoxItem Content="{loc:Text SearchUsageWindow.MatchAllWords}" />
                        <ComboBoxItem Content="{loc:Text SearchUsageWindow.MatchAnyWord}" />
                        <ComboBoxItem Content="{loc:Text SearchUsageWindow.MatchExactPhrase}" />
                    </ComboBox>
                    <Button Content="{loc:Text SearchUsageWindow.FindBible}" Click="FindBible_Click" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EsButton.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FindPassage}" Value="">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=FindVersion}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:Text SearchUsageWindow.TitlesTab}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="320"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="제목 검색어"
                                 Margin="0,0,10,0" />
                        <Button Command="{Binding LookupTitlesCommand}"
                                Style="{StaticResource EsButton.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Text SearchUsageWindow.Lookup}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              AutomationProperties.Name="제목 조회 결과"
                              ItemsSource="{Binding LookupCandidates}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnTitle}" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnAlternateTitle}" Binding="{Binding AlternateTitle}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnFolder}" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnBookReference}" Binding="{Binding BookReference}" Width="*" />
                            <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnUserReference}" Binding="{Binding UserReference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Text SearchUsageWindow.UsageTab}" x:Name="UsageTab">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <DatePicker SelectedDate="{Binding UsageFrom}" Width="150" Margin="0,0,8,8" />
                        <DatePicker SelectedDate="{Binding UsageTo}" Width="150" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding UsageSessions}"
                                  SelectedItem="{Binding SelectedUsageSession}"
                                  AutomationProperties.Name="사용 세션 선택"
                                  Width="180"
                                  Margin="0,0,8,8" />
                        <Button Command="{Binding RefreshUsageCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Text SearchUsageWindow.Load}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectedUsageCommand}"
                                Style="{StaticResource EsButton.Danger}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Text SearchUsageWindow.Delete}" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseUsageReport_Click"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="{loc:Text SearchUsageWindow.BrowseReportTip}"
                                AutomationProperties.Name="사용 보고서 경로 찾아보기"
                                Margin="0,0,8,8">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>
                        <Button Command="{Binding ExportUsageReportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="{loc:Text SearchUsageWindow.ExportRtfTip}"
                                AutomationProperties.Name="RTF 내보내기"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Text SearchUsageWindow.ExportRtf}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid AutomationProperties.Name="사용 기록 목록"
                                  ItemsSource="{Binding UsageRecords}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="46" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnDate}" Binding="{Binding WorshipDate, StringFormat=yyyy-MM-dd}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnWorshipList}" Binding="{Binding WorshipList}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnTitle}" Binding="{Binding SongTitle}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnNumber}" Binding="{Binding SongNumber}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="2"
                                  AutomationProperties.Name="사용 요약"
                                  ItemsSource="{Binding UsageSummary}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnCount}" Binding="{Binding Occurrences}" Width="80" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnTitle}" Binding="{Binding SongTitle}" Width="*" />
                                <DataGridTextColumn Header="{loc:Text SearchUsageWindow.ColumnNumber}" Binding="{Binding SongNumber}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource Brush.Status.Danger}"
                       Style="{StaticResource Type.Caption.Style}"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Style="{StaticResource Type.Caption.Style}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <Button Click="Close_Click"
                        Style="{StaticResource EsButton.Secondary}">
                    <TextBlock Text="{loc:Text SearchUsageWindow.Close}" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
