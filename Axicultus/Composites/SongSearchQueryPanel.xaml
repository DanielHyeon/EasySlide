<UserControl x:Class="Axicultus.Wpf.Composites.SongSearchQueryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        SongSearchQueryPanel — 계획서 §5.2 재사용 컴포지트(곡 검색 쿼리 폼 카드).
        검색어 + 검색 필드 토글 + 조/타이밍 + 플래그 + 수정일 + 폴더 선택 + 검색 실행.
        DataContext 는 호스트(SearchUsageWindow 등)에서 상속된 SearchUsageViewModel 을 그대로 사용한다
        (View만 분리, ViewModel·바인딩 동일 — 동작 동등성 우선).
        필드 라벨은 곡 편집기(SongEditorWindow)와 동일 한글 용어로 통일한다(제목·가사·교단 참조 등).
    -->
    <Border Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadius.Medium}"
            Padding="{StaticResource Thickness.Lg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Text SongSearchQueryPanel.Search}"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBox x:Name="PhraseBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="검색어"
                         Margin="0,10,0,12">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchSongsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <UniformGrid Columns="2">
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.Title}" IsChecked="{Binding SearchTitle, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.Lyrics}" IsChecked="{Binding SearchLyrics, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.Number}" IsChecked="{Binding SearchSongNumber, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.DenominationRef}" IsChecked="{Binding SearchBookReference, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.UserRef}" IsChecked="{Binding SearchUserReference, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.LicenseAdmin}" IsChecked="{Binding SearchLicenceAdmin, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.WriterComposer}" IsChecked="{Binding SearchWriter, Mode=TwoWay}" Margin="0,0,8,8" />
                    <CheckBox Content="{loc:Text SongSearchQueryPanel.Copyright}" IsChecked="{Binding SearchCopyright, Mode=TwoWay}" Margin="0,0,8,8" />
                </UniformGrid>
                <TextBlock Text="{loc:Text SongSearchQueryPanel.Key}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding SearchKeys}" Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="조(Key) 검색"
                         Margin="0,4,0,10" />
                <TextBlock Text="{loc:Text SongSearchQueryPanel.Timing}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding SearchTimings}" Text="{Binding SearchTiming, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="타이밍 검색"
                         Margin="0,4,0,10" />
                <CheckBox Content="{loc:Text SongSearchQueryPanel.HasChords}"
                          IsChecked="{Binding NotationsOnly, Mode=TwoWay}"
                          Margin="0,0,0,8" />
                <CheckBox Content="{loc:Text SongSearchQueryPanel.MediaItem}"
                          IsChecked="{Binding MediaOnly, Mode=TwoWay}"
                          Margin="0,0,0,8" />
                <CheckBox Content="{loc:Text SongSearchQueryPanel.Modified}"
                          IsChecked="{Binding UseModifiedDates, Mode=TwoWay}"
                          Margin="0,0,0,8" />
                <DatePicker IsEnabled="{Binding UseModifiedDates}" SelectedDate="{Binding ModifiedFrom}" Margin="0,0,0,6" />
                <DatePicker IsEnabled="{Binding UseModifiedDates}" SelectedDate="{Binding ModifiedTo}" Margin="0,0,0,14" />
                <TextBlock Text="{loc:Text SongSearchQueryPanel.Folder}"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SearchFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding SearchSongsCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Text SongSearchQueryPanel.Search}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
