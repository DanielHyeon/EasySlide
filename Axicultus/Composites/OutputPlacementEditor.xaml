<UserControl x:Class="Axicultus.Wpf.Composites.OutputPlacementEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
             xmlns:options="clr-namespace:Axicultus.Wpf.Controls">
    <UserControl.Resources><ResourceDictionary Source="/Axicultus;component/Controls/OptionsLayout.xaml" /></UserControl.Resources>
    <Canvas>
        <CheckBox Style="{x:Null}" Canvas.Left="41" Canvas.Top="112" Width="216" Height="24"
            Content="{loc:Text OutputPlacementEditor.SingleMonitorMode}" IsChecked="{Binding [OutputAsSingle], Mode=TwoWay}"
            IsEnabled="{Binding UseCustomOutputBounds}" AutomationProperties.Name="Act as Single Monitor Mode" />
        <TextBox Style="{x:Null}" Canvas.Left="255" Canvas.Top="75" Width="65" Height="27" IsReadOnly="True"
            IsTabStop="False" Text="{Binding AudienceHeight, Mode=OneWay}" IsEnabled="{Binding UseCustomOutputBounds}"
            AutomationProperties.Name="Audience Height" />
        <options:OptionNumberBox Canvas.Left="135" Canvas.Top="75" Width="65" Height="27"
            Text="{Binding DisplayCustomLeft, Mode=TwoWay, ValidatesOnExceptions=True}" Minimum="-9999" Maximum="9999"
            IsEnabled="{Binding UseCustomOutputBounds}" AutomationProperties.Name="Display Custom Left" />
        <TextBlock Canvas.Left="95" Canvas.Top="40" Width="37" Height="20" Text="{loc:Text OutputPlacementEditor.Top}" TextWrapping="Wrap" />
        <options:OptionNumberBox Canvas.Left="255" Canvas.Top="36" Width="65" Height="27"
            Text="{Binding DisplayCustomWidth, Mode=TwoWay, ValidatesOnExceptions=True}" Minimum="1" Maximum="9999"
            IsEnabled="{Binding UseCustomOutputBounds}" AutomationProperties.Name="Display Custom Width" />
        <options:OptionNumberBox Canvas.Left="135" Canvas.Top="36" Width="65" Height="27"
            Text="{Binding DisplayCustomTop, Mode=TwoWay, ValidatesOnExceptions=True}" Minimum="-9999" Maximum="9999"
            IsEnabled="{Binding UseCustomOutputBounds}" AutomationProperties.Name="Display Custom Top" />
        <RadioButton Style="{x:Null}" Canvas.Left="14" Canvas.Top="36" Width="83" Height="24" Content="{loc:Text OutputPlacementEditor.Custom}"
            GroupName="optDM"
            IsChecked="{Binding UseCustomOutputBounds, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=True}"
            AutomationProperties.Name="Custom:" />
        <CheckBox Style="{x:Null}" Canvas.Left="14" Canvas.Top="7" Width="264" Height="24"
            IsEnabled="{Binding UseCustomOutputBounds, Mode=OneWay, Converter={StaticResource OptionChoice}, ConverterParameter=False}"
            Content="{loc:Text OutputPlacementEditor.PreferSecondary}" IsChecked="{Binding DisplayAlwaysUseSecondaryMonitor, Mode=TwoWay}"
            AutomationProperties.Name="Prefer a secondary monitor" />
        <TextBlock Canvas.Left="201" Canvas.Top="82" Width="57" Height="20" Text="{loc:Text OutputPlacementEditor.Height}" TextWrapping="Wrap" />
        <TextBlock Canvas.Left="96" Canvas.Top="79" Width="37" Height="20" Text="{loc:Text OutputPlacementEditor.Left}" TextWrapping="Wrap" />
        <TextBlock Canvas.Left="203" Canvas.Top="40" Width="52" Height="20" Text="{loc:Text OutputPlacementEditor.Width}" TextWrapping="Wrap" />
    </Canvas>
</UserControl>
