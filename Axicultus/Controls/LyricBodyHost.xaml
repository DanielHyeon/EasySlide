<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Axicultus.Wpf.Controls">
    <Style x:Key="LyricBodyHost" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl"><ContentPresenter /></ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FitExternalText}" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <controls:LyricParagraphSurface Paragraph="{Binding PrimaryParagraph}">
                                <controls:LyricParagraphSurface.RenderTransform>
                                    <TranslateTransform Y="{Binding BodyVerticalOffset}" />
                                </controls:LyricParagraphSurface.RenderTransform>
                            </controls:LyricParagraphSurface>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
