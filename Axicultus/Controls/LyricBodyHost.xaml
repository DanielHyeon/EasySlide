<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Axicultus.Wpf.Controls">
    <Style x:Key="LyricBodyHost" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl"><ContentPresenter /></ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding UsesSampleParagraphs}" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel>
                                <StackPanel.RenderTransform><TranslateTransform Y="{Binding BodyVerticalOffset}" /></StackPanel.RenderTransform>
                                <controls:LyricParagraphSurface Paragraph="{Binding PrimaryParagraph}" MinHeight="{Binding PrimaryRegionHeight}" />
                                <controls:LyricParagraphSurface Paragraph="{Binding SecondaryParagraph}">
                                    <controls:LyricParagraphSurface.Style>
                                        <Style TargetType="controls:LyricParagraphSurface">
                                            <Setter Property="Margin" Value="{Binding BodyText2Margin}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding SecondaryParagraph}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </controls:LyricParagraphSurface.Style>
                                </controls:LyricParagraphSurface>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
