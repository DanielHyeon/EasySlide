<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:options="clr-namespace:Axicultus.Wpf.Controls">
    <options:OptionChoiceConverter x:Key="OptionChoice" />
    <options:IntegerOptionConverter x:Key="IntegerOption" />
    <Style x:Key="ClassicOptionsGroup" TargetType="GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Margin="0,9,0,0" />
                        <ContentPresenter />
                        <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,0" Padding="3,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OptionFolderRow" TargetType="ListBoxItem">
        <Setter Property="Height" Value="23" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="OptionTool" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="options:OptionNumberBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="options:OptionNumberBox">
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Background="{TemplateBinding Background}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,1" VerticalAlignment="Center" />
                            <UniformGrid Rows="2" Grid.Column="1" Margin="0,1,1,1">
                                <RepeatButton Focusable="False" Command="{x:Static options:OptionNumberBox.Increase}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="Increase">
                                    <Path Data="M0,4 L4,0 L8,4 Z" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                </RepeatButton>
                                <RepeatButton Focusable="False" Command="{x:Static options:OptionNumberBox.Decrease}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="Decrease">
                                    <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                </RepeatButton>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="OptionIconItem">
        <options:FrmIcon Icon="{Binding Icon}" Width="17" Height="17" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
    </DataTemplate>
</ResourceDictionary>
