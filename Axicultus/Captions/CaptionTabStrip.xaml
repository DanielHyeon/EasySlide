<UserControl x:Class="Axicultus.Wpf.Captions.CaptionTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
             Foreground="{DynamicResource Brush.Text.Primary}"
             FontFamily="{DynamicResource Font.Primary}" FontSize="{DynamicResource Type.Body.FontSize}">
    <!-- The tab strip over the main window's preview column (a045): the preview and caption tabs, and the caption's on-air
         switch, seen on both tabs. DataContext: the caption console's view model. Its styles are its own, as the console's. -->
    <UserControl.Resources>
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" StrokeThickness="2" Stroke="{DynamicResource Brush.Border.Focus}" RadiusX="4" RadiusY="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A tab: the one shown joins the column below it (the page's face, the accent on top). -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,2,-1" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Button.FontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,2,1,1" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Surface.Page}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The caption's state on the caption tab: hidden, on air, or chosen on air while the output screen is off. -->
        <Style x:Key="AirDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.Visible}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Live.Active}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Session.Visible}" Value="True" />
                        <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{DynamicResource Brush.Live.Standby}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The on-air switch: its colour and words follow the session (hidden until put on air). -->
        <Style x:Key="AirSwitch" TargetType="Button">
            <Setter Property="Content" Value="{loc:Text CaptionConsole.AirHidden}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Live.Hidden}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnHidden}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Button.FontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Brush.Border.Focus}" BorderThickness="0">
                            <!-- (a narrow column cuts the words short; the tool tip and the colour still tell) -->
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.Visible}" Value="True">
                    <Setter Property="Content" Value="{loc:Text CaptionConsole.AirVisible}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Active}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnActive}" />
                </DataTrigger>
                <!-- Chosen on air, but the output screen is off: nothing goes out until it comes back. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Session.Visible}" Value="True" />
                        <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="{loc:Text CaptionConsole.AirStandby}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Standby}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnStandby}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
        <!-- (the tabs keep their width; the switch takes what is left, its words cut short in a narrow column) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AirButton" Grid.Column="1" HorizontalAlignment="Right" Focusable="False" Style="{StaticResource AirSwitch}" Command="{Binding ToggleVisibleCommand}" Margin="8,3,3,3"
                    ToolTip="{loc:Text CaptionConsole.AirTip}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="3,4,0,0">
                <RadioButton x:Name="PreviewTab" Style="{StaticResource Tab}" Focusable="False" Content="{loc:Text CaptionConsole.PreviewTab}" IsChecked="True" />
                <RadioButton x:Name="CaptionTab" Style="{StaticResource Tab}" Focusable="False" AutomationProperties.Name="{loc:Text CaptionConsole.TabName}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource AirDot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Text CaptionConsole.Tab}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
