<Window x:Class="Axicultus.Wpf.Captions.CaptionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카메라 자막 설정" Width="900" Height="820" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Page}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Primary}" FontSize="{DynamicResource Type.BodyLarge.FontSize}">
    <!-- Connections, devices and fine-tuning: set up before the service, out of the operator's way during it.
         The caption console owns this window and runs every button here (it keeps the state). -->
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Type.Title3.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OBS 연결" Style="{StaticResource Section}" />
                            <TextBlock Text="OBS → 도구 → WebSocket 서버 설정의 주소·포트·암호" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HostLabel" Text="주소" Style="{StaticResource Label}" />
                                <TextBox x:Name="Host" Grid.Column="1" Text="127.0.0.1" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=HostLabel}"
                                         ToolTip="같은 PC는 127.0.0.1. 다른 PC는 그 PC의 IP 또는 도메인 (원격 공유기에서 OBS 포트를 포트포워딩해야 합니다)." />
                                <TextBlock x:Name="PortLabel" Grid.Row="1" Text="포트" Style="{StaticResource Label}" />
                                <TextBox x:Name="Port" Grid.Row="1" Grid.Column="1" Text="4455" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}" />
                                <TextBlock x:Name="PasswordLabel" Grid.Row="2" Text="암호" Style="{StaticResource Label}" />
                                <DockPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock x:Name="SavedPassword" DockPanel.Dock="Right" Text="(저장됨)" Style="{StaticResource Label}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed" />
                                    <PasswordBox x:Name="Password" MinHeight="32" VerticalContentAlignment="Center" FontSize="{DynamicResource Type.BodyLarge.FontSize}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                                </DockPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="ConnectButton" Content="연결 / 재연결" Margin="0,0,12,0" />
                                <CheckBox x:Name="AutoObs" Content="앱 시작 시 자동 연결 및 자막 서버 시작"
                                          ToolTip="암호는 연결할 때 이 Windows 사용자 계정으로 암호화해 보관합니다. 빈칸이면 저장된 암호를 사용합니다." />
                            </WrapPanel>
                            <TextBlock x:Name="ServerLabel" Text="자막 서버 시작 중…" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OBS 브라우저 소스" Style="{StaticResource Section}" />
                            <DockPanel>
                                <Button x:Name="CopyUrlButton" DockPanel.Dock="Right" Content="주소 복사" Margin="8,0,0,0" />
                                <TextBox x:Name="BrowserUrl" IsReadOnly="True" Text="http://127.0.0.1:17948/" AutomationProperties.Name="OBS 자막 소스 주소"
                                         ToolTip="OBS 카메라 장면에 브라우저 소스로 추가하고 카메라 소스보다 위에 두세요. 크기는 캔버스와 같게." />
                            </DockPanel>
                            <Button x:Name="AddObsSource" Content="OBS에 자막 소스 추가" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="OBS의 현재 프로그램 씬 맨 위에 자막 브라우저 소스를 캔버스 크기로 넣습니다. 다른 씬에서 다시 누르면 같은 소스를 그 씬에도 넣습니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OBS 씬" Style="{StaticResource Section}" />
                            <WrapPanel>
                                <ComboBox x:Name="Scenes" Width="170" Margin="0,0,8,6" AutomationProperties.Name="전환할 OBS 프로그램 씬" />
                                <TextBox x:Name="SourceName" Width="150" Margin="0,0,8,6" AutomationProperties.Name="함께 제어할 OBS 소스 이름 (선택)"
                                         ToolTip="함께 켜거나 끌 OBS 소스 이름 (선택)" />
                                <CheckBox x:Name="EnableSource" IsChecked="True" Content="소스 표시" Margin="0,0,8,6" />
                                <Button x:Name="SwitchSceneButton" Content="프로그램 씬 전환" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="씬 단축키 (Ctrl+Alt+1~4) · 씬 이름을 입력하고 연결을 눌러 저장" Style="{StaticResource Hint}" Margin="0,6,0,4" />
                            <UniformGrid Columns="4">
                                <TextBox x:Name="Scene1" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 1 씬 이름" />
                                <TextBox x:Name="Scene2" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 2 씬 이름" />
                                <TextBox x:Name="Scene3" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 3 씬 이름" />
                                <TextBox x:Name="Scene4" AutomationProperties.Name="Ctrl Alt 4 씬 이름" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PPT 세부 조정" Style="{StaticResource Section}" />
                            <TextBlock Text="읽은 가사가 틀렸거나 다른 텍스트 상자를 보낼 때만 씁니다." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="ReloadDeckButton" Content="송출 PPT 다시 읽기" Margin="0,0,8,6" />
                                <Button x:Name="OpenDeckButton" Content="다른 PPT 열기…" Margin="0,0,0,6" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SlidesLabel" Text="슬라이드" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Slides" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SlidesLabel}" />
                                <TextBlock x:Name="BoxesLabel" Grid.Row="1" Text="텍스트 상자" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Boxes" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"
                                          AutomationProperties.LabeledBy="{Binding ElementName=BoxesLabel}" />
                            </Grid>
                            <TextBlock x:Name="CueLabel" Text="이 슬라이드의 자막 문구" Margin="0,10,0,4" />
                            <TextBox x:Name="Cue" AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource Type.Title3.FontSize}" Height="100"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.LabeledBy="{Binding ElementName=CueLabel}" />
                            <Button x:Name="SaveCueButton" Content="이 장 문구 고쳐 저장" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="위 칸에서 고친 문구를 이 슬라이드의 자막으로 씁니다 (읽은 가사가 틀렸을 때)." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="CameraControls">
                            <TextBlock Text="카메라" Style="{StaticResource Section}" />
                            <DockPanel>
                                <TextBlock x:Name="CameraSourceLabel" Text="미리 볼 OBS 카메라 소스" Style="{StaticResource Label}" />
                                <TextBox x:Name="CameraSource" ToolTip="OBS 소스 목록에 보이는 카메라 소스 이름 그대로"
                                         AutomationProperties.LabeledBy="{Binding ElementName=CameraSourceLabel}" />
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="PreviewObsCamera" Content="카메라 미리보기" Margin="0,0,16,6" />
                                <CheckBox x:Name="ObsOwnsCamera" Content="카메라는 OBS에서 사용" IsChecked="{Binding ObsOwnsCamera, Mode=TwoWay}" Margin="0,0,16,6" />
                                <Button x:Name="ToggleCameraButton" Content="로컬 카메라 켜기 / 끄기" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="복구" Style="{StaticResource Section}" />
                            <TextBlock Text="앱이 갑자기 꺼졌을 때 이 예배의 초안·순서·자막 선택을 되돌립니다." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <Button x:Name="RecoverButton" Content="예배 편집 복구…" HorizontalAlignment="Left" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
