<Window x:Class="Axicultus.Wpf.Captions.CaptionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Captions;assembly=Axicultus.Captions"
        Title="{loc:Text CaptionSettingsWindow.Title}" Width="900" Height="820" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Page}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Primary}" FontSize="{DynamicResource Type.BodyLarge.FontSize}">
    <!-- Connections, devices and fine-tuning: set up before the service, out of the operator's way during it.
         The caption console owns this window and runs every button here (it keeps the state). -->
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Type.Title3.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.ObsConnection}" Style="{StaticResource Section}" />
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.ObsConnectionHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HostLabel" Text="{loc:Text CaptionSettingsWindow.Host}" Style="{StaticResource Label}" />
                                <TextBox x:Name="Host" Grid.Column="1" Text="127.0.0.1" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=HostLabel}"
                                         ToolTip="{loc:Text CaptionSettingsWindow.HostTip}" />
                                <TextBlock x:Name="PortLabel" Grid.Row="1" Text="{loc:Text CaptionSettingsWindow.Port}" Style="{StaticResource Label}" />
                                <TextBox x:Name="Port" Grid.Row="1" Grid.Column="1" Text="4455" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}" />
                                <TextBlock x:Name="PasswordLabel" Grid.Row="2" Text="{loc:Text CaptionSettingsWindow.Password}" Style="{StaticResource Label}" />
                                <DockPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock x:Name="SavedPassword" DockPanel.Dock="Right" Text="{loc:Text CaptionSettingsWindow.SavedPassword}" Style="{StaticResource Label}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed" />
                                    <PasswordBox x:Name="Password" MinHeight="32" VerticalContentAlignment="Center" FontSize="{DynamicResource Type.BodyLarge.FontSize}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                                </DockPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="ConnectButton" Content="{loc:Text CaptionSettingsWindow.Connect}" Margin="0,0,12,0" />
                                <CheckBox x:Name="AutoObs" Content="{loc:Text CaptionSettingsWindow.AutoConnect}"
                                          ToolTip="{loc:Text CaptionSettingsWindow.AutoConnectTip}" />
                            </WrapPanel>
                            <TextBlock x:Name="ServerLabel" Text="{loc:Text CaptionSettingsWindow.ServerStarting}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.BrowserSource}" Style="{StaticResource Section}" />
                            <DockPanel>
                                <Button x:Name="CopyUrlButton" DockPanel.Dock="Right" Content="{loc:Text CaptionSettingsWindow.CopyUrl}" Margin="8,0,0,0" />
                                <TextBox x:Name="BrowserUrl" IsReadOnly="True" Text="http://127.0.0.1:17948/" AutomationProperties.Name="OBS 자막 소스 주소"
                                         ToolTip="{loc:Text CaptionSettingsWindow.BrowserUrlTip}" />
                            </DockPanel>
                            <Button x:Name="AddObsSource" Content="{loc:Text CaptionSettingsWindow.AddSource}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="{loc:Text CaptionSettingsWindow.AddSourceTip}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.Scenes}" Style="{StaticResource Section}" />
                            <WrapPanel>
                                <ComboBox x:Name="Scenes" Width="170" Margin="0,0,8,6" AutomationProperties.Name="전환할 OBS 프로그램 씬" />
                                <TextBox x:Name="SourceName" Width="150" Margin="0,0,8,6" AutomationProperties.Name="함께 제어할 OBS 소스 이름 (선택)"
                                         ToolTip="{loc:Text CaptionSettingsWindow.SourceNameTip}" />
                                <CheckBox x:Name="EnableSource" IsChecked="True" Content="{loc:Text CaptionSettingsWindow.EnableSource}" Margin="0,0,8,6" />
                                <Button x:Name="SwitchSceneButton" Content="{loc:Text CaptionSettingsWindow.SwitchScene}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.SceneKeysHint}" Style="{StaticResource Hint}" Margin="0,6,0,4" />
                            <UniformGrid Columns="4">
                                <TextBox x:Name="Scene1" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 1 씬 이름" />
                                <TextBox x:Name="Scene2" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 2 씬 이름" />
                                <TextBox x:Name="Scene3" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 3 씬 이름" />
                                <TextBox x:Name="Scene4" AutomationProperties.Name="Ctrl Alt 4 씬 이름" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.PptTuning}" Style="{StaticResource Section}" />
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.PptTuningHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="ReloadDeckButton" Content="{loc:Text CaptionSettingsWindow.ReloadDeck}" Margin="0,0,8,6" />
                                <Button x:Name="OpenDeckButton" Content="{loc:Text CaptionSettingsWindow.OpenDeck}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SlidesLabel" Text="{loc:Text CaptionSettingsWindow.Slide}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Slides" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SlidesLabel}" />
                                <TextBlock x:Name="BoxesLabel" Grid.Row="1" Text="{loc:Text CaptionSettingsWindow.TextBox}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Boxes" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"
                                          AutomationProperties.LabeledBy="{Binding ElementName=BoxesLabel}" />
                            </Grid>
                            <TextBlock x:Name="CueLabel" Text="{loc:Text CaptionSettingsWindow.Cue}" Margin="0,10,0,4" />
                            <TextBox x:Name="Cue" AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource Type.Title3.FontSize}" Height="100"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.LabeledBy="{Binding ElementName=CueLabel}" />
                            <Button x:Name="SaveCueButton" Content="{loc:Text CaptionSettingsWindow.SaveCue}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="{loc:Text CaptionSettingsWindow.SaveCueTip}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="CameraControls">
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.Camera}" Style="{StaticResource Section}" />
                            <DockPanel>
                                <TextBlock x:Name="CameraSourceLabel" Text="{loc:Text CaptionSettingsWindow.CameraSource}" Style="{StaticResource Label}" />
                                <TextBox x:Name="CameraSource" ToolTip="{loc:Text CaptionSettingsWindow.CameraSourceTip}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=CameraSourceLabel}" />
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="PreviewObsCamera" Content="{loc:Text CaptionSettingsWindow.PreviewCamera}" Margin="0,0,16,6" />
                                <CheckBox x:Name="ObsOwnsCamera" Content="{loc:Text CaptionSettingsWindow.ObsOwnsCamera}" IsChecked="{Binding ObsOwnsCamera, Mode=TwoWay}" Margin="0,0,16,6" />
                                <Button x:Name="ToggleCameraButton" Content="{loc:Text CaptionSettingsWindow.ToggleCamera}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.Recovery}" Style="{StaticResource Section}" />
                            <TextBlock Text="{loc:Text CaptionSettingsWindow.RecoveryHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <Button x:Name="RecoverButton" Content="{loc:Text CaptionSettingsWindow.Recover}" HorizontalAlignment="Left" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
