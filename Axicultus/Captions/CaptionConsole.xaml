<UserControl x:Class="Axicultus.Wpf.Captions.CaptionConsole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:captions="clr-namespace:Axicultus.Wpf.Captions"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Background="{DynamicResource Brush.Surface.Page}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Primary}" FontSize="{DynamicResource Type.Body.FontSize}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />
        <captions:SameItemConverter x:Key="SameItem" />
        <!-- Spacing follows the app's scale (Theme/Tokens/Spacing.xaml): 8 within a group and between groups of the one
             column. Text and controls are the main window's size: its body and button text (Type.Body, Type.Button), buttons
             and lists 32 high (Spacing.ButtonHeight.Sm), the main actions 40 (Md). -->

        <!-- A choice of one: a track holding its options, the chosen one raised as a card with the accent border, so a choice
             reads apart from the command buttons. -->
        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <!-- The keyboard's mark, as EsButton.FocusVisual draws it. (The console keeps its styles to itself: tests and the
             harness open it without the app's dictionaries, so it names no app style; sizes are the tokens' values.) -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" StrokeThickness="2" Stroke="{DynamicResource Brush.Border.Focus}" RadiusX="6" RadiusY="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Button.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="6" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Commands: the app's secondary button (EsButton.Secondary: card face, strong border) at its size. -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Button.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- The one main action of the source on screen (send the typed caption, the next step): the only filled button. -->
        <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Big}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryPressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.PrimaryPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- (the app's control theme writes its text in its own colours; here in the theme's text colour) -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A caption colour: the button shows the colour in its Tag; the colour in use has the accent ring (set in code). -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Surface: where a click in the tab leaves the keyboard while following (no focus mark), so Space stays the on-air
         switch; a control chosen with Tab keeps Space and the arrows. (Transparent: a click on empty space lands here.) -->
    <Grid x:Name="Surface" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" Background="Transparent">
        <!-- One column, as wide as the main window's output (live) column. Too low for all of it (a small main window), the
             column scrolls rather than cutting a control off (its MinHeight is set in code); the steps or the typed box
             take the height left. -->
        <ScrollViewer x:Name="Body" Margin="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                      PreviewMouseWheel="ColumnWheel">
        <Grid x:Name="Column" MinWidth="300" Width="{Binding ViewportWidth, ElementName=Body}" Height="{Binding ViewportHeight, ElementName=Body}">
            <!-- The upper part takes the height left; the camera preview its own (the column's width at 16:9 until the
                 splitter over it is moved, as the main window's live view is resized; then the height it was given, kept
                 with the caption's other choices). -->
            <Grid.RowDefinitions>
                <RowDefinition x:Name="UpperRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StageRow" Height="Auto" MinHeight="96" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="Upper">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The source (follow the screen or type) and the settings. -->
            <DockPanel x:Name="TopBar">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="{loc:Text CaptionConsole.Settings}" Click="OpenSettings" VerticalAlignment="Center"
                        Margin="8,0,0,0" ToolTip="{loc:Text CaptionConsole.SettingsTip}" />
                <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ScreenMode" Content="{loc:Text CaptionConsole.FollowScreen}" GroupName="Source" IsChecked="True" Checked="SourceChanged" Style="{StaticResource Segment}"
                                     ToolTip="{loc:Text CaptionConsole.FollowScreenTip}" />
                        <RadioButton x:Name="DirectMode" Content="{loc:Text CaptionConsole.DirectInput}" GroupName="Source" Checked="SourceChanged" Style="{StaticResource Segment}" />
                    </UniformGrid>
                </Border>
            </DockPanel>

            <!-- The source's own controls: following, the display and the steps; typing, the box and its send button. -->
            <Grid x:Name="SourceArea" Grid.Row="1" Margin="0,8,0,0">
                <DockPanel x:Name="ScreenPanel">
                    <Border x:Name="ModeTrack" DockPanel.Dock="Top" Style="{StaticResource SegmentTrack}">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="AutoShow" Content="{loc:Text CaptionConsole.ShowAuto}" Tag="auto" GroupName="Show" IsChecked="True" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                         ToolTip="{loc:Text CaptionConsole.ShowAutoTip}" />
                            <RadioButton x:Name="TextOnly" Content="{loc:Text CaptionConsole.ShowText}" Tag="text" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                         ToolTip="{loc:Text CaptionConsole.ShowTextTip}" />
                            <RadioButton x:Name="ScoreOnly" Content="{loc:Text CaptionConsole.ShowScore}" Tag="score" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                         ToolTip="{loc:Text CaptionConsole.ShowScoreTip}" />
                            <RadioButton x:Name="ScoreAndText" Content="{loc:Text CaptionConsole.ShowScoreText}" Tag="scoretext" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                         ToolTip="{loc:Text CaptionConsole.ShowScoreTextTip}" />
                        </UniformGrid>
                    </Border>
                    <!-- The followed deck step by step, in rows as the main window's preview shows slides: a picked step moves the
                         caption only (the output screen stays). Without a deck, the pages of the output panel's song, passage or
                         text: a picked page turns the panel and the caption follows. The height left (at least a row of steps;
                         more scroll), also while there is no step (a deck being read, a media item, an empty panel). A step shows
                         its slide (and row) and its text, or the score row's picture; the whole text is in its tool tip. -->
                    <Grid x:Name="StepArea" Margin="0,8,0,0">
                        <ListBox x:Name="StepStrip" MinHeight="74" Foreground="{DynamicResource Brush.Text.Primary}"
                                 ItemsSource="{Binding Steps}" SelectedItem="{Binding CurrentStep, Mode=OneWay}" SelectionChanged="StepPicked"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}"
                                 AutomationProperties.Name="PPT 단계 (누르면 자막만 그 단계로)">
                            <ListBox.ItemContainerStyle>
                                <!-- A screen reader reads the step: its slide (and row) and its first line. The step on air has the
                                     accent border (not the theme's white selection), the step the next button goes to a dashed one. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Margin="{TemplateBinding Padding}">
                                                    <Border x:Name="Frame" BorderThickness="2" CornerRadius="6" BorderBrush="Transparent" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <Rectangle x:Name="NextMark" RadiusX="6" RadiusY="6" StrokeThickness="2" StrokeDashArray="2 2"
                                                               Stroke="{DynamicResource Brush.Accent.Primary}" Visibility="Collapsed" IsHitTestVisible="False" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SameItem}">
                                                                <Binding />
                                                                <Binding Path="DataContext.NextStep" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="NextMark" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="140" Height="62" Background="{DynamicResource Brush.Surface.Subtle}" CornerRadius="4" Padding="6,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="ToolTip" Value="{Binding Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text}" Value="">
                                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" FontWeight="SemiBold" />
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoSteps" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="{loc:Text CaptionConsole.NoSteps}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=StepStrip}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- The typed caption: the height left, at least three lines (a caption has up to three; set in code). -->
                <DockPanel x:Name="DirectPanel" Visibility="Collapsed">
                    <DockPanel x:Name="InstantRow" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Text CaptionConsole.NewLineHint}" Style="{StaticResource Quiet}" />
                        <CheckBox x:Name="Instant" Content="{loc:Text CaptionConsole.Instant}" IsChecked="{Binding IsInstant, Mode=TwoWay}"
                                  ToolTip="{loc:Text CaptionConsole.InstantTip}" />
                    </DockPanel>
                    <Button x:Name="TakeButton" DockPanel.Dock="Bottom" Content="{loc:Text CaptionConsole.Take}" Command="{Binding TakeCommand}" Click="BackToDraft"
                            Style="{StaticResource Main}" Margin="0,8,0,0" />
                    <TextBox x:Name="Draft" AcceptsReturn="True" FontSize="{DynamicResource Type.BodyLarge.FontSize}" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="DraftKey"
                             AutomationProperties.Name="직접 입력 자막" />
                </DockPanel>
            </Grid>

            <!-- What the tab last did or why it could not: one line (its full text in the tool tip), so nothing moves. -->
            <TextBlock x:Name="Status" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />

            <!-- Following: the steps back and on, where the caption is (the item or deck, the slide and row), and sync. -->
            <Grid x:Name="NavBar" Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=ScreenMode, Converter={StaticResource Shown}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousButton" Click="Previous" Style="{StaticResource Big}" MinWidth="84" AutomationProperties.Name="이전"
                        ToolTip="{loc:Text CaptionConsole.PreviousTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 5,0 L 0,5 L 5,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Text CaptionConsole.Previous}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NextButton" Grid.Column="1" Click="Next" Style="{StaticResource Main}" MinWidth="84" Margin="8,0,0,0" AutomationProperties.Name="다음"
                        ToolTip="{loc:Text CaptionConsole.NextTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text CaptionConsole.Next}" VerticalAlignment="Center" />
                        <Path Data="M 0,0 L 5,5 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- The one place that says where the caption is. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock x:Name="ScoreRowLabel" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <!-- (a no-break space until a deck names itself: the line is there from the start) -->
                    <TextBlock x:Name="DeckLabel" Text="&#160;" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <CheckBox x:Name="SyncShow" Grid.Column="3" Content="{loc:Text CaptionConsole.SyncShort}" IsChecked="{Binding Session.SyncShow, Mode=TwoWay}"
                          AutomationProperties.Name="{loc:Text CaptionConsole.SyncShow}" ToolTip="{loc:Text CaptionConsole.SyncShowTip}" />
            </Grid>

            </Grid>

            <!-- Moved with the mouse (or, chosen with Tab, the arrows): the camera preview's height; the steps or the typed
                 box take what is left, never less than their least. -->
            <GridSplitter x:Name="StageSplitter" Grid.Row="1" Height="4" Margin="0,8,0,4" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Brush.Border.Default}"
                          PreviewMouseLeftButtonDown="LimitPreview" PreviewKeyDown="LimitPreview"
                          DragCompleted="KeepPreview" PreviewKeyUp="KeepPreview"
                          FocusVisualStyle="{StaticResource FocusRing}" ToolTip="{loc:Text CaptionConsole.PreviewSizeTip}"
                          AutomationProperties.Name="{loc:Text CaptionConsole.PreviewSizeTip}" />

            <!-- What goes on air, drawn as the camera screen draws it (16:9), as large as fits the column's width and its row. -->
            <Border x:Name="Stage" Grid.Row="2" Padding="8" CornerRadius="6" Background="{DynamicResource Brush.Surface.Subtle}">
                <Viewbox x:Name="ObsPreviewBox" Stretch="Uniform" AutomationProperties.Name="송출 자막 미리보기">
                    <!-- A camera frame: black, as on the output screen. -->
                    <Grid Width="1920" Height="1080" Background="Black" ClipToBounds="True">
                        <TextBlock x:Name="PreviewHint" Text="{loc:Text CaptionConsole.PreviewOff}" FontSize="56"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CameraPreview" Source="{Binding Preview}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleY="{Binding ScaleY}" />
                            </Image.RenderTransform>
                        </Image>
                        <captions:CameraCaptionView x:Name="PreviewCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    DataContext="{Binding Session}" Visibility="{Binding HasText, Converter={StaticResource Shown}}" />
                        <!-- Hidden: what showing it would put on air, dim; the session sends nothing meanwhile. -->
                        <captions:CameraCaptionView x:Name="HeldCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.5"
                                                    DataContext="{Binding Held}"
                                                    Visibility="{Binding HasText, Converter={StaticResource Shown}, FallbackValue=Collapsed}" />
                        <!-- Nothing goes out: hidden by the operator, or chosen on air while the output screen is off. -->
                        <Border x:Name="HiddenBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40" Padding="32,12" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Hidden}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.Visible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Session.Visible}" Value="True" />
                                                <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Live.Standby}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="HiddenBadgeText" FontSize="60" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Text CaptionConsole.HiddenBadge}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnHidden}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Session.Visible}" Value="True" />
                                                    <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{loc:Text CaptionConsole.ScreenOffBadge}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnStandby}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Viewbox>
            </Border>

            <!-- The caption's look and where it goes, at hand during the service: groups that wrap whole (a label never
                 parts from its control). -->
            <WrapPanel x:Name="LookRow" Grid.Row="3" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                    <TextBlock x:Name="LinesLabel" Text="{loc:Text CaptionConsole.Lines}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LinesBox" Width="76" SelectionChanged="LinesChanged" AutomationProperties.LabeledBy="{Binding ElementName=LinesLabel}"
                              ToolTip="{loc:Text CaptionConsole.LinesTip}">
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Lines1}" />
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Lines2}" />
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Lines3}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                    <TextBlock x:Name="ScoreSizeLabel" Text="{loc:Text CaptionConsole.ScoreSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ScoreSizeBox" Width="88" SelectionChanged="ScoreSizeChanged" AutomationProperties.LabeledBy="{Binding ElementName=ScoreSizeLabel}"
                              ToolTip="{loc:Text CaptionConsole.ScoreSizeTip}">
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Small}" />
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Medium}" />
                        <ComboBoxItem Content="{loc:Text CaptionConsole.Large}" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="BoxCheck" Content="{loc:Text CaptionConsole.Box}" Click="BoxChanged" Margin="0,4,16,0" VerticalAlignment="Center"
                          ToolTip="{loc:Text CaptionConsole.BoxTip}" />
                <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="0,4,16,0">
                    <TextBlock Text="{loc:Text CaptionConsole.TextColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Tag="#FFFFFF" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="{loc:Text CaptionConsole.White}" AutomationProperties.Name="흰색" />
                    <Button Tag="#FFE14D" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="{loc:Text CaptionConsole.Yellow}" AutomationProperties.Name="노랑" />
                    <Button Tag="#7FD8FF" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="{loc:Text CaptionConsole.SkyBlue}" AutomationProperties.Name="하늘" />
                    <Button Tag="#9BF07A" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="{loc:Text CaptionConsole.LightGreen}" AutomationProperties.Name="연두" />
                    <Button Tag="#000000" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="{loc:Text CaptionConsole.Black}" AutomationProperties.Name="검정" />
                    <Button Content="{loc:Text CaptionConsole.CustomColor}" Click="PickCustomColor" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="DestinationsLabel" Text="{loc:Text CaptionConsole.Destinations}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="ToCamera" Content="{loc:Text CaptionConsole.ToCamera}" IsChecked="{Binding Session.AudienceEnabled, Mode=TwoWay}"
                              ToolTip="{loc:Text CaptionConsole.ToCameraTip}" />
                    <CheckBox x:Name="ToObs" Content="OBS" IsChecked="{Binding Session.ObsEnabled, Mode=TwoWay}" Margin="12,0,16,0"
                              ToolTip="{loc:Text CaptionConsole.ToObsTip}" />
                </StackPanel>
                <!-- What OBS and the camera are doing, beside where the caption goes (two lines at most, the whole in the tool tip). -->
                <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="ObsLabel" Text="{loc:Text CaptionConsole.ObsNotConnected}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="CameraStatus" Text="{Binding Status}" Style="{StaticResource Quiet}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" />
                </StackPanel>
            </WrapPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
