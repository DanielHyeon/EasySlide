<Window x:Class="Axicultus.Wpf.Captions.CaptionConsole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:captions="clr-namespace:Axicultus.Wpf.Captions"
        xmlns:composites="clr-namespace:Axicultus.Wpf.Composites"
        xmlns:input="clr-namespace:Axicultus.Wpf.Input"
        xmlns:controls="clr-namespace:Axicultus.Wpf.Controls"
        xmlns:conv="clr-namespace:Axicultus.Wpf.Converters"
        Title="카메라 하단 자막" Width="1040" Height="720" MinWidth="900" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Page}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Primary}" FontSize="{DynamicResource Type.BodyLarge.FontSize}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />
        <composites:LiveRowBadgeConverter x:Key="LiveBadge" />
        <conv:KindToFrmIconConverter x:Key="KindToFrmIcon" ForWorshipList="True" />
        <conv:KindToLabelConverter x:Key="KindToLabel" />
        <!-- Spacing follows the app's scale (Theme/Tokens/Spacing.xaml): 8 within a group, 16 between groups, 24 between
             sections; controls are at least Spacing.TargetMin (44) high. -->

        <!-- A choice of one: a track holding its options, the chosen one raised as a card with the accent border, so a choice
             reads apart from the command buttons. -->
        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <!-- The keyboard's mark, as EsButton.FocusVisual draws it. (The console keeps its styles to itself: tests and the
             harness open it without the app's dictionaries, so it names no app style; sizes are the tokens' values.) -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" StrokeThickness="2" Stroke="{DynamicResource Brush.Border.Focus}" RadiusX="6" RadiusY="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="6" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Commands: the app's secondary button (EsButton.Secondary: card face, strong border), at the operator's text size
             and the touch height (Spacing.TargetMin, 44). -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Title3.FontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- The one main action of the source on screen (send the typed caption, the next step): the only filled button. -->
        <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Big}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryPressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.PrimaryPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- (the app's control theme writes 12-14 DIP text in its own colours; the operator's window reads at 16 in the
             theme's text colour) -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A section's name over its controls. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Type.BodyLarge.FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <!-- A caption colour: the button shows the colour in its Tag; the colour in use has the accent ring (set in code). -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The on-air switch: its colour and words follow the session (hidden until put on air). -->
        <Style x:Key="AirSwitch" TargetType="Button">
            <Setter Property="Content" Value="자막 숨김 · 눌러서 내보내기 (Space)" />
            <Setter Property="Background" Value="{DynamicResource Brush.Live.Hidden}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnHidden}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Title3.FontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="MinWidth" Value="320" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Brush.Border.Focus}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.Visible}" Value="True">
                    <Setter Property="Content" Value="자막 나가는 중 · 눌러서 숨김 (Space)" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Active}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnActive}" />
                </DataTrigger>
                <!-- Chosen on air, but the output screen is off: nothing goes out until it comes back. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Session.Visible}" Value="True" />
                        <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="자막 대기 · 화면 꺼짐 (Space)" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Standby}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnStandby}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Surface: where a mouse click on a control leaves the keyboard while following (no focus mark), so Space stays the
         on-air switch; a control chosen with Tab keeps Space and the arrows. -->
    <Grid x:Name="Surface" Margin="16" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- On air or hidden, where it goes, OBS, settings. -->
        <Grid x:Name="TopBar" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AirButton" Style="{StaticResource AirSwitch}" Command="{Binding ToggleVisibleCommand}" Click="BackToDraft"
                    ToolTip="자막을 카메라·OBS에 내보내거나 숨깁니다. Esc는 언제나 숨깁니다." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="DestinationsLabel" Text="내보낼 곳" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="ToCamera" Content="카메라" IsChecked="{Binding Session.AudienceEnabled, Mode=TwoWay}"
                          ToolTip="Axicultus 송출 화면의 카메라 하단 자막" />
                <CheckBox x:Name="ToObs" Content="OBS" IsChecked="{Binding Session.ObsEnabled, Mode=TwoWay}" Margin="12,0,0,0"
                          ToolTip="OBS 브라우저 소스 (http://127.0.0.1:17948/)" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0">
                <TextBlock x:Name="ObsLabel" Text="OBS 연결 전" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="CameraStatus" Text="{Binding Status}" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="3" Content="설정…" Click="OpenSettings" VerticalAlignment="Center"
                    ToolTip="OBS 연결 · 카메라 · 씬 단축키 · 브라우저 소스 · 복구 · PPT 세부 조정" />
        </Grid>

        <!-- The body: below the designed 900x620 (a small screen) it scrolls; the on-air bar above stays in view.
             Its size follows the viewport down to that minimum (a scrolled Grid would otherwise get no height to share). -->
        <ScrollViewer x:Name="Body" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MinWidth="852" MinHeight="481" Width="{Binding ViewportWidth, ElementName=Body}" Height="{Binding ViewportHeight, ElementName=Body}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The source: typed text, or what is on the output screen. -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SegmentTrack}">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="DirectMode" Content="직접 입력" GroupName="Source" IsChecked="True" Checked="SourceChanged" Style="{StaticResource Segment}" />
                        <RadioButton x:Name="ScreenMode" Content="화면 따라가기" GroupName="Source" Checked="SourceChanged" Style="{StaticResource Segment}"
                                     ToolTip="송출 화면(라이브가 아니어도 송출 칸)의 PPT · 찬양 · 성경 · 텍스트를 자막으로 따라갑니다." />
                    </UniformGrid>
                </Border>
                <!-- The source's own controls on top, the worship list in the rest. Too short for both (a small window), the
                     column scrolls rather than cutting off a button (its MinHeight is set in code). -->
                <ScrollViewer x:Name="SourcePanel" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="ColumnWheel">
                <Grid x:Name="SourceColumn" Height="{Binding ViewportHeight, ElementName=SourcePanel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SourceControls">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The typed caption: three lines of it (a caption has up to three; its height is set in code), scrolled beyond. -->
                        <StackPanel x:Name="DirectPanel">
                            <TextBox x:Name="Draft" AcceptsReturn="True" FontSize="{DynamicResource Type.Title1.FontSize}" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="DraftKey"
                                     AutomationProperties.Name="직접 입력 자막" />
                            <Button x:Name="TakeButton" Content="자막 보내기 (Enter)" Command="{Binding TakeCommand}" Click="BackToDraft"
                                    Style="{StaticResource Main}" Margin="0,8,0,0" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="Shift+Enter 줄바꿈" Style="{StaticResource Quiet}" />
                                <CheckBox x:Name="Instant" Content="입력하는 대로 보내기" IsChecked="{Binding IsInstant, Mode=TwoWay}"
                                          ToolTip="한글은 글자가 완성될 때마다 보냅니다. Enter로 확정하면 입력 칸이 비워지고 자막은 다음 입력까지 유지됩니다." />
                            </DockPanel>
                        </StackPanel>

                        <!-- Following the screen, in reading order: what is followed, how it is shown, then the steps (the
                             sync box under the buttons it changes). -->
                        <StackPanel x:Name="ScreenPanel" Visibility="Collapsed">
                            <!-- The one place that says where the caption is (the item or deck, the slide and row). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="ScoreRowLabel" FontSize="{DynamicResource Type.Title3.FontSize}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <!-- (a no-break space until a deck names itself: the line is there from the start) -->
                                    <TextBlock x:Name="DeckLabel" Text="&#160;" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegmentTrack}" Margin="0,16,0,0">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="AutoShow" Content="자동" Tag="auto" GroupName="Show" IsChecked="True" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                                 ToolTip="슬라이드마다 악보 그림이 있으면 악보를, 없으면 자막을 보냅니다. (1)" />
                                    <RadioButton x:Name="TextOnly" Content="자막" Tag="text" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                                 ToolTip="글자만 보냅니다. (2)" />
                                    <RadioButton x:Name="ScoreOnly" Content="악보" Tag="score" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                                 ToolTip="PPT 악보를 줄(오선과 그 아래 가사)로 나누어 한 줄씩 보냅니다. (3)" />
                                    <RadioButton x:Name="ScoreAndText" Content="악보+자막" Tag="scoretext" GroupName="Show" Checked="ScoreChanged" Style="{StaticResource Segment}"
                                                 ToolTip="악보 한 줄 아래에 그 줄의 가사를 함께 보냅니다. (4)" />
                                </UniformGrid>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviousButton" Click="Previous" Style="{StaticResource Big}" AutomationProperties.Name="이전"
                                        ToolTip="이전 줄 / 이전 슬라이드 (← ↑)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 7,0 L 0,7 L 7,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="이전" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NextButton" Grid.Column="2" Click="Next" Style="{StaticResource Main}" AutomationProperties.Name="다음"
                                        ToolTip="다음 줄 / 다음 슬라이드 (→ ↓)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="다음" VerticalAlignment="Center" />
                                        <Path Data="M 0,0 L 7,7 L 0,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="SyncShow" Content="이전·다음으로 송출 화면도 넘기기 (싱크)" Margin="0,8,0,0" IsChecked="{Binding Session.SyncShow, Mode=TwoWay}"
                                      ToolTip="켜면 이전/다음이 송출 화면(PPT 슬라이드, 찬양·성경 페이지)을 넘기고 자막이 따라갑니다. 악보는 그 장의 줄을 다 보낸 뒤 다음 장으로 넘깁니다." />
                        </StackPanel>

                        <!-- What the console last did or why it could not: under the controls that caused it, one line (its full
                             text in the tool tip), so the list below keeps its place. -->
                        <TextBlock x:Name="Status" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <!-- The main window's worship list (DataContext: MainViewModel), in both sources: a pick here is a pick
                         there; the button, a double-click and Enter put the item in the output panel and, unlike a
                         double-click in the main list, never start the live output (the screen would show it a second time).
                         Its own section (a rule and a title) apart from the caption's controls: it changes the output screen,
                         not the caption. Its rows are the main list's rows (kind icon, title, LIVE; the main window's text
                         size, which follows the interface size). -->
                    <DockPanel x:Name="WorshipPanel" Grid.Row="1" Margin="0,24,0,0">
                        <Border x:Name="WorshipHeader" DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0"
                                Padding="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="더블클릭 · Enter로 올리기" Style="{StaticResource Quiet}" Margin="0,0,0,8" />
                                <TextBlock Text="예배 순서" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                        </Border>
                        <Button x:Name="SendItemButton" DockPanel.Dock="Bottom" Content="송출 칸에 올리기" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding SendWorshipSelectionToOutputCommand}" AutomationProperties.Name="고른 예배 순서 항목을 송출 칸에 올리기"
                                ToolTip="고른 항목을 송출 칸에 올립니다. 라이브가 꺼져 있으면 켜지 않고, 라이브 중이면 송출 화면도 바뀝니다. 따라가기에서는 자막이 송출 칸을 따라가고, 직접 입력에서는 입력한 자막 그대로입니다." />
                        <Grid>
                            <ListView x:Name="WorshipList" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                      FontSize="{DynamicResource Type.Body.FontSize}" BorderThickness="1"
                                      AutomationProperties.Name="예배 순서 (더블클릭·Enter로 송출 칸에 올리기)" KeyDown="WorshipListKey">
                                <ListView.ItemContainerStyle>
                                    <!-- The main list's row (WorshipListPanel.xaml); a double-click on a row puts it in the output panel
                                         (on the list's empty space: nothing). -->
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <Setter Property="MinHeight" Value="20" />
                                        <Setter Property="Padding" Value="2,0,14,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="input:RowDoubleClick.Command" Value="{Binding DataContext.SendWorshipSelectionToOutputCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <DockPanel.ToolTip>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} — {1}">
                                                            <Binding Path="Kind" Converter="{StaticResource KindToLabel}" />
                                                            <Binding Path="Title" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DockPanel.ToolTip>
                                            <controls:FrmIcon DockPanel.Dock="Left" Icon="{Binding Converter={StaticResource KindToFrmIcon}}" Width="16" Height="16" Margin="4,0,8,0" />
                                            <!-- Only the row on air (one of two rows of the same song), as in the main list. -->
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Live.Active}" CornerRadius="3" Padding="5,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource LiveBadge}">
                                                        <Binding />
                                                        <Binding Path="DataContext.LiveRow" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="LIVE" Foreground="White" FontSize="{DynamicResource Type.Badge.FontSize}" FontWeight="Bold"
                                                           AutomationProperties.Name="송출 중" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="WorshipListEmpty" Text="예배 순서가 비어 있습니다" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- What goes on air, drawn as the camera screen draws it (16:9), what comes next, and the caption's look.
                 Top-aligned: the preview is as large as the room left by the rows under it allows, and those rows stay right
                 under it (room left over by a wide window or a hidden band goes below them, not between). -->
            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox x:Name="ObsPreviewBox" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="송출 자막 미리보기">
                    <!-- A camera frame: black, as on the output screen. -->
                    <Grid Width="1920" Height="1080" Background="Black" ClipToBounds="True">
                        <TextBlock x:Name="PreviewHint" Text="카메라 미리보기는 설정에서 켭니다" FontSize="56"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CameraPreview" Source="{Binding Preview}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleY="{Binding ScaleY}" />
                            </Image.RenderTransform>
                        </Image>
                        <captions:CameraCaptionView x:Name="PreviewCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    DataContext="{Binding Session}" Visibility="{Binding HasText, Converter={StaticResource Shown}}" />
                        <!-- Hidden: what Space would put on air, dim; the session sends nothing meanwhile. -->
                        <captions:CameraCaptionView x:Name="HeldCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.5"
                                                    DataContext="{Binding Held}"
                                                    Visibility="{Binding HasText, Converter={StaticResource Shown}, FallbackValue=Collapsed}" />
                        <!-- Nothing goes out: hidden by the operator, or chosen on air while the output screen is off. -->
                        <Border x:Name="HiddenBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40" Padding="32,12" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Live.Hidden}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.Visible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Session.Visible}" Value="True" />
                                                <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Live.Standby}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="HiddenBadgeText" FontSize="60" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="숨김 중 · 내보내지 않습니다" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnHidden}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Session.Visible}" Value="True" />
                                                    <Condition Binding="{Binding Session.ScreenOff}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="화면 꺼짐 · 내보내지 않습니다" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Live.OnStandby}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Viewbox>
                <!-- Following the screen, a band under the preview (as wide as it, away from the worship list's send button):
                     the steps and, at their end, what the next button would send. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

        <!-- The followed deck step by step: a picked step moves the caption only (the output screen stays). Without a deck,
             the pages of the output panel's song, passage or text: a picked page turns the panel and the caption follows.
             Following the screen it keeps its place also while it has no step (a deck being read, a media item, an empty
             panel), so the preview and the list do not change size from item to item. -->
        <ListBox x:Name="StepStrip" Margin="0,16,0,0" Height="108" Foreground="{DynamicResource Brush.Text.Primary}"
                 Visibility="{Binding IsChecked, ElementName=ScreenMode, Converter={StaticResource Shown}}"
                 ItemsSource="{Binding Steps}" SelectedItem="{Binding CurrentStep, Mode=OneWay}" SelectionChanged="StepPicked"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}"
                 AutomationProperties.Name="PPT 단계 (누르면 자막만 그 단계로)">
            <ListBox.ItemContainerStyle>
                <!-- A screen reader reads the step: its slide (and row) and its first line. -->
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="140" Margin="2">
                        <Border Height="44" Background="{DynamicResource Brush.Surface.Subtle}" CornerRadius="4">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="6,2" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Type.BodyLarge.FontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="2,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NoSteps" Margin="12,16,12,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="단계 없음 · PPT · 찬양 · 성경 · 텍스트를 송출하면 여기에 단계가 보입니다">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, ElementName=ScreenMode}" Value="True" />
                                <Condition Binding="{Binding HasItems, ElementName=StepStrip}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

                    <!-- What the next button would send, as the camera screen would show it (only a followed source has a
                         next step). Its label has a fixed width: the strip beside it does not change size with it. -->
                    <Border x:Name="NextCard" Grid.Column="1" Margin="8,16,0,0" Height="108" Padding="10,5" Style="{StaticResource Card}"
                            Visibility="{Binding IsChecked, ElementName=ScreenMode, Converter={StaticResource Shown}}"
                            ToolTip="다음을 누르면 나갈 자막입니다. 미리보기만 · 내보내지 않습니다.">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="68" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="다음" Style="{StaticResource Quiet}" />
                                <TextBlock x:Name="NextLabel" Text="{Binding Next.Label, FallbackValue=—}" FontSize="{DynamicResource Type.BodyLarge.FontSize}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Viewbox x:Name="NextPreview" Stretch="Uniform" AutomationProperties.Name="다음 자막 미리보기">
                                <Grid Width="1920" Height="1080" Background="Black" ClipToBounds="True">
                                    <captions:CameraCaptionView x:Name="NextCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                                DataContext="{Binding Next}"
                                                                Visibility="{Binding HasText, Converter={StaticResource Shown}, FallbackValue=Collapsed}" />
                                </Grid>
                            </Viewbox>
                        </DockPanel>
                    </Border>
                </Grid>

        <!-- The caption's look, at hand during the service: its own section under the preview it changes (a rule and a
             title, as the worship list's), the left column kept for the source and the worship list down to the bottom. -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <TextBlock Text="자막 모양" Style="{StaticResource SectionTitle}" />
                    </Border>
        <!-- Groups that wrap whole (a label never parts from its control): sizes and box first, the colours after. -->
        <WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,20,0">
                <TextBlock x:Name="LinesLabel" Text="자막 줄 수" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LinesBox" Width="76" SelectionChanged="LinesChanged" AutomationProperties.LabeledBy="{Binding ElementName=LinesLabel}"
                          ToolTip="자막 영역의 높이. 더 긴 글은 글자가 작아져 이 안에 들어갑니다.">
                    <ComboBoxItem Content="1줄" />
                    <ComboBoxItem Content="2줄" />
                    <ComboBoxItem Content="3줄" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,20,0">
                <TextBlock x:Name="ScoreSizeLabel" Text="악보 크기" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ScoreSizeBox" Width="88" SelectionChanged="ScoreSizeChanged" AutomationProperties.LabeledBy="{Binding ElementName=ScoreSizeLabel}"
                          ToolTip="카메라·OBS 화면에서 악보가 차지하는 높이">
                    <ComboBoxItem Content="작게" />
                    <ComboBoxItem Content="보통" />
                    <ComboBoxItem Content="크게" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="BoxCheck" Content="배경 상자" Click="BoxChanged" Margin="0,4,20,0" VerticalAlignment="Center"
                      ToolTip="끄면 글자에 테두리 그림자만 넣습니다." />
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="글자색" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Tag="#FFFFFF" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="흰색 (기본)" AutomationProperties.Name="흰색" />
                <Button Tag="#FFE14D" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="노랑" AutomationProperties.Name="노랑" />
                <Button Tag="#7FD8FF" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="하늘" AutomationProperties.Name="하늘" />
                <Button Tag="#9BF07A" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="연두" AutomationProperties.Name="연두" />
                <Button Tag="#000000" Style="{StaticResource Swatch}" Click="PickColor" ToolTip="검정" AutomationProperties.Name="검정" />
                <Button Content="직접 선택…" Click="PickCustomColor" Margin="4,0,0,0" />
            </StackPanel>
        </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
