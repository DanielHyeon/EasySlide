<Window x:Class="Axicultus.Wpf.Captions.CaptionConsole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카메라 하단 자막" Width="760" Height="780" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SettingsVisibility"/><!-- also used for the preview caption box -->
    </Window.Resources>
    <DockPanel Margin="14">
        <!-- Status and settings: one line, settings open in place. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" Content="설정" Padding="12,4"
                          AutomationProperties.Name="자막 및 OBS 설정 열기"/>
            <WrapPanel x:Name="CameraControls" VerticalAlignment="Center">
                <TextBlock x:Name="ServerLabel" Text="자막 서버 시작 중…" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock x:Name="ObsLabel" Text="OBS 연결 전" VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#707070"/>
            </WrapPanel>
        </DockPanel>

        <Border x:Name="SettingsPanel" DockPanel.Dock="Top" BorderBrush="#C8C8C8" BorderThickness="1" Padding="10" Margin="0,0,0,8"
                Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource SettingsVisibility}}">
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="OBS WebSocket (OBS → 도구 → WebSocket 서버 설정)" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,5">
                        <TextBlock Text="주소" VerticalAlignment="Center"/>
                        <TextBox x:Name="Host" Text="127.0.0.1" Width="150" Margin="4,0,10,0" AutomationProperties.Name="OBS WebSocket 주소"
                                 ToolTip="같은 PC는 127.0.0.1. 다른 PC는 그 PC의 IP 또는 도메인 (원격 공유기에서 OBS 포트를 포트포워딩해야 합니다)."/>
                        <TextBlock Text="포트" VerticalAlignment="Center"/>
                        <TextBox x:Name="Port" Text="4455" Width="60" Margin="4,0,10,0" AutomationProperties.Name="OBS WebSocket 포트"/>
                        <TextBlock Text="암호" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="Password" Width="130" Margin="4,0" AutomationProperties.Name="OBS WebSocket 암호"/>
                        <TextBlock x:Name="SavedPassword" Text="(저장됨)" VerticalAlignment="Center" Foreground="#707070" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Content="연결 / 재연결" Click="ConnectObs" Padding="8,4"/>
                    </WrapPanel>
                    <CheckBox x:Name="AutoObs" Content="앱 시작 시 자동 연결 및 자막 서버 시작" Margin="0,3"
                              ToolTip="암호는 연결할 때 이 Windows 사용자 계정으로 암호화해 보관합니다. 빈칸이면 저장된 암호를 사용합니다."/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="OBS 브라우저 소스 주소" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="복사" Click="CopyBrowserUrl" Padding="8,3" Margin="4,0,0,0"/>
                        <TextBox IsReadOnly="True" Text="http://127.0.0.1:17948/" AutomationProperties.Name="OBS 자막 소스 주소"
                                 ToolTip="OBS 카메라 장면에 브라우저 소스로 추가하고 카메라 소스보다 위에 두세요. 크기는 캔버스와 같게."/>
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock x:Name="CameraSourceLabel" Text="미리 볼 OBS 카메라 소스" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CameraSource" Width="180" ToolTip="OBS 소스 목록에 보이는 카메라 소스 이름 그대로"
                                 AutomationProperties.LabeledBy="{Binding ElementName=CameraSourceLabel}"/>
                        <CheckBox x:Name="PreviewObsCamera" Content="카메라 미리보기" Margin="10,0" VerticalAlignment="Center"/>
                        <CheckBox Content="카메라는 OBS에서 사용" IsChecked="{Binding ObsOwnsCamera, Mode=TwoWay}" VerticalAlignment="Center"
                                  DataContext="{Binding DataContext, ElementName=CameraControls}"/>
                        <Button Content="로컬 카메라 켜기 / 끄기" Click="ToggleCamera" Padding="6,3" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox x:Name="Scenes" Width="170" AutomationProperties.Name="전환할 OBS 프로그램 씬"/>
                        <TextBox x:Name="SourceName" Width="140" Margin="6,0" AutomationProperties.Name="함께 제어할 OBS 소스 이름 (선택)"
                                 ToolTip="함께 켜거나 끌 OBS 소스 이름 (선택)"/>
                        <CheckBox x:Name="EnableSource" IsChecked="True" Content="소스 표시" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="프로그램 씬 전환" Click="SwitchScene" Padding="8,4"/>
                    </WrapPanel>
                    <TextBlock Text="씬 단축키 (Ctrl+Alt+1~4) · 씬 이름을 입력하고 연결을 눌러 저장" Margin="0,8,0,2"/>
                    <UniformGrid Columns="4">
                        <TextBox x:Name="Scene1" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 1 씬 이름"/>
                        <TextBox x:Name="Scene2" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 2 씬 이름"/>
                        <TextBox x:Name="Scene3" Margin="0,0,4,0" AutomationProperties.Name="Ctrl Alt 3 씬 이름"/>
                        <TextBox x:Name="Scene4" AutomationProperties.Name="Ctrl Alt 4 씬 이름"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Preview of what goes on air, with the caption colours. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Border x:Name="ObsPreviewBox" Background="#232323" Height="220" AutomationProperties.Name="송출 자막 미리보기">
                <Grid>
                    <TextBlock x:Name="PreviewHint" Text="카메라 미리보기는 설정에서 켭니다" Foreground="#808080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding DataContext.Preview, ElementName=CameraControls}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleY="{Binding DataContext.ScaleY, ElementName=CameraControls}"/>
                        </Image.RenderTransform>
                    </Image>
                    <Border Background="{Binding Session.CaptionBackground}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="16,0,16,12" Padding="10,3" CornerRadius="3"
                            Visibility="{Binding Session.HasText, Converter={StaticResource SettingsVisibility}}">
                        <StackPanel>
                            <Image Source="{Binding Session.PublicImage}" MaxHeight="110" Stretch="Uniform"/>
                            <TextBlock Text="{Binding Session.PublicText}" Foreground="{Binding Session.CaptionForeground}" FontSize="18" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="80"
                                       Visibility="{Binding Session.HasPublicText, Converter={StaticResource SettingsVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="글자색" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Tag="#FFFFFF" Background="#FFFFFF" Click="PickColor" Width="22" Height="22" Margin="2,0" ToolTip="흰색 (미리보기 기본)" AutomationProperties.Name="흰색"/>
                <Button Tag="#FFE14D" Background="#FFE14D" Click="PickColor" Width="22" Height="22" Margin="2,0" ToolTip="노랑" AutomationProperties.Name="노랑"/>
                <Button Tag="#7FD8FF" Background="#7FD8FF" Click="PickColor" Width="22" Height="22" Margin="2,0" ToolTip="하늘" AutomationProperties.Name="하늘"/>
                <Button Tag="#9BF07A" Background="#9BF07A" Click="PickColor" Width="22" Height="22" Margin="2,0" ToolTip="연두" AutomationProperties.Name="연두"/>
                <Button Tag="#000000" Background="#000000" Click="PickColor" Width="22" Height="22" Margin="2,0" ToolTip="검정" AutomationProperties.Name="검정"/>
                <Button Content="직접 선택…" Click="PickCustomColor" Padding="6,2" Margin="4,0,12,0"/>
                <CheckBox x:Name="BoxCheck" Content="배경 상자" VerticalAlignment="Center" Click="BoxChanged"
                          ToolTip="끄면 글자에 테두리 그림자만 넣습니다."/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="내보낼 곳" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ToCamera" Content="카메라 (Axicultus 송출 화면)" IsChecked="{Binding Session.AudienceEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip="Axicultus 송출 화면의 카메라 하단 자막"/>
                <CheckBox x:Name="ToObs" Content="OBS" IsChecked="{Binding Session.ObsEnabled, Mode=TwoWay}" Margin="14,0,0,0" VerticalAlignment="Center"
                          ToolTip="OBS 브라우저 소스 (http://127.0.0.1:17948/)"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="HideButton" Content="자막 숨김 (Esc)" Command="{Binding HideCommand}" Padding="10,4"/>
                <Button x:Name="ShowButton" Content="다시 표시" Command="{Binding ShowCommand}" Padding="10,4" Margin="4,0"/>
                <Button x:Name="RecoverButton" Content="예배 편집 복구…" Click="Recover" Padding="10,4" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- What to show: typed text, or the text on the audience screen. -->
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <RadioButton x:Name="DirectMode" Content="직접 입력한 자막" GroupName="Source" IsChecked="True" Checked="SourceChanged"
                             FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="ScreenMode" Content="송출 화면 자막 따라가기 (PPT · 찬양 · 성경)" GroupName="Source" Checked="SourceChanged"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
            </WrapPanel>

            <Grid>
            <DockPanel x:Name="DirectPanel">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="TakeButton" Content="송출 (Enter)" Command="{Binding TakeCommand}" Padding="12,5"/>
                    <CheckBox x:Name="Instant" Content="입력하는 대로 바로 송출" VerticalAlignment="Center" Margin="12,0"
                              IsChecked="{Binding IsInstant, Mode=TwoWay}"
                              ToolTip="한글은 글자가 완성될 때마다 송출합니다. Enter로 확정하면 입력 칸이 비워지고 자막은 다음 입력까지 유지됩니다."/>
                    <TextBlock Text="Shift+Enter 줄바꿈" Foreground="#707070" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBox x:Name="Draft" AcceptsReturn="True" FontSize="22" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="DraftKey"
                         AutomationProperties.Name="직접 입력 자막"/>
            </DockPanel>

            <DockPanel x:Name="ScreenPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <WrapPanel>
                        <Button Content="송출 PPT 다시 읽기" Click="OpenLiveDeck" Padding="9,4" Margin="0,0,4,0"/>
                        <Button Content="다른 PPT 열기…" Click="OpenDeck" Padding="9,4"/>
                        <TextBlock x:Name="DeckLabel" VerticalAlignment="Center" Margin="8,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="보낼 내용" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="TextOnly" Content="자막만" GroupName="Show" IsChecked="True" Checked="ScoreChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ScoreOnly" Content="악보만" GroupName="Show" Checked="ScoreChanged" VerticalAlignment="Center" Margin="0,0,10,0"
                                     ToolTip="PPT 슬라이드를 위·아래 절반으로 나누어 하단 자막 자리에 보냅니다. 슬라이드가 바뀌면 상단부터 시작합니다."/>
                        <RadioButton x:Name="ScoreAndText" Content="악보 + 자막" GroupName="Show" Checked="ScoreChanged" VerticalAlignment="Center"
                                     ToolTip="악보 절반 아래에 이 슬라이드의 자막(텍스트 상자)을 함께 보냅니다."/>
                        <ToggleButton x:Name="ScoreTop" Content="위 줄 (↑)" Click="ScoreTopClick" Padding="10,3" Margin="14,0,4,0" IsEnabled="False"
                                      ToolTip="악보 줄(오선과 그 아래 가사)을 자동으로 찾아 한 줄씩 보냅니다."/>
                        <ToggleButton x:Name="ScoreBottom" Content="아래 줄 (↓)" Click="ScoreBottomClick" Padding="10,3" IsEnabled="False"/>
                        <TextBlock x:Name="ScoreRowLabel" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#707070"/>
                    </WrapPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="슬라이드" VerticalAlignment="Center" Margin="0,0,4,0" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="Slides" Width="70" DockPanel.Dock="Left" SelectionChanged="SlideSelected" AutomationProperties.Name="슬라이드 번호"/>
                        <TextBlock x:Name="BoxesLabel" Text="텍스트 상자" VerticalAlignment="Center" Margin="10,0,4,0" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="Boxes" DisplayMemberPath="Name" SelectionChanged="BoxSelected"
                                  AutomationProperties.LabeledBy="{Binding ElementName=BoxesLabel}"/>
                    </DockPanel>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <Button Content="이전 자막" Click="Previous" Padding="8,4"/>
                    <Button Content="다음 자막" Click="Next" Margin="4,0" Padding="8,4"/>
                    <Button Content="이 장 문구 고쳐 저장" Click="SaveOverride" Padding="8,4" Margin="8,0,0,0"
                            ToolTip="아래 칸에서 고친 문구를 이 슬라이드의 자막으로 씁니다."/>
                </WrapPanel>
                <TextBox x:Name="Cue" AcceptsReturn="True" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="18"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="PPT 자막 미리보기와 수동 문구"/>
            </DockPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
