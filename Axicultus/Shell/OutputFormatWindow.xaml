<Window x:Class="Axicultus.Wpf.Shell.OutputFormatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:settings="clr-namespace:Axicultus.Wpf.Settings"
    xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
    Title="{loc:Text OutputFormatWindow.Title}" Width="760" Height="530" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <!-- Same look as the Options window: classic controls inside titled groups, two columns per tab, button row at the bottom. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Controls/OptionsLayout.xaml" /></ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="GroupPad">14,26,14,6</Thickness>
            <Style TargetType="GroupBox" BasedOn="{StaticResource ClassicOptionsGroup}"><Setter Property="Margin" Value="0,0,0,10" /></Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="Row" TargetType="DockPanel"><Setter Property="Margin" Value="0,0,0,8" /></Style>
            <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="DockPanel.Dock" Value="Right" /><Setter Property="Width" Value="30" /><Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="4,0,0,0" />
            </Style>
            <Style x:Key="Fill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="Seg" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Check boxes and radios keep their command in Tag: Toggle_Changed runs it for mouse, keyboard and UI Automation alike. -->
    <Grid Margin="16" ToggleButton.Checked="Toggle_Changed" ToggleButton.Unchecked="Toggle_Changed">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl Style="{x:Null}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TabItem Style="{x:Null}" Padding="10,5" Header="{loc:Text OutputFormatWindow.TabLyrics}">
                <Grid Margin="8,14,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Display}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <CheckBox Content="{loc:Text OutputFormatWindow.TitleHeading}" IsChecked="{Binding ActiveLyricsTitleHeading, Mode=OneWay}" Tag="{Binding ToggleLyricsTitleHeadingCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.Outline}" IsChecked="{Binding ActiveLyricsOutline, Mode=OneWay}" Tag="{Binding ToggleLyricsOutlineCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.Shadow}" IsChecked="{Binding ActiveLyricsShadow, Mode=OneWay}" Tag="{Binding ToggleLyricsShadowCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.ChorusEmphasis}" IsChecked="{Binding ActiveLyricsEmphasisChorusOnly, Mode=OneWay}" Tag="{Binding ToggleEmphasisChorusOnlyCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.Interlace}" IsChecked="{Binding ActiveLyricsInterlace, Mode=OneWay}" Tag="{Binding ToggleInterlaceCommand}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.RegionDisplay}">
                            <UniformGrid VerticalAlignment="Top" Columns="3" Margin="{StaticResource GroupPad}">
                                <RadioButton Content="{loc:Text OutputFormatWindow.Both}" IsChecked="{Binding DefaultRegionChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Both}" />
                                <RadioButton Content="{loc:Text OutputFormatWindow.Region1Only}" IsChecked="{Binding DefaultRegionChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Region1Only}" />
                                <RadioButton Content="{loc:Text OutputFormatWindow.Region2Only}" IsChecked="{Binding DefaultRegionChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Region2Only}" />
                            </UniformGrid>
                        </GroupBox>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Transpose}">
                            <DockPanel VerticalAlignment="Top" Margin="14,26,14,14">
                                <Button Style="{StaticResource Step}" Width="84" Content="{loc:Text OutputFormatWindow.TransposeReset}" Command="{Binding TransposeLiveResetCommand}" />
                                <Button Style="{StaticResource Step}" Content="▼" Command="{Binding TransposeLiveDownCommand}" AutomationProperties.Name="반음 내림" ToolTip="{loc:Text OutputFormatWindow.SemitoneDown}" />
                                <Button Style="{StaticResource Step}" Content="▲" Command="{Binding TransposeLiveUpCommand}" AutomationProperties.Name="반음 올림" ToolTip="{loc:Text OutputFormatWindow.SemitoneUp}" />
                                <TextBlock Text="{Binding LiveTransposeLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                        </GroupBox>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Alignment}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="{loc:Text OutputFormatWindow.Horizontal}" Width="44" VerticalAlignment="Center" />
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Left}" IsChecked="{Binding DefaultRegion1AlignmentChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Left}" AutomationProperties.Name="가사 왼쪽 정렬" />
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Center}" IsChecked="{Binding DefaultRegion1AlignmentChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Center}" AutomationProperties.Name="가사 가운데 정렬" Margin="4,0" />
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Right}" IsChecked="{Binding DefaultRegion1AlignmentChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Right}" AutomationProperties.Name="가사 오른쪽 정렬" />
                                    </UniformGrid>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="{loc:Text OutputFormatWindow.Vertical}" Width="44" VerticalAlignment="Center" />
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Top}" IsChecked="{Binding DefaultVerticalChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Top}" AutomationProperties.Name="가사 위 정렬" />
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Center}" IsChecked="{Binding DefaultVerticalChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Center}" AutomationProperties.Name="가사 세로 가운데 정렬" Margin="4,0" />
                                        <RadioButton Style="{StaticResource Seg}" Content="{loc:Text OutputFormatWindow.Bottom}" IsChecked="{Binding DefaultVerticalChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Bottom}" AutomationProperties.Name="가사 아래 정렬" />
                                    </UniformGrid>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Spacing}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreaseLyricsLineSpacingCommand}" AutomationProperties.Name="줄 간격 늘림" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreaseLyricsLineSpacingCommand}" AutomationProperties.Name="줄 간격 줄임" />
                                    <TextBlock Text="{Binding ActiveLyricsLineSpacing, StringFormat={loc:Text OutputFormatWindow.LineSpacing}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreaseLyricsLeftMarginCommand}" AutomationProperties.Name="왼쪽 여백 넓게" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreaseLyricsLeftMarginCommand}" AutomationProperties.Name="왼쪽 여백 좁게" />
                                    <TextBlock Text="{Binding ActiveLyricsLeftMargin, StringFormat={loc:Text OutputFormatWindow.LeftMargin}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreaseLyricsRightMarginCommand}" AutomationProperties.Name="오른쪽 여백 넓게" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreaseLyricsRightMarginCommand}" AutomationProperties.Name="오른쪽 여백 좁게" />
                                    <TextBlock Text="{Binding ActiveLyricsRightMargin, StringFormat={loc:Text OutputFormatWindow.RightMargin}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreaseLyricsBottomMarginCommand}" AutomationProperties.Name="아래 여백 넓게" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreaseLyricsBottomMarginCommand}" AutomationProperties.Name="아래 여백 좁게" />
                                    <TextBlock Text="{Binding ActiveLyricsBottomMargin, StringFormat={loc:Text OutputFormatWindow.BottomMargin}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}" ToolTip="{loc:Text OutputFormatWindow.RegionGapTip}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreaseRegionGapCommand}" AutomationProperties.Name="영역 간격 넓게" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreaseRegionGapCommand}" AutomationProperties.Name="영역 간격 좁게" />
                                    <TextBlock Text="{Binding ActiveRegionGap, StringFormat={loc:Text OutputFormatWindow.RegionGap}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}" ToolTip="{loc:Text OutputFormatWindow.BodyOffsetTip}">
                                    <Button Style="{StaticResource Step}" Content="▼" Command="{Binding MoveBodyDownCommand}" AutomationProperties.Name="본문 아래로" />
                                    <Button Style="{StaticResource Step}" Content="▲" Command="{Binding MoveBodyUpCommand}" AutomationProperties.Name="본문 위로" />
                                    <TextBlock Text="{Binding ActiveBodyVerticalOffset, StringFormat={loc:Text OutputFormatWindow.BodyOffset}}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{x:Null}" Padding="10,5" Header="{loc:Text OutputFormatWindow.TabBackground}">
                <Grid Margin="8,14,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.BackgroundImage}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <UniformGrid Rows="1" Margin="0,0,0,10">
                                    <Button x:Name="Gallery" Style="{StaticResource Fill}" Content="{loc:Text OutputFormatWindow.Gallery}" ToolTip="{loc:Text OutputFormatWindow.GalleryTip}" AutomationProperties.Name="갤러리에서 배경 선택" />
                                    <Button x:Name="PickImage" Style="{StaticResource Fill}" Content="{loc:Text OutputFormatWindow.PickFile}" ToolTip="{loc:Text OutputFormatWindow.PickFileTip}" AutomationProperties.Name="배경 이미지 파일 선택" Margin="4,0" />
                                    <Button Style="{StaticResource Fill}" Content="{loc:Text OutputFormatWindow.ClearImage}" Command="{Binding ClearOutputBackgroundImageCommand}" AutomationProperties.Name="배경 지우기" />
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="{loc:Text OutputFormatWindow.ImageFill}" IsChecked="{Binding DefaultImageModeChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Fill}" />
                                    <RadioButton Content="{loc:Text OutputFormatWindow.ImageFit}" IsChecked="{Binding DefaultImageModeChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Fit}" />
                                    <RadioButton Content="{loc:Text OutputFormatWindow.ImageCenter}" IsChecked="{Binding DefaultImageModeChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Center}" />
                                    <RadioButton Content="{loc:Text OutputFormatWindow.ImageTile}" IsChecked="{Binding DefaultImageModeChoice, Mode=TwoWay, Converter={StaticResource OptionChoice}, ConverterParameter=Tile}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.GradientDirection}">
                            <UniformGrid VerticalAlignment="Top" Columns="2" Margin="{StaticResource GroupPad}">
                                <RadioButton Content="{loc:Text OutputFormatWindow.GradientVertical}" IsChecked="{Binding GradientDirectionIsVertical, Mode=OneWay}" Tag="{Binding ApplyGradientDirectionCommand}" CommandParameter="{x:Static settings:LyricsGradientDirection.Vertical}" />
                                <RadioButton Content="{loc:Text OutputFormatWindow.GradientHorizontal}" IsChecked="{Binding GradientDirectionIsHorizontal, Mode=OneWay}" Tag="{Binding ApplyGradientDirectionCommand}" CommandParameter="{x:Static settings:LyricsGradientDirection.Horizontal}" />
                                <RadioButton Content="{loc:Text OutputFormatWindow.DiagonalDown}" ToolTip="{loc:Text OutputFormatWindow.DiagonalDownTip}" IsChecked="{Binding GradientDirectionIsDiagonalDown, Mode=OneWay}" Tag="{Binding ApplyGradientDirectionCommand}" CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalDown}" />
                                <RadioButton Content="{loc:Text OutputFormatWindow.DiagonalUp}" ToolTip="{loc:Text OutputFormatWindow.DiagonalUpTip}" IsChecked="{Binding GradientDirectionIsDiagonalUp, Mode=OneWay}" Tag="{Binding ApplyGradientDirectionCommand}" CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalUp}" />
                            </UniformGrid>
                        </GroupBox>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Transition}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <CheckBox Content="{loc:Text OutputFormatWindow.Fade}" IsChecked="{Binding ActiveFadeTransition, Mode=OneWay}" Tag="{Binding ToggleFadeTransitionCommand}" />
                                <TextBlock x:Name="ItemMotionLabel" Text="{loc:Text OutputFormatWindow.ItemTransition}" />
                                <ComboBox x:Name="ItemMotion" Style="{x:Null}" Height="27" ItemsSource="{Binding TransitionKindOptions}" SelectedValue="{Binding ActiveTransitionKind, Mode=OneWay}"
                                          SelectedValuePath="Value" DisplayMemberPath="Key" SelectionChanged="ItemMotion_SelectionChanged"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ItemMotionLabel}" Margin="0,4,0,10" />
                                <TextBlock x:Name="SlideMotionLabel" Text="{loc:Text OutputFormatWindow.SlideTransition}" />
                                <ComboBox Style="{x:Null}" Height="27" ItemsSource="{Binding TransitionKindOptions}" SelectedValue="{Binding SlideTransitionKindInput, Mode=TwoWay}"
                                          SelectedValuePath="Value" DisplayMemberPath="Key"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SlideMotionLabel}" Margin="0,4,0,10" />
                                <TextBlock Text="{loc:Text OutputFormatWindow.Speed}" Margin="0,0,0,6" />
                                <UniformGrid Columns="3">
                                    <RadioButton Content="{loc:Text OutputFormatWindow.Fast}" ToolTip="{loc:Text OutputFormatWindow.Ms150}" IsChecked="{Binding TransitionIsFast, Mode=OneWay}" Tag="{Binding ApplyTransitionDurationCommand}">
                                        <RadioButton.CommandParameter><sys:Int32>150</sys:Int32></RadioButton.CommandParameter>
                                    </RadioButton>
                                    <RadioButton Content="{loc:Text OutputFormatWindow.Normal}" ToolTip="{loc:Text OutputFormatWindow.Ms250}" IsChecked="{Binding TransitionIsNormal, Mode=OneWay}" Tag="{Binding ApplyTransitionDurationCommand}">
                                        <RadioButton.CommandParameter><sys:Int32>250</sys:Int32></RadioButton.CommandParameter>
                                    </RadioButton>
                                    <RadioButton Content="{loc:Text OutputFormatWindow.Slow}" ToolTip="{loc:Text OutputFormatWindow.Ms500}" IsChecked="{Binding TransitionIsSlow, Mode=OneWay}" Tag="{Binding ApplyTransitionDurationCommand}">
                                        <RadioButton.CommandParameter><sys:Int32>500</sys:Int32></RadioButton.CommandParameter>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{x:Null}" Padding="10,5" Header="{loc:Text OutputFormatWindow.TabInfoPanel}">
                <Grid Margin="8,14,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.ShownItems}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <CheckBox Content="{loc:Text OutputFormatWindow.ShowPanel}" IsChecked="{Binding ActiveLyricsDisplayPanel, Mode=OneWay}" Tag="{Binding ToggleLyricsDisplayPanelCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.Position}" IsChecked="{Binding ActiveLyricsPositionIndicator, Mode=OneWay}" Tag="{Binding ToggleLyricsPositionIndicatorCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.VerseName}" IsChecked="{Binding ActiveLyricsVerseHeading, Mode=OneWay}" Tag="{Binding ToggleLyricsVerseHeadingCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.SongNumber}" IsChecked="{Binding ActiveLyricsItemNumber, Mode=OneWay}" Tag="{Binding ToggleLyricsItemNumberCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.SongTitle}" IsChecked="{Binding ActiveLyricsTitleOnPanel, Mode=OneWay}" Tag="{Binding ToggleLyricsTitleOnPanelCommand}"
                                          ToolTip="{loc:Text OutputFormatWindow.SongTitleTip}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.Copyright}" IsChecked="{Binding ActiveLyricsCopyright, Mode=OneWay}" Tag="{Binding ToggleLyricsCopyrightCommand}" />
                                <CheckBox Content="{loc:Text OutputFormatWindow.NextItem}" IsChecked="{Binding ActiveLyricsNextItem, Mode=OneWay}" Tag="{Binding ToggleLyricsNextItemCommand}" />
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <GroupBox DockPanel.Dock="Top" Header="{loc:Text OutputFormatWindow.Look}">
                            <StackPanel VerticalAlignment="Top" Margin="{StaticResource GroupPad}">
                                <CheckBox Content="{loc:Text OutputFormatWindow.Transparent}" IsChecked="{Binding ActiveLyricsPanelTransparent, Mode=OneWay}" Tag="{Binding TogglePanelTransparentCommand}"
                                          ToolTip="{loc:Text OutputFormatWindow.TransparentTip}" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="{loc:Text OutputFormatWindow.PanelColor}" Width="64" VerticalAlignment="Center" />
                                    <UniformGrid Rows="1">
                                        <Button Style="{StaticResource Fill}" Background="#000000" Command="{Binding ApplyPanelColorHexCommand}" CommandParameter="#000000" AutomationProperties.Name="정보 패널 색 검정" ToolTip="{loc:Text OutputFormatWindow.BlackDefault}" />
                                        <Button Style="{StaticResource Fill}" Background="#102040" Command="{Binding ApplyPanelColorHexCommand}" CommandParameter="#102040" AutomationProperties.Name="정보 패널 색 남색" ToolTip="{loc:Text OutputFormatWindow.Navy}" Margin="4,0,0,0" />
                                        <Button Style="{StaticResource Fill}" Background="#303030" Command="{Binding ApplyPanelColorHexCommand}" CommandParameter="#303030" AutomationProperties.Name="정보 패널 색 진회색" ToolTip="{loc:Text OutputFormatWindow.DarkGray}" Margin="4,0,0,0" />
                                        <Button Style="{StaticResource Fill}" Background="#3A1030" Command="{Binding ApplyPanelColorHexCommand}" CommandParameter="#3A1030" AutomationProperties.Name="정보 패널 색 자주" ToolTip="{loc:Text OutputFormatWindow.Plum}" Margin="4,0,0,0" />
                                        <Button Style="{StaticResource Fill}" Background="#103020" Command="{Binding ApplyPanelColorHexCommand}" CommandParameter="#103020" AutomationProperties.Name="정보 패널 색 진녹색" ToolTip="{loc:Text OutputFormatWindow.DarkGreen}" Margin="4,0,0,0" />
                                    </UniformGrid>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource Step}" Content="+" Command="{Binding IncreasePanelFontScaleCommand}" AutomationProperties.Name="정보 패널 글자 크게" />
                                    <Button Style="{StaticResource Step}" Content="−" Command="{Binding DecreasePanelFontScaleCommand}" AutomationProperties.Name="정보 패널 글자 작게" />
                                    <TextBlock Text="{Binding ActivePanelFontScale, StringFormat={loc:Text OutputFormatWindow.FontScale}}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" IsCancel="True" Content="{loc:Text OutputFormatWindow.Close}" Click="Close_Click" Width="104" Height="35" />
            <TextBlock Text="{loc:Text OutputFormatWindow.ApplyToAll}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="ApplyGlobal" Content="{loc:Text OutputFormatWindow.GlobalFormat}" Click="ApplyToAll_Click" Height="35" Padding="12,0" Margin="0,0,8,0"
                    AutomationProperties.Name="정보 화면을 제외하고 전역 서식 적용"
                    ToolTip="{loc:Text OutputFormatWindow.GlobalFormatTip}" />
            <Button x:Name="ApplyCopied" Content="{loc:Text OutputFormatWindow.CopiedFormat}" Click="ApplyToAll_Click" Height="35" Padding="12,0"
                    AutomationProperties.Name="복사한 서식을 전 항목에 적용"
                    ToolTip="{loc:Text OutputFormatWindow.CopiedFormatTip}" />
        </DockPanel>
    </Grid>
</Window>
