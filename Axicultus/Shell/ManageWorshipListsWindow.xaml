<Window x:Class="Axicultus.Wpf.Shell.ManageWorshipListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="예배 순서 관리"
        Width="460"
        Height="440"
        MinWidth="380"
        MinHeight="360"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 현재 순서 저장 -->
        <TextBlock Text="현재 예배 순서를 이름으로 저장"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
        <Grid Grid.Row="1" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox"
                     Style="{StaticResource EsTextBox.Default}"
                     AutomationProperties.Name="저장할 예배 순서 이름" />
            <Button Grid.Column="1"
                    Click="Save_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="8,0,0,0"
                    Content="저장"
                    AutomationProperties.Name="현재 순서 저장" />
        </Grid>

        <!-- 저장된 목록 / 휴지통 (FrmManageItemLists MainTabControl: ListsTab, TrashTab) -->
        <TabControl Grid.Row="2"
                    x:Name="MainTabControl"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    AutomationProperties.Name="예배 순서 목록과 휴지통">
            <TabItem x:Name="ListsTab" Header="목록">
                <ListBox x:Name="SavedListBox"
                         ItemsSource="{Binding SavedLists}"
                         AutomationProperties.Name="저장된 예배 순서 목록"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1" />
            </TabItem>
            <TabItem x:Name="TrashTab" Header="휴지통">
                <ListBox x:Name="TrashListBox"
                         ItemsSource="{Binding TrashedLists}"
                         SelectionMode="Extended"
                         AutomationProperties.Name="휴지통의 예배 순서 목록"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1" />
            </TabItem>
        </TabControl>

        <!-- 휴지통 탭의 버튼 — 목록 탭에서는 숨긴다(FrmManageItemLists.MainTabControl_SelectedIndexChanged). -->
        <StackPanel Grid.Row="3"
                    x:Name="TrashButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Margin="0,16,0,0">
            <Button Click="Restore_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="0,0,8,0"
                    Content="복원"
                    AutomationProperties.Name="선택 순서 휴지통에서 복원" />
            <Button Click="DeletePermanently_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Margin="0,0,8,0"
                    Content="영구 삭제"
                    AutomationProperties.Name="선택 순서 영구 삭제" />
            <Button Click="EmptyTrash_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Content="휴지통 비우기"
                    AutomationProperties.Name="휴지통 비우기" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    x:Name="ListButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Click="Rename_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="이름 변경"
                    AutomationProperties.Name="선택 순서 이름 변경" />
            <Button Click="Delete_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Margin="0,0,8,0"
                    Content="삭제"
                    AutomationProperties.Name="선택 순서 삭제" />
            <Button Click="Merge_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="병합"
                    ToolTip="선택 순서를 현재 예배 순서 뒤에 이어 붙입니다(현재 항목 유지). 불러오기는 대체합니다."
                    AutomationProperties.Name="선택 순서 현재에 병합" />
            <Button Click="Load_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Content="불러오기"
                    AutomationProperties.Name="선택 순서 불러오기" />
        </StackPanel>
    </Grid>
</Window>
