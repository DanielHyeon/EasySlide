<Window x:Class="Axicultus.Wpf.Shell.ManageWorshipListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Title="{loc:Text ManageWorshipListsWindow.Title}"
        Width="460"
        Height="440"
        MinWidth="380"
        MinHeight="360"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 현재 순서 저장 -->
        <TextBlock Text="{loc:Text ManageWorshipListsWindow.SaveCurrentHint}"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
        <Grid Grid.Row="1" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox"
                     Style="{StaticResource EsTextBox.Default}"
                     AutomationProperties.Name="저장할 예배 순서 이름" />
            <Button Grid.Column="1"
                    Click="Save_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="8,0,0,0"
                    Content="{loc:Text ManageWorshipListsWindow.Save}"
                    AutomationProperties.Name="현재 순서 저장" />
        </Grid>

        <!-- Saved lists / trash (FrmManageItemLists MainTabControl: ListsTab, TrashTab) -->
        <TabControl Grid.Row="2"
                    x:Name="MainTabControl"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    AutomationProperties.Name="예배 순서 목록과 휴지통">
            <TabItem x:Name="ListsTab" Header="{loc:Text ManageWorshipListsWindow.ListsTab}">
                <ListBox x:Name="SavedListBox"
                         ItemsSource="{Binding SavedLists}"
                         AutomationProperties.Name="저장된 예배 순서 목록"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1" />
            </TabItem>
            <TabItem x:Name="TrashTab" Header="{loc:Text ManageWorshipListsWindow.TrashTab}">
                <ListBox x:Name="TrashListBox"
                         ItemsSource="{Binding TrashedLists}"
                         SelectionMode="Extended"
                         AutomationProperties.Name="휴지통의 예배 순서 목록"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1" />
            </TabItem>
        </TabControl>

        <!-- The trash tab's buttons: hidden on the lists tab (FrmManageItemLists.MainTabControl_SelectedIndexChanged). -->
        <StackPanel Grid.Row="3"
                    x:Name="TrashButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Margin="0,16,0,0">
            <Button Click="Restore_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="0,0,8,0"
                    Content="{loc:Text ManageWorshipListsWindow.Restore}"
                    AutomationProperties.Name="선택 순서 휴지통에서 복원" />
            <Button Click="DeletePermanently_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Margin="0,0,8,0"
                    Content="{loc:Text ManageWorshipListsWindow.DeletePermanently}"
                    AutomationProperties.Name="선택 순서 영구 삭제" />
            <Button Click="EmptyTrash_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Content="{loc:Text ManageWorshipListsWindow.EmptyTrash}"
                    AutomationProperties.Name="휴지통 비우기" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    x:Name="ListButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Click="Rename_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="{loc:Text ManageWorshipListsWindow.Rename}"
                    AutomationProperties.Name="선택 순서 이름 변경" />
            <Button Click="Delete_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Margin="0,0,8,0"
                    Content="{loc:Text ManageWorshipListsWindow.Delete}"
                    AutomationProperties.Name="선택 순서 삭제" />
            <Button Click="Merge_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="{loc:Text ManageWorshipListsWindow.Merge}"
                    ToolTip="{loc:Text ManageWorshipListsWindow.MergeTip}"
                    AutomationProperties.Name="선택 순서 현재에 병합" />
            <Button Click="Load_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Content="{loc:Text ManageWorshipListsWindow.Load}"
                    AutomationProperties.Name="선택 순서 불러오기" />
        </StackPanel>
    </Grid>
</Window>
