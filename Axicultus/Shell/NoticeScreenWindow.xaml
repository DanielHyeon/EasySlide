<Window x:Class="Axicultus.Wpf.Shell.NoticeScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Axicultus.Wpf.Controls"
        xmlns:loc="clr-namespace:Axicultus.Wpf.Localization"
        Title="{loc:Text NoticeScreenWindow.Title}" Width="740" Height="590" MinWidth="494" MinHeight="364"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Surface.Page}">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <DataTemplate x:Key="ActionCaption">
            <StackPanel Orientation="Horizontal">
                <controls:FrmIcon Width="16" Height="16" Margin="0,0,6,0"
                                  Icon="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Target="{Binding ElementName=ScreenName}" Content="{loc:Text NoticeScreenWindow.NoticeName}" />
                <TextBox x:Name="ScreenName" VerticalContentAlignment="Center" MinHeight="32"
                         Text="{Binding NewScreenName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="새 정보 화면 이름" />
            </StackPanel>
            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    Command="{Binding SaveAsCommand}" Style="{StaticResource EsButton.Primary}"
                    Content="{loc:Text NoticeScreenWindow.Save}" Tag="save" ContentTemplate="{StaticResource ActionCaption}"
                    ToolTip="{loc:Text NoticeScreenWindow.SaveTip}" AutomationProperties.Name="정보 화면 저장" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom">
            <Expander Header="{loc:Text NoticeScreenWindow.SavedNotices}" Margin="0,8,0,0" AutomationProperties.Name="저장된 공지 관리">
                <Grid Margin="4,6,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding SavedScreens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
                              VerticalContentAlignment="Center" AutomationProperties.Name="저장된 정보 화면" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource EsButton.Secondary}"
                            Command="{Binding OpenCommand}" Content="{loc:Text NoticeScreenWindow.Open}" Tag="folder_open"
                            ContentTemplate="{StaticResource ActionCaption}" AutomationProperties.Name="정보 화면 불러오기" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource EsButton.Secondary}"
                            Command="{Binding DeleteCommand}" Content="{loc:Text NoticeScreenWindow.Delete}" Tag="delete"
                            ContentTemplate="{StaticResource ActionCaption}" AutomationProperties.Name="정보 화면 삭제" />
                </Grid>
            </Expander>
            <TextBlock Text="{Binding StatusText}" Margin="2,4,2,4" TextWrapping="Wrap"
                       Style="{StaticResource Type.Caption.Style}" AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,2,0,2" Style="{StaticResource EsButton.Secondary}"
                            VerticalAlignment="Center" Click="Close_Click" Content="{loc:Text NoticeScreenWindow.Close}" AutomationProperties.Name="닫기" />
                    <WrapPanel>
                        <Button Command="{Binding AddToQueueCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,2,6,2"
                                Content="{loc:Text NoticeScreenWindow.AddToQueue}" Tag="text_bullet_list_add" ContentTemplate="{StaticResource ActionCaption}"
                                AutomationProperties.Name="텍스트 항목을 예배 순서에 추가" />
                        <Button Command="{Binding SendCommand}" Style="{StaticResource EsButton.Primary}" Margin="0,2,6,2"
                                Content="{loc:Text NoticeScreenWindow.SendNow}" Tag="live" ContentTemplate="{StaticResource ActionCaption}"
                                AutomationProperties.Name="공지 송출" />
                        <Button Command="{Binding ClearCommand}" Style="{StaticResource EsButton.Secondary}" Margin="0,2,0,2"
                                Content="{loc:Text NoticeScreenWindow.ClearOutput}" Tag="desktop" ContentTemplate="{StaticResource ActionCaption}"
                                ToolTip="{loc:Text NoticeScreenWindow.ClearOutputTip}" AutomationProperties.Name="공지 내리기(검은 화면)" />
                    </WrapPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MaxWidth="240" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource EditorCard}">
                <DockPanel>
                    <Label DockPanel.Dock="Top" Target="{Binding ElementName=MessageText}"
                           Content="{loc:Text NoticeScreenWindow.NoticeText}" FontSize="{DynamicResource Type.BodyLarge.FontSize}" />
                    <TextBox x:Name="MessageText" Margin="0,6,0,0" Padding="8"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             FontSize="{DynamicResource Type.BodyLarge.FontSize}" AutomationProperties.Name="공지 문구 입력" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource EditorCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Text NoticeScreenWindow.OutputFormat}" FontWeight="SemiBold" Margin="0,0,0,12"
                                   FontSize="{DynamicResource Type.BodyLarge.FontSize}" />
                        <Label Target="{Binding ElementName=NoticeFont}" Content="{loc:Text NoticeScreenWindow.Font}" />
                        <ComboBox x:Name="NoticeFont" ItemsSource="{Binding FontNameOptions}"
                                  Text="{Binding FontName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                  AutomationProperties.Name="공지 글꼴" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,4,0">
                                <Label Target="{Binding ElementName=NoticeSize}" Content="{loc:Text NoticeScreenWindow.Size}" />
                                <ComboBox x:Name="NoticeSize" ItemsSource="{Binding FontSizePresets}"
                                  SelectedItem="{Binding FontSizePt, Mode=TwoWay}"
                                  AutomationProperties.Name="공지 글자 크기(pt)" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <Label Target="{Binding ElementName=NoticeAlignment}" Content="{loc:Text NoticeScreenWindow.Alignment}" />
                                <ComboBox x:Name="NoticeAlignment" ItemsSource="{Binding AlignmentPresets}"
                                  SelectedValue="{Binding Alignment, Mode=TwoWay}"
                                  SelectedValuePath="Value" DisplayMemberPath="Key"
                                  AutomationProperties.Name="공지 정렬" />
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,4,0">
                                <Label Target="{Binding ElementName=NoticeTextColor}" Content="{loc:Text NoticeScreenWindow.TextColor}" />
                                <ComboBox x:Name="NoticeTextColor" ItemsSource="{Binding ColorPresets}"
                                  SelectedValue="{Binding ColorArgb, Mode=TwoWay}"
                                  SelectedValuePath="Value" DisplayMemberPath="Key"
                                  AutomationProperties.Name="공지 글자색" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <Label Target="{Binding ElementName=NoticeBackground}" Content="{loc:Text NoticeScreenWindow.BackgroundColor}" />
                                <ComboBox x:Name="NoticeBackground" ItemsSource="{Binding BackgroundColorPresets}"
                                  SelectedValue="{Binding BackgroundColorArgb, Mode=TwoWay}"
                                  SelectedValuePath="Value" DisplayMemberPath="Key"
                                  AutomationProperties.Name="공지 배경색" />
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox Content="{loc:Text NoticeScreenWindow.Bold}" IsChecked="{Binding Bold, Mode=TwoWay}" FontWeight="Bold" Margin="0,2,8,2" AutomationProperties.Name="공지 굵게" />
                            <CheckBox Content="{loc:Text NoticeScreenWindow.Italic}" IsChecked="{Binding Italic, Mode=TwoWay}" FontStyle="Italic" Margin="0,2,8,2" AutomationProperties.Name="공지 기울임" />
                            <CheckBox IsChecked="{Binding Underline, Mode=TwoWay}" Margin="0,2" AutomationProperties.Name="공지 밑줄">
                                <TextBlock Text="{loc:Text NoticeScreenWindow.Underline}" TextDecorations="Underline" />
                            </CheckBox>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
