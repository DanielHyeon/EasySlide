<Window x:Class="Axicultus.Wpf.Shell.OutputAlertsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Axicultus.Wpf.Localization" Title="{loc:Text OutputAlertsWindow.Title}" Width="490" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="AudienceMessageLabel" Text="{loc:Text OutputAlertsWindow.AudienceMessage}" /><ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AudienceMessageLabel}" x:Name="Message" IsEditable="True" />
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
            <CheckBox x:Name="MessageFlash" Content="{loc:Text OutputAlertsWindow.Flash}" /><CheckBox x:Name="MessageScroll" Content="{loc:Text OutputAlertsWindow.Scroll}" Margin="8,0"/><CheckBox x:Name="MessageTransparent" Content="{loc:Text OutputAlertsWindow.Transparent}" />
            <Button Content="{loc:Text OutputAlertsWindow.Show}" Click="Message_Click" Margin="8,0" IsEnabled="{Binding IsOutputLiveActive}"/>
            <Button Content="{loc:Text OutputAlertsWindow.ClearHistory}" Click="ClearMessageHistory_Click"/>
        </StackPanel>
        <TextBlock Text="{loc:Text OutputAlertsWindow.ParentalAlert}" /><DockPanel><TextBox AutomationProperties.Name="호출 머리말" x:Name="Prefix" Text="{loc:Text OutputAlertsWindow.ParentalAlert}" Width="105"/><ComboBox AutomationProperties.Name="보호자 호출 내용" x:Name="Parental" IsEditable="True"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
            <CheckBox x:Name="ParentalFlash" Content="{loc:Text OutputAlertsWindow.Flash}"/><CheckBox x:Name="ParentalScroll" Content="{loc:Text OutputAlertsWindow.Scroll}" Margin="8,0"/><CheckBox x:Name="ParentalTransparent" Content="{loc:Text OutputAlertsWindow.Transparent}"/>
            <Button Content="{loc:Text OutputAlertsWindow.Call}" Click="Parental_Click" Margin="8,0" IsEnabled="{Binding IsOutputLiveActive}"/>
            <Button Content="{loc:Text OutputAlertsWindow.ClearHistory}" Click="ClearParentalHistory_Click"/>
        </StackPanel>
        <TextBlock x:Name="LyricsMessageLabel" Text="{loc:Text OutputAlertsWindow.LyricsMessage}"/><TextBox AutomationProperties.LabeledBy="{Binding ElementName=LyricsMessageLabel}" Text="{Binding OutputLiveMessage, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10"><Button Content="{loc:Text OutputAlertsWindow.Show}" Command="{Binding SendLiveMessageCommand}"/><Button Content="{loc:Text OutputAlertsWindow.Clear}" Command="{Binding ClearLiveMessageCommand}" Margin="8,0"/></StackPanel>
        <Button Content="{loc:Text OutputAlertsWindow.StopAll}" Click="Stop_Click" HorizontalAlignment="Left"/>
    </StackPanel>
</Window>
