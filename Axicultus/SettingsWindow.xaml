                                        <options:OptionColorButton Width="130" Height="39" Content="그라데이션 끝색"
                                            Argb="{Binding LyricsMonitorBackgroundColor2Argb, Mode=TwoWay}" AutomationProperties.Name="회중 송출 가사 배경 그라데이션 끝색"
                                            IsEnabled="{Binding LyricsMonitorBackgroundIsGradient}" ToolTip="그라데이션을 켜면 배경색에서 이 색으로 이어집니다." />
                                    </WrapPanel>
                                    <CheckBox IsChecked="{Binding LyricsMonitorBackgroundIsGradient, Mode=TwoWay}" Content="가사 배경 세로 그라데이션 사용" AutomationProperties.Name="가사 배경 그라데이션 사용" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <CheckBox IsChecked="{Binding LyricsMonitorShowNotations, Mode=TwoWay}" Content="회중 화면 코드 표기" AutomationProperties.Name="회중 송출 가사 코드 표기" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <TextBlock x:Name="LblLyricsMonitorFontSize" Text="글자 크기" />
                                    <TextBox Text="{Binding LyricsMonitorFontSize}" AutomationProperties.LabeledBy="{Binding ElementName=LblLyricsMonitorFontSize}" Margin="0,2,0,8" />
                                    <CheckBox Content="굵게" IsChecked="{Binding LyricsMonitorBold, Mode=TwoWay}" />
                                    <CheckBox Content="기울임" IsChecked="{Binding LyricsMonitorItalic, Mode=TwoWay}" />
                                    <CheckBox Content="밑줄" IsChecked="{Binding LyricsMonitorUnderline, Mode=TwoWay}" />
                                </StackPanel>
                            </GroupBox>
                            <CheckBox Content="라이브 안전 확인" IsChecked="{Binding UseSafetyConfirmations, Mode=TwoWay}" />
                            <TextBlock x:Name="ReferenceSeparatorLabel" Text="참조 구분 기호" />
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=ReferenceSeparatorLabel}" Text="{Binding ReferenceAlertPickSeparator}" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="고급">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <StackPanel Margin="{StaticResource Thickness.Xl}">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="다시 읽기" Command="{Binding RefreshCommand}" Padding="8,2" />
                                    <Button Content="기본값 복원" Command="{Binding RestoreDefaultsCommand}" Padding="8,2" Margin="8,0,0,0" />
                                </WrapPanel>
                                <CheckBox IsChecked="{Binding EnableDiagnostics, Mode=TwoWay}" Content="진단 로그 활성화" AutomationProperties.Name="진단 로그 활성화" MinHeight="{DynamicResource Spacing.TargetMin}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Style="{x:Null}" Padding="10,5" Header="장치 점검" x:Name="DeviceCheckTab" AutomationProperties.Name="장치 점검">
                <composites:DeviceCheckPanel x:Name="DeviceCheck" />
            </TabItem>

        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button IsDefault="True" Content="OK" Click="Confirm_Click" Width="104" Height="35" Margin="0,0,16,0" />
                <Button IsCancel="True" Content="Cancel" Width="104" Height="35" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ValidationMessages}" />
        </DockPanel>
    </Grid>
</Window>
