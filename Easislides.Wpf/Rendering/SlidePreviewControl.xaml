<UserControl x:Class="Easislides.Wpf.Rendering.SlidePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Easislides.Wpf.Rendering"
             x:Name="Root"
             MinHeight="180"
             Focusable="True"
             SnapsToDevicePixels="True">
    <Grid>
        <local:PreviewCanvas x:Name="PreviewCanvasElement"
                             Source="{Binding Source, ElementName=Root}"
                             FillMode="{Binding FillMode, ElementName=Root}"
                             IsSelected="{Binding IsSelected, ElementName=Root}"
                             SlideNumber="{Binding SlideNumber, ElementName=Root}"
                             ShowSlideNumber="{Binding ShowSlideNumber, ElementName=Root}"
                             Background="{DynamicResource Brush.Surface.Page}"
                             SelectionBrush="{DynamicResource Brush.Accent.Primary}"
                             SlideNumberBackground="{DynamicResource Brush.Accent.Primary}"
                             SlideNumberForeground="{DynamicResource Brush.Text.Inverse}" />

        <Grid x:Name="FallbackPanel"
              Background="{DynamicResource Brush.Surface.Page}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16">
                <TextBlock x:Name="FallbackTitleText"
                           Text="{Binding Title, ElementName=Root, TargetNullValue=No preview}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock x:Name="FallbackKindText"
                           Text="{Binding Kind, ElementName=Root, TargetNullValue=Item}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
