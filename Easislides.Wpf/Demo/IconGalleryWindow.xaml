<Window x:Class="Easislides.Wpf.Demo.IconGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EsIcons Gallery — 아이콘 매핑 시각 검증 (docs/ui/icon-migration-map.md)"
        Width="1100" Height="780"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="EsIcons — Fluent UI System Icons 매핑"
                   Style="{StaticResource Type.Title1.Style}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Style="{StaticResource Type.Body.Style}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16">
            <Run Text="ADR-0002: " FontWeight="SemiBold" /><Run Text="레거시 raster 60+ 자산을 Microsoft Fluent UI System Icons (MIT)로 매핑. 외주 없이 내부 추출 — " />
            <Hyperlink NavigateUri="docs/ui/icon-migration-map.md"><Run Text="매핑 표 원본" /></Hyperlink>
            <Run Text=" / " />
            <Hyperlink NavigateUri="docs/ui/icon-pipeline.md"><Run Text="파이프라인 가이드" /></Hyperlink>
        </TextBlock>

        <!-- Icon Gallery -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- §1 송출 제어 -->
                <TextBlock Text="§1 송출 제어 (라이브)"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,8,0,12" />
                <ItemsControl x:Name="LiveIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Medium}"
                                    Width="180" Height="100"
                                    Margin="6"
                                    Padding="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                   FontSize="32"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Key}"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SymbolName}"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- §2 콘텐츠 -->
                <TextBlock Text="§2 콘텐츠 (성경·찬양·미디어·문서)"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,24,0,12" />
                <ItemsControl x:Name="ContentIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Medium}"
                                    Width="180" Height="100"
                                    Margin="6" Padding="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="32" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SymbolName}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- §3 파일·관리 -->
                <TextBlock Text="§3 파일·폴더·관리"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,24,0,12" />
                <ItemsControl x:Name="FileIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Medium}"
                                    Width="180" Height="100"
                                    Margin="6" Padding="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="32" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SymbolName}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- §4 설정·시스템 -->
                <TextBlock Text="§4 설정·시스템·도움말"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,24,0,12" />
                <ItemsControl x:Name="SettingsIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Medium}"
                                    Width="180" Height="100"
                                    Margin="6" Padding="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="32" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SymbolName}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- §5 모니터 + 기타 -->
                <TextBlock Text="§5 모니터·디스플레이 + §7 폐기 대체"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,24,0,12" />
                <ItemsControl x:Name="OtherIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Medium}"
                                    Width="180" Height="100"
                                    Margin="6" Padding="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="32" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SymbolName}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 색 토큰 적용 예시 (라이브 상태 색) -->
                <TextBlock Text="라이브 색 토큰 적용 예시"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,24,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Medium}" Width="180" Height="100" Margin="6" Padding="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="VideoClip24" FontSize="32" Foreground="{DynamicResource Brush.Live.Active}" HorizontalAlignment="Center" />
                            <TextBlock Text="Live.Active" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Live.Active}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Medium}" Width="180" Height="100" Margin="6" Padding="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pause24" FontSize="32" Foreground="{DynamicResource Brush.Live.Standby}" HorizontalAlignment="Center" />
                            <TextBlock Text="Live.Standby" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Live.Standby}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Medium}" Width="180" Height="100" Margin="6" Padding="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="32" Foreground="{DynamicResource Brush.Status.Danger}" HorizontalAlignment="Center" />
                            <TextBlock Text="Status.Danger" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Status.Danger}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Medium}" Width="180" Height="100" Margin="6" Padding="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="32" Foreground="{DynamicResource Brush.Status.Success}" HorizontalAlignment="Center" />
                            <TextBlock Text="Status.Success" Style="{StaticResource Type.Body.Style}" Foreground="{DynamicResource Brush.Status.Success}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0">
            <Run Text="총 50+ 아이콘. 모두 WPF UI 3.0.5의 SymbolRegular enum (Fluent UI System Icons MIT)에서 추출 — 외부 디자이너 외주 0원." />
            <LineBreak />
            <Run Text="다크/라이트 테마 토글 후에도 색 토큰이 정상 전환되는지 확인 — DemoWindow에서 테마 변경 후 본 창 재진입." />
        </TextBlock>

    </Grid>
</Window>
