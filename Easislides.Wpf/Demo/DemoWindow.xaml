<Window x:Class="Easislides.Wpf.Demo.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides v3.0 — Sprint 0 Demo (EasiDS 토큰 검증)"
        Width="900" Height="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 헤더 -->
            <RowDefinition Height="Auto" />  <!-- 컨트롤 패널 -->
            <RowDefinition Height="*" />     <!-- 버튼 데모 -->
            <RowDefinition Height="Auto" />  <!-- PoC 진입점 -->
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="EasiSlides v3.0 — Sprint 0 산출물"
                       Style="{StaticResource Type.Display.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="EasiDS 디자인 토큰 + 베이스 컨트롤 + PoC 진입점 (ADR-0001~0007)"
                       Style="{StaticResource Type.Body.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 컨트롤 패널 — 테마/크기 토글 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Lg}"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="테마:"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,8,0" />
                <Button x:Name="BtnLight" Content="라이트" Style="{StaticResource EsButton.Secondary}"
                        Click="OnLight_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnDark" Content="다크" Style="{StaticResource EsButton.Secondary}"
                        Click="OnDark_Click" Margin="0,0,24,0" />

                <TextBlock Text="크기:"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,8,0" />
                <Button Content="표준" Style="{StaticResource EsButton.Secondary}"
                        Click="OnSizeStandard_Click" Margin="0,0,8,0" />
                <Button Content="큰 글씨" Style="{StaticResource EsButton.Secondary}"
                        Click="OnSizeLarge_Click" Margin="0,0,8,0" />
                <Button Content="시니어" Style="{StaticResource EsButton.Secondary}"
                        Click="OnSizeSenior_Click" />
            </StackPanel>
        </Border>

        <!-- EsButton 3변종 데모 -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Xl}">
            <StackPanel>
                <TextBlock Text="EsButton 변종 — 토큰 참조 검증"
                           Style="{StaticResource Type.Title2.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,0,16" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Primary (주요 액션)" Style="{StaticResource EsButton.Primary}" Margin="0,0,12,0" />
                    <Button Content="Secondary" Style="{StaticResource EsButton.Secondary}" Margin="0,0,12,0" />
                    <Button Content="삭제 (Danger)" Style="{StaticResource EsButton.Danger}" />
                </StackPanel>
                <TextBlock Text="비활성 상태:"
                           Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,12,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Primary" Style="{StaticResource EsButton.Primary}" IsEnabled="False" Margin="0,0,12,0" />
                    <Button Content="Secondary" Style="{StaticResource EsButton.Secondary}" IsEnabled="False" Margin="0,0,12,0" />
                    <Button Content="Danger" Style="{StaticResource EsButton.Danger}" IsEnabled="False" />
                </StackPanel>

                <TextBlock Text="포커스 링 확인: Tab 키로 버튼 사이 이동 — 파란 외곽선이 보여야 함 (§7.2)"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- PoC 진입점 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="PoC-A: HookManager 호환성"
                    Style="{StaticResource EsButton.Primary}"
                    Click="OnPocA_Click" Margin="0,0,12,0" />
            <Button Content="PoC-B: COM STA Stress 100회"
                    Style="{StaticResource EsButton.Primary}"
                    Click="OnPocB_Click" />
        </StackPanel>

    </Grid>
</Window>
