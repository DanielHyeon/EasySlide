<Window x:Class="Easislides.Wpf.Shell.OutputAlertsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="송출 알림" Width="490" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="AudienceMessageLabel" Text="회중 메시지" /><ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AudienceMessageLabel}" x:Name="Message" IsEditable="True" />
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
            <CheckBox x:Name="MessageFlash" Content="깜박임" /><CheckBox x:Name="MessageScroll" Content="스크롤" Margin="8,0"/><CheckBox x:Name="MessageTransparent" Content="투명 배경" />
            <Button Content="표시" Click="Message_Click" Margin="8,0" IsEnabled="{Binding IsOutputLiveActive}"/>
            <Button Content="기록 지우기" Click="ClearMessageHistory_Click"/>
        </StackPanel>
        <TextBlock Text="보호자 호출" /><DockPanel><TextBox AutomationProperties.Name="호출 머리말" x:Name="Prefix" Text="보호자 호출" Width="105"/><ComboBox AutomationProperties.Name="보호자 호출 내용" x:Name="Parental" IsEditable="True"/></DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
            <CheckBox x:Name="ParentalFlash" Content="깜박임"/><CheckBox x:Name="ParentalScroll" Content="스크롤" Margin="8,0"/><CheckBox x:Name="ParentalTransparent" Content="투명 배경"/>
            <Button Content="호출" Click="Parental_Click" Margin="8,0" IsEnabled="{Binding IsOutputLiveActive}"/>
            <Button Content="기록 지우기" Click="ClearParentalHistory_Click"/>
        </StackPanel>
        <TextBlock x:Name="LyricsMessageLabel" Text="가사 모니터 메시지"/><TextBox AutomationProperties.LabeledBy="{Binding ElementName=LyricsMessageLabel}" Text="{Binding OutputLiveMessage, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,10"><Button Content="표시" Command="{Binding SendLiveMessageCommand}"/><Button Content="지우기" Command="{Binding ClearLiveMessageCommand}" Margin="8,0"/></StackPanel>
        <Button Content="회중 메시지 및 보호자 호출 중지" Click="Stop_Click" HorizontalAlignment="Left"/>
    </StackPanel>
</Window>
