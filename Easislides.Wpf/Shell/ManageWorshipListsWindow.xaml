<Window x:Class="Easislides.Wpf.Shell.ManageWorshipListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="예배 순서 관리"
        Width="460"
        Height="440"
        MinWidth="380"
        MinHeight="360"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 현재 순서 저장 -->
        <TextBlock Text="현재 예배 순서를 이름으로 저장"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
        <Grid Grid.Row="1" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox"
                     Style="{StaticResource EsTextBox.Default}"
                     AutomationProperties.Name="저장할 예배 순서 이름" />
            <Button Grid.Column="1"
                    Click="Save_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="8,0,0,0"
                    Content="저장"
                    AutomationProperties.Name="현재 순서 저장" />
        </Grid>

        <!-- 저장된 목록 -->
        <ListBox Grid.Row="2"
                 x:Name="SavedListBox"
                 ItemsSource="{Binding SavedLists}"
                 AutomationProperties.Name="저장된 예배 순서 목록"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Click="Rename_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="이름 변경"
                    AutomationProperties.Name="선택 순서 이름 변경" />
            <Button Click="Delete_Click"
                    Style="{StaticResource EsButton.Danger}"
                    Margin="0,0,8,0"
                    Content="삭제"
                    AutomationProperties.Name="선택 순서 삭제" />
            <Button Click="Merge_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="병합"
                    ToolTip="선택 순서를 현재 예배 순서 뒤에 이어 붙입니다(현재 항목 유지). 불러오기는 대체합니다."
                    AutomationProperties.Name="선택 순서 현재에 병합" />
            <Button Click="Load_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Content="불러오기"
                    AutomationProperties.Name="선택 순서 불러오기" />
        </StackPanel>
    </Grid>
</Window>
