<Window x:Class="Easislides.Wpf.Shell.NameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        MinHeight="180"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- BoolToVis 는 앱 전역이 아니라 창마다 선언하는 패턴(MainWindow 와 동일). -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Prompt}"
                   Style="{StaticResource Type.Body.Style}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   TextWrapping="Wrap" />

        <TextBox Grid.Row="1"
                 x:Name="InputBox"
                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource EsTextBox.Default}"
                 Margin="0,10,0,0"
                 AutomationProperties.Name="새 이름" />

        <!-- 빈 이름·중복일 때만 빨간 안내가 보인다. -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                   Foreground="{DynamicResource Brush.Status.Danger}"
                   Style="{StaticResource Type.Caption.Style}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="취소"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="취소" />
            <!-- IsDefault=True 라 Enter 로 확인. CanConfirm 이 false 면 버튼이 꺼져 Enter 도 동작 안 함. -->
            <Button Content="확인"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Click="Ok_Click"
                    Style="{StaticResource EsButton.Primary}"
                    AutomationProperties.Name="이름 변경 확인" />
        </StackPanel>
    </Grid>
</Window>
