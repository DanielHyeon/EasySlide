<Window x:Class="Easislides.Wpf.Shell.NoticeScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공지 화면 — InfoScreen"
        Width="520"
        Height="420"
        MinWidth="420"
        MinHeight="320"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="회중 출력에 표시할 공지(안내) 문구를 입력하고 '송출'을 누르세요. 줄바꿈으로 여러 줄을 보낼 수 있습니다."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox Grid.Row="1"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 AutomationProperties.Name="공지 문구 입력" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="글자 크기"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding FontSizePresets}"
                      SelectedItem="{Binding FontSizePt, Mode=TwoWay}"
                      Width="90"
                      AutomationProperties.Name="공지 글자 크기(pt)" />
            <TextBlock Text="정렬"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="16,0,8,0" />
            <ComboBox ItemsSource="{Binding AlignmentPresets}"
                      SelectedValue="{Binding Alignment, Mode=TwoWay}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Key"
                      Width="100"
                      ToolTip="공지 가로 정렬(기본=출력 기본 정렬)"
                      AutomationProperties.Name="공지 정렬" />
            <TextBlock Text="글자색"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="16,0,8,0" />
            <ComboBox ItemsSource="{Binding ColorPresets}"
                      SelectedValue="{Binding ColorArgb, Mode=TwoWay}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Key"
                      Width="100"
                      ToolTip="공지 글자색(기본=출력 기본 글자색)"
                      AutomationProperties.Name="공지 글자색" />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0,0,0" />
        </StackPanel>

        <!-- 명명 정보 화면(레거시 InfoScreen .esi 목록) — 현재 본문을 이름으로 저장, 콤보에서 골라 불러오기/삭제. -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding NewScreenName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     ToolTip="새 정보 화면 이름"
                     AutomationProperties.Name="새 정보 화면 이름" />
            <Button Grid.Column="1"
                    Command="{Binding SaveAsCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="6,0,0,0"
                    Content="저장"
                    AutomationProperties.Name="정보 화면 저장" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding SavedScreens}"
                      SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
                      MinHeight="30"
                      ToolTip="저장된 정보 화면"
                      AutomationProperties.Name="저장된 정보 화면" />
            <Button Grid.Column="4"
                    Command="{Binding OpenCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="6,0,0,0"
                    Content="불러오기"
                    AutomationProperties.Name="정보 화면 불러오기" />
            <Button Grid.Column="5"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="6,0,0,0"
                    Content="삭제"
                    AutomationProperties.Name="정보 화면 삭제" />
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Command="{Binding SendCommand}"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="0,0,8,0"
                    Content="송출"
                    AutomationProperties.Name="공지 송출" />
            <Button Command="{Binding AddToQueueCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="순서에 추가"
                    ToolTip="이 텍스트를 예배 순서에 항목으로 추가합니다(즉시 송출과 달리 순서에 저장돼 나중에 송출 가능)."
                    AutomationProperties.Name="텍스트 항목을 예배 순서에 추가" />
            <Button Command="{Binding ClearCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="지우기"
                    AutomationProperties.Name="공지 내리기(검은 화면)" />
            <Button Click="Close_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="닫기"
                    AutomationProperties.Name="닫기" />
        </StackPanel>
    </Grid>
</Window>
