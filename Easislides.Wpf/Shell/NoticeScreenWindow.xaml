<Window x:Class="Easislides.Wpf.Shell.NoticeScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공지 화면 — InfoScreen"
        Width="520"
        Height="420"
        MinWidth="420"
        MinHeight="320"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="회중 출력에 표시할 공지(안내) 문구를 입력하고 '송출'을 누르세요. 줄바꿈으로 여러 줄을 보낼 수 있습니다."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox Grid.Row="1"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 AutomationProperties.Name="공지 문구 입력" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="글자 크기"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding FontSizePresets}"
                      SelectedItem="{Binding FontSizePt, Mode=TwoWay}"
                      Width="90"
                      AutomationProperties.Name="공지 글자 크기(pt)" />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Command="{Binding SendCommand}"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="0,0,8,0"
                    Content="송출"
                    AutomationProperties.Name="공지 송출" />
            <Button Command="{Binding ClearCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="지우기"
                    AutomationProperties.Name="공지 내리기(검은 화면)" />
            <Button Click="Close_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="닫기"
                    AutomationProperties.Name="닫기" />
        </StackPanel>
    </Grid>
</Window>
