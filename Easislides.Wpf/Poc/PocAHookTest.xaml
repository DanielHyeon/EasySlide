<Window x:Class="Easislides.Wpf.Poc.PocAHookTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoC-A: HookManager + WPF PreviewKeyDown 호환성 검증 (ADR-0004)"
        Width="780" Height="560"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PoC-A: 글로벌 후킹 vs WPF 라우티드 이벤트"
                   Style="{StaticResource Type.Title1.Style}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Lg}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextWrapping="Wrap">
                    <Run Text="검증 시나리오 (ADR-0004):" FontWeight="SemiBold" /><LineBreak />
                    1. 이 창 활성 상태에서 F5/F1/Space 등을 누르면 로컬(WPF) 핸들러가 작동<LineBreak />
                    2. "글로벌 후킹 활성" 토글 후 다른 앱 활성화 → F5 누르면 글로벌 핸들러가 EasiSlides 명령 실행<LineBreak />
                    3. 두 경로가 동시 도달 시 글로벌이 우선 (e.Handled = true)
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnEnableHook" Content="글로벌 후킹 활성"
                            Style="{StaticResource EsButton.Primary}"
                            Click="OnEnableHook_Click" Margin="0,0,12,0" />
                    <Button x:Name="BtnDisableHook" Content="글로벌 후킹 비활성"
                            Style="{StaticResource EsButton.Secondary}"
                            Click="OnDisableHook_Click" IsEnabled="False" Margin="0,0,12,0" />
                    <Button Content="로그 지우기"
                            Style="{StaticResource EsButton.Secondary}"
                            Click="OnClearLog_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Md}">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogTextBlock"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="합격 기준: 글로벌 핸들러는 비포커스 시에도 작동, 충돌 키는 글로벌 우선, 로컬은 글로벌 미등록 키에만 발화."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
