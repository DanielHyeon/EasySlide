<Window x:Class="Easislides.Wpf.Poc.PocBComStress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoC-B: PowerPoint COM STA Stress Test (계획서 §10.3)"
        Width="780" Height="560"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PoC-B: COM 객체 STA 어피니티 + 100회 stress"
                   Style="{StaticResource Type.Title1.Style}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Lg}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextWrapping="Wrap">
                    <Run Text="검증 시나리오 (§10.3 STA 스레드 모델 리스크):" FontWeight="SemiBold" /><LineBreak />
                    1. OfficePptSession이 자체 STA 워커 스레드 생성<LineBreak />
                    2. 100회 순회: PowerPoint Application 생성 → Quit → ReleaseComObject<LineBreak />
                    3. 종료 후 POWERPNT.EXE 좀비 프로세스 0건 확인<LineBreak />
                    4. UI 스레드 멈춤 없이 진행 (Task.Run 패턴)
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnStart" Content="100회 stress 시작"
                            Style="{StaticResource EsButton.Primary}"
                            Click="OnStart_Click" Margin="0,0,12,0" />
                    <Button x:Name="BtnCheck" Content="좀비 POWERPNT.EXE 확인"
                            Style="{StaticResource EsButton.Secondary}"
                            Click="OnCheckZombies_Click" Margin="0,0,12,0" />
                    <Button Content="로그 지우기"
                            Style="{StaticResource EsButton.Secondary}"
                            Click="OnClearLog_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Md}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="대기 중"
                           Style="{StaticResource Type.Title3.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <ProgressBar x:Name="PocProgress"
                             Minimum="0" Maximum="100" Value="0"
                             Height="6" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Md}">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogTextBlock"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="합격 기준: 100회 모두 성공 + 종료 후 POWERPNT.EXE 0개 + UI 응답성 유지."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
