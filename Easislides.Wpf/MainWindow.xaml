<Window x:Class="Easislides.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        xmlns:converters="clr-namespace:Easislides.Wpf.Converters"
        xmlns:rendering="clr-namespace:Easislides.Wpf.Rendering"
        xmlns:settings="clr-namespace:Easislides.Wpf.Settings"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides"
        Width="1180"
        Height="760"
        MinWidth="1180"
        MinHeight="760"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LegacyPowerPointThumbnailSizeConverter x:Key="LegacyPowerPointThumbnailSize" />
        <converters:LegacyLyricsRichTextBoxWidthConverter x:Key="LegacyLyricsRichTextBoxWidth" />
        <converters:LegacySampleScreenSizeConverter x:Key="LegacySampleScreenSize" />
        <converters:SongRowDisplayConverter x:Key="SongRowDisplay" />
        <Style x:Key="ClassicOutputToggleButton" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Button.FontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource Type.Weight.Semibold}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EsButton.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadius.Medium}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClassicVerseJumpButton"
               TargetType="Button"
               BasedOn="{StaticResource EsButton.Secondary}">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="33" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClassicVerseJumpWideButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicVerseJumpButton}">
            <Setter Property="Width" Value="23" />
        </Style>
        <Style x:Key="ClassicOperatorStripButton"
               TargetType="Button"
               BasedOn="{StaticResource EsButton.Secondary}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="33" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ClassicOperatorStripDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource EsButton.Danger}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="33" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ClassicOperatorStripToggleButton"
               TargetType="ToggleButton"
               BasedOn="{StaticResource ClassicOutputToggleButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="33" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ClassicTopToolStripButton"
               TargetType="Button"
               BasedOn="{StaticResource EsButton.Secondary}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ClassicTopToolStripTextButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicTopToolStripButton}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <Style x:Key="ClassicTopToolStripToggleButton"
               TargetType="ToggleButton"
               BasedOn="{StaticResource ClassicOutputToggleButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="ClassicTopToolStripComboBox"
               TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClassicTopOperatorStripButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicOperatorStripButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style x:Key="ClassicPanelDisplayList" TargetType="ListView">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Page}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="ClassicPanelDisplayListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 전역 단축키: Ctrl+K 로 명령 팔레트 열기(§7.4 — FrmMain 136개 메뉴를 검색 가능한 단일 진입점으로 흡수). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPalette.OpenCommand}" />
    </Window.InputBindings>

    <!-- 루트를 Grid 로 감싸 명령 팔레트 오버레이를 전체 위에 띄운다(평소엔 숨김). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <!-- FrmMain 메뉴바(File/Edit/View/Output/Tools/Help) 포팅.
             모든 항목은 실제 MainViewModel 명령 또는 DI 창 런처(Click)에 배선 — dead UI 없음.
             출력 항목은 명령 CanExecute 로 라이브 상태에 따라 자동 활성/비활성. -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource Brush.Surface.Card}"
              FontSize="12"
              Padding="0"
              AutomationProperties.Name="주 메뉴">
            <MenuItem Header="File">
                <!-- 빠른 저장(Ctrl+S) — 현재 세션 이름으로 덮어 저장. 미저장 변경(● 수정됨)과 짝. -->
                <MenuItem Header="예배 순서 저장" Command="{Binding QuickSaveWorshipListCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Save24" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="예배 순서에 파일 추가" Click="AddExternalFile_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionNewItem}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="레거시 예배 순서(.esw) 가져오기..." Click="ImportLegacyWorshipList_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PowerPoint 폴더 찾아보기..." Click="OpenPowerPointLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="미디어 폴더 찾아보기..." Click="OpenMediaLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="라이브러리 열기" Click="OpenLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Contents}" /></MenuItem.Icon>
                </MenuItem>
                <!-- 최근 예배 순서(레거시 Recent Edits) — 최신순 이름을 클릭하면 즉시 다시 불러온다. 비어 있으면 비활성. -->
                <MenuItem Header="최근 예배 순서"
                          ItemsSource="{Binding RecentWorshipLists}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.WorshipList}" /></MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentWorshipListCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="종료" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="곡 복사" Click="SongCopy_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionCopy}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 이동" Click="SongMove_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionMove}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 삭제" Click="SongDelete_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionDelete}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="삭제 항목 복구" Click="SongRecover_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="스마트 병합" Click="SongMerge_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="폴더 정리" Click="FolderEditor_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 검색·사용처" Click="OpenSearchUsage_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="설정" Click="OpenSettings_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Settings}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="출력 새로고침" Command="{Binding RefreshOutputCommand}" InputGestureText="Ctrl+F5">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="EasiSlides 폴더 열기" Click="OpenEasiSlidesFolder_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 곡 번호 표시(FrmMain Edit 메뉴 Use Song Numbering) — 라이브러리 곡 목록에 "번호. 제목" 표시. 설정에 저장됨. -->
                <MenuItem Header="곡 번호 표시"
                          IsCheckable="True"
                          IsChecked="{Binding Library.UseSongNumbering, Mode=TwoWay}" />
            </MenuItem>

            <MenuItem Header="Output">
                <MenuItem Header="Go LIVE"
                          Command="{Binding ToggleOutputLiveCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsOutputLiveActive, Mode=OneWay}"
                          InputGestureText="F12">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveToggle}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="송출 후 다음 항목" Command="{Binding SendToOutputAndNextCommand}" InputGestureText="F11">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview를 Output으로 보내고 Black 해제"
                          Command="{Binding CopyPreviewToOutputAndClearBlackCommand}"
                          InputGestureText="F7">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview를 Output으로 보내기"
                          Command="{Binding CopyPreviewToOutputShortcutCommand}"
                          InputGestureText="F8">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="라이브 중지" Command="{Binding StopLiveCommand}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.NoRotate}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="처음 항목" Command="{Binding FirstItemCommand}" />
                <MenuItem Header="다음 슬라이드/절" Command="{Binding LiveNextShortcutCommand}" InputGestureText="Space">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="이전 슬라이드/절" Command="{Binding LivePreviousShortcutCommand}" InputGestureText="Shift+Space" />
                <MenuItem Header="마지막 항목" Command="{Binding LastItemCommand}" />
                <Separator />
                <MenuItem Header="검은 화면"
                          Command="{Binding ToggleOutputBlackCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsOutputBlackActive, Mode=OneWay}"
                          InputGestureText="F9">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveBlack}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="화면 비우기"
                          Command="{Binding ToggleOutputClearCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsOutputClearActive, Mode=OneWay}"
                          InputGestureText="F3">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionClear}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="출력 숨김" Command="{Binding HideOutputCommand}" InputGestureText="Ctrl+H">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveHide}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="복귀" Command="{Binding RestoreOutputCommand}" />
                <MenuItem Header="현재 항목 처음으로" Command="{Binding RestartCurrentItemCommand}" InputGestureText="Ctrl+R" />
                <Separator />
                <!-- 스테이지(Preview) 모니터(gap §3.1) — 회중용 출력과 별개로 워십 리더·밴드가 보는 확인 모니터.
                     선택한 모니터에 풀스크린으로 가사를 띄우되, 회중 화면이 검정/비움이어도 스테이지는 가사를 계속 보여 준다. -->
                <MenuItem Header="스테이지 모니터 열기" Command="{Binding OpenStageMonitorCommand}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MonitorDual}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="스테이지 모니터 닫기" Command="{Binding CloseStageMonitorCommand}" />
                <Separator />
                <!-- 출력 표시 토글(FrmMain View/Output "Show …" 토글 대응) — 기존 인-셸 설정·명령 재사용.
                     IsChecked 는 현재 상태(Active*)에 단방향 바인딩, 클릭은 토글 명령이 처리(체크 표시 동기화). -->
                <MenuItem Header="위치 인디케이터 (N/M)"
                          IsChecked="{Binding ActiveLyricsPositionIndicator, Mode=OneWay}"
                          Command="{Binding ToggleLyricsPositionIndicatorCommand}" />
                <MenuItem Header="절 헤딩 (1절/후렴)"
                          IsChecked="{Binding ActiveLyricsVerseHeading, Mode=OneWay}"
                          Command="{Binding ToggleLyricsVerseHeadingCommand}" />
                <MenuItem Header="곡 번호 표시"
                          IsChecked="{Binding ActiveLyricsItemNumber, Mode=OneWay}"
                          Command="{Binding ToggleLyricsItemNumberCommand}" />
                <MenuItem Header="정보 패널에 제목 표시"
                          IsChecked="{Binding ActiveLyricsTitleOnPanel, Mode=OneWay}"
                          Command="{Binding ToggleLyricsTitleOnPanelCommand}"
                          ToolTip="현재 곡 제목을 송출 화면 좌측 상단 정보 밴드에 작게 표시(레거시 Def_PanelTitle)." />
                <MenuItem Header="저작권 표시"
                          IsChecked="{Binding ActiveLyricsCopyright, Mode=OneWay}"
                          Command="{Binding ToggleLyricsCopyrightCommand}" />
                <MenuItem Header="다음 항목 표시"
                          IsChecked="{Binding ActiveLyricsNextItem, Mode=OneWay}"
                          Command="{Binding ToggleLyricsNextItemCommand}" />
                <MenuItem Header="정보 패널 투명 배경"
                          IsChecked="{Binding ActiveLyricsPanelTransparent, Mode=OneWay}"
                          Command="{Binding TogglePanelTransparentCommand}"
                          ToolTip="곡번호·저작권·다음항목 밴드의 어두운 배경을 없앱니다(레거시 Transparent)." />
                <!-- 정보 패널 밴드 색(레거시 Def_PanelColour) — 색조만 고르고 반투명은 유지(밴드 뒤 가사 비침). 투명 배경 on 이면 무시됨. -->
                <MenuItem Header="정보 패널 색">
                    <MenuItem Header="검정 (기본)"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#000000" />
                    <MenuItem Header="남색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#102040" />
                    <MenuItem Header="진회색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#303030" />
                    <MenuItem Header="자주"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#3A1030" />
                    <MenuItem Header="진녹색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#103020" />
                </MenuItem>
                <!-- 정보 패널 글자 크기(레거시 Def_PanelFont 크기) — 곡번호·저작권·다음항목·위치 텍스트를 비율로 확대/축소. -->
                <MenuItem Header="정보 패널 글자">
                    <MenuItem Header="{Binding ActivePanelFontScale, StringFormat=현재 크기: {0}%}" IsEnabled="False" />
                    <MenuItem Header="크게 (+)" Command="{Binding IncreasePanelFontScaleCommand}" />
                    <MenuItem Header="작게 (−)" Command="{Binding DecreasePanelFontScaleCommand}" />
                </MenuItem>
                <MenuItem Header="제목 헤딩"
                          IsChecked="{Binding ActiveLyricsTitleHeading, Mode=OneWay}"
                          Command="{Binding ToggleLyricsTitleHeadingCommand}" />
                <MenuItem Header="가사 외곽선"
                          IsChecked="{Binding ActiveLyricsOutline, Mode=OneWay}"
                          Command="{Binding ToggleLyricsOutlineCommand}" />
                <MenuItem Header="가사 그림자"
                          IsChecked="{Binding ActiveLyricsShadow, Mode=OneWay}"
                          Command="{Binding ToggleLyricsShadowCommand}" />
                <MenuItem Header="가사 굵게"
                          IsChecked="{Binding ActiveLyricsBold, Mode=OneWay}"
                          Command="{Binding ToggleLyricsBoldCommand}" />
                <MenuItem Header="가사 기울임"
                          IsChecked="{Binding ActiveLyricsItalic, Mode=OneWay}"
                          Command="{Binding ToggleLyricsItalicCommand}" />
                <MenuItem Header="가사 밑줄"
                          IsChecked="{Binding ActiveLyricsUnderline, Mode=OneWay}"
                          Command="{Binding ToggleLyricsUnderlineCommand}" />
                <MenuItem Header="강조는 후렴만(굵게·기울임·밑줄)"
                          IsChecked="{Binding ActiveLyricsEmphasisChorusOnly, Mode=OneWay}"
                          Command="{Binding ToggleEmphasisChorusOnlyCommand}" />
                <MenuItem Header="이중 언어 줄 교차(원문/번역 번갈아)"
                          IsChecked="{Binding ActiveLyricsInterlace, Mode=OneWay}"
                          Command="{Binding ToggleInterlaceCommand}" />
                <Separator />
                <!-- 전환 효과(FrmMain Transition) — 현재 페이드만 구현. 페이드 on/off + 속도 프리셋. -->
                <MenuItem Header="전환 효과">
                    <MenuItem Header="페이드 사용"
                              IsChecked="{Binding ActiveFadeTransition, Mode=OneWay}"
                              Command="{Binding ToggleFadeTransitionCommand}" />
                    <Separator />
                    <!-- 슬라이드/절 전환(같은 곡 안 절·슬라이드 이동) — 항목 전환(아래 '모션:' 라디오)과 분리(FrmMain 항목 vs 슬라이드 전환). -->
                    <MenuItem Header="슬라이드 전환(같은 곡 절·슬라이드 이동)"
                              StaysOpenOnClick="True"
                              ToolTip="같은 곡 안에서 절·슬라이드만 바뀔 때 쓰는 전환. 곡→곡 항목 전환은 아래 '모션:' 항목에서 따로 고릅니다.">
                        <ComboBox ItemsSource="{Binding TransitionKindOptions}"
                                  SelectedValue="{Binding SlideTransitionKindInput, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Key"
                                  MinWidth="200"
                                  Margin="4"
                                  AutomationProperties.Name="슬라이드/절 전환 효과" />
