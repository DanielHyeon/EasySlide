                              CommandParameter="{x:Static settings:LyricsTransitionKind.RevealCircle}" />
                    <MenuItem Header="모션: 사각 리빌"
                              IsChecked="{Binding TransitionKindIsRevealRectangle, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.RevealRectangle}" />
                    <MenuItem Header="모션: 와이프 →"
                              IsChecked="{Binding TransitionKindIsWipeRight, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeRight}" />
                    <MenuItem Header="모션: 와이프 ←"
                              IsChecked="{Binding TransitionKindIsWipeLeft, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeLeft}" />
                    <MenuItem Header="모션: 와이프 ↓"
                              IsChecked="{Binding TransitionKindIsWipeDown, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeDown}" />
                    <MenuItem Header="모션: 와이프 ↑"
                              IsChecked="{Binding TransitionKindIsWipeUp, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeUp}" />
                    <MenuItem Header="모션: 블라인드(가로)"
                              IsChecked="{Binding TransitionKindIsBlindsH, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BlindsHorizontal}" />
                    <MenuItem Header="모션: 블라인드(세로)"
                              IsChecked="{Binding TransitionKindIsBlindsV, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BlindsVertical}" />
                    <MenuItem Header="모션: 체커보드"
                              IsChecked="{Binding TransitionKindIsCheckerboard, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Checkerboard}" />
                    <MenuItem Header="모션: 다이아몬드"
                              IsChecked="{Binding TransitionKindIsDiamond, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Diamond}" />
                    <MenuItem Header="모션: 양문 열기"
                              IsChecked="{Binding TransitionKindIsDoorsOpen, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.DoorsOpen}" />
                    <MenuItem Header="모션: 양문 닫기"
                              IsChecked="{Binding TransitionKindIsDoorsClose, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.DoorsClose}" />
                    <MenuItem Header="모션: 별"
                              IsChecked="{Binding TransitionKindIsStar, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Star}" />
                    <MenuItem Header="모션: 십자(2-레이어)"
                              IsChecked="{Binding TransitionKindIsCross, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Cross}" />
                    <MenuItem Header="모션: 나비넥타이(2-레이어)"
                              IsChecked="{Binding TransitionKindIsBowTie, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BowTie}" />
                    <MenuItem Header="모션: 하트(2-레이어)"
                              IsChecked="{Binding TransitionKindIsHeart, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Heart}" />
                    <MenuItem Header="모션: 시계 와이프"
                              IsChecked="{Binding TransitionKindIsWedge, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Wedge}" />
                    <MenuItem Header="모션: 나선"
                              IsChecked="{Binding TransitionKindIsSpiral, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Spiral}" />
                    <MenuItem Header="모션: 바람개비"
                              IsChecked="{Binding TransitionKindIsWindMill, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WindMill}" />
                    <MenuItem Header="모션: 부채 펼침"
                              IsChecked="{Binding TransitionKindIsFanUp, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.FanUp}" />
                    <Separator />
                    <MenuItem Header="빠르게 (150ms)"
                              IsChecked="{Binding TransitionIsFast, Mode=OneWay}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>150</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="보통 (250ms)"
                              IsChecked="{Binding TransitionIsNormal, Mode=OneWay}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>250</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="느리게 (500ms)"
                              IsChecked="{Binding TransitionIsSlow, Mode=OneWay}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>500</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <!-- 대기 화면(Gap)(FrmMain Gap Item) — 라이브 콘텐츠가 없을 때(대기 상태) 보여줄 화면. 모드/페이드/로고를 빠르게 조작. -->
                <MenuItem Header="대기 화면(Gap)">
                    <MenuItem Header="모드"
                              StaysOpenOnClick="True"
                              ToolTip="대기(라이브 콘텐츠 없음) 상태에서 보여줄 화면: 없음/검정/기본/로고 이미지.">
                        <ComboBox ItemsSource="{Binding GapItemModeOptions}"
                                  SelectedValue="{Binding GapItemModeInput, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Key"
                                  MinWidth="180"
                                  Margin="4"
                                  AutomationProperties.Name="대기 화면 Gap 모드" />
                    </MenuItem>
                    <MenuItem Header="전환 페이드 사용"
                              IsChecked="{Binding ActiveGapItemUseFade, Mode=OneWay}"
                              Command="{Binding ToggleGapItemUseFadeCommand}"
                              ToolTip="대기 화면으로 들어갈 때 부드럽게 페이드합니다." />
                    <Separator />
                    <MenuItem Header="로고 이미지 선택..." Click="SelectGapLogo_Click"
                              ToolTip="'로고' 모드에서 보여줄 이미지를 고릅니다(고르면 모드도 로고로 바뀜)." />
                    <MenuItem Header="로고 지우기"
                              Command="{Binding ClearGapItemLogoFileCommand}" />
                </MenuItem>
                <!-- 배경 이미지(FrmMain Images 탭 — 배경 적용). 선택은 파일 대화상자(코드-비하인드), 해제는 커맨드. -->
                <MenuItem Header="배경 이미지">
                    <MenuItem Header="갤러리에서 선택..."
                              Click="OpenImageLibrary_Click" />
                    <MenuItem Header="이미지 선택..."
                              Click="SelectOutputBackgroundImage_Click" />
                    <MenuItem Header="배경 지우기"
                              Command="{Binding ClearOutputBackgroundImageCommand}" />
                    <Separator />
                    <!-- 배경 이미지 표시 모드(레거시 Def_ImageMode: Tile/Centre/BestFit). 기본 채움=UniformToFill. -->
                    <MenuItem Header="표시 모드: 채움(가득)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsFill, Mode=OneWay}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Fill}" />
                    <MenuItem Header="표시 모드: 맞춤(전체 보임)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsFit, Mode=OneWay}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Fit}" />
                    <MenuItem Header="표시 모드: 가운데(원본 크기)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsCenter, Mode=OneWay}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Center}" />
                    <MenuItem Header="표시 모드: 타일(반복)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsTile, Mode=OneWay}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Tile}" />
                </MenuItem>
                <!-- 배경 2색 그라데이션 방향(레거시 Def_BackColour 패턴) — 2색 배경일 때 방향 선택. 기본 세로(위→아래). -->
                <MenuItem Header="그라데이션 방향">
                    <MenuItem Header="세로 (위→아래)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsVertical, Mode=OneWay}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.Vertical}" />
                    <MenuItem Header="가로 (좌→우)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsHorizontal, Mode=OneWay}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.Horizontal}" />
                    <MenuItem Header="대각선 ↘ (좌상→우하)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsDiagonalDown, Mode=OneWay}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalDown}" />
                    <MenuItem Header="대각선 ↗ (좌하→우상)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsDiagonalUp, Mode=OneWay}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalUp}" />
                </MenuItem>
                <!-- 이중 언어 영역 표시(레거시 Def_ShowRegion1/2/Both) — 둘 다/Region1만/Region2만. 단일 언어 곡엔 영향 없음. -->
                <MenuItem Header="이중 언어 영역 표시">
                    <MenuItem Header="둘 다"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsBoth, Mode=OneWay}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Both}" />
                    <MenuItem Header="Region 1만(주 언어)"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsRegion1Only, Mode=OneWay}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Region1Only}" />
                    <MenuItem Header="Region 2만(보조 언어)"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsRegion2Only, Mode=OneWay}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Region2Only}" />
                </MenuItem>
                <!-- 코드/악상 표시(FrmMain Def_Notations) — on 이면 송출 가사에 코드 줄을 함께 그린다. 조옮김은 이게 켜져야 의미 있다. -->
                <MenuItem Header="코드 표시"
                          IsChecked="{Binding ActiveLyricsNotations, Mode=OneWay}"
                          Command="{Binding ToggleLyricsNotationsCommand}"
                          ToolTip="송출 가사에 코드(악보 기호) 줄을 함께 표시(레거시 Def_Notations). 아래 조옮김은 이게 켜져야 적용됨." />
                <!-- 코드 조옮김(FrmMain Transpose Up/Down Semi-Tone, To Capo 0) — "코드 표시" on 일 때 송출 코드를 이동.
                     라이브 곡에 즉시 반영(재송출). 새 곡을 송출하면 원조로 초기화된다. -->
                <MenuItem Header="코드 조옮김">
                    <MenuItem Header="{Binding LiveTransposeLabel}" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="반음 올림 ▲"
                              Command="{Binding TransposeLiveUpCommand}" />
                    <MenuItem Header="반음 내림 ▼"
                              Command="{Binding TransposeLiveDownCommand}" />
                    <MenuItem Header="원조 복귀"
                              Command="{Binding TransposeLiveResetCommand}" />
                </MenuItem>
                <Separator />
                <!-- 전 항목에 전역 기본 서식 적용(FrmMain "Apply to All Except InfoScreens") — 모든 항목의 개별 서식을 끄고
                     운영 기본(인스펙터) 서식으로 송출하게 한다. 곡·성경 텍스트에만 영향. -->
                <MenuItem Header="전 항목에 전역 서식 적용"
                          Command="{Binding ApplyGlobalFormatToAllCommand}"
                          ToolTip="모든 예배 순서 항목의 '개별 서식'을 끄고 전역 기본(인스펙터) 서식으로 통일(레거시 Apply to All)." />
                <!-- 복사한 항목별 서식을 전 항목(곡·성경)에 일괄 적용 — 우클릭 "이 항목 서식 복사"로 담아 둔 서식이 있을 때만 활성. -->
                <MenuItem Header="복사한 서식을 전 항목에 적용"
                          Command="{Binding ApplyCopiedFormatToAllCommand}"
                          ToolTip="우클릭 '이 항목 서식 복사'로 담아 둔 서식을 모든 곡·성경 항목에 한 번에 적용(같은 색·글꼴로 통일)." />
                <Separator />
                <!-- 가사 정렬(FrmMain Align Left/Centre/Right) — 기존 인-셸 정렬 명령 재사용. -->
                <MenuItem Header="가사 정렬">
                    <MenuItem Header="왼쪽"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Left}" />
                    <MenuItem Header="가운데"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Center}" />
                    <MenuItem Header="오른쪽"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Right}" />
                </MenuItem>
                <!-- 세로 정렬(FrmMain Vertical Alignment Top/Centre/Bottom). -->
                <MenuItem Header="가사 세로 정렬">
                    <MenuItem Header="위"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}" />
                    <MenuItem Header="가운데"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}" />
                    <MenuItem Header="아래"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}" />
                </MenuItem>
                <Separator />
                <!-- 글자 크기·줄 간격(FrmMain 글자 크기/줄 간격) — 기존 인-셸 명령 재사용. -->
                <MenuItem Header="글자 크게" Command="{Binding IncreaseLyricsFontSizeCommand}" />
                <MenuItem Header="글자 작게" Command="{Binding DecreaseLyricsFontSizeCommand}" />
                <MenuItem Header="줄 간격 늘림" Command="{Binding IncreaseLyricsLineSpacingCommand}" />
                <MenuItem Header="줄 간격 줄임" Command="{Binding DecreaseLyricsLineSpacingCommand}" />
                <Separator />
                <!-- 본문 여백(FrmMain ShowLeftMargin/ShowRightMargin/ShowBottomMargin) — 본문을 가장자리에서 안쪽으로 들여쓴다. -->
                <MenuItem Header="본문 여백">
                    <MenuItem Header="{Binding ActiveLyricsLeftMargin, StringFormat=왼쪽 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="왼쪽 여백 넓게" Command="{Binding IncreaseLyricsLeftMarginCommand}" />
                    <MenuItem Header="왼쪽 여백 좁게" Command="{Binding DecreaseLyricsLeftMarginCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ActiveLyricsRightMargin, StringFormat=오른쪽 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="오른쪽 여백 넓게" Command="{Binding IncreaseLyricsRightMarginCommand}" />
                    <MenuItem Header="오른쪽 여백 좁게" Command="{Binding DecreaseLyricsRightMarginCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ActiveLyricsBottomMargin, StringFormat=아래 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="아래 여백 넓게" Command="{Binding IncreaseLyricsBottomMarginCommand}" />
                    <MenuItem Header="아래 여백 좁게" Command="{Binding DecreaseLyricsBottomMarginCommand}" />
                    <Separator />
                    <!-- 이중 언어 영역 간 세로 간격(FrmMain Ind_Reg2TopUpDown) — 원문(Region1)과 번역(Region2) 사이 간격. -->
                    <MenuItem Header="{Binding ActiveRegionGap, StringFormat=영역 간 간격: {0}px}" IsEnabled="False" />
                    <MenuItem Header="영역 간격 넓게" Command="{Binding IncreaseRegionGapCommand}" />
                    <MenuItem Header="영역 간격 좁게" Command="{Binding DecreaseRegionGapCommand}" />
                    <Separator />
                    <!-- 본문 세로 위치(FrmMain Ind_Reg1TopUpDown) — 정렬 유지한 채 본문을 위/아래로 미세 이동. -->
                    <MenuItem Header="{Binding ActiveBodyVerticalOffset, StringFormat=본문 세로 위치: {0}px}" IsEnabled="False" />
                    <MenuItem Header="본문 위로 ▲" Command="{Binding MoveBodyUpCommand}" />
                    <MenuItem Header="본문 아래로 ▼" Command="{Binding MoveBodyDownCommand}" />
                </MenuItem>
            </MenuItem>

