                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="예배 순서 관리" Click="OpenManageWorshipLists_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.WorshipList}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="성경 버전 관리" Click="OpenBibleVersionManager_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Bible}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="찬양집 색인..." Click="OpenPraiseBookIndex_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="공지 화면(InfoScreen)..." Click="OpenNoticeScreen_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="세션 메모..." Click="OpenSessionNotes_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionEdit}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 예배 순서 검증 — 라이브 송출 전 깨진 PPT·미디어 파일을 미리 거른다(레거시 ValidateWorshipListItems). -->
                <MenuItem Header="예배 순서 검증"
                          Command="{Binding ValidateWorshipListCommand}"
                          ToolTip="라이브 송출 전 깨진 PowerPoint·미디어 파일이 없는지 점검합니다.">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.StatusCheck}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 데이터베이스 압축·정리(레거시 Tools Compact & Repair) — 백업 후 VACUUM. -->
                <MenuItem Header="데이터베이스 압축·정리"
                          Command="{Binding Library.CompactDatabaseCommand}"
                          ToolTip="곡 데이터베이스의 빈 공간을 회수해 파일을 줄입니다(백업을 먼저 만듭니다).">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 모든 설정 초기화(레거시 Tools "Clear EasiSlides Registry Settings and Exit") — 설정이 꼬여 앱이
                     이상할 때 쓰는 복구 탈출구. 파괴적(되돌릴 수 없음)이라 확인 다이얼로그를 거치고, 초기화 후 앱을 다시 시작한다. -->
                <MenuItem Header="모든 설정 초기화..."
                          Click="ResetAllSettings_Click"
                          ToolTip="모든 설정을 기본값으로 되돌리고 앱을 다시 시작합니다(곡·성경 데이터는 영향 없음). 설정이 꼬였을 때 쓰는 복구 기능입니다.">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Alert}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="도움말" Click="OpenHelp_Click" InputGestureText="F1">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Help}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="등록 안내" Click="OpenRegistration_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.StatusCheck}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="정보" Click="OpenAbout_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Info}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <composites:LiveBar DockPanel.Dock="Top"
                            DataContext="{Binding LiveBar}" />

        <!-- 하단 상태바(FrmMain StatusStrip 파리티) — 예배 순서 항목 수·현재 절 위치·운영 상태·출력 모니터.
             기존 VM 상태만 바인딩(Queue.Count·LyricsPageLabel·StatusText·SelectedOutputDisplay). 가장 아래에 깔린다. -->
        <Border DockPanel.Dock="Bottom"
                x:Name="StatusBar"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Subtle}"
                Padding="12,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Queue.Count, StringFormat='예배 순서 {0}개'}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               AutomationProperties.Name="예배 순서 항목 수" />
                    <TextBlock Text="{Binding LyricsPageLabel}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               AutomationProperties.Name="현재 절 위치" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding SelectedOutputDisplay.Name}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           AutomationProperties.Name="출력 모니터" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                x:Name="toolStripContainerMain"
                Tag="toolStripContainerMain"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Card}"
                Padding="2,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Visibility="Collapsed" />

                <WrapPanel x:Name="toolStripMain"
                           Tag="toolStripMain"
                           Grid.Row="0"
                           Orientation="Horizontal"
                           Margin="0">
                    <Button x:Name="Main_New"
                            Tag="Main_New"
                            Click="Main_New_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="New"
                            AutomationProperties.Name="Main_New New">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionNewItem}" />
                    </Button>
                    <Button x:Name="Main_Edit"
                            Tag="Main_Edit"
                            Click="Main_Edit_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Edit"
                            AutomationProperties.Name="Main_Edit Edit">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionEdit}" />
                    </Button>
                    <Button x:Name="Main_Copy"
                            Tag="Main_Copy"
                            Click="SongCopy_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Copy"
                            AutomationProperties.Name="Main_Copy Copy">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionCopy}" />
                    </Button>
                    <Button x:Name="Main_Move"
                            Tag="Main_Move"
                            Click="SongMove_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Move"
                            AutomationProperties.Name="Main_Move Move">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionMove}" />
                    </Button>
                    <Button x:Name="Main_Delete"
                            Tag="Main_Delete"
                            Click="SongDelete_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            Margin="0,0,8,0"
                            ToolTip="Delete"
                            AutomationProperties.Name="Main_Delete Delete">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionDelete}" />
                    </Button>
                    <Button x:Name="Main_Media"
                            Tag="Main_Media"
                            Click="OpenMediaLibrary_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Play Media"
                            AutomationProperties.Name="Main_Media Play Media">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaPlay}" />
                    </Button>
                    <Button x:Name="Main_Refresh"
                            Tag="Main_Refresh"
                            Click="Main_Refresh_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            Margin="0,0,8,0"
                            ToolTip="Refresh"
                            AutomationProperties.Name="Main_Refresh Refresh">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" />
                    </Button>
                    <Button x:Name="Main_Options"
                            Tag="Main_Options"
                            Click="OpenSettings_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            Margin="0,0,8,0"
                            ToolTip="Options"
                            AutomationProperties.Name="Main_Options Options">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Settings}" />
                    </Button>
                    <ToggleButton x:Name="Main_NoRotate"
                                  Tag="Main_NoRotate"
                                  IsChecked="{Binding IsNoRotateChecked, Mode=OneWay}"
                                  Command="{Binding ToggleAutoRotateCommand}"
                                  Style="{StaticResource ClassicTopToolStripToggleButton}"
                                  ToolTip="Stop Auto Rotate"
                                  AutomationProperties.Name="Main_NoRotate Stop Auto Rotate">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.NoRotate}" />
                    </ToggleButton>
                    <ComboBox x:Name="Main_RotateStyle"
                              Tag="Main_RotateStyle"
                              Style="{StaticResource ClassicTopToolStripComboBox}"
                              ItemsSource="{Binding AutoRotateModeOptions}"
                              SelectedValue="{Binding AutoRotateModeInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Text"
                              MinWidth="176"
                              Margin="0,0,8,0"
                              ToolTip="Rotate Style"
                              AutomationProperties.Name="Main_RotateStyle Rotate Style">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Tag" Value="{Binding LegacyTag}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="Main_Alerts"
                            Tag="Main_Alerts"
                            Click="Main_Alerts_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Alerts"
                            AutomationProperties.Name="Main_Alerts Alerts">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Alert}" />
                    </Button>
                    <Button x:Name="Main_Chinese"
                            Tag="Main_Chinese"
                            Command="{Binding ToggleRegionDisplayCommand}"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            Margin="0,0,8,0"
                            ToolTip="Trad/Simp Chinese"
                            AutomationProperties.Name="Main_Chinese Trad/Simp Chinese">
                        <ui:SymbolIcon Symbol="Translate24" />
                    </Button>
                    <Button x:Name="Main_Find"
                            Tag="Main_Find"
                            Click="Main_Find_Click"
                            Style="{StaticResource ClassicTopToolStripButton}"
                            ToolTip="Find"
                            AutomationProperties.Name="Main_Find Find">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" />
                    </Button>
                    <ComboBox x:Name="Main_QuickFind"
                              Tag="Main_QuickFind"
                              Style="{StaticResource ClassicTopToolStripComboBox}"
                              IsEditable="True"
                              Text="{Binding Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              MaxDropDownHeight="260"
                              Width="130"
                              Margin="0,0,8,0"
                              PreviewKeyDown="Main_QuickFind_PreviewKeyDown"
                              ToolTip="Enter phrase and press Keyboard Enter key"
                              AutomationProperties.Name="Main_QuickFind Search Phrase" />
                    <Button x:Name="Main_JumpA"
                            Tag="Main_JumpA"
                            Style="{StaticResource ClassicTopToolStripTextButton}"
                            ToolTip="구찬송가">
                        <TextBlock Text="구찬송가" />
                    </Button>
                    <Button x:Name="Main_JumpB"
                            Tag="Main_JumpB"
                            Style="{StaticResource ClassicTopToolStripTextButton}"
                            ToolTip="새찬송가">
                        <TextBlock Text="새찬송가" />
                    </Button>
                    <Button x:Name="Main_JumpC"
                            Tag="Main_JumpC"
                            Style="{StaticResource ClassicTopToolStripTextButton}"
                            ToolTip="개역개정">
                        <TextBlock Text="개역개정" />
                    </Button>
                </WrapPanel>

                <!-- Classic Operator 고정 바 — FrmMain toolstrip처럼 조밀한 아이콘 바를 유지한다. -->
                <WrapPanel x:Name="ClassicOperatorBar"
                           Grid.Row="1"
                           Orientation="Horizontal">
                    <Button Command="{Binding GoLiveCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            Margin="0,0,2,0"
                            ToolTip="선택 항목을 라이브로 송출 (F12)"
                            AutomationProperties.Name="Go Live">
                        <ui:SymbolIcon Symbol="VideoClip24" />
                    </Button>
                    <Button Command="{Binding SendToOutputAndNextCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            Margin="0,0,2,0"
                            ToolTip="선택 항목을 송출하고 곧바로 다음 항목으로 이동 (F11)"
                            AutomationProperties.Name="송출 후 다음 항목">
                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" />
                    </Button>
                    <Button Command="{Binding StopLiveCommand}"
                            Style="{StaticResource EsButton.Danger}"
                            Width="26"
                            Height="24"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Margin="0,0,2,0"
                            ToolTip="현재 라이브 송출을 중지"
                            AutomationProperties.Name="라이브 중지">
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </Button>
                    <Button Command="{Binding BlackScreenCommand}"
                            Style="{StaticResource EsButton.Danger}"
                            Width="26"
                            Height="24"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Margin="0,0,2,0"
                            ToolTip="검은 화면으로 전환 (F9)"
                            AutomationProperties.Name="검은 화면">
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </Button>
                    <Button Command="{Binding ClearOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="가사/콘텐츠를 비우고 배경만 송출 (F3)"
                            AutomationProperties.Name="화면 비우기"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Eraser24" />
                    </Button>
                    <Button Command="{Binding HideOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="가사/콘텐츠 숨김(배경 유지)"
                            AutomationProperties.Name="출력 숨김"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </Button>
                    <Button Command="{Binding RestoreOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="숨김/검은 화면/비우기에서 직전 송출로 복귀"
                            AutomationProperties.Name="출력 복귀"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Eye24" />
                    </Button>
                    <Button Command="{Binding RestartCurrentItemCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="현재 라이브 항목을 처음(첫 절/첫 슬라이드)으로 되돌려 재송출"
                            AutomationProperties.Name="현재 항목 처음으로"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="ArrowReset24" />
                    </Button>
                    <Button Command="{Binding RefreshOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="출력 화면을 다시 그린다(디스플레이 글리치 복구)"
                            AutomationProperties.Name="출력 새로고침"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </Button>
                    <Button Command="{Binding OpenOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            Margin="0,0,2,0"
                            ToolTip="선택한 모니터에 출력 창 열기"
                            AutomationProperties.Name="출력 열기">
                        <ui:SymbolIcon Symbol="WindowNew24" />
                    </Button>
                    <Button Command="{Binding CloseOutputCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            Margin="0,0,8,0"
                            ToolTip="출력 창 닫기"
                            AutomationProperties.Name="출력 닫기">
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </Button>
                    <!-- 명령 팔레트 진입(발견가능성) — 마우스 운영자도 ⌘K 없이 클릭으로 모든 명령/창을 검색·실행. -->
                    <Button Command="{Binding CommandPalette.OpenCommand}"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="모든 명령·창 검색 (Ctrl+K)"
                            AutomationProperties.Name="명령 팔레트 열기"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Search24" />
                    </Button>
                    <Button Click="AddExternalFile_Click"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="PowerPoint/미디어 파일을 예배 순서에 추가"
                            AutomationProperties.Name="파일 추가"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Add24" />
                    </Button>
                    <Button Click="OpenManageWorshipLists_Click"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="예배 순서 저장/불러오기"
                            AutomationProperties.Name="예배 순서 관리"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Save24" />
                    </Button>
                    <Button Click="OpenSearchUsage_Click"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="검색 및 사용처"
                            AutomationProperties.Name="검색 및 사용처"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Search24" />
                    </Button>
                    <Button Click="OpenSettings_Click"
                            Style="{StaticResource ClassicTopOperatorStripButton}"
                            ToolTip="설정 열기"
                            AutomationProperties.Name="설정 열기"
                            Margin="0,0,2,0">
                        <ui:SymbolIcon Symbol="Settings24" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="ClassicFrmMainConsole"
              Tag="splitContainerMain"
              Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ClassicSourceColumn"
                                  Width="0.75*"
                                  MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ClassicRightColumn"
                                  Width="2.35*"
                                  MinWidth="620" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 상단 콘텐츠 브라우저(라이브러리/성경 탭) + 하단 예배 순서(항상 표시) — FrmMain식 멀티페인.
                 곡·성경을 찾으면서 예배 순서를 동시에 보도록 탭 전환을 없앤다(§7.4 단일 콘솔 통합).
                 GridSplitter 로 두 패널 높이를 운영자가 조절. -->
            <Grid x:Name="ClassicSourcePane"
                  Tag="splitContainer1"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- 브라우저/예배순서 두 패널 높이 비율은 GridSplitter 로 조절하고, 종료 시 비율을 저장해 다음 실행에 복원한다(레거시 splitter 상태). -->
                    <RowDefinition x:Name="BrowserRow" Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="WorshipQueueRow" Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            x:Name="LeftBrowserTabs"
                            Tag="tabControlSource"
                            SelectionChanged="LeftBrowserTabs_SelectionChanged"
                            TabStripPlacement="Bottom"
                            Style="{StaticResource EsTabView.FrmMainBottom}"
                            BorderThickness="0"
                            Background="Transparent">
                    <TabItem Tag="Folders"
                             AutomationProperties.Name="Folders">
                        <TabItem.Header>
                            <TextBlock Text="Folders" />
                        </TabItem.Header>
                    <Grid x:Name="ClassicFoldersSourceGrid"
                          Margin="3,5,3,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="ClassicFoldersTopStrip"
                              Grid.Row="0"
                              Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ClassicSongFolderCombo"
                                      Tag="SongFolder"
                                      ItemsSource="{Binding Library.Folders}"
                                      SelectedItem="{Binding Library.SelectedFolder, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      MinHeight="28"
                                      AutomationProperties.Name="폴더 선택" />
                            <StackPanel x:Name="ClassicFoldersToolStrip"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="4,0,0,0">
                                <Button Command="{Binding Library.LoadCommand}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="0,0,3,0"
                                        ToolTip="라이브러리 불러오기"
                                        AutomationProperties.Name="라이브러리 불러오기">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </Button>
                                <Button Command="{Binding AddSelectedLibrarySongCommand}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="0,0,3,0"
                                        ToolTip="선택 곡을 예배 순서에 추가"
                                        AutomationProperties.Name="선택 곡을 예배 순서에 추가">
                                    <ui:SymbolIcon Symbol="Add24" />
                                </Button>
                                <ToggleButton x:Name="Folders_WordCount"
                                              Tag="Folders_WordCount"
                                              IsChecked="{Binding Library.IsWordCountSortEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding Library.IsFolderWordCountSortAvailable}"
                                              Style="{StaticResource ClassicTopToolStripToggleButton}"
                                              Width="28"
                                              Height="28"
                                              Margin="0,0,3,0"
                                              Padding="0"
                                              Content="#"
                                              ToolTip="Folders_WordCount / CJK Word Count 정렬"
                                              AutomationProperties.Name="Folders_WordCount" />
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Library.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="28"
                                 Margin="0,0,0,4"
                                 ToolTip="제목·가사·분류 검색"
                                 AutomationProperties.Name="곡 검색" />

                        <!-- A/B/C(초성) 점프 바 — 표시된 곡의 머리글자를 눌러 그 글자로 시작하는 첫 곡으로 이동(FrmMain 곡 목록 점프).
                             곡이 없으면 머리글자도 없어 빈 줄이 된다. -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding Library.AvailableInitials}"
                                      Margin="0,0,0,4"
                                      AutomationProperties.Name="머리글자 점프 바">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.Library.JumpToInitialCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource EsButton.Secondary}"
                                            MinWidth="30"
                                            Padding="6,2"
                                            Margin="0,0,3,3"
                                            ToolTip="이 머리글자로 시작하는 첫 곡으로 이동" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListView Grid.Row="3"
                                  x:Name="LibrarySongList"
                                  ItemsSource="{Binding Library.Songs}"
                                  SelectedItem="{Binding Library.SelectedSong, Mode=TwoWay}"
                                  Tag="SongsList"
                                  SelectionMode="Extended"
                                  KeyDown="LibrarySongList_KeyDown"
                                  PreviewMouseLeftButtonDown="LibrarySongList_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="LibrarySongList_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="LibrarySongList_PreviewMouseMove"
                                  AutomationProperties.Name="곡 목록"
                                  BorderThickness="1"
                                  FontSize="12"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="MinHeight" Value="20" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.Resources>
                            <!-- 곡 한 줄 표시: "곡 번호 표시"(Use Song Numbering) on 이면 "번호. 제목", off 면 제목만.
                                 곡번호표시 값은 ListBox 의 DataContext(Library)에서 읽어, 토글하면 모든 줄이 즉시 갱신된다. -->
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="270">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource SongRowDisplay}">
                                                            <Binding Path="Title" />
                                                            <Binding Path="SongNumber" />
                                                            <Binding Path="DataContext.Library.UseSongNumbering"
                                                                     RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="70"
                                                    DisplayMemberBinding="{Binding Category}" />
                                </GridView>
                            </ListView.View>
                            <ListView.InputBindings>
                                <!-- 더블클릭으로 예배 순서에 추가(선택 후 추가). -->
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding AddSelectedLibrarySongCommand}" />
                            </ListView.InputBindings>
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="CMenuSongs"
                                             Tag="CMenuSongs"
                                             Opened="CMenuSongs_Opened">
                                    <MenuItem x:Name="CMenuSongs_SelectAll"
                                              Tag="CMenuSongs_SelectAll"
                                              Header="Select _All"
                                              Click="CMenuSongs_SelectAll_Click" />
                                    <MenuItem x:Name="CMenuSongs_UnselectAll"
                                              Tag="CMenuSongs_UnselectAll"
                                              Header="_Unselect All"
                                              Click="CMenuSongs_UnselectAll_Click" />
                                    <MenuItem x:Name="CMenuSongs_AddShow"
                                              Tag="CMenuSongs_AddShow"
                                              Header="Add &amp;&amp; _Show"
                                              Click="CMenuSongs_AddShow_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuSongs_Edit"
                                              Tag="CMenuSongs_Edit"
                                              Header="Edit item"
                                              Click="CMenuSongs_Edit_Click" />
                                    <MenuItem x:Name="CMenuSongs_Copy"
                                              Tag="CMenuSongs_Copy"
                                              Header="Copy item"
                                              Click="SongCopy_Click" />
                                    <MenuItem x:Name="CMenuSongs_Delete"
                                              Tag="CMenuSongs_Delete"
                                              Header="Delete item"
                                              Click="CMenuSongs_Delete_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuSongs_Refresh"
                                              Tag="CMenuSongs_Refresh"
                                              Header="Refresh"
                                              Click="CMenuSongs_Refresh_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>

                        <!-- 라이브러리 곡 목록 빈 상태 안내 — 곡을 한 번 불러왔는데(HasLoadedSongs) 표시할 곡이 0건일 때만.
                             불러오기 전·로딩 중에는 뜨지 않는다. 문구는 상황(빈 폴더 / 검색 0건)에 따라 VM이 정해 준다.
                             검색 빈 상태(154)와 똑같이 ListBox "다음"에 둬 z-order 안전, 클릭은 통과(IsHitTestVisible=False)라 더블클릭 추가를 막지 않는다. -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding Library.LibraryEmptyStateMessage}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="16"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Visibility="{Binding Library.HasLibraryEmptyState, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.Name="라이브러리 곡 없음" />

                        <TextBlock Grid.Row="4"
                                   Text="{Binding Library.StatusMessage}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <TabItem Tag="InfoScreenSource"
                         x:Name="InfoScreenSourceTab"
                         AutomationProperties.Name="InfoScr source">
                    <TabItem.Header>
                        <TextBlock Text="InfoScr" />
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Saved InfoScreens"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Button Grid.Column="2"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh InfoScreen list" />
                            <Button Grid.Column="4"
                                    Command="{Binding AddSelectedCommand}"
                                    Style="{StaticResource EsButton.Primary}"
                                    Content="Add"
                                    AutomationProperties.Name="Add selected InfoScreen to Worship List" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="InlineInfoScreenList"
                                 ItemsSource="{Binding Screens}"
                                 SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 DisplayMemberPath="Name"
                                 KeyDown="InlineInfoScreenList_KeyDown"
                                 MouseDoubleClick="InlineInfoScreenList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="InlineInfoScreenList_PreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="InlineInfoScreenList_PreviewMouseRightButtonDown"
                                 PreviewMouseMove="InlineInfoScreenList_PreviewMouseMove"
                                 AutomationProperties.Name="InfoScreen source list">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="CMenuInfoScreenFiles"
                                             Tag="CMenuFiles">
                                    <MenuItem x:Name="CMenuInfoScreenFiles_SelectAll"
                                              Tag="CMenuFiles_SelectAll"
                                              Header="Select _All"
                                              Click="CMenuInfoScreenFiles_SelectAll_Click" />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_UnselectAll"
                                              Tag="CMenuFiles_UnselectAll"
                                              Header="_Unselect All"
                                              Click="CMenuInfoScreenFiles_UnselectAll_Click" />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_AddShow"
                                              Tag="CMenuFiles_AddShow"
                                              Header="Add &amp;&amp; _Show"
                                              Click="CMenuInfoScreenFiles_AddShow_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_Edit"
                                              Tag="CMenuFiles_Edit"
                                              Header="Edit"
                                              Click="CMenuInfoScreenFiles_Edit_Click" />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_Copy"
                                              Tag="CMenuFiles_Copy"
                                              Header="Copy"
                                              Click="CMenuInfoScreenFiles_Copy_Click" />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_Delete"
                                              Tag="CMenuFiles_Delete"
                                              Header="Delete"
                                              Click="CMenuInfoScreenFiles_Delete_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuInfoScreenFiles_Refresh"
                                              Tag="CMenuFiles_Refresh"
                                              Header="Refresh"
                                              Click="CMenuInfoScreenFiles_Refresh_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding StatusText}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <TabItem Tag="PowerPointSource"
                         x:Name="PowerPointSourceTab"
                         Visibility="{Binding DataContext.IsPowerPointTabVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="PowerPoint source">
                    <TabItem.Header>
                        <TextBlock Text="PowerP" />
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PowerpointFolder"
                                      Tag="PowerpointFolder"
                                      ItemsSource="{Binding FolderGroups}"
                                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="34"
                                      VerticalContentAlignment="Center"
                                      ToolTip="{Binding FolderPath}"
                                      AutomationProperties.Name="PowerPoint folder selector" />
                            <Button Grid.Column="2"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh PowerPoint list" />
                            <Button Grid.Column="4"
                                    Command="{Binding AddSelectedCommand}"
                                    Style="{StaticResource EsButton.Primary}"
                                    Content="Add"
                                    AutomationProperties.Name="Add selected PowerPoint to Worship List" />
                            <Menu Grid.Column="6"
                                  x:Name="PP_ListType"
                                  Tag="PP_ListType"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="PowerPoint list type">
                                <MenuItem>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.PptPreview}"
                                                           FontSize="14"
                                                           Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ListingStyleLabel}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="PP_ListStyle"
                                              Tag="PP_ListStyle"
                                              Header="List"
                                              Command="{Binding UseListStyleCommand}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsListStyle, Mode=OneWay}" />
                                    <MenuItem x:Name="PP_PreviewStyle"
                                              Tag="PP_PreviewStyle"
                                              Header="Preview"
                                              Command="{Binding UsePreviewStyleCommand}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsPreviewStyle, Mode=OneWay}" />
                                </MenuItem>
                            </Menu>
                        </Grid>

                        <CheckBox Grid.Row="1"
                                  IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                                  Content="Include subfolders"
                                  Margin="0,0,0,8"
                                  AutomationProperties.Name="Include PowerPoint subfolders" />

                        <TextBox Grid.Row="2"
                                 Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 Margin="0,0,0,8"
                                 ToolTip="Filter by file name"
                                 AutomationProperties.Name="PowerPoint file filter" />

                        <ListBox Grid.Row="3"
                                 x:Name="InlinePowerPointList"
                                 Tag="PowerpointList"
                                 ItemsSource="{Binding Presentations}"
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 DisplayMemberPath="FileName"
                                 SelectionChanged="InlinePowerPointList_SelectionChanged"
                                 KeyDown="InlinePowerPointList_KeyDown"
                                 MouseDoubleClick="InlinePowerPointList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="InlinePowerPointList_PreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="InlinePowerPointList_PreviewMouseRightButtonDown"
                                 PreviewMouseMove="InlinePowerPointList_PreviewMouseMove"
                                 AutomationProperties.Name="PowerPoint source file list">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="CMenuPowerPointFiles"
                                             Tag="CMenuFiles">
                                    <MenuItem x:Name="CMenuPowerPointFiles_SelectAll"
                                              Tag="CMenuFiles_SelectAll"
                                              Header="Select _All"
                                              Click="CMenuPowerPointFiles_SelectAll_Click" />
                                    <MenuItem x:Name="CMenuPowerPointFiles_UnselectAll"
                                              Tag="CMenuFiles_UnselectAll"
                                              Header="_Unselect All"
                                              Click="CMenuPowerPointFiles_UnselectAll_Click" />
                                    <MenuItem x:Name="CMenuPowerPointFiles_AddShow"
                                              Tag="CMenuFiles_AddShow"
                                              Header="Add &amp;&amp; _Show"
                                              Click="CMenuPowerPointFiles_AddShow_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuPowerPointFiles_Edit"
                                              Tag="CMenuFiles_Edit"
                                              Header="Edit"
                                              Click="CMenuPowerPointFiles_Edit_Click" />
                                    <MenuItem x:Name="CMenuPowerPointFiles_Copy"
                                              Tag="CMenuFiles_Copy"
                                              Header="Copy"
                                              Click="CMenuPowerPointFiles_Copy_Click" />
                                    <MenuItem x:Name="CMenuPowerPointFiles_Delete"
                                              Tag="CMenuFiles_Delete"
                                              Header="Delete"
                                              Click="CMenuPowerPointFiles_Delete_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuPowerPointFiles_Refresh"
                                              Tag="CMenuFiles_Refresh"
                                              Header="Refresh"
                                              Click="CMenuPowerPointFiles_Refresh_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewStyle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox Grid.Row="3"
                                 x:Name="flowLayoutExternalPowerPoint"
                                 Tag="flowLayoutExternalPowerPoint"
                                 ItemsSource="{Binding Presentations}"
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 SelectionChanged="InlinePowerPointList_SelectionChanged"
                                 KeyDown="InlinePowerPointList_KeyDown"
                                 MouseDoubleClick="InlinePowerPointList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="InlinePowerPointList_PreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="InlinePowerPointList_PreviewMouseRightButtonDown"
                                 PreviewMouseMove="InlinePowerPointList_PreviewMouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="PowerPoint source preview list">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="CMenuPowerPointPreviewFiles"
                                             Tag="CMenuFiles">
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_SelectAll"
                                              Tag="CMenuFiles_SelectAll"
                                              Header="Select _All"
                                              Click="CMenuPowerPointFiles_SelectAll_Click" />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_UnselectAll"
                                              Tag="CMenuFiles_UnselectAll"
                                              Header="_Unselect All"
                                              Click="CMenuPowerPointFiles_UnselectAll_Click" />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_AddShow"
                                              Tag="CMenuFiles_AddShow"
                                              Header="Add &amp;&amp; _Show"
                                              Click="CMenuPowerPointFiles_AddShow_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_Edit"
                                              Tag="CMenuFiles_Edit"
                                              Header="Edit"
                                              Click="CMenuPowerPointFiles_Edit_Click" />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_Copy"
                                              Tag="CMenuFiles_Copy"
                                              Header="Copy"
                                              Click="CMenuPowerPointFiles_Copy_Click" />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_Delete"
                                              Tag="CMenuFiles_Delete"
                                              Header="Delete"
                                              Click="CMenuPowerPointFiles_Delete_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CMenuPowerPointPreviewFiles_Refresh"
                                              Tag="CMenuFiles_Refresh"
                                              Header="Refresh"
                                              Click="CMenuPowerPointFiles_Refresh_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewStyle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}}"
                                            MinHeight="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                            Margin="4"
                                            Padding="4"
                                            CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderBrush" Value="Red" />
                                                        <Setter Property="BorderThickness" Value="5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Height="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                                    Background="{DynamicResource Brush.Surface.Page}"
                                                    BorderBrush="{DynamicResource Brush.Border.Muted}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding ThumbnailStatus}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.PowerPointSlide}"
                                                                   FontSize="34"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding FileName}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       FontSize="{StaticResource FontSize.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4"
                                   Text="{Binding StatusText}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <TabItem Tag="Bibles"
                         AutomationProperties.Name="Bibles">
                    <!-- 성경 탭 = 책 아이콘. -->
                    <TabItem.Header>
                        <TextBlock Text="Bibles" />
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- FrmMain Bibles top strip: BookLookup + BibleUserLookup + Bibles_ShowVerses/Bibles_Go. -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      x:Name="BookLookup"
                                      Tag="BookLookup"
                                      ItemsSource="{Binding Bible.Books}"
                                      SelectedItem="{Binding Bible.SelectedBook, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      MinHeight="28"
                                      FontSize="12"
                                      AutomationProperties.Name="성경 책" />

                            <TextBox Grid.Column="2"
                                     x:Name="BibleUserLookup"
                                     Tag="BibleUserLookup"
                                     Text="{Binding Bible.TypedReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="BibleReferenceBox_KeyDown"
                                     MinHeight="28"
                                     FontSize="12"
                                     ToolTip="구절 직접 입력 (예: 창 1:1-2:3, John 3:16)"
                                     AutomationProperties.Name="성경 구절 직접 입력" />

                            <ToggleButton Grid.Column="4"
                                          x:Name="Bibles_ShowVerses"
                                          Tag="Bibles_ShowVerses"
                                          IsChecked="{Binding Bible.ShowVerses, Mode=TwoWay}"
                                          Style="{StaticResource ClassicOutputToggleButton}"
                                          MinWidth="28"
                                          MinHeight="28"
                                          Padding="6,0"
                                          ToolTip="절 번호 표시 전환"
                                          AutomationProperties.Name="성경 절 번호 표시">
                                <TextBlock Text="V" FontWeight="Bold" />
                            </ToggleButton>

                            <Button Grid.Column="6"
                                    x:Name="Bibles_Go"
                                    Tag="Bibles_Go"
                                    Click="JumpBibleReference_Click"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Padding="4,0"
                                    ToolTip="입력한 구절로 이동"
                                    AutomationProperties.Name="입력한 성경 구절로 이동">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.BibleGo}" />
                            </Button>
                        </Grid>

                        <!-- 본문 — 구절 범위를 드래그 선택한 뒤 아래 "선택 구절 추가" 또는 우클릭 메뉴 사용. -->
                        <TextBox Grid.Row="1"
                                 x:Name="BiblePassageBox"
                                 Tag="BibleText"
                                 Text="{Binding Bible.PassageText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,8,0,0"
                                 PreviewKeyDown="BiblePassageBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="BiblePassageBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="BiblePassageBox_PreviewMouseMove"
                                 AutomationProperties.Name="성경 본문">
                            <!-- 본문 우클릭 메뉴(레거시 Bible 우클릭) — 전체 선택/복사 + 선택 구절을 예배 순서·공지 화면으로. -->
                            <TextBox.ContextMenu>
                                <ContextMenu x:Name="CMenuBible"
                                             Tag="CMenuBible"
                                             Opened="BibleContextMenu_Opened">
                                    <MenuItem x:Name="CMenuBible_SelectAll"
                                              Tag="CMenuBible_SelectAll"
                                              Header="Select _All"
                                              Click="SelectAllBiblePassage_Click" />
                                    <MenuItem x:Name="CMenuBible_UnselectAll"
                                              Tag="CMenuBible_UnselectAll"
