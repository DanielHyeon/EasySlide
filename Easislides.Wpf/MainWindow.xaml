                              IsChecked="{Binding TransitionKindIsSpin, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Spin}" />
                    <MenuItem Header="모션: 뒤집기(가로)"
                              IsChecked="{Binding TransitionKindIsFlipH, Mode=OneWay}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.FlipHorizontal}" />
                    <MenuItem Header="모션: 뒤집기(세로)"
