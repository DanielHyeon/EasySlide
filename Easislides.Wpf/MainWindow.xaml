                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0"
                                    x:Name="SearchModeTabs"
                                    BorderThickness="0"
                                    Background="Transparent">
                            <!-- 곡: 폴더 가로지르는 다중 필드 검색 -->
                            <TabItem Header="곡"
                                     Tag="SearchSongs">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <Button Command="{Binding Search.SearchSongsCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="교차 검색"
                                                AutomationProperties.Name="전체 폴더에서 곡 검색" />
                                        <Button Command="{Binding AddSearchedSongCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Content="예배 순서에 추가"
                                                AutomationProperties.Name="선택한 검색 결과를 예배 순서에 추가" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,0,0,8"
                                             ToolTip="제목·가사·번호로 검색 (Enter 로 실행)"
                                             AutomationProperties.Name="검색어">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding Search.SearchSongsCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <!-- 검색 범위(기본 제목+가사+번호). 폴더는 기본 전체 선택 → 폴더 가로지름. -->
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <CheckBox Content="제목"
                                                  IsChecked="{Binding Search.SearchTitle, Mode=TwoWay}"
                                                  Margin="0,0,12,0"
                                                  AutomationProperties.Name="제목 검색" />
                                        <CheckBox Content="가사"
                                                  IsChecked="{Binding Search.SearchLyrics, Mode=TwoWay}"
                                                  Margin="0,0,12,0"
                                                  AutomationProperties.Name="가사 검색" />
                                        <CheckBox Content="번호"
                                                  IsChecked="{Binding Search.SearchSongNumber, Mode=TwoWay}"
                                                  AutomationProperties.Name="곡 번호 검색" />
                                    </StackPanel>
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding Search.SearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                             KeyDown="SourceListAddOnEnter_KeyDown"
                                             AutomationProperties.Name="검색 결과 목록">
                                        <ListBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding AddSearchedSongCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding FolderName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- 검색 결과 빈 상태 안내 — 검색을 "실행했는데" 결과가 0건일 때만(검색 전엔 안 뜸). 같은 셀(Row 3)에 겹쳐 안내한다.
                                         목록 "뒤"가 아니라 마크업상 ListBox "다음"에 둬, 테마가 ListBox 배경을 칠해도 항상 위에 보이게(z-order 안전). 클릭은 통과(IsHitTestVisible=False)라 더블클릭 추가를 막지 않는다. -->
                                    <TextBlock Grid.Row="3"
                                               Text="검색 결과가 없습니다.&#x0a;검색어나 검색 범위(제목·가사·번호)를 바꿔 보세요."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="16"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               Visibility="{Binding Search.HasNoSearchResults, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.Name="검색 결과 없음" />
                                </Grid>
                            </TabItem>

                            <!-- 제목: 제목/별칭으로 빠르게 찾기(가사 본문 검색 없이). 결과를 예배 순서에 추가. -->
                            <TabItem Header="제목"
                                     Tag="SearchTitles">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <Button Command="{Binding Search.LookupTitlesCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="제목 조회"
                                                AutomationProperties.Name="제목으로 곡 조회" />
                                        <Button Command="{Binding AddLookupTitleCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Content="예배 순서에 추가"
                                                AutomationProperties.Name="선택한 제목을 예배 순서에 추가" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,0,0,8"
                                             ToolTip="제목 일부 (Enter 로 조회)"
                                             AutomationProperties.Name="제목 검색어">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding Search.LookupTitlesCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Search.LookupCandidates}"
                                             SelectedItem="{Binding SelectedTitleCandidate, Mode=TwoWay}"
                                             KeyDown="SourceListAddOnEnter_KeyDown"
                                             AutomationProperties.Name="제목 조회 결과 목록">
                                        <ListBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding AddLookupTitleCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding FolderName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- 제목 조회 빈 상태 안내 — 조회를 "실행했는데" 후보가 0건일 때만(조회 전엔 안 뜸). 곡 검색 빈 상태와 같은 방식(ListBox 다음·히트테스트 통과). -->
                                    <TextBlock Grid.Row="2"
                                               Text="조회된 제목이 없습니다.&#x0a;제목 일부를 바꿔 다시 조회해 보세요."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="16"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               Visibility="{Binding Search.HasNoLookupResults, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.Name="조회 결과 없음" />
                                </Grid>
                            </TabItem>

                            <!-- 사용: 송출 이력(언제 어떤 곡을 썼는지) 읽기전용. 기간을 정해 불러온다. -->
                            <TabItem Header="사용"
                                     Tag="SearchUsage">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <WrapPanel Margin="0,0,0,8">
                                        <DatePicker SelectedDate="{Binding Search.UsageFrom}"
                                                    Width="120"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="사용 시작일" />
                                        <DatePicker SelectedDate="{Binding Search.UsageTo}"
                                                    Width="120"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="사용 종료일" />
                                    </WrapPanel>
                                    <Button Grid.Row="1"
                                            Command="{Binding Search.RefreshUsageCommand}"
                                            Style="{StaticResource EsButton.Secondary}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="이력 불러오기"
                                            AutomationProperties.Name="사용 이력 불러오기" />
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Search.UsageRecords}"
                                             AutomationProperties.Name="사용 이력 목록">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding SongTitle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding WorshipDate, StringFormat=yyyy-MM-dd}"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- 곡/제목/사용 공통 피드백. 경고(ValidationMessage)는 빨강, 일반 상태(건수·안내)는 흐린 글자.
                             ValidationMessage 도 함께 보여야 "DB 경로 미준비" 같은 가드가 침묵하지 않는다(인라인 흡수 시 사각지대 제거). -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,8,0,0">
                            <!-- 경고는 비어 있으면 공백(기존 SearchUsageWindow 와 동일 패턴 — 별도 가시성 컨버터 없이). -->
                            <TextBlock Text="{Binding Search.ValidationMessage}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Status.Danger}" />
                            <TextBlock Text="{Binding Search.StatusMessage}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="Transparent"
                              AutomationProperties.Name="브라우저/예배 순서 높이 조절" />

                <!-- 예배 순서 — 항상 보이는 하단 패널(FrmMain 좌측 하단 송출 큐). 재사용 컴포지트(§5.2, DataContext 상속). -->
                <TabControl Grid.Row="2"
                            x:Name="LeftListTabs"
                            Tag="tabControlLists"
                            SelectionChanged="LeftListTabs_SelectionChanged"
                            TabStripPlacement="Bottom"
                            Style="{StaticResource EsTabView.FrmMainBottom}"
                            BorderThickness="0"
                            Background="Transparent">
                    <TabItem Tag="WorshipList"
                             AutomationProperties.Name="Worship List">
                        <TabItem.Header>
                            <TextBlock Text="Worship List" />
                        </TabItem.Header>
                        <composites:WorshipListPanel AddSelectedSourceRequested="WorshipListPanel_AddSelectedSourceRequested"
                                                     OpenSessionNotesRequested="WorshipListPanel_OpenSessionNotesRequested"
                                                     EditSelectedItemRequested="WorshipListPanel_EditSelectedItemRequested" />
                    </TabItem>
                    <TabItem Tag="PraiseBook"
                             x:Name="PraiseBookTab"
                             AutomationProperties.Name="Praise Book">
                        <TabItem.Header>
                            <TextBlock Text="Praise Book" />
                        </TabItem.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="InlinePraiseBookSavedBooksCombo"
                                          Tag="PraiseBook"
                                          ItemsSource="{Binding SavedBooks}"
                                          SelectionChanged="InlinePraiseBookSavedBooksCombo_SelectionChanged"
                                          MinHeight="28"
                                          Margin="0,0,4,0"
                                          AutomationProperties.Name="Saved Praise Book list" />
                                <Button Grid.Column="1"
                                        x:Name="PB_Manage"
                                        Tag="PB_Manage"
                                        Click="OpenPraiseBookIndex_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="M"
                                        ToolTip="Manage PraiseBooks"
                                        AutomationProperties.Name="Manage PraiseBooks" />
                                <Button Grid.Column="2"
                                        x:Name="PB_Add"
                                        Tag="PB_Add"
                                        Click="InlinePraiseBookAddSelected_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="+"
                                        ToolTip="Add selected song to PraiseBook"
                                        AutomationProperties.Name="Add to PraiseBook" />
                                <ToggleButton Grid.Column="3"
                                              x:Name="PB_WordCount"
                                              Tag="PB_WordCount"
                                              Click="PB_WordCount_Click"
                                              Style="{StaticResource ClassicOutputToggleButton}"
                                              Width="28"
                                              Height="28"
                                              Padding="6,0"
                                              Margin="0,0,2,0"
                                              Content="#"
                                              IsChecked="{Binding IsWordCountSortEnabled, Mode=OneWay}"
                                              ToolTip="Sort by CJK Word Count"
                                              AutomationProperties.Name="Sort by CJK Word Count" />
                                <Button Grid.Column="4"
                                        x:Name="InlinePraiseBookOpenBookButton"
                                        Click="InlinePraiseBookOpenBook_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="Open"
                                        AutomationProperties.Name="Open selected Praise Book" />
                                <Button Grid.Column="5"
                                        Click="InlinePraiseBookRefresh_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="Refresh"
                                        AutomationProperties.Name="Refresh Praise Book index" />
                                <Button Grid.Column="6"
                                        x:Name="PB_Delete"
                                        Tag="PB_Delete"
                                        Click="InlinePraiseBookDeleteSelected_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="-"
                                        ToolTip="Delete"
                                        AutomationProperties.Name="Delete selected PraiseBook items" />
                                <Button Grid.Column="7"
                                        x:Name="PB_Word"
                                        Tag="PB_Word"
                                        Click="InlinePraiseBookExportRtf_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="0,0,2,0"
                                        Content="W"
                                        ToolTip="Generate RTF Document"
                                        AutomationProperties.Name="Generate PraiseBook RTF document" />
                                <Button Grid.Column="8"
                                        x:Name="PB_Html"
                                        Tag="PB_Html"
                                        Click="InlinePraiseBookExportHtml_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Content="H"
                                        ToolTip="Generate HTML Document"
                                        AutomationProperties.Name="Generate PraiseBook HTML document" />
                            </Grid>

                            <ListView Grid.Row="1"
                                      x:Name="PraiseBookItems"
                                      Tag="PraiseBookItems"
                                      ItemsSource="{Binding Entries}"
                                      SelectionMode="Extended"
                                      BorderThickness="1"
                                      FontSize="12"
                                      PreviewMouseLeftButtonDown="PraiseBookItems_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="PraiseBookItems_PreviewMouseMove"
                                      PreviewMouseRightButtonDown="PraiseBookItems_PreviewMouseRightButtonDown"
                                      MouseDoubleClick="InlinePraiseBookItems_MouseDoubleClick"
                                      KeyDown="PraiseBookItems_KeyDown"
                                      SelectionChanged="PraiseBookItems_SelectionChanged"
                                      AutomationProperties.Name="PraiseBookItems">
                                <ListView.Resources>
                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <Setter Property="MinHeight" Value="22" />
                                        <Setter Property="Padding" Value="2,0" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Width="46">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Number}"
                                                               TextAlignment="Right"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="CMenuPraiseB"
                                                 Tag="CMenuPraiseB"
                                                 Opened="CMenuPraiseB_Opened">
                                        <MenuItem x:Name="CMenuPraiseB_SelectAll"
                                                  Tag="CMenuPraiseB_SelectAll"
                                                  Header="Select _All"
                                                  Click="CMenuPraiseB_SelectAll_Click" />
                                        <MenuItem x:Name="CMenuPraiseB_UnselectAll"
                                                  Tag="CMenuPraiseB_UnselectAll"
                                                  Header="_Unselect All"
                                                  Click="CMenuPraiseB_UnselectAll_Click" />
                                        <MenuItem x:Name="CMenuPraiseB_Clear"
                                                  Tag="CMenuPraiseB_Clear"
                                                  Header="Clear PraiseBook List"
                                                  Click="CMenuPraiseB_Clear_Click" />
                                        <Separator />
                                        <MenuItem x:Name="CMenuPraiseB_Edit"
                                                  Tag="CMenuPraiseB_Edit"
                                                  Header="Edit item"
                                                  Click="CMenuPraiseB_Edit_Click" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <Button Grid.Column="1"
                                        Click="OpenPraiseBookIndex_Click"
                                        Style="{StaticResource EsButton.Secondary}"
                                        Content="Window"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Open Praise Book window" />
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border.Default}"
                          AutomationProperties.Name="splitContainerMain 소스/Preview-Output 너비 조절" />

            <!-- splitContainerMain.Panel2 -> splitContainer2:
                 Preview 컬럼과 Output 컬럼을 좌우로 나누고, 각 컬럼은 상단 제어/하단 화면으로 다시 나뉜다. -->
            <Grid x:Name="ClassicRightConsole"
                  Tag="splitContainer2"
                  Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ClassicPreviewColumn"
                                      Width="*"
                                      MinWidth="280" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition x:Name="ClassicOutputColumn"
                                      Width="1.35*"
                                      MinWidth="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ClassicTopControlRow"
                                   Height="1.15*"
                                   MinHeight="220" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="ClassicBottomScreenRow"
                                   Height="0.85*"
                                   MinHeight="260" />
                </Grid.RowDefinitions>

            <GridSplitter Grid.Column="1"
                          Grid.RowSpan="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border.Default}"
                          AutomationProperties.Name="splitContainer2 Preview/Output 너비 조절" />

            <GridSplitter Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border.Default}"
                          AutomationProperties.Name="splitContainerPreview/Output 상하 패널 높이 조절" />

            <Border x:Name="ClassicPreviewPane"
                    Tag="splitContainerPreview.Panel1"
                    Grid.Column="0"
                    Grid.Row="0"
                    Background="White"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="ClassicPreviewPanelDisplayName"
                                  Tag="PreviewPanelDisplayName"
                                  Style="{StaticResource ClassicPanelDisplayList}"
                                  SelectedIndex="0"
                                  AutomationProperties.Name="Preview 선택 항목">
                            <ListViewItem Style="{StaticResource ClassicPanelDisplayListItem}"
                                          IsSelected="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Preview}"
                                                   FontSize="15"
                                                   Margin="0,0,5,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DataContext.PreviewPanelTitleText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DataContext.PreviewPanelSourceText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DataContext.PreviewPanelStatusText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Grid>
                            </ListViewItem>
                        </ListView>
                        <WrapPanel Grid.Column="1"
                                   x:Name="ClassicPreviewTopStrip"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right">
                            <Button x:Name="btnToLive"
                                    Tag="btnToLive"
                                    Command="{Binding PreviewToLiveCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="32"
                                    MinHeight="28"
                                    Padding="6,0"
                                    Margin="4,0,0,0"
                                    ToolTip="선택 항목을 라이브로 송출"
                                    AutomationProperties.Name="Preview Go Live">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveToggle}" />
                            </Button>
                            <Button x:Name="btnToOutputMoveNext"
                                    Tag="btnToOutputMoveNext"
                                    Command="{Binding CopyPreviewToOutputAndNextCommand}"
                                    Click="FocusOutputArea_Click"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="32"
                                    MinHeight="28"
                                    Padding="6,0"
                                    Margin="4,0,0,0"
                                    ToolTip="Output으로 복사 후 Preview 다음"
                                    AutomationProperties.Name="Preview Output 복사 후 다음">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveMoveToOutput}" />
                            </Button>
                            <Button x:Name="btnToOutput"
                                    Tag="btnToOutput"
                                    Command="{Binding CopyPreviewToOutputCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="32"
                                    MinHeight="28"
                                    Padding="6,0"
                                    Margin="4,0,0,0"
                                    ToolTip="선택 항목을 Output으로 복사"
                                    AutomationProperties.Name="Preview Output 복사">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" />
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Surface.Page}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1">
                        <!-- FrmMain Preview top pane: 선택 항목 종류에 맞춰 내부 content만 전환하고, 운영자-facing 탭 헤더는 렌더링하지 않는다. -->
                        <TabControl BorderThickness="0"
                                    Background="Transparent"
                                    Style="{StaticResource EsTabView.FrmMainContentSwitch}"
                                    SelectedIndex="{Binding SelectedContentTabIndex, Mode=TwoWay}">
                            <TabItem AutomationProperties.Name="Preview">
                                <!-- 내부 content-switch metadata; 헤더는 FrmMainContentSwitch 템플릿에서 숨겨진다. -->
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Preview}" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Preview" />
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- 이미지 파일을 탐색기에서 미리보기 영역에 끌어다 놓으면 출력 배경 이미지로 설정(레거시 이미지→배경 드래그).
                                     Background="Transparent" 라야 빈 여백까지 드롭을 받는다(배경 없는 Panel 은 빈 영역이 히트테스트 안 됨). -->
                                <Grid Margin="{StaticResource Thickness.Lg}"
                                      Background="Transparent"
                                      AllowDrop="True"
                                      DragOver="PreviewArea_DragOver"
                                      Drop="PreviewArea_Drop">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <rendering:SlidePreviewControl Grid.Row="0"
                                                                   Title="{Binding SelectedItem.Title}"
                                                                   Kind="{Binding SelectedItem.Kind}"
                                                                   Source="{Binding SelectedItem.PreviewSource}"
                                                                   FillMode="{Binding SelectedItem.PreviewFillMode}"
                                                                   SlideNumber="{Binding SelectedItem.SlideNumber}"
                                                                   ShowSlideNumber="True"
                                                                   IsSelected="True"
                                                                   Visibility="Collapsed" />

                                    <!-- 선택 곡의 실제 가사 표시(라이브 큐 콘텐츠 plumbing — LiveQueueItem.Lyrics). 가사 없으면 비어 표시. -->
                                    <ScrollViewer Grid.Row="1"
                                                  x:Name="ClassicPreviewInfo"
                                                  Tag="PreviewInfo"
                                                  Margin="0"
                                                  Focusable="True"
                                                  MouseDown="ClassicKeyboardSurface_MouseDown"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <ItemsControl x:Name="flowLayoutPreviewLyrics"
                                                          Tag="flowLayoutPreviewLyrics"
                                                          ItemsSource="{Binding PreviewLyricsPages}"
                                                          Visibility="{Binding IsPreviewTextMode, Converter={StaticResource BoolToVis}}"
                                                          AutomationProperties.Name="Preview 가사 페이지 영역">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.GoToPreviewLyricsPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding PageIndex}"
                                                                Margin="0"
                                                                Padding="0"
                                                                BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                Cursor="Hand"
                                                                ToolTip="{Binding PositionText, StringFormat=Preview {0}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="Red" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Border BorderThickness="0"
                                                                    Padding="4,3"
                                                                    MinHeight="24">
                                                                <Border.Width>
                                                                    <Binding Path="ActualWidth"
                                                                             RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                                             Converter="{StaticResource LegacyLyricsRichTextBoxWidth}" />
                                                                </Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Page}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Background" Value="#FFFFFF00" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding BodyText}"
                                                                           TextWrapping="Wrap"
                                                                           FontFamily="Microsoft Sans Serif"
                                                                           FontSize="13"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel x:Name="IndPanel"
                                                        Tag="IndPanel"
                                                        Visibility="{Binding IsPreviewFormatMode, Converter={StaticResource BoolToVis}}">
                                                <CheckBox x:Name="Ind_checkBox"
                                                          Tag="Ind_checkBox"
                                                          Command="{Binding ToggleUseIndividualFormattingCommand}"
                                                          IsChecked="{Binding SelectedItem.UseIndividualFormatting, Mode=OneWay}"
                                                          Content="Use Individual Settings"
                                                          Margin="0,0,0,8"
                                                          AutomationProperties.Name="개별 서식 사용" />

                                                <Border x:Name="panelIndTemplate"
                                                        Tag="panelIndTemplate"
                                                        Margin="0,0,0,8">
                                                    <WrapPanel x:Name="toolStripIndTemplates"
                                                               Tag="toolStripIndTemplates">
                                                        <Button x:Name="Ind_LoadTemplate"
                                                                Tag="Ind_LoadTemplate"
                                                                Content="Load Template"
                                                                Click="LoadPreviewItemTemplate_Click"
                                                                IsEnabled="{Binding CanEditSelectedItemColor}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="104"
                                                                Margin="0,0,4,4"
                                                                AutomationProperties.Name="개별 설정 템플릿 불러오기" />
                                                        <Button x:Name="Ind_SaveTemplate"
                                                                Tag="Ind_SaveTemplate"
                                                                Content="Save Template"
                                                                Click="SavePreviewItemTemplate_Click"
                                                                IsEnabled="{Binding CanEditSelectedItemColor}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="104"
                                                                Margin="0,0,4,4"
                                                                AutomationProperties.Name="개별 설정 템플릿 저장" />
                                                    </WrapPanel>
                                                </Border>

                                                <GroupBox x:Name="IndgroupBox1"
                                                          Tag="IndgroupBox1"
                                                          Header="Text"
                                                          Margin="0,0,0,8">
                                                    <StackPanel Margin="8">
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Content="Yellow"
                                                                    Command="{Binding SetSelectedItemTextColorCommand}"
                                                                    CommandParameter="#FFFFFF00"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="58"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="White"
                                                                    Command="{Binding SetSelectedItemTextColorCommand}"
                                                                    CommandParameter="#FFFFFFFF"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="58"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Red"
                                                                    Command="{Binding SetSelectedItemTextColorCommand}"
                                                                    CommandParameter="#FFFF4040"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="52"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Default"
                                                                    Command="{Binding SetSelectedItemTextColorCommand}"
                                                                    CommandParameter="{x:Null}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                        <WrapPanel>
                                                            <Button Content="Bold"
                                                                    Command="{Binding ToggleSelectedItemBoldCommand}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="54"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Italic"
                                                                    Command="{Binding ToggleSelectedItemItalicCommand}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="54"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Underline"
                                                                    Command="{Binding ToggleSelectedItemUnderlineCommand}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="76"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox x:Name="IndgroupBox2"
                                                          Tag="IndgroupBox2"
                                                          Header="Align / Size"
                                                          Margin="0,0,0,8">
                                                    <StackPanel Margin="8">
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Content="Left"
                                                                    Command="{Binding SetSelectedItemAlignmentCommand}"
                                                                    CommandParameter="1"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="52"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Center"
                                                                    Command="{Binding SetSelectedItemAlignmentCommand}"
                                                                    CommandParameter="2"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Right"
                                                                    Command="{Binding SetSelectedItemAlignmentCommand}"
                                                                    CommandParameter="3"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="56"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Default"
                                                                    Command="{Binding SetSelectedItemAlignmentCommand}"
                                                                    CommandParameter="{x:Null}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                        <WrapPanel>
                                                            <Button Content="36"
                                                                    Command="{Binding SetSelectedItemFontSizeCommand}"
                                                                    CommandParameter="36"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="44"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="48"
                                                                    Command="{Binding SetSelectedItemFontSizeCommand}"
                                                                    CommandParameter="48"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="44"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="60"
                                                                    Command="{Binding SetSelectedItemFontSizeCommand}"
                                                                    CommandParameter="60"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="44"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Default"
                                                                    Command="{Binding SetSelectedItemFontSizeCommand}"
                                                                    CommandParameter="{x:Null}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox x:Name="IndgroupBoxPosition"
                                                          Tag="IndgroupBoxPosition"
                                                          Header="Position"
                                                          Margin="0,0,0,8">
                                                    <StackPanel Margin="8">
                                                        <WrapPanel x:Name="Ind_VAlign"
                                                                   Tag="Ind_VAlign"
                                                                   Margin="0,0,0,6"
                                                                   IsEnabled="{Binding CanEditSelectedItemColor}">
                                                            <ToggleButton x:Name="Ind_VAlignTop"
                                                                          Tag="0"
                                                                          Content="Top"
                                                                          IsChecked="{Binding SelectedItemVerticalAlignmentIsTop, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemVerticalAlignmentCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="54"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          AutomationProperties.Name="선택 항목 위쪽 정렬" />
                                                            <ToggleButton x:Name="Ind_VAlignCentre"
                                                                          Tag="1"
                                                                          Content="Centre"
                                                                          IsChecked="{Binding SelectedItemVerticalAlignmentIsCenter, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemVerticalAlignmentCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="66"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          AutomationProperties.Name="선택 항목 세로 가운데 정렬" />
                                                            <ToggleButton x:Name="Ind_VAlignBottom"
                                                                          Tag="2"
                                                                          Content="Bottom"
                                                                          IsChecked="{Binding SelectedItemVerticalAlignmentIsBottom, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemVerticalAlignmentCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="70"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          AutomationProperties.Name="선택 항목 아래쪽 정렬" />
                                                        </WrapPanel>
                                                        <Grid IsEnabled="{Binding CanEditSelectedItemColor}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="0"
                                                                       Text="Left"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"
                                                                       Style="{StaticResource Type.Caption.Style}"
                                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                            <TextBox x:Name="Ind_LeftUpDown"
                                                                     Grid.Row="0"
                                                                     Grid.Column="1"
                                                                     Tag="Ind_LeftUpDown"
                                                                     Text="{Binding SelectedItemLeftMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                                                     MinWidth="44"
                                                                     Height="26"
                                                                     TextAlignment="Right"
                                                                     VerticalContentAlignment="Center"
                                                                     AutomationProperties.Name="선택 항목 왼쪽 여백" />
                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="3"
                                                                       Text="Right"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"
                                                                       Style="{StaticResource Type.Caption.Style}"
                                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                            <TextBox x:Name="Ind_RightUpDown"
                                                                     Grid.Row="0"
                                                                     Grid.Column="4"
                                                                     Tag="Ind_RightUpDown"
                                                                     Text="{Binding SelectedItemRightMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                                                     MinWidth="44"
                                                                     Height="26"
                                                                     TextAlignment="Right"
                                                                     VerticalContentAlignment="Center"
                                                                     AutomationProperties.Name="선택 항목 오른쪽 여백" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="0"
                                                                       Text="Bottom"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"
                                                                       Style="{StaticResource Type.Caption.Style}"
                                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                            <TextBox x:Name="Ind_BottomUpDown"
                                                                     Grid.Row="2"
                                                                     Grid.Column="1"
                                                                     Tag="Ind_BottomUpDown"
                                                                     Text="{Binding SelectedItemBottomMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                                                     MinWidth="44"
                                                                     Height="26"
                                                                     TextAlignment="Right"
                                                                     VerticalContentAlignment="Center"
                                                                     AutomationProperties.Name="선택 항목 아래 여백" />
                                                        </Grid>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox x:Name="IndgroupBox3"
                                                          Tag="IndgroupBox3"
                                                          Header="Font / Back"
                                                          Margin="0,0,0,8">
                                                    <StackPanel Margin="8">
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Content="Malgun"
                                                                    Command="{Binding SetSelectedItemFontNameCommand}"
                                                                    CommandParameter="맑은 고딕"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="64"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Arial"
                                                                    Command="{Binding SetSelectedItemFontNameCommand}"
                                                                    CommandParameter="Arial"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="56"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Default"
                                                                    Command="{Binding SetSelectedItemFontNameCommand}"
                                                                    CommandParameter="{x:Null}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                        <WrapPanel x:Name="Ind_BackColour"
                                                                   Tag="Ind_BackColour">
                                                            <Button Content="Blue"
                                                                    Command="{Binding SetSelectedItemBackgroundColorCommand}"
                                                                    CommandParameter="#FF0B5B7A"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="56"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Black"
                                                                    Command="{Binding SetSelectedItemBackgroundColorCommand}"
                                                                    CommandParameter="#FF000000"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="56"
                                                                    Margin="0,0,4,4" />
                                                            <Button Content="Default"
                                                                    Command="{Binding SetSelectedItemBackgroundColorCommand}"
                                                                    CommandParameter="{x:Null}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="62"
                                                                    Margin="0,0,4,4" />
                                                        </WrapPanel>
                                                        <Grid Margin="0,6,0,0"
                                                              IsEnabled="{Binding CanEditSelectedItemColor}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Image"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"
                                                                       Style="{StaticResource Type.Caption.Style}"
                                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding SelectedItemBackgroundImagePath, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     MinWidth="120"
                                                                     Height="26"
                                                                     Margin="0,0,4,0"
                                                                     ToolTip="{Binding SelectedItemBackgroundImagePath}"
                                                                     AutomationProperties.Name="선택 항목 배경 이미지 경로" />
                                                            <Button x:Name="Ind_BackImageSelect"
                                                                    Grid.Column="2"
                                                                    Tag="Ind_BackImageSelect"
                                                                    Content="Select..."
                                                                    Click="SelectPreviewItemBackgroundImage_Click"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="64"
                                                                    Margin="0,0,4,0"
                                                                    AutomationProperties.Name="선택 항목 배경 이미지 선택" />
                                                            <Button x:Name="Ind_NoImage"
                                                                    Grid.Column="3"
                                                                    Tag="Ind_NoImage"
                                                                    Content="No Image"
                                                                    Command="{Binding SetSelectedItemBackgroundImageCommand}"
                                                                    CommandParameter=""
                                                                    IsEnabled="{Binding CanClearSelectedItemBackgroundImage}"
                                                                    Style="{StaticResource EsButton.Secondary}"
                                                                    MinWidth="76"
                                                                    ToolTip="{Binding SelectedItemBackgroundNoImageToolTip}"
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    AutomationProperties.Name="선택 항목 배경 이미지 해제" />
                                                        </Grid>
                                                        <WrapPanel x:Name="Ind_ImageMode"
                                                                   Tag="Ind_ImageMode"
                                                                   Margin="0,6,0,0"
                                                                   IsEnabled="{Binding CanEditSelectedItemColor}"
                                                                   ToolTip="Background Picture Format">
                                                            <ToggleButton x:Name="Ind_ImageBestFit"
                                                                          Tag="2"
                                                                          Content="Best Fit"
                                                                          IsChecked="{Binding SelectedItemBackgroundModeIsFit, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemBackgroundImageModeCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsBackgroundMode.Fit}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="66"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          ToolTip="Best Fit Image"
                                                                          AutomationProperties.Name="선택 항목 배경 이미지 맞춤" />
                                                            <ToggleButton x:Name="Ind_ImageCentre"
                                                                          Tag="1"
                                                                          Content="Centre"
                                                                          IsChecked="{Binding SelectedItemBackgroundModeIsCenter, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemBackgroundImageModeCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsBackgroundMode.Center}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="62"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          ToolTip="Centre Image"
                                                                          AutomationProperties.Name="선택 항목 배경 이미지 가운데" />
                                                            <ToggleButton x:Name="Ind_ImageTile"
                                                                          Tag="0"
                                                                          Content="Tile"
                                                                          IsChecked="{Binding SelectedItemBackgroundModeIsTile, Mode=OneWay}"
                                                                          Command="{Binding SetSelectedItemBackgroundImageModeCommand}"
                                                                          CommandParameter="{x:Static settings:LyricsBackgroundMode.Tile}"
                                                                          Style="{StaticResource ClassicOutputToggleButton}"
                                                                          MinWidth="52"
                                                                          Height="26"
                                                                          Padding="8,0"
                                                                          Margin="0,0,4,4"
                                                                          ToolTip="Tile Image"
                                                                          AutomationProperties.Name="선택 항목 배경 이미지 타일" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox x:Name="IndgroupBoxTransition"
                                                          Tag="IndgroupBoxTransition"
                                                          Header="Transition">
                                                    <WrapPanel x:Name="Ind_Transition"
                                                               Tag="Ind_Transition"
                                                               Margin="8"
                                                               IsEnabled="{Binding CanEditSelectedItemColor}">
                                                        <ComboBox x:Name="Ind_TransItem"
                                                                  Tag="Ind_TransItem"
                                                                  ItemsSource="{Binding LegacyTransitionOptions}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedValuePath="Kind"
                                                                  SelectedValue="{Binding SelectedItemTransitionKindInput, Mode=TwoWay}"
                                                                  MinWidth="132"
                                                                  Height="26"
                                                                  Margin="0,0,4,4"
                                                                  ToolTip="Item Transition"
                                                                  AutomationProperties.Name="선택 항목 전환" />
                                                        <ComboBox x:Name="Ind_TransSlides"
                                                                  Tag="Ind_TransSlides"
                                                                  ItemsSource="{Binding LegacyTransitionOptions}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedValuePath="Kind"
                                                                  SelectedValue="{Binding SelectedSlideTransitionKindInput, Mode=TwoWay}"
                                                                  MinWidth="132"
                                                                  Height="26"
                                                                  Margin="0,0,4,4"
                                                                  ToolTip="Slide Transition"
                                                                  AutomationProperties.Name="선택 항목 슬라이드 전환" />
                                                    </WrapPanel>
                                                </GroupBox>

                                                <GroupBox x:Name="IndgroupBox4"
                                                          Tag="IndgroupBox4"
                                                          Header="Copy / Clear">
                                                    <WrapPanel Margin="8">
                                                        <Button Content="Copy"
                                                                Command="{Binding CopySelectedItemFormattingCommand}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="56"
                                                                Margin="0,0,4,4" />
                                                        <Button Content="Paste"
                                                                Command="{Binding PasteSelectedItemFormattingCommand}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="56"
                                                                Margin="0,0,4,4" />
                                                        <Button Content="All"
                                                                Command="{Binding ApplyCopiedFormatToAllCommand}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="48"
                                                                Margin="0,0,4,4" />
                                                        <Button Content="Clear"
                                                                Command="{Binding ClearSelectedItemFormattingCommand}"
                                                                Style="{StaticResource EsButton.Secondary}"
                                                                MinWidth="56"
                                                                Margin="0,0,4,4" />
                                                    </WrapPanel>
                                                </GroupBox>
                                            </StackPanel>

                                            <TextBlock Text="{Binding PreviewItemInfoText}"
                                                       Visibility="{Binding IsPreviewInfoMode, Converter={StaticResource BoolToVis}}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource Type.Body.Style}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       AutomationProperties.Name="Preview 항목 정보" />
                                        </Grid>
                                    </ScrollViewer>

                                </Grid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="PowerPoint">
                                <!-- 내부 content-switch metadata; 헤더는 FrmMainContentSwitch 템플릿에서 숨겨진다. -->
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.PowerPointSlide}" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="PowerPoint" />
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- FrmMain flowLayoutPreviewPowerPoint: 상단은 덱 썸네일 흐름만 담당하고,
                                     큰 슬라이드는 아래 ClassicPreviewHolder 에서 표시한다. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <ScrollViewer x:Name="ClassicPreviewPowerPointSurface"
                                                  Tag="flowLayoutPreviewPowerPoint"
                                                  Focusable="True"
                                                  MouseDown="ClassicKeyboardSurface_MouseDown"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AutomationProperties.Name="Preview PowerPoint 썸네일 영역">
                                        <ItemsControl x:Name="ClassicPreviewPowerPointThumbnailGrid"
                                                      ItemsSource="{Binding PowerPoint.Thumbnails}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.GoToSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding SlideNumber}"
                                                            Margin="6"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding SlideNumber, StringFormat=슬라이드 {0}}"
                                                            AutomationProperties.Name="{Binding SlideNumber, StringFormat=슬라이드 {0}}">
                                                        <Button.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                          Command="{Binding DataContext.ReplayPreviewPowerPointSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding SlideNumber}" />
                                                        </Button.InputBindings>
                                                        <Border Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}}"
                                                                Height="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                                                BorderThickness="5"
                                                                Background="White"
                                                                Padding="0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="Red" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Image Source="{Binding Image}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                <TextBlock Text="{Binding SlideNumber}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Top"
                                                                           MinWidth="18"
                                                                           TextAlignment="Center"
                                                                           FontWeight="Bold"
                                                                           Foreground="Black"
                                                                           Background="#FFF6E600" />
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="Media">
                                <!-- 내부 content-switch metadata; 헤더는 FrmMainContentSwitch 템플릿에서 숨겨진다. -->
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaFile}" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Media" />
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- 미디어 재생 컨트롤 — MediaPlaybackViewModel(Media) 바인딩(G1.2 / gap-analysis.md §4 G-α).
                                     placeholder 텍스트를 실제 컨트롤 표면으로 대체. 백엔드 NoOp 상태에선 상태·컨트롤이 비활성으로 표시. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Media.StatusText}"
                                                   Style="{StaticResource Type.Title3.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Media.Source}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Type.BodyLarge.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Run Text="{Binding Media.PositionText, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Media.DurationText, Mode=OneWay}" />
                                    </TextBlock>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12"
                                                ButtonBase.Click="FocusPreviewArea_Click">
                                        <!-- 미디어 전송 컨트롤 — 텍스트 글리프 대신 Fluent SymbolIcon 으로 현대화(아이콘 업그레이드).
                                             접근성은 AutomationProperties.Name 으로 유지(스크린리더가 한국어 이름을 읽음). -->
                                        <Button Command="{Binding Media.FastReverseCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                ToolTip="되감기"
                                                AutomationProperties.Name="되감기">
                                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaRewind}" />
                                        </Button>
                                        <Button Command="{Binding Media.PlayPauseCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Margin="0,0,8,0"
                                                ToolTip="재생/일시정지 (Space)"
                                                AutomationProperties.Name="재생/일시정지">
                                            <ui:SymbolIcon Symbol="{Binding Media.PlayPauseSymbol}" />
                                        </Button>
                                        <Button Command="{Binding Media.RestartCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                ToolTip="처음부터 다시 재생 (Enter)"
                                                AutomationProperties.Name="처음부터 다시 재생">
                                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaRestart}" />
                                        </Button>
                                        <Button Command="{Binding Media.StopCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                ToolTip="정지 (Esc 또는 S)"
                                                AutomationProperties.Name="정지">
                                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaStop}" />
                                        </Button>
                                        <Button Command="{Binding Media.FastForwardCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                ToolTip="빨리감기"
                                                AutomationProperties.Name="빨리감기">
                                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaFastForward}" />
                                        </Button>
                                        <!-- 토글 2종(음소거·반복)은 켜짐/꺼짐 상태가 한눈에 보여야 하므로 아이콘 + 글자 라벨 + 토글 배경.
                                             음소거 아이콘은 상태 구동(MuteSymbol) — 음소거면 ×스피커, 아니면 소리나는 스피커로 현재 상태를 정직하게 표시. -->
                                        <ToggleButton IsChecked="{Binding Media.IsMuted, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleMuteCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Margin="0,0,8,0"
                                                      ToolTip="음소거 토글 (M)"
                                                      AutomationProperties.Name="음소거 토글">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding Media.MuteSymbol}" Margin="0,0,6,0" />
                                                <TextBlock Text="음소거" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding Media.IsRepeatEnabled, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleRepeatCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      ToolTip="반복 재생 토글"
                                                      AutomationProperties.Name="반복 토글">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MediaRepeat}" Margin="0,0,6,0" />
                                                <TextBlock Text="반복" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="미디어 폴더"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding MediaDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding LiveCameraSource}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ClassicPreviewSlidePane"
                    Tag="splitContainerPreview.Panel2"
                    Grid.Column="0"
                    Grid.Row="2"
                    Background="#808080"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Focusable="True"
                    MouseDown="ClassicKeyboardSurface_MouseDown"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ClassicPreviewBottomStripHost"
                            Background="White"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="0,0,0,1"
                            Margin="-6,-6,-6,6"
                            Padding="6,6,6,5">
                        <WrapPanel x:Name="ClassicPreviewBottomStrip"
                                   Orientation="Horizontal"
                                   ButtonBase.Click="FocusPreviewArea_Click">
                            <Button x:Name="IndcbPreviewNotes"
                                    Tag="IndcbPreviewNotes"
                                    Click="OpenSessionNotes_Click"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Width="33"
                                    Content="N"
                                    ToolTip="세션 노트"
                                    AutomationProperties.Name="Preview 세션 노트" />
                            <ToggleButton x:Name="IndradioButtonText"
                                          Tag="IndradioButtonText"
                                          Command="{Binding ShowPreviewTextModeCommand}"
                                          IsChecked="{Binding IsPreviewTextMode, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="46"
                                          Content="Text"
                                          ToolTip="텍스트 보기"
                                          AutomationProperties.Name="Preview Text 모드" />
                            <ToggleButton x:Name="IndradioButtonFormat"
                                          Tag="IndradioButtonFormat"
                                          Command="{Binding ShowPreviewFormatModeCommand}"
                                          IsChecked="{Binding IsPreviewFormatMode, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="40"
                                          Content="Set"
                                          ToolTip="서식 설정"
                                          AutomationProperties.Name="Preview Set 모드" />
                            <ToggleButton x:Name="IndradioButtonInfo"
                                          Tag="IndradioButtonInfo"
                                          Command="{Binding ShowPreviewInfoModeCommand}"
                                          IsChecked="{Binding IsPreviewInfoMode, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="45"
                                          Content="Info"
                                          ToolTip="항목 정보"
                                          AutomationProperties.Name="Preview Info 모드" />
                            <Button x:Name="PreviewBtnItemUp"
                                    Tag="PreviewBtnItemUp"
                                    Command="{Binding PreviousPreviewItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="⌃"
                                    ToolTip="이전 항목"
                                    AutomationProperties.Name="Preview 이전 항목" />
                            <Button x:Name="PreviewBtnItemDown"
                                    Tag="PreviewBtnItemDown"
                                    Command="{Binding NextPreviewItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="⌄"
                                    ToolTip="다음 항목"
                                    AutomationProperties.Name="Preview 다음 항목" />
                            <Button x:Name="PreviewBtnSlideUp"
                                    Tag="PreviewBtnSlideUp"
                                    Command="{Binding PreviousSlideCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="◀"
                                    ToolTip="이전 슬라이드"
                                    AutomationProperties.Name="Preview 이전 슬라이드" />
                            <Button x:Name="PreviewBtnSlideDown"
                                    Tag="PreviewBtnSlideDown"
                                    Command="{Binding NextSlideCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="▶"
                                    ToolTip="다음 슬라이드"
                                    AutomationProperties.Name="Preview 다음 슬라이드" />
                            <TextBlock x:Name="ClassicPreviewPositionLabel"
                                       Text="{Binding PreviewNavigationPositionLabel}"
                                       MinWidth="36"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       AutomationProperties.Name="Preview 현재 위치" />
                            <WrapPanel x:Name="flowLayoutPanel1"
                                       Tag="flowLayoutPanel1">
                                <Button x:Name="PreviewBtnVerse1" Tag="1" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="1" Style="{StaticResource ClassicVerseJumpButton}" Content="1" AutomationProperties.Name="Preview 1절" />
                                <Button x:Name="PreviewBtnVerse2" Tag="2" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="2" Style="{StaticResource ClassicVerseJumpButton}" Content="2" AutomationProperties.Name="Preview 2절" />
                                <Button x:Name="PreviewBtnVerse3" Tag="3" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="3" Style="{StaticResource ClassicVerseJumpButton}" Content="3" AutomationProperties.Name="Preview 3절" />
                                <Button x:Name="PreviewBtnVerse4" Tag="4" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="4" Style="{StaticResource ClassicVerseJumpButton}" Content="4" AutomationProperties.Name="Preview 4절" />
                                <Button x:Name="PreviewBtnVerse5" Tag="5" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="5" Style="{StaticResource ClassicVerseJumpButton}" Content="5" AutomationProperties.Name="Preview 5절" />
                                <Button x:Name="PreviewBtnVerse6" Tag="6" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="6" Style="{StaticResource ClassicVerseJumpButton}" Content="6" AutomationProperties.Name="Preview 6절" />
                                <Button x:Name="PreviewBtnVerse7" Tag="7" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="7" Style="{StaticResource ClassicVerseJumpButton}" Content="7" AutomationProperties.Name="Preview 7절" />
                                <Button x:Name="PreviewBtnVerse8" Tag="8" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="8" Style="{StaticResource ClassicVerseJumpButton}" Content="8" AutomationProperties.Name="Preview 8절" />
                                <Button x:Name="PreviewBtnVerse9" Tag="9" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="9" Style="{StaticResource ClassicVerseJumpButton}" Content="9" AutomationProperties.Name="Preview 9절" />
                                <Button x:Name="PreviewBtnVersePreChorus" Tag="111" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="p" Style="{StaticResource ClassicVerseJumpButton}" Content="p" AutomationProperties.Name="Preview pre-chorus" />
                                <Button x:Name="PreviewBtnVersePreChorus2" Tag="112" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="q" Style="{StaticResource ClassicVerseJumpButton}" Content="q" AutomationProperties.Name="Preview pre-chorus 2" />
                                <Button x:Name="PreviewBtnVerseChorus" Tag="0" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="c" Style="{StaticResource ClassicVerseJumpButton}" Content="c" AutomationProperties.Name="Preview chorus" />
                                <Button x:Name="PreviewBtnVerseChorus2" Tag="102" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="t" Style="{StaticResource ClassicVerseJumpButton}" Content="t" AutomationProperties.Name="Preview chorus 2" />
                                <Button x:Name="PreviewBtnVerseBridge" Tag="100" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="b" Style="{StaticResource ClassicVerseJumpButton}" Content="b" AutomationProperties.Name="Preview bridge" />
                                <Button x:Name="PreviewBtnVerseBridge2" Tag="103" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="w" Style="{StaticResource ClassicVerseJumpWideButton}" Content="w" AutomationProperties.Name="Preview bridge 2" />
                                <Button x:Name="PreviewBtnVerseEnding" Tag="101" Command="{Binding JumpToLyricsSectionCommand}" CommandParameter="e" Style="{StaticResource ClassicVerseJumpButton}" Content="e" AutomationProperties.Name="Preview ending" />
                            </WrapPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          x:Name="ClassicPreviewSampleScreenHost">
                    <Viewbox x:Name="ClassicPreviewHolder"
                             Tag="PreviewHolder"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"
                             Focusable="True"
                             MouseDown="ClassicKeyboardSurface_MouseDown"
                             AutomationProperties.Name="Preview 4:3 화면 프레임">
                        <Viewbox.Width>
                            <MultiBinding Converter="{StaticResource LegacySampleScreenSize}">
                                <Binding ElementName="ClassicPreviewSampleScreenHost" Path="ActualWidth" />
                                <Binding ElementName="ClassicPreviewSampleScreenHost" Path="ActualHeight" />
                            </MultiBinding>
                        </Viewbox.Width>
                        <Viewbox.Height>
                            <MultiBinding Converter="{StaticResource LegacySampleScreenSize}" ConverterParameter="Height">
                                <Binding ElementName="ClassicPreviewSampleScreenHost" Path="ActualWidth" />
                                <Binding ElementName="ClassicPreviewSampleScreenHost" Path="ActualHeight" />
                            </MultiBinding>
                        </Viewbox.Height>
                        <Grid Width="960"
                              Height="720">
                            <Border x:Name="ClassicPreviewBack"
                                    Tag="PreviewBack"
                                    Background="#165D7A"
                                    BorderBrush="#111111"
                                    BorderThickness="0,0,8,8"
                                    Focusable="True"
                                    MouseDown="ClassicKeyboardSurface_MouseDown">
                                <Grid>
                                    <TextBlock x:Name="ClassicPreviewLargeLyricsText"
                                               Tag="PreviewScreenLyrics"
                                               Text="{Binding PreviewLyricsText}"
                                               Visibility="{Binding HasPreviewLyricsText, Converter={StaticResource BoolToVis}}"
                                               Margin="36,48,36,68"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="48"
                                               FontWeight="Bold"
                                               LineHeight="64"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="#FFF6E600"
                                               AutomationProperties.Name="Preview 큰 화면 본문" />
                                    <TextBlock Text="{Binding PreviewNavigationPositionLabel}"
                                               Margin="20,0,0,18"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="#FFF6E600"
                                               AutomationProperties.Name="Preview 큰 화면 위치" />
                                </Grid>
                            </Border>
                            <rendering:SlidePreviewControl x:Name="ClassicPreviewLargeSlide"
                                                           Title="{Binding PreviewVisualTitle}"
                                                           Kind="{Binding PreviewVisualKind}"
                                                           Source="{Binding PreviewVisualSource}"
                                                           FillMode="{Binding PreviewVisualFillMode}"
                                                           SlideNumber="{Binding PreviewVisualSlideNumber}"
                                                           ShowSlideNumber="True"
                                                           IsSelected="True"
                                                           Visibility="{Binding HasPreviewVisualSource, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ClassicOutputPane"
                    Tag="splitContainerOutput.Panel1"
                    Grid.Column="2"
                    Grid.Row="0"
                    Background="White"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="ClassicOutputPanelDisplayName"
                                  Tag="OutputPanelDisplayName"
                                  Style="{StaticResource ClassicPanelDisplayList}"
                                  SelectedIndex="0"
                                  AutomationProperties.Name="Output 현재 송출 항목">
                            <ListViewItem Style="{StaticResource ClassicPanelDisplayListItem}"
                                          IsSelected="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveToggle}"
                                                   FontSize="15"
                                                   Margin="0,0,5,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DataContext.OutputPanelTitleText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DataContext.OutputPanelSourceText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DataContext.OutputPanelStatusText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Grid>
                            </ListViewItem>
                        </ListView>
                        <WrapPanel Grid.Column="1"
                                   x:Name="ClassicOutputTopStrip"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right">
                            <ToggleButton x:Name="cbOutputBlack"
                                          Tag="cbOutputBlack"
                                          Command="{Binding ToggleOutputBlackCommand}"
                                          IsChecked="{Binding IsOutputBlackActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOutputToggleButton}"
                                          MinWidth="32"
                                          MinHeight="28"
                                          Padding="6,0"
                                          Margin="4,0,0,0"
                                          ToolTip="검은 화면"
                                          AutomationProperties.Name="Output 검은 화면">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveBlack}" />
                            </ToggleButton>
                            <ToggleButton x:Name="cbOutputClear"
                                          Tag="cbOutputClear"
                                          Command="{Binding ToggleOutputClearCommand}"
                                          IsChecked="{Binding IsOutputClearActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOutputToggleButton}"
                                          MinWidth="32"
                                          MinHeight="28"
                                          Padding="6,0"
                                          Margin="4,0,0,0"
                                          Content="Tx"
                                          ToolTip="화면 비우기"
                                          AutomationProperties.Name="Output 화면 비우기" />
                            <ToggleButton x:Name="cbGoLive"
                                          Tag="cbGoLive"
                                          Command="{Binding ToggleOutputLiveCommand}"
                                          IsChecked="{Binding IsOutputLiveActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOutputToggleButton}"
                                          MinWidth="32"
                                          MinHeight="28"
                                          Padding="6,0"
                                          Margin="4,0,0,0"
                                          Content="LIVE"
                                          ToolTip="출력 복귀"
                                          AutomationProperties.Name="Output 복귀" />
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Surface.Page}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1">
                        <Grid x:Name="ClassicOutputInfo"
                              Tag="OutputInfo"
                              Focusable="True"
                              MouseDown="ClassicKeyboardSurface_MouseDown">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#FFF6E600"
                                    Padding="4,2"
                                    Visibility="{Binding IsOutputHeaderTextVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding OutputItem.Title}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Status.Danger}" />
                            </Border>
                            <Grid Grid.Row="1">
                                <ScrollViewer x:Name="ClassicOutputLyricsScrollViewer"
                                              Focusable="True"
                                              MouseDown="ClassicKeyboardSurface_MouseDown"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="8"
                                              Visibility="{Binding HasOutputLyricsText, Converter={StaticResource BoolToVis}}"
                                              AutomationProperties.Name="Output 가사 페이지 영역">
                                    <ItemsControl x:Name="flowLayoutOutputLyrics"
                                                  Tag="flowLayoutOutputLyrics"
                                                  Focusable="True"
                                                  MouseDown="ClassicKeyboardSurface_MouseDown"
                                                  ItemsSource="{Binding OutputLyricsPages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.GoToOutputLyricsPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding PageIndex}"
                                                        Margin="0"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding PositionText, StringFormat=Output {0}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Border BorderThickness="0"
                                                            Padding="4,3"
                                                            MinHeight="24">
                                                        <Border.Width>
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                                     Converter="{StaticResource LegacyLyricsRichTextBoxWidth}" />
                                                        </Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Page}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="#FFFFFF00" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding BodyText}"
                                                                   TextWrapping="Wrap"
                                                                   FontFamily="Microsoft Sans Serif"
                                                                   FontSize="13"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="ClassicOutputPowerPointSurface"
                                              Tag="flowLayoutOutputPowerPoint"
                                              Focusable="True"
                                              MouseDown="ClassicKeyboardSurface_MouseDown"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="8"
                                              Visibility="{Binding IsOutputPowerPointContext, Converter={StaticResource BoolToVis}}"
                                              AutomationProperties.Name="Output PowerPoint 썸네일 영역">
                                    <ItemsControl x:Name="ClassicOutputThumbnailGrid"
                                                  ItemsSource="{Binding OutputPowerPoint.Thumbnails}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.GoToOutputSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding SlideNumber}"
                                                        Margin="6"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip="{Binding SlideNumber, StringFormat=슬라이드 {0}}"
                                                        AutomationProperties.Name="{Binding SlideNumber, StringFormat=Output 슬라이드 {0}}">
                                                    <Button.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                                      Command="{Binding DataContext.ReplayOutputPowerPointSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding SlideNumber}" />
                                                    </Button.InputBindings>
                                                    <Border Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}}"
                                                            Height="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                                            BorderThickness="5"
                                                            Background="White"
                                                            Padding="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="Red" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Image Source="{Binding Image}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                            <TextBlock Text="{Binding SlideNumber}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Top"
                                                                       MinWidth="18"
                                                                       TextAlignment="Center"
                                                                       FontWeight="Bold"
                                                                       Foreground="Black"
                                                                       Background="#FFF6E600" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="ClassicOutputVisualSurface"
                                              Tag="flowLayoutOutputVisual"
                                              Focusable="True"
                                              MouseDown="ClassicKeyboardSurface_MouseDown"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="8"
                                              Visibility="{Binding IsOutputVisualContext, Converter={StaticResource BoolToVis}}"
                                              AutomationProperties.Name="Output 시각 자료 영역">
                                    <WrapPanel>
                                        <Button Command="{Binding RefreshOutputVisualCommand}"
                                                Margin="6"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Output 시각 자료 새로고침"
                                                AutomationProperties.Name="Output 시각 자료 새로고침">
                                            <Border Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}}"
                                                    MinHeight="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                                    Padding="4"
                                                    Background="{DynamicResource Brush.Surface.Page}"
                                                    BorderBrush="Red"
                                                    BorderThickness="5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <rendering:SlidePreviewControl Title="{Binding OutputVisualTitle}"
                                                                                   Kind="{Binding OutputVisualKind}"
                                                                                   Source="{Binding OutputVisualSource}"
                                                                                   FillMode="{Binding OutputVisualFillMode}"
                                                                                   SlideNumber="{Binding OutputVisualSlideNumber}"
                                                                                   Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}}"
                                                                                   Height="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LegacyPowerPointThumbnailSize}, ConverterParameter=Height}"
                                                                                   IsHitTestVisible="False"
                                                                                   AutomationProperties.Name="Output 시각 자료 썸네일" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding OutputVisualTitle}"
                                                               Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="32"
                                                               Style="{StaticResource Type.Caption.StrongStyle}"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding OutputVisualKind}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </WrapPanel>
                                </ScrollViewer>
                            </Grid>
                            <Border x:Name="ClassicOutputMediaSurface"
                                    Tag="flowLayoutOutputMedia"
                                    Grid.Row="2"
                                    Focusable="True"
                                    MouseDown="ClassicKeyboardSurface_MouseDown"
                                    Background="White"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="0,1,0,0"
                                    Padding="6,5"
                                    Visibility="{Binding IsOutputMediaContext, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Output 미디어 영역">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OutputBtnMediaInline"
                                            Tag="OutputBtnMedia"
                                            Command="{Binding PlayOutputMediaCommand}"
                                            Click="FocusOutputArea_Click"
                                            Style="{StaticResource EsButton.Secondary}"
                                            MinWidth="30"
                                            MinHeight="26"
                                            Padding="6,0"
                                            Margin="0,0,6,0"
                                            ToolTip="미디어 재생/일시정지"
                                            AutomationProperties.Name="Output 미디어 재생 일시정지">
                                        <ui:SymbolIcon Symbol="{Binding OutputMediaPlayPauseSymbol}" />
                                    </Button>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OutputMediaTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.StrongStyle}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding OutputMediaSourceText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding OutputMediaStatusText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ClassicOutputSlidePane"
                    Tag="splitContainerOutput.Panel2"
                    Grid.Column="2"
                    Grid.Row="2"
                    Background="#808080"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Focusable="True"
                    MouseDown="ClassicKeyboardSurface_MouseDown"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ClassicOutputBottomStripHost"
                            Background="White"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="0,0,0,1"
                            Margin="-6,-6,-6,6"
                            Padding="6,6,6,5">
                        <WrapPanel x:Name="ClassicOutputBottomStrip"
                                   Orientation="Horizontal"
                                   ButtonBase.Click="FocusOutputArea_Click">
                            <Button x:Name="OutputBtnJumpToNonRotate"
                                    Tag="OutputBtnJumpToNonRotate"
                                    Command="{Binding JumpToNextNonRotateOutputItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Width="31"
                                    Content="J"
                                    ToolTip="회전 제외 항목으로 이동"
                                    AutomationProperties.Name="Output 회전 제외 항목 이동" />
                            <Button x:Name="OutputBtnMedia"
                                    Tag="OutputBtnMedia"
                                    Command="{Binding PlayOutputMediaCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Width="31"
                                    ToolTip="미디어 재생/일시정지"
                                    AutomationProperties.Name="Output 미디어 재생 일시정지">
                                <ui:SymbolIcon Symbol="{Binding OutputMediaPlayPauseSymbol}" />
                            </Button>
                            <ToggleButton x:Name="OutputBtnRefAlert"
                                          Tag="OutputBtnRefAlert"
                                          Command="{Binding ToggleOutputReferenceAlertCommand}"
                                          IsChecked="{Binding IsOutputReferenceAlertActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="31"
                                          Content="!"
                                          ToolTip="성경 구절 알림"
                                          AutomationProperties.Name="Output 구절 알림" />
                            <Button x:Name="OutputBtnStopLive"
                                    Tag="StopLiveCommand"
                                    Command="{Binding StopLiveCommand}"
                                    Style="{StaticResource ClassicOperatorStripDangerButton}"
                                    Width="31"
                                    ToolTip="라이브 중지"
                                    AutomationProperties.Name="Output 라이브 중지">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                            <Button x:Name="OutputBtnRestartCurrentItem"
                                    Tag="Menu_RestartCurrentItem"
                                    Command="{Binding RestartCurrentItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Width="31"
                                    ToolTip="현재 항목 처음으로"
                                    AutomationProperties.Name="Output 현재 항목 처음으로">
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </Button>
                            <Button x:Name="OutputBtnRefresh"
                                    Tag="Menu_RefreshOutput"
                                    Command="{Binding RefreshOutputCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Width="31"
                                    ToolTip="출력 새로고침"
                                    AutomationProperties.Name="Output 새로고침">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" />
                            </Button>
                            <ToggleButton Command="{Binding ToggleOutputBlackCommand}"
                                          IsChecked="{Binding IsOutputBlackActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="40"
                                          ToolTip="검은 화면"
                                          AutomationProperties.Name="Output 하단 검은 화면">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveBlack}" />
                            </ToggleButton>
                            <ToggleButton Command="{Binding ToggleOutputClearCommand}"
                                          IsChecked="{Binding IsOutputClearActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="40"
                                          Content="Tx"
                                          ToolTip="화면 비우기"
                                          AutomationProperties.Name="Output 하단 화면 비우기" />
                            <Button x:Name="OutputBtnItemUp"
                                    Tag="OutputBtnItemUp"
                                    Command="{Binding PreviousOutputItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="⌃"
                                    ToolTip="이전 항목"
                                    AutomationProperties.Name="Output 이전 항목" />
                            <Button x:Name="OutputBtnItemDown"
                                    Tag="OutputBtnItemDown"
                                    Command="{Binding NextOutputItemCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="⌄"
                                    ToolTip="다음 항목"
                                    AutomationProperties.Name="Output 다음 항목" />
                            <Button x:Name="OutputBtnSlideUp"
                                    Tag="OutputBtnSlideUp"
                                    Command="{Binding PreviousOutputSlideCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="◀"
                                    ToolTip="이전 슬라이드"
                                    AutomationProperties.Name="Output 이전 슬라이드" />
                            <Button x:Name="OutputBtnSlideDown"
                                    Tag="OutputBtnSlideDown"
                                    Command="{Binding NextOutputSlideCommand}"
                                    Style="{StaticResource ClassicOperatorStripButton}"
                                    Content="▶"
                                    ToolTip="다음 슬라이드"
                                    AutomationProperties.Name="Output 다음 슬라이드" />
                            <TextBlock x:Name="ClassicOutputPositionLabel"
                                       Text="{Binding OutputNavigationPositionLabel}"
                                       MinWidth="36"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       AutomationProperties.Name="Output 현재 위치" />
                            <ToggleButton Command="{Binding ToggleOutputLiveCommand}"
                                          IsChecked="{Binding IsOutputLiveActive, Mode=OneWay}"
                                          Style="{StaticResource ClassicOperatorStripToggleButton}"
                                          Width="56"
                                          ToolTip="출력 복귀"
                                          AutomationProperties.Name="Output 하단 복귀">
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </ToggleButton>
                            <WrapPanel x:Name="flowLayoutPanel2"
                                       Tag="flowLayoutPanel2"
                                       Margin="4,0,0,0">
                                <Button x:Name="OutputBtnVerse1" Tag="1" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="1" Style="{StaticResource ClassicVerseJumpButton}" Content="1" AutomationProperties.Name="Output 1절" />
                                <Button x:Name="OutputBtnVerse2" Tag="2" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="2" Style="{StaticResource ClassicVerseJumpButton}" Content="2" AutomationProperties.Name="Output 2절" />
                                <Button x:Name="OutputBtnVerse3" Tag="3" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="3" Style="{StaticResource ClassicVerseJumpButton}" Content="3" AutomationProperties.Name="Output 3절" />
                                <Button x:Name="OutputBtnVerse4" Tag="4" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="4" Style="{StaticResource ClassicVerseJumpButton}" Content="4" AutomationProperties.Name="Output 4절" />
                                <Button x:Name="OutputBtnVerse5" Tag="5" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="5" Style="{StaticResource ClassicVerseJumpButton}" Content="5" AutomationProperties.Name="Output 5절" />
                                <Button x:Name="OutputBtnVerse6" Tag="6" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="6" Style="{StaticResource ClassicVerseJumpButton}" Content="6" AutomationProperties.Name="Output 6절" />
                                <Button x:Name="OutputBtnVerse7" Tag="7" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="7" Style="{StaticResource ClassicVerseJumpButton}" Content="7" AutomationProperties.Name="Output 7절" />
                                <Button x:Name="OutputBtnVerse8" Tag="8" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="8" Style="{StaticResource ClassicVerseJumpButton}" Content="8" AutomationProperties.Name="Output 8절" />
                                <Button x:Name="OutputBtnVerse9" Tag="9" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="9" Style="{StaticResource ClassicVerseJumpButton}" Content="9" AutomationProperties.Name="Output 9절" />
                                <Button x:Name="OutputBtnVersePreChorus" Tag="111" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="p" Style="{StaticResource ClassicVerseJumpButton}" Content="p" AutomationProperties.Name="Output pre-chorus" />
                                <Button x:Name="OutputBtnVersePreChorus2" Tag="112" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="q" Style="{StaticResource ClassicVerseJumpButton}" Content="q" AutomationProperties.Name="Output pre-chorus 2" />
                                <Button x:Name="OutputBtnVerseChorus" Tag="0" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="c" Style="{StaticResource ClassicVerseJumpButton}" Content="c" AutomationProperties.Name="Output chorus" />
                                <Button x:Name="OutputBtnVerseChorus2" Tag="102" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="t" Style="{StaticResource ClassicVerseJumpButton}" Content="t" AutomationProperties.Name="Output chorus 2" />
                                <Button x:Name="OutputBtnVerseBridge" Tag="100" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="b" Style="{StaticResource ClassicVerseJumpButton}" Content="b" AutomationProperties.Name="Output bridge" />
                                <Button x:Name="OutputBtnVerseBridge2" Tag="103" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="w" Style="{StaticResource ClassicVerseJumpWideButton}" Content="w" AutomationProperties.Name="Output bridge 2" />
                                <Button x:Name="OutputBtnVerseEnding" Tag="101" Command="{Binding JumpToOutputLyricsSectionCommand}" CommandParameter="e" Style="{StaticResource ClassicVerseJumpButton}" Content="e" AutomationProperties.Name="Output ending" />
                            </WrapPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          x:Name="ClassicOutputSampleScreenHost">
                    <Viewbox x:Name="ClassicOutputHolder"
                             Tag="OutputHolder"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"
                             Focusable="True"
                             MouseDown="ClassicKeyboardSurface_MouseDown"
                             AutomationProperties.Name="Output 4:3 화면 프레임">
                        <Viewbox.Width>
                            <MultiBinding Converter="{StaticResource LegacySampleScreenSize}">
                                <Binding ElementName="ClassicOutputSampleScreenHost" Path="ActualWidth" />
                                <Binding ElementName="ClassicOutputSampleScreenHost" Path="ActualHeight" />
                            </MultiBinding>
                        </Viewbox.Width>
                        <Viewbox.Height>
                            <MultiBinding Converter="{StaticResource LegacySampleScreenSize}" ConverterParameter="Height">
                                <Binding ElementName="ClassicOutputSampleScreenHost" Path="ActualWidth" />
                                <Binding ElementName="ClassicOutputSampleScreenHost" Path="ActualHeight" />
                            </MultiBinding>
                        </Viewbox.Height>
                        <Grid Width="960"
                              Height="720">
                            <Border x:Name="ClassicOutputBack"
                                    Tag="OutputBack"
                                    Background="#165D7A"
                                    BorderBrush="#111111"
                                    Focusable="True"
                                    MouseDown="ClassicKeyboardSurface_MouseDown"
                                    BorderThickness="0,0,8,8">
                                <Grid>
                                    <TextBlock x:Name="ClassicOutputLargeLyricsText"
                                               Tag="OutputScreenLyrics"
                                               Text="{Binding OutputLyricsText}"
                                               Visibility="{Binding HasOutputLyricsText, Converter={StaticResource BoolToVis}}"
                                               Margin="36,48,36,68"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="48"
                                               FontWeight="Bold"
                                               LineHeight="64"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="#FFF6E600"
                                               AutomationProperties.Name="Output 큰 화면 본문" />
                                    <TextBlock Text="{Binding OutputNavigationPositionLabel}"
                                               Margin="20,0,0,18"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="#FFF6E600"
                                               AutomationProperties.Name="Output 큰 화면 위치" />
                                    <TextBlock Text="{Binding LiveBar.StateLabel}"
                                               Margin="0,0,20,18"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="#FFF6E600" />
                                </Grid>
                            </Border>
                            <rendering:SlidePreviewControl x:Name="ClassicOutputLargeSlideImage"
                                                           Title="{Binding OutputVisualTitle}"
                                                           Kind="{Binding OutputVisualKind}"
                                                           Source="{Binding OutputVisualSource}"
                                                           FillMode="{Binding OutputVisualFillMode}"
                                                           SlideNumber="{Binding OutputVisualSlideNumber}"
                                                           Visibility="{Binding HasOutputVisualSource, Converter={StaticResource BoolToVis}}"
                                                           AutomationProperties.Name="Output 큰 시각 자료" />
                        </Grid>
                    </Viewbox>
                    </Grid>

                    <Border Grid.Row="2"
                            x:Name="panelOutputLM1"
                            Tag="panelOutputLM1"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            Background="{DynamicResource Brush.Surface.Page}"
                            Margin="0,6,0,0"
                            Padding="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="panelOutputLM2"
                                    Tag="panelOutputLM2"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent" />
                            <TextBox Grid.Row="1"
                                     x:Name="OutputTextBoxLM"
                                     Tag="OutputTextBoxLM"
                                     Text="{Binding OutputLiveMessage, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="28"
                                     Padding="6,2"
                                     BorderThickness="0"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="라이브 메시지 입력">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding SendLiveMessageCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="panelOutputLM3"
                                        Tag="panelOutputLM3"
                                        Orientation="Horizontal">
                                <Button x:Name="OutputBtnLMSend"
                                        Tag="OutputBtnLMSend"
                                        Command="{Binding SendLiveMessageCommand}"
                                        Style="{StaticResource EsButton.Primary}"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="4,0,0,0"
                                        Content=">"
                                        ToolTip="라이브 메시지 송출"
                                        AutomationProperties.Name="라이브 메시지 송출" />
                                <Button x:Name="OutputBtnLMClear"
                                        Tag="OutputBtnLMClear"
                                        Command="{Binding ClearLiveMessageCommand}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Padding="6,0"
                                        Margin="4,0,0,0"
                                        Content="X"
                                        ToolTip="라이브 메시지 지우기"
                                        AutomationProperties.Name="라이브 메시지 지우기" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ClassicInspectorFlyout"
                    Grid.Column="2"
                    Grid.RowSpan="3"
                    Width="340"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="5"
                    Visibility="Collapsed"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <StackPanel>
                    <TextBlock Text="운영 상태"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="출력"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding OutputDisplays}"
                              SelectedItem="{Binding SelectedOutputDisplay, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="출력 모니터 선택"
                              MinHeight="36"
                              Margin="0,4,0,16" />

                    <!-- 스테이지(Preview) 모니터 선택 — 회중용 출력과 별개 모니터를 골라 리더 확인용으로 띄운다(gap §3.1). -->
                    <TextBlock Text="스테이지 모니터"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding PreviewDisplays}"
                              SelectedItem="{Binding SelectedPreviewDisplay, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="스테이지 모니터 선택"
                              MinHeight="36"
                              Margin="0,4,0,16" />

                    <TextBlock Text="송출"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding LiveBar.State}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,2,0,16" />

                    <TextBlock Text="선택"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding SelectedItem.Kind}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <!-- 인-셸 출력 모양 인스펙터(§7.5 P0) — 별도 Settings 모달 없이 글자색·배경을 즉시 적용,
                         설정→출력 VM 경로로 라이브 반영. 세분 색 편집은 후속. -->
                    <TextBlock Text="출력 모양"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ItemsControl ItemsSource="{Binding OutputAppearancePresets}"
                                  Margin="0,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ApplyOutputAppearanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,4"
                                        Padding="6"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 미리보기 스와치: 배경 위에 글자색 'Aa' -->
                                        <Border Width="34"
                                                Height="22"
                                                CornerRadius="3"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="Aa"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding TextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ActiveAppearanceName, StringFormat=현재: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <!-- 세분 색 직접 지정(§7.3-A) — 프리셋 너머 임의 hex 색. Enter 또는 적용 버튼으로 반영. -->
                    <TextBlock Text="색 직접 지정 (#RRGGBB)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="글자"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="TextColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveTextColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="글자색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyTextColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=TextColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyTextColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=TextColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="글자색 적용" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="배경"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="BackgroundColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveBackgroundColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="배경색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyBackgroundColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyBackgroundColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="배경색 적용" />
                    </Grid>

                    <!-- 인-셸 가사 정렬(§7.3-A) — 모달 없이 좌/중/우 즉시 적용, 라이브 출력에 반영. -->
                    <TextBlock Text="가사 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="가사 왼쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="가사 오른쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsAlignmentLabel, StringFormat=현재 정렬: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 세로 정렬(§7.3-A) — 위/가운데/아래. -->
                    <TextBlock Text="가사 세로 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="위"
                                AutomationProperties.Name="가사 위쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 세로 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="아래"
                                AutomationProperties.Name="가사 아래쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsVerticalAlignmentLabel, StringFormat=현재 세로: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 폰트 크기(§7.3-A) — 작게(-)/크게(+) 단계 조절. -->
                    <TextBlock Text="가사 크기"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="A−"
                                ToolTip="가사 글자 작게"
                                AutomationProperties.Name="가사 글자 작게" />
                        <Button Command="{Binding IncreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="A+"
                                ToolTip="가사 글자 크게"
                                AutomationProperties.Name="가사 글자 크게" />
                        <!-- 직접 수치 입력(FrmMain NumericUpDown 대응) — 범위 밖 값은 자동 클램프, 입력 후 포커스 이동 시 적용. -->
                        <TextBox Text="{Binding LyricsFontSizeInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="가사 글자 크기 직접 입력 (24~120px) — 숫자가 아니면 빨간 테두리로 표시"
                                 AutomationProperties.Name="가사 글자 크기 직접 입력" />
                        <TextBlock Text="px"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 출력 가사 전역 글꼴(FrmMain Def_FontName) — 편집 가능 콤보라 목록 밖 글꼴명도 직접 입력 가능. 비우면 테마 기본 글꼴. 곡별 글꼴(43)이 있으면 그 곡 우선. -->
                    <TextBlock Text="출력 글꼴 (비우면 기본)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding LyricsFontFamilyOptions}"
                              Text="{Binding LyricsFontFamilyInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              Margin="0,4,0,0"
                              ToolTip="회중 출력 가사의 기본 글꼴. 목록에서 고르거나 글꼴명을 직접 입력하세요. 비우면 테마 기본 글꼴을 씁니다. 곡별 글꼴이 지정된 곡은 그 글꼴이 우선합니다."
                              AutomationProperties.Name="출력 가사 전역 글꼴" />

                    <!-- 보조 영역(Region2) 폰트 크기(FrmMain Ind_Reg2SizeUpDown) — 이중 언어 곡의 번역 영역 크기. 0=본문과 동일. -->
                    <TextBlock Text="보조영역 크기 (0=본문과 동일)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <TextBox Text="{Binding LyricsFontSize2Input, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="이중 언어 곡의 보조 영역(Region2) 글자 크기. 0=본문과 동일, 그 외 24~120px. 숫자가 아니면 빨간 테두리"
                                 AutomationProperties.Name="보조영역 글자 크기 직접 입력" />
                        <TextBlock Text="px"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 보조 영역(Region2) 전역 글꼴(FrmMain Ind_Reg2Font) — 비우면 본문 글꼴 추종. 곡별 글꼴(44)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 글꼴 (비우면 본문과 동일)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding LyricsFontFamilyOptions}"
                              Text="{Binding LyricsFontFamily2Input, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 기본 글꼴. 비우면 본문(Region1) 글꼴을 따릅니다. 곡별 글꼴이 지정된 곡은 그 글꼴이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 글꼴" />

                    <!-- 보조 영역(Region2) 전역 글자색 — 본문과 동일(추종) 또는 별도 색. 곡별 색(30)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 글자색 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsTextColor2Presets}"
                              SelectedValue="{Binding LyricsTextColor2Input, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 글자색. '본문과 동일'이면 본문(Region1) 색을 따릅니다. 곡별 색이 지정된 곡은 그 색이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 글자색" />

                    <!-- 보조 영역(Region2) 전역 가로 정렬 — 본문과 동일(추종) 또는 별도 정렬. 곡별 정렬(32)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 정렬 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsRegion2AlignmentPresets}"
                              SelectedValue="{Binding LyricsRegion2AlignmentInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 가로 정렬. '본문과 동일'이면 본문(Region1) 정렬을 따릅니다. 곡별 정렬이 지정된 곡은 그 정렬이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 정렬" />

                    <!-- 보조 영역(Region2) 전역 굵게 — 본문과 동일(추종) 또는 별도(굵게/보통). 곡별 굵게가 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 굵게 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsRegion2BoldPresets}"
                              SelectedValue="{Binding LyricsRegion2BoldInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 굵게. '본문과 동일'이면 본문(Region1) 굵게를 따릅니다(번역만 보통으로 두는 등 분리 가능). 곡별 굵게가 지정된 곡은 그 값이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 굵게" />

                    <!-- 보조 영역(Region2) 전역 기울임 — 본문과 동일(추종) 또는 별도(기울임/곧게). 곡별 기울임이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 기울임 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsRegion2ItalicPresets}"
                              SelectedValue="{Binding LyricsRegion2ItalicInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 기울임. '본문과 동일'이면 본문(Region1) 기울임을 따릅니다(번역만 기울임으로 두는 등 분리 가능). 곡별 기울임이 지정된 곡은 그 값이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 기울임" />

                    <!-- 보조 영역(Region2) 전역 밑줄 — 본문과 동일(추종) 또는 별도(밑줄/없음). 곡별 밑줄이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 밑줄 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsRegion2UnderlinePresets}"
                              SelectedValue="{Binding LyricsRegion2UnderlineInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 밑줄. '본문과 동일'이면 본문(Region1) 밑줄을 따릅니다. 곡별 밑줄이 지정된 곡은 그 값이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 밑줄" />

                    <!-- 인-셸 가사 줄 간격(§7.3-A) — 폰트 대비 % 로 −/+ 조절. -->
                    <TextBlock Text="줄 간격"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="−"
                                ToolTip="줄 간격 좁게"
                                AutomationProperties.Name="줄 간격 좁게" />
                        <Button Command="{Binding IncreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="＋"
                                ToolTip="줄 간격 넓게"
                                AutomationProperties.Name="줄 간격 넓게" />
                        <!-- 직접 수치 입력(FrmMain NumericUpDown 대응) — 범위 밖 값은 자동 클램프, 입력 후 포커스 이동 시 적용. -->
                        <TextBox Text="{Binding LyricsLineSpacingInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="가사 줄 간격 직접 입력 (100~220%) — 숫자가 아니면 빨간 테두리로 표시"
                                 AutomationProperties.Name="가사 줄 간격 직접 입력" />
                        <TextBlock Text="%"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 본문 여백(FrmMain ShowLeftMargin/ShowRightMargin/ShowBottomMargin) — 본문을 가장자리에서 안쪽으로
                         들여쓴다. 좌/우/아래 3종 직접 수치 입력(0~400px, 범위 밖은 클램프·비숫자는 빨간 테두리). -->
                    <TextBlock Text="본문 여백(px)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 왼쪽 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="왼쪽"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding LyricsLeftMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 왼쪽 여백 (0~400px)"
                                 AutomationProperties.Name="본문 왼쪽 여백 직접 입력" />
                        <!-- 오른쪽 -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="오른쪽"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding LyricsRightMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 오른쪽 여백 (0~400px)"
                                 AutomationProperties.Name="본문 오른쪽 여백 직접 입력" />
                        <!-- 아래 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="아래"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding LyricsBottomMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 아래 여백 (0~400px)"
                                 AutomationProperties.Name="본문 아래 여백 직접 입력" />
                    </Grid>

                    <!-- 인-셸 가사 폰트 효과(§7.3-A) — 굵게/기울임/그림자 토글. 그림자는 어두운/영상 배경 가독성. -->
                    <TextBlock Text="가사 효과"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <ToggleButton IsChecked="{Binding ActiveLyricsBold, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsBoldCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontWeight="Bold"
                                      Content="가"
                                      ToolTip="가사 굵게"
                                      AutomationProperties.Name="가사 굵게 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsItalic, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsItalicCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontStyle="Italic"
                                      Content="가"
                                      ToolTip="가사 기울임"
                                      AutomationProperties.Name="가사 기울임 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsUnderline, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsUnderlineCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      Content="가"
                                      ToolTip="가사 밑줄"
                                      AutomationProperties.Name="가사 밑줄 토글">
                            <ToggleButton.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextDecorations="Underline" />
                                </DataTemplate>
                            </ToggleButton.ContentTemplate>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ActiveLyricsShadow, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsShadowCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="그림자"
                                      ToolTip="가사 그림자(어두운 배경 가독성)"
                                      AutomationProperties.Name="가사 그림자 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsPositionIndicator, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsPositionIndicatorCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="N/M"
                                      ToolTip="절/슬라이드 위치 인디케이터 표시(출력 우하단)"
                                      AutomationProperties.Name="위치 인디케이터 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsTitleHeading, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsTitleHeadingCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="제목"
                                      ToolTip="곡 제목을 가사 위 상단 배너로 표시(§7.3-A)"
                                      AutomationProperties.Name="제목 헤딩 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsOutline, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsOutlineCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Content="외곽선"
                                      ToolTip="가사 글자에 외곽선(Outline) — 어두운/영상 배경 위 가독성(§7.3-A)"
                                      AutomationProperties.Name="외곽선 효과 토글" />
                    </StackPanel>

                    <!-- 제목 헤딩 정렬(§7.3-A Heading Align) — 헤딩 표시 시 곡 제목을 좌/중/우로. -->
                    <TextBlock Text="제목 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="제목 왼쪽 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="제목 가운데 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="제목 오른쪽 정렬" />
                    </StackPanel>
                    <!-- 제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A Heading At First Screen Only). -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFirstScreenOnly, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFirstScreenOnlyCommand}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="첫 절만"
                                  ToolTip="제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A)"
                                  AutomationProperties.Name="제목 헤딩 첫 화면만 토글" />
                    <!-- 헤딩이 본문(Region1) 정렬을 따름(FrmMain Def_HeadAlign AsR1) — on 이면 위 제목 정렬(좌/중/우) 무시. -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFollowBody, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFollowBodyCommand}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="본문 정렬 따름"
                                  ToolTip="제목 헤딩이 본문(Region1) 가로 정렬을 그대로 따름(FrmMain AsR1). 켜면 위 좌/중/우 설정은 무시"
                                  AutomationProperties.Name="제목 헤딩 본문 정렬 따름 토글" />
                    <!-- 헤딩이 보조 영역(Region2) 정렬을 따름(FrmMain Def_HeadAlign AsR2) — 이중 언어 곡에서 번역 영역 정렬 추종. AsR1 보다 우선. -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFollowRegion2, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFollowRegion2Command}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="보조영역 정렬 따름"
                                  ToolTip="제목 헤딩이 보조 영역(Region2) 가로 정렬을 따름(FrmMain AsR2). 이중 언어 곡용. 켜면 본문 정렬 따름·좌/중/우 설정보다 우선"
                                  AutomationProperties.Name="제목 헤딩 보조영역 정렬 따름 토글" />

                    <!-- 출력 모양 설정 템플릿(§7.3-A) — 현재 모양을 이름으로 저장, 콤보에서 골라 적용/삭제. -->
                    <TextBlock Text="모양 템플릿"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewAppearanceTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="30"
                                 ToolTip="새 템플릿 이름"
                                 AutomationProperties.Name="새 모양 템플릿 이름" />
                        <Button Grid.Column="1"
                                Command="{Binding SaveAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="저장"
                                AutomationProperties.Name="모양 템플릿 저장" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AppearanceTemplateNames}"
                                  SelectedItem="{Binding SelectedAppearanceTemplate, Mode=TwoWay}"
                                  MinHeight="30"
                                  ToolTip="저장된 템플릿"
                                  AutomationProperties.Name="저장된 모양 템플릿" />
                        <Button Grid.Column="1"
                                Command="{Binding ApplyAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="모양 템플릿 적용" />
                        <Button Grid.Column="2"
                                Command="{Binding DeleteAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="삭제"
                                AutomationProperties.Name="모양 템플릿 삭제" />
                    </Grid>
                    <!-- 출력 모양 기본값 복원(FrmMain Default Layout) — 색·정렬·폰트·효과·여백·패널·그라데이션 등 전체를 기본값으로. -->
                    <Button Command="{Binding ResetOutputAppearanceCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            HorizontalAlignment="Left"
                            MinHeight="32"
                            Padding="12,0"
                            Margin="0,8,0,0"
                            Content="기본값으로 복원"
                            ToolTip="출력 모양(색·정렬·폰트·효과·여백·패널·그라데이션 등) 전체를 기본값으로 되돌립니다(레거시 Default Layout)."
                            AutomationProperties.Name="출력 모양 기본값 복원" />
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </DockPanel>

        <!-- 명령 팔레트 오버레이(§7.4) — CommandPalette.IsOpen 일 때만 표시. 반투명 배경 + 중앙 검색 패널.
             키 처리(↑↓/Enter/Esc·열림 시 포커스)는 코드비하인드(MainWindow.xaml.cs)가 담당한다. -->
        <Border x:Name="CommandPaletteOverlay"
                Background="#99000000"
                Visibility="{Binding CommandPalette.IsOpen, Converter={StaticResource BoolToVis}}"
                MouseDown="CommandPaletteOverlay_MouseDown"
                Panel.ZIndex="100">
            <Border Width="560"
                    MaxHeight="420"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <DockPanel>
                    <TextBox x:Name="CommandPaletteSearchBox"
                             DockPanel.Dock="Top"
                             Text="{Binding CommandPalette.Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown"
                             FontSize="16"
                             Padding="8,6"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="명령 검색" />
                    <!-- 검색 결과 없음 안내 — 검색어와 일치하는 명령이 없을 때만 보인다(현대 팔레트 UX). -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="일치하는 명령이 없습니다."
                               Style="{StaticResource Type.Body.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding CommandPalette.HasNoResults, Converter={StaticResource BoolToVis}}" />
                    <ListBox ItemsSource="{Binding CommandPalette.Results}"
                             SelectedItem="{Binding CommandPalette.SelectedCommand, Mode=TwoWay}"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             MaxHeight="320"
                             BorderThickness="0"
                             AutomationProperties.Name="명령 결과 목록">
                        <!-- 항목 레벨 접근성 이름 — 스크린리더가 "명령명, [위험,] 분류"를 한 호흡에 읽게 한다.
                             BasedOn 으로 wpfui 의 기본 ListBoxItem 테마(선택·호버 비주얼)를 보존한 채 이름만 덧입힌다. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding AccessibleName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 좌: 명령 이름/분류, 우: 위험 배지(라이브 송출에 영향 주는 주의 명령). -->
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Category}"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>

                                    <!-- 우측: [단축키 힌트][위험 배지] — 단축키와 위험 표시를 한 줄에 묶는다. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 단축키 힌트(VS Code 식) — 명령 옆에 기본 단축키를 흐리게 보여 발견가능성을 높인다.
                                             단축키 없으면 빈 문자열이라 자동으로 안 보인다. 음성은 항목 AccessibleName 이 전달하므로 여기엔 자동화 이름 없음. -->
                                        <TextBlock Text="{Binding ShortcutHint}"
                                                   FontFamily="{DynamicResource Font.Primary}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <!-- 위험 명령(라이브 중지·검은 화면·출력 닫기·화면 비우기·출력 숨김·Go Live)만 빨간 "위험" 배지.
                                             한 사람이 라이브 운영 중 실수로 송출을 끊는 일을 줄이려 눈에 띄게 한다(§7.4 후속). -->
                                        <!-- 배지는 순수 시각 표시. 위험 정보는 항목(ListBoxItem)의 AutomationProperties.Name
                                             (AccessibleName)이 전달하므로, 배지에는 명시적 AutomationProperties.Name 을 두지 않아
                                             항목을 읽을 때 "위험 명령"이 중복 발화되지 않게 한다(WPF 엔 AccessibilityView=Raw 가 없음). -->
                                        <Border Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource Brush.Status.Danger}"
                                                CornerRadius="{StaticResource CornerRadius.Small}"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="라이브 출력에 영향을 주는 주의 명령">
                                            <!-- Foreground 는 흰색 리터럴 — 배지 배경이 양 테마 모두 진한 빨강이라
                                                 테마 토큰(Inverse: 다크에서 검정)보다 흰색이 대비에 안전. -->
                                            <TextBlock Text="위험"
                                                       FontFamily="{DynamicResource Font.Primary}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
