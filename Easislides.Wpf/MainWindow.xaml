<Window x:Class="Easislides.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        xmlns:rendering="clr-namespace:Easislides.Wpf.Rendering"
        xmlns:settings="clr-namespace:Easislides.Wpf.Settings"
        xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides v3.0 - WPF 운영 셸"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 전역 단축키: Ctrl+K 로 명령 팔레트 열기(§7.4 — FrmMain 136개 메뉴를 검색 가능한 단일 진입점으로 흡수). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPalette.OpenCommand}" />
    </Window.InputBindings>

    <!-- 루트를 Grid 로 감싸 명령 팔레트 오버레이를 전체 위에 띄운다(평소엔 숨김). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <composites:LiveBar DockPanel.Dock="Top"
                            DataContext="{Binding LiveBar}" />

        <Border DockPanel.Dock="Bottom"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Card}"
                Padding="{StaticResource Thickness.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowNew24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 열기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 닫기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoLiveCommand}"
                            Style="{StaticResource EsButton.Primary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="VideoClip24" Margin="0,0,6,0" />
                            <TextBlock Text="LIVE" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BlackScreenCommand}"
                            Style="{StaticResource EsButton.Danger}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,6,0" />
                            <TextBlock Text="Black" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding HideOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="가사/콘텐츠 숨김(배경 유지)"
                            AutomationProperties.Name="출력 숨김"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,6,0" />
                            <TextBlock Text="숨김" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="가사/콘텐츠를 비우고 배경만 송출(검은 화면과 구별)"
                            AutomationProperties.Name="화면 비우기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                            <TextBlock Text="비우기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RestoreOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="숨김/검은 화면/비우기에서 직전 송출로 복귀"
                            AutomationProperties.Name="출력 복귀"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eye24" Margin="0,0,6,0" />
                            <TextBlock Text="복귀" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RestartCurrentItemCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="현재 라이브 항목을 처음(첫 절/첫 슬라이드)으로 되돌려 재송출"
                            AutomationProperties.Name="현재 항목 처음으로"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" Margin="0,0,6,0" />
                            <TextBlock Text="처음으로" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="출력 화면을 다시 그린다(디스플레이 글리치 복구)"
                            AutomationProperties.Name="출력 새로고침"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                            <TextBlock Text="새로고침" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsAutoRotating, Mode=OneWay}"
                                  Command="{Binding ToggleAutoRotateCommand}"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,0,8,0"
                                  ToolTip="라이브 중 절/슬라이드를 일정 간격으로 자동 전환(§7.3-B)"
                                  AutomationProperties.Name="자동 회전 토글">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Margin="0,0,6,0" />
                            <TextBlock Text="자동회전" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- 우측 인스펙터 접기/펼치기(§7.4 가변 패널) — 접으면 중앙 미리보기가 넓어진다. -->
                    <ToggleButton IsChecked="{Binding IsInspectorExpanded, Mode=TwoWay}"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,0,8,0"
                                  Content="인스펙터"
                                  ToolTip="우측 출력 모양 인스펙터 접기/펼치기"
                                  AutomationProperties.Name="인스펙터 접기 토글" />
                    <!-- 라이브러리·성경·외부파일·I/O·도움말·등록·정보 런처는 ⌘K 명령 팔레트로 흡수(§7.4 적극 정리).
                         바에는 자주 쓰는 파일·순서·검색·설정만 남긴다. 핸들러는 BindWindowLaunchers 가 참조. -->
                    <!-- 명령 팔레트 진입(발견가능성) — 마우스 운영자도 ⌘K 없이 클릭으로 모든 명령/창을 검색·실행. -->
                    <Button Command="{Binding CommandPalette.OpenCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="모든 명령·창 검색 (Ctrl+K)"
                            AutomationProperties.Name="명령 팔레트 열기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="명령 ⌘K" />
                        </StackPanel>
                    </Button>
                    <Button Click="AddExternalFile_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="PowerPoint/미디어 파일을 예배 순서에 추가"
                            AutomationProperties.Name="파일 추가"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                            <TextBlock Text="파일" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenManageWorshipLists_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="예배 순서 저장/불러오기"
                            AutomationProperties.Name="예배 순서 관리"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                            <TextBlock Text="순서" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSearchUsage_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="Search and usage"
                            AutomationProperties.Name="Search and usage"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSettings_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="설정 열기"
                            AutomationProperties.Name="설정 열기">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
                            <TextBlock Text="설정" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="{StaticResource Thickness.Xl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <!-- 우측 인스펙터 컬럼: Auto — 인스펙터를 접으면(Visibility=Collapsed) 0 으로 줄어 중앙이 넓어진다(§7.4 가변 패널). -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 상단 콘텐츠 브라우저(라이브러리/성경 탭) + 하단 예배 순서(항상 표시) — FrmMain식 멀티페인.
                 곡·성경을 찾으면서 예배 순서를 동시에 보도록 탭 전환을 없앤다(§7.4 단일 콘솔 통합).
                 GridSplitter 로 두 패널 높이를 운영자가 조절. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            x:Name="LeftBrowserTabs"
                            SelectionChanged="LeftBrowserTabs_SelectionChanged"
                            BorderThickness="0"
                            Background="Transparent">
                    <TabItem Header="라이브러리"
                             Tag="Library">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button Command="{Binding Library.LoadCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Margin="0,0,8,0"
                                    Content="불러오기"
                                    AutomationProperties.Name="라이브러리 불러오기" />
                            <Button Command="{Binding AddSelectedLibrarySongCommand}"
                                    Style="{StaticResource EsButton.Primary}"
                                    Content="예배 순서에 추가"
                                    AutomationProperties.Name="선택 곡을 예배 순서에 추가" />
                        </StackPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Library.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 Margin="0,0,0,8"
                                 ToolTip="제목·가사·분류 검색"
                                 AutomationProperties.Name="곡 검색" />

                        <ComboBox Grid.Row="2"
                                  ItemsSource="{Binding Library.Folders}"
                                  SelectedItem="{Binding Library.SelectedFolder, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  MinHeight="34"
                                  Margin="0,0,0,8"
                                  AutomationProperties.Name="폴더 선택" />

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding Library.Songs}"
                                 SelectedItem="{Binding Library.SelectedSong, Mode=TwoWay}"
                                 DisplayMemberPath="Title"
                                 AutomationProperties.Name="곡 목록">
                            <ListBox.InputBindings>
                                <!-- 더블클릭으로 예배 순서에 추가(선택 후 추가). -->
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding AddSelectedLibrarySongCommand}" />
                            </ListBox.InputBindings>
                        </ListBox>

                        <TextBlock Grid.Row="4"
                                   Text="{Binding Library.StatusMessage}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <TabItem Header="성경"
                         Tag="Bible">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 버전·책 선택 + 검색 — BibleWindow 와 동일 재사용 컴포지트(DataContext=Bible 로 국한). -->
                        <composites:BibleVerseFinder Grid.Row="0"
                                                     DataContext="{Binding Bible}" />

                        <!-- 본문 — 구절 범위를 드래그 선택한 뒤 아래 "선택 구절 추가". -->
                        <TextBox Grid.Row="1"
                                 x:Name="BiblePassageBox"
                                 Text="{Binding Bible.PassageText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,8,0,0"
                                 AutomationProperties.Name="성경 본문" />

                        <Button Grid.Row="2"
                                Click="AddBibleVerse_Click"
                                Style="{StaticResource EsButton.Primary}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Content="선택 구절 추가"
                                AutomationProperties.Name="선택한 성경 구절을 예배 순서에 추가" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding Bible.SelectedPassageTitle}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Row="4"
                                   Text="{Binding Bible.StatusMessage}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="Transparent"
                              AutomationProperties.Name="브라우저/예배 순서 높이 조절" />

                <!-- 예배 순서 — 항상 보이는 하단 패널(FrmMain 좌측 하단 송출 큐). 재사용 컴포지트(§5.2, DataContext 상속). -->
                <composites:WorshipListPanel Grid.Row="2" />
            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Xl}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="현재 항목"
                                   Style="{StaticResource Type.Title2.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding SelectedItem.Title}"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,20,0,20"
                            Background="{DynamicResource Brush.Surface.Page}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Small}">
                        <!-- 중앙 미리보기 — 선택 항목 종류에 맞춰 SelectedIndex 가 자동 전환(곡=Preview/PPT=PowerPoint/미디어=Media).
                             운영자가 탭을 수동으로 누르지 않아도 알맞은 미리보기가 보인다(FrmMain식 멀티페인 §7.4). -->
                        <TabControl BorderThickness="0"
                                    Background="Transparent"
                                    SelectedIndex="{Binding SelectedContentTabIndex, Mode=TwoWay}">
                            <TabItem Header="Preview">
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <rendering:SlidePreviewControl Grid.Row="0"
                                                                   Title="{Binding SelectedItem.Title}"
                                                                   Kind="{Binding SelectedItem.Kind}"
                                                                   Source="{Binding SelectedItem.PreviewSource}"
                                                                   FillMode="{Binding SelectedItem.PreviewFillMode}"
                                                                   SlideNumber="{Binding SelectedItem.SlideNumber}"
                                                                   ShowSlideNumber="True"
                                                                   IsSelected="True" />

                                    <!-- 선택 곡의 실제 가사 표시(라이브 큐 콘텐츠 plumbing — LiveQueueItem.Lyrics). 가사 없으면 비어 표시. -->
                                    <ScrollViewer Grid.Row="1"
                                                  MaxHeight="140"
                                                  Margin="0,12,0,0"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding SelectedItem.Lyrics}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   AutomationProperties.Name="선택 곡 가사" />
                                    </ScrollViewer>

                                    <!-- 절 단위 페이지네이션 — 이전 절 / 현재 페이지 표시 / 다음 절 (PR B).
                                         곡 항목이고 절이 2개 이상일 때만 유효(LyricsPageCount>1). -->
                                    <StackPanel x:Name="LyricsPagePanel"
                                                Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0">
                                        <Button Command="{Binding PreviousLyricsPageCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="◀ 이전 절"
                                                AutomationProperties.Name="이전 절" />
                                        <TextBlock Text="{Binding LyricsPageLabel}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="40"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <Button Command="{Binding NextLyricsPageCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="8,0,0,0"
                                                Content="다음 절 ▶"
                                                AutomationProperties.Name="다음 절" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="PowerPoint"
                                     Visibility="{Binding IsPowerPointTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- PPT 미리보기 — PowerPointPreviewViewModel(PowerPoint) 바인딩(G1 / gap-analysis.md §4 G-α).
                                     렌더된 슬라이드 이미지를 표시(미적재 시 상태·덱 정보). placeholder "Decks: N" 대체. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0"
                                           Source="{Binding PowerPoint.PreviewImage}"
                                           Stretch="Uniform"
                                           AutomationProperties.Name="PowerPoint 슬라이드 미리보기" />

                                    <!-- 덱 전체 슬라이드 썸네일 스트립 — 클릭으로 해당 슬라이드 이동(라이브 중이면 출력도 갱신). -->
                                    <ScrollViewer Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding PowerPoint.Thumbnails}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.GoToSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding SlideNumber}"
                                                            Margin="2,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding SlideNumber, StringFormat=슬라이드 {0}}"
                                                            AutomationProperties.Name="{Binding SlideNumber, StringFormat=슬라이드 {0}}">
                                                        <Border BorderThickness="2"
                                                                CornerRadius="{StaticResource CornerRadius.Small}"
                                                                Padding="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="{Binding Image}"
                                                                   Width="120"
                                                                   Height="68"
                                                                   Stretch="Uniform" />
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center">
                                        <!-- 슬라이드 이동 — 라이브 송출 중이면 출력도 즉시 갱신(G1.2 라이브 슬라이드 이동). -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">
                                            <Button Command="{Binding PreviousSlideCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Margin="0,0,8,0"
                                                    Content="◀ 이전"
                                                    AutomationProperties.Name="이전 슬라이드" />
                                            <Button Command="{Binding NextSlideCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Content="다음 ▶"
                                                    AutomationProperties.Name="다음 슬라이드" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PowerPoint.StatusText}"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding PowerPointFileCount, StringFormat={}덱: {0}}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Media"
                                     Visibility="{Binding IsMediaTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- 미디어 재생 컨트롤 — MediaPlaybackViewModel(Media) 바인딩(G1.2 / gap-analysis.md §4 G-α).
                                     placeholder 텍스트를 실제 컨트롤 표면으로 대체. 백엔드 NoOp 상태에선 상태·컨트롤이 비활성으로 표시. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Media.StatusText}"
                                                   Style="{StaticResource Type.Title3.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Media.Source}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Type.BodyLarge.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Run Text="{Binding Media.PositionText, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Media.DurationText, Mode=OneWay}" />
                                    </TextBlock>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Button Command="{Binding Media.FastReverseCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="◀◀"
                                                AutomationProperties.Name="되감기" />
                                        <Button Command="{Binding Media.PlayPauseCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Margin="0,0,8,0"
                                                Content="{Binding Media.PlayPauseLabel}"
                                                AutomationProperties.Name="재생/일시정지" />
                                        <Button Command="{Binding Media.StopCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="■"
                                                AutomationProperties.Name="정지" />
                                        <Button Command="{Binding Media.FastForwardCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="▶▶"
                                                AutomationProperties.Name="빨리감기" />
                                        <ToggleButton IsChecked="{Binding Media.IsMuted, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleMuteCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Margin="0,0,8,0"
                                                      Content="음소거"
                                                      AutomationProperties.Name="음소거 토글" />
                                        <ToggleButton IsChecked="{Binding Media.IsRepeatEnabled, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleRepeatCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Content="반복"
                                                      AutomationProperties.Name="반복 토글" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="미디어 폴더"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding MediaDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding LiveCameraSource}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding PreviousItemCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,8,0"
                                Content="이전" />
                        <Button Command="{Binding NextItemCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Content="다음" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Width="340"
                    Visibility="{Binding IsInspectorExpanded, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <StackPanel>
                    <TextBlock Text="운영 상태"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="출력"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding OutputDisplays}"
                              SelectedItem="{Binding SelectedOutputDisplay, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="출력 모니터 선택"
                              MinHeight="36"
                              Margin="0,4,0,16" />

                    <TextBlock Text="송출"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding LiveBar.State}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,2,0,16" />

                    <TextBlock Text="선택"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding SelectedItem.Kind}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <!-- 인-셸 출력 모양 인스펙터(§7.5 P0) — 별도 Settings 모달 없이 글자색·배경을 즉시 적용,
                         설정→출력 VM 경로로 라이브 반영. 세분 색 편집은 후속. -->
                    <TextBlock Text="출력 모양"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ItemsControl ItemsSource="{Binding OutputAppearancePresets}"
                                  Margin="0,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ApplyOutputAppearanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,4"
                                        Padding="6"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 미리보기 스와치: 배경 위에 글자색 'Aa' -->
                                        <Border Width="34"
                                                Height="22"
                                                CornerRadius="3"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="Aa"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding TextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ActiveAppearanceName, StringFormat=현재: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <!-- 세분 색 직접 지정(§7.3-A) — 프리셋 너머 임의 hex 색. Enter 또는 적용 버튼으로 반영. -->
                    <TextBlock Text="색 직접 지정 (#RRGGBB)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="글자"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="TextColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveTextColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="글자색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyTextColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=TextColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyTextColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=TextColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="글자색 적용" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="배경"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="BackgroundColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveBackgroundColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="배경색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyBackgroundColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyBackgroundColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="배경색 적용" />
                    </Grid>

                    <!-- 인-셸 가사 정렬(§7.3-A) — 모달 없이 좌/중/우 즉시 적용, 라이브 출력에 반영. -->
                    <TextBlock Text="가사 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="가사 왼쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="가사 오른쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsAlignmentLabel, StringFormat=현재 정렬: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 세로 정렬(§7.3-A) — 위/가운데/아래. -->
                    <TextBlock Text="가사 세로 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="위"
                                AutomationProperties.Name="가사 위쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 세로 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="아래"
                                AutomationProperties.Name="가사 아래쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsVerticalAlignmentLabel, StringFormat=현재 세로: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 폰트 크기(§7.3-A) — 작게(-)/크게(+) 단계 조절. -->
                    <TextBlock Text="가사 크기"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="A−"
                                ToolTip="가사 글자 작게"
                                AutomationProperties.Name="가사 글자 작게" />
                        <Button Command="{Binding IncreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="A+"
                                ToolTip="가사 글자 크게"
                                AutomationProperties.Name="가사 글자 크게" />
                        <TextBlock Text="{Binding ActiveLyricsFontSize, StringFormat={}{0}px}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 인-셸 가사 줄 간격(§7.3-A) — 폰트 대비 % 로 −/+ 조절. -->
                    <TextBlock Text="줄 간격"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="−"
                                ToolTip="줄 간격 좁게"
                                AutomationProperties.Name="줄 간격 좁게" />
                        <Button Command="{Binding IncreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="＋"
                                ToolTip="줄 간격 넓게"
                                AutomationProperties.Name="줄 간격 넓게" />
                        <TextBlock Text="{Binding ActiveLyricsLineSpacing, StringFormat={}{0}%}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 인-셸 가사 폰트 효과(§7.3-A) — 굵게/기울임/그림자 토글. 그림자는 어두운/영상 배경 가독성. -->
                    <TextBlock Text="가사 효과"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <ToggleButton IsChecked="{Binding ActiveLyricsBold, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsBoldCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontWeight="Bold"
                                      Content="가"
                                      ToolTip="가사 굵게"
                                      AutomationProperties.Name="가사 굵게 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsItalic, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsItalicCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontStyle="Italic"
                                      Content="가"
                                      ToolTip="가사 기울임"
                                      AutomationProperties.Name="가사 기울임 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsShadow, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsShadowCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="그림자"
                                      ToolTip="가사 그림자(어두운 배경 가독성)"
                                      AutomationProperties.Name="가사 그림자 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsPositionIndicator, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsPositionIndicatorCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="N/M"
                                      ToolTip="절/슬라이드 위치 인디케이터 표시(출력 우하단)"
                                      AutomationProperties.Name="위치 인디케이터 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsTitleHeading, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsTitleHeadingCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="제목"
                                      ToolTip="곡 제목을 가사 위 상단 배너로 표시(§7.3-A)"
                                      AutomationProperties.Name="제목 헤딩 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsOutline, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsOutlineCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Content="외곽선"
                                      ToolTip="가사 글자에 외곽선(Outline) — 어두운/영상 배경 위 가독성(§7.3-A)"
                                      AutomationProperties.Name="외곽선 효과 토글" />
                    </StackPanel>

                    <!-- 제목 헤딩 정렬(§7.3-A Heading Align) — 헤딩 표시 시 곡 제목을 좌/중/우로. -->
                    <TextBlock Text="제목 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="제목 왼쪽 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="제목 가운데 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="제목 오른쪽 정렬" />
                    </StackPanel>
                    <!-- 제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A Heading At First Screen Only). -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFirstScreenOnly, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFirstScreenOnlyCommand}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="첫 절만"
                                  ToolTip="제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A)"
                                  AutomationProperties.Name="제목 헤딩 첫 화면만 토글" />

                    <!-- 출력 모양 설정 템플릿(§7.3-A) — 현재 모양을 이름으로 저장, 콤보에서 골라 적용/삭제. -->
                    <TextBlock Text="모양 템플릿"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewAppearanceTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="30"
                                 ToolTip="새 템플릿 이름"
                                 AutomationProperties.Name="새 모양 템플릿 이름" />
                        <Button Grid.Column="1"
                                Command="{Binding SaveAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="저장"
                                AutomationProperties.Name="모양 템플릿 저장" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AppearanceTemplateNames}"
                                  SelectedItem="{Binding SelectedAppearanceTemplate, Mode=TwoWay}"
                                  MinHeight="30"
                                  ToolTip="저장된 템플릿"
                                  AutomationProperties.Name="저장된 모양 템플릿" />
                        <Button Grid.Column="1"
                                Command="{Binding ApplyAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="모양 템플릿 적용" />
                        <Button Grid.Column="2"
                                Command="{Binding DeleteAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="삭제"
                                AutomationProperties.Name="모양 템플릿 삭제" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

        <!-- 명령 팔레트 오버레이(§7.4) — CommandPalette.IsOpen 일 때만 표시. 반투명 배경 + 중앙 검색 패널.
             키 처리(↑↓/Enter/Esc·열림 시 포커스)는 코드비하인드(MainWindow.xaml.cs)가 담당한다. -->
        <Border x:Name="CommandPaletteOverlay"
                Background="#99000000"
                Visibility="{Binding CommandPalette.IsOpen, Converter={StaticResource BoolToVis}}"
                MouseDown="CommandPaletteOverlay_MouseDown"
                Panel.ZIndex="100">
            <Border Width="560"
                    MaxHeight="420"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <DockPanel>
                    <TextBox x:Name="CommandPaletteSearchBox"
                             DockPanel.Dock="Top"
                             Text="{Binding CommandPalette.Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown"
                             FontSize="16"
                             Padding="8,6"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="명령 검색" />
                    <ListBox ItemsSource="{Binding CommandPalette.Results}"
                             SelectedItem="{Binding CommandPalette.SelectedCommand, Mode=TwoWay}"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             MaxHeight="320"
                             BorderThickness="0"
                             AutomationProperties.Name="명령 결과 목록">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Category}"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
