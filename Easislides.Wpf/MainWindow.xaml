<Window x:Class="Easislides.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        xmlns:rendering="clr-namespace:Easislides.Wpf.Rendering"
        xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides v3.0 - WPF 운영 셸"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <composites:LiveBar DockPanel.Dock="Top"
                            DataContext="{Binding LiveBar}" />

        <Border DockPanel.Dock="Bottom"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Card}"
                Padding="{StaticResource Thickness.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowNew24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 열기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 닫기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoLiveCommand}"
                            Style="{StaticResource EsButton.Primary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="VideoClip24" Margin="0,0,6,0" />
                            <TextBlock Text="LIVE" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BlackScreenCommand}"
                            Style="{StaticResource EsButton.Danger}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,6,0" />
                            <TextBlock Text="Black" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenLibrary_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="라이브러리 열기"
                            AutomationProperties.Name="라이브러리 열기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                            <TextBlock Text="라이브러리" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenManageWorshipLists_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="예배 순서 저장/불러오기"
                            AutomationProperties.Name="예배 순서 관리"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                            <TextBlock Text="순서" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenExternalFiles_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="외부 파일 복사/이동"
                            AutomationProperties.Name="외부 파일 복사/이동"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                            <TextBlock Text="외부 파일" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenImportExport_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="Import/Export"
                            AutomationProperties.Name="Import/Export"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ExportRtf}" Margin="0,0,6,0" />
                            <TextBlock Text="I/O" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSearchUsage_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="Search and usage"
                            AutomationProperties.Name="Search and usage"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenBible_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="성경 열기"
                            AutomationProperties.Name="성경 열기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Bible}" Margin="0,0,6,0" />
                            <TextBlock Text="성경" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenHelp_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="도움말 열기"
                            AutomationProperties.Name="도움말 열기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="QuestionCircle24" Margin="0,0,6,0" />
                            <TextBlock Text="도움말" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenRegistration_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="등록 페이지 안내"
                            AutomationProperties.Name="등록 페이지 안내"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                            <TextBlock Text="등록" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenAbout_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="EasiSlides 정보"
                            AutomationProperties.Name="EasiSlides 정보"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                            <TextBlock Text="정보" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSettings_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="설정 열기"
                            AutomationProperties.Name="설정 열기">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
                            <TextBlock Text="설정" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="{StaticResource Thickness.Xl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 예배 순서 목록 — 재사용 컴포지트로 분리(§5.2). DataContext(MainViewModel) 상속. -->
            <composites:WorshipListPanel Grid.Column="0" />

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Xl}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="현재 항목"
                                   Style="{StaticResource Type.Title2.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding SelectedItem.Title}"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,20,0,20"
                            Background="{DynamicResource Brush.Surface.Page}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Small}">
                        <TabControl BorderThickness="0"
                                    Background="Transparent">
                            <TabItem Header="Preview">
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <rendering:SlidePreviewControl Grid.Row="0"
                                                                   Title="{Binding SelectedItem.Title}"
                                                                   Kind="{Binding SelectedItem.Kind}"
                                                                   Source="{Binding SelectedItem.PreviewSource}"
                                                                   FillMode="{Binding SelectedItem.PreviewFillMode}"
                                                                   SlideNumber="{Binding SelectedItem.SlideNumber}"
                                                                   ShowSlideNumber="True"
                                                                   IsSelected="True" />

                                    <!-- 선택 곡의 실제 가사 표시(라이브 큐 콘텐츠 plumbing — LiveQueueItem.Lyrics). 가사 없으면 비어 표시. -->
                                    <ScrollViewer Grid.Row="1"
                                                  MaxHeight="180"
                                                  Margin="0,12,0,0"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding SelectedItem.Lyrics}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   AutomationProperties.Name="선택 곡 가사" />
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem Header="PowerPoint"
                                     Visibility="{Binding IsPowerPointTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- PPT 미리보기 — PowerPointPreviewViewModel(PowerPoint) 바인딩(G1 / gap-analysis.md §4 G-α).
                                     렌더된 슬라이드 이미지를 표시(미적재 시 상태·덱 정보). placeholder "Decks: N" 대체. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0"
                                           Source="{Binding PowerPoint.PreviewImage}"
                                           Stretch="Uniform"
                                           AutomationProperties.Name="PowerPoint 슬라이드 미리보기" />

                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PowerPoint.StatusText}"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding PowerPointFileCount, StringFormat={}덱: {0}}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Media"
                                     Visibility="{Binding IsMediaTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- 미디어 재생 컨트롤 — MediaPlaybackViewModel(Media) 바인딩(G1.2 / gap-analysis.md §4 G-α).
                                     placeholder 텍스트를 실제 컨트롤 표면으로 대체. 백엔드 NoOp 상태에선 상태·컨트롤이 비활성으로 표시. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Media.StatusText}"
                                                   Style="{StaticResource Type.Title3.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Media.Source}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Type.BodyLarge.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Run Text="{Binding Media.PositionText, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Media.DurationText, Mode=OneWay}" />
                                    </TextBlock>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Button Command="{Binding Media.FastReverseCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="◀◀"
                                                AutomationProperties.Name="되감기" />
                                        <Button Command="{Binding Media.PlayPauseCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Margin="0,0,8,0"
                                                Content="{Binding Media.PlayPauseLabel}"
                                                AutomationProperties.Name="재생/일시정지" />
                                        <Button Command="{Binding Media.StopCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="■"
                                                AutomationProperties.Name="정지" />
                                        <Button Command="{Binding Media.FastForwardCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="▶▶"
                                                AutomationProperties.Name="빨리감기" />
                                        <ToggleButton IsChecked="{Binding Media.IsMuted, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleMuteCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Margin="0,0,8,0"
                                                      Content="음소거"
                                                      AutomationProperties.Name="음소거 토글" />
                                        <ToggleButton IsChecked="{Binding Media.IsRepeatEnabled, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleRepeatCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Content="반복"
                                                      AutomationProperties.Name="반복 토글" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="미디어 폴더"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding MediaDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding LiveCameraSource}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding PreviousItemCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,8,0"
                                Content="이전" />
                        <Button Command="{Binding NextItemCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Content="다음" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <StackPanel>
                    <TextBlock Text="운영 상태"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="출력"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding OutputDisplays}"
                              SelectedItem="{Binding SelectedOutputDisplay, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="출력 모니터 선택"
                              MinHeight="36"
                              Margin="0,4,0,16" />

                    <TextBlock Text="송출"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding LiveBar.State}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,2,0,16" />

                    <TextBlock Text="선택"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding SelectedItem.Kind}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
