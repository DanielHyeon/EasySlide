<Window x:Class="Easislides.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        xmlns:converters="clr-namespace:Easislides.Wpf.Converters"
        xmlns:rendering="clr-namespace:Easislides.Wpf.Rendering"
        xmlns:settings="clr-namespace:Easislides.Wpf.Settings"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides v3.0 - WPF 운영 셸"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:SongRowDisplayConverter x:Key="SongRowDisplay" />
    </Window.Resources>

    <!-- 전역 단축키: Ctrl+K 로 명령 팔레트 열기(§7.4 — FrmMain 136개 메뉴를 검색 가능한 단일 진입점으로 흡수). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPalette.OpenCommand}" />
    </Window.InputBindings>

    <!-- 루트를 Grid 로 감싸 명령 팔레트 오버레이를 전체 위에 띄운다(평소엔 숨김). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <!-- FrmMain 메뉴바(File/Edit/View/Output/Tools/Help) 현대적 포팅(EsIcons + wpfui 테마).
             모든 항목은 실제 MainViewModel 명령 또는 DI 창 런처(Click)에 배선 — dead UI 없음.
             출력 항목은 명령 CanExecute 로 라이브 상태에 따라 자동 활성/비활성. -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource Brush.Surface.Card}"
              Padding="4,2"
              AutomationProperties.Name="주 메뉴">
            <MenuItem Header="파일">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                <MenuItem Header="예배 순서에 파일 추가" Click="AddExternalFile_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionNewItem}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PowerPoint 폴더 찾아보기..." Click="OpenPowerPointLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="미디어 폴더 찾아보기..." Click="OpenMediaLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="라이브러리 열기" Click="OpenLibrary_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Contents}" /></MenuItem.Icon>
                </MenuItem>
                <!-- 최근 예배 순서(레거시 Recent Edits) — 최신순 이름을 클릭하면 즉시 다시 불러온다. 비어 있으면 비활성. -->
                <MenuItem Header="최근 예배 순서"
                          ItemsSource="{Binding RecentWorshipLists}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.WorshipList}" /></MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentWorshipListCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="종료" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="편집">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionEdit}" /></MenuItem.Icon>
                <MenuItem Header="곡 복사" Click="SongCopy_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionCopy}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 이동" Click="SongMove_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionMove}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 삭제" Click="SongDelete_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionDelete}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="삭제 항목 복구" Click="SongRecover_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="스마트 병합" Click="SongMerge_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="폴더 정리" Click="FolderEditor_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="곡 검색·사용처" Click="OpenSearchUsage_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="보기">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.MonitorSingle}" /></MenuItem.Icon>
                <MenuItem Header="설정" Click="OpenSettings_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Settings}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="출력 새로고침" Command="{Binding RefreshOutputCommand}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="EasiSlides 폴더 열기" Click="OpenEasiSlidesFolder_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 곡 번호 표시(FrmMain Edit 메뉴 Use Song Numbering) — 라이브러리 곡 목록에 "번호. 제목" 표시. 설정에 저장됨. -->
                <MenuItem Header="곡 번호 표시"
                          IsCheckable="True"
                          IsChecked="{Binding Library.UseSongNumbering, Mode=TwoWay}" />
            </MenuItem>

            <MenuItem Header="출력">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveToggle}" /></MenuItem.Icon>
                <MenuItem Header="Go LIVE" Command="{Binding GoLiveCommand}" InputGestureText="F12">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveToggle}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="송출 후 다음 항목" Command="{Binding SendToOutputAndNextCommand}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="라이브 중지" Command="{Binding StopLiveCommand}">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.NoRotate}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="처음 항목" Command="{Binding FirstItemCommand}" />
                <MenuItem Header="다음 항목" Command="{Binding NextItemCommand}" InputGestureText="Space">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveSendToOutput}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="이전 항목" Command="{Binding PreviousItemCommand}" InputGestureText="Shift+Space" />
                <MenuItem Header="마지막 항목" Command="{Binding LastItemCommand}" />
                <Separator />
                <MenuItem Header="검은 화면" Command="{Binding BlackScreenCommand}" InputGestureText="F9">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveBlack}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="화면 비우기" Command="{Binding ClearOutputCommand}" InputGestureText="F3">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionClear}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="출력 숨김" Command="{Binding HideOutputCommand}" InputGestureText="Ctrl+H">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.LiveHide}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="복귀" Command="{Binding RestoreOutputCommand}" />
                <MenuItem Header="현재 항목 처음으로" Command="{Binding RestartCurrentItemCommand}" />
                <Separator />
                <!-- 출력 표시 토글(FrmMain View/Output "Show …" 토글 대응) — 기존 인-셸 설정·명령 재사용.
                     IsChecked 는 현재 상태(Active*)에 단방향 바인딩, 클릭은 토글 명령이 처리(체크 표시 동기화). -->
                <MenuItem Header="위치 인디케이터 (N/M)"
                          IsChecked="{Binding ActiveLyricsPositionIndicator}"
                          Command="{Binding ToggleLyricsPositionIndicatorCommand}" />
                <MenuItem Header="절 헤딩 (1절/후렴)"
                          IsChecked="{Binding ActiveLyricsVerseHeading}"
                          Command="{Binding ToggleLyricsVerseHeadingCommand}" />
                <MenuItem Header="곡 번호 표시"
                          IsChecked="{Binding ActiveLyricsItemNumber}"
                          Command="{Binding ToggleLyricsItemNumberCommand}" />
                <MenuItem Header="정보 패널에 제목 표시"
                          IsChecked="{Binding ActiveLyricsTitleOnPanel}"
                          Command="{Binding ToggleLyricsTitleOnPanelCommand}"
                          ToolTip="현재 곡 제목을 송출 화면 좌측 상단 정보 밴드에 작게 표시(레거시 Def_PanelTitle)." />
                <MenuItem Header="저작권 표시"
                          IsChecked="{Binding ActiveLyricsCopyright}"
                          Command="{Binding ToggleLyricsCopyrightCommand}" />
                <MenuItem Header="다음 항목 표시"
                          IsChecked="{Binding ActiveLyricsNextItem}"
                          Command="{Binding ToggleLyricsNextItemCommand}" />
                <MenuItem Header="정보 패널 투명 배경"
                          IsChecked="{Binding ActiveLyricsPanelTransparent}"
                          Command="{Binding TogglePanelTransparentCommand}"
                          ToolTip="곡번호·저작권·다음항목 밴드의 어두운 배경을 없앱니다(레거시 Transparent)." />
                <!-- 정보 패널 밴드 색(레거시 Def_PanelColour) — 색조만 고르고 반투명은 유지(밴드 뒤 가사 비침). 투명 배경 on 이면 무시됨. -->
                <MenuItem Header="정보 패널 색">
                    <MenuItem Header="검정 (기본)"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#000000" />
                    <MenuItem Header="남색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#102040" />
                    <MenuItem Header="진회색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#303030" />
                    <MenuItem Header="자주"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#3A1030" />
                    <MenuItem Header="진녹색"
                              Command="{Binding ApplyPanelColorHexCommand}"
                              CommandParameter="#103020" />
                </MenuItem>
                <!-- 정보 패널 글자 크기(레거시 Def_PanelFont 크기) — 곡번호·저작권·다음항목·위치 텍스트를 비율로 확대/축소. -->
                <MenuItem Header="정보 패널 글자">
                    <MenuItem Header="{Binding ActivePanelFontScale, StringFormat=현재 크기: {0}%}" IsEnabled="False" />
                    <MenuItem Header="크게 (+)" Command="{Binding IncreasePanelFontScaleCommand}" />
                    <MenuItem Header="작게 (−)" Command="{Binding DecreasePanelFontScaleCommand}" />
                </MenuItem>
                <MenuItem Header="제목 헤딩"
                          IsChecked="{Binding ActiveLyricsTitleHeading}"
                          Command="{Binding ToggleLyricsTitleHeadingCommand}" />
                <MenuItem Header="가사 외곽선"
                          IsChecked="{Binding ActiveLyricsOutline}"
                          Command="{Binding ToggleLyricsOutlineCommand}" />
                <MenuItem Header="가사 그림자"
                          IsChecked="{Binding ActiveLyricsShadow}"
                          Command="{Binding ToggleLyricsShadowCommand}" />
                <MenuItem Header="가사 굵게"
                          IsChecked="{Binding ActiveLyricsBold}"
                          Command="{Binding ToggleLyricsBoldCommand}" />
                <MenuItem Header="가사 기울임"
                          IsChecked="{Binding ActiveLyricsItalic}"
                          Command="{Binding ToggleLyricsItalicCommand}" />
                <MenuItem Header="가사 밑줄"
                          IsChecked="{Binding ActiveLyricsUnderline}"
                          Command="{Binding ToggleLyricsUnderlineCommand}" />
                <MenuItem Header="강조는 후렴만(굵게·기울임·밑줄)"
                          IsChecked="{Binding ActiveLyricsEmphasisChorusOnly}"
                          Command="{Binding ToggleEmphasisChorusOnlyCommand}" />
                <MenuItem Header="이중 언어 줄 교차(원문/번역 번갈아)"
                          IsChecked="{Binding ActiveLyricsInterlace}"
                          Command="{Binding ToggleInterlaceCommand}" />
                <Separator />
                <!-- 전환 효과(FrmMain Transition) — 현재 페이드만 구현. 페이드 on/off + 속도 프리셋. -->
                <MenuItem Header="전환 효과">
                    <MenuItem Header="페이드 사용"
                              IsChecked="{Binding ActiveFadeTransition}"
                              Command="{Binding ToggleFadeTransitionCommand}" />
                    <Separator />
                    <!-- 전환 모션(Fade/Slide 4방향) — FrmMain 전환 효과 중 구현분. -->
                    <MenuItem Header="모션: 페이드"
                              IsChecked="{Binding TransitionKindIsFade}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Fade}" />
                    <MenuItem Header="모션: 슬라이드 ←(왼쪽에서)"
                              IsChecked="{Binding TransitionKindIsSlideLeft}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.SlideFromLeft}" />
                    <MenuItem Header="모션: 슬라이드 →(오른쪽에서)"
                              IsChecked="{Binding TransitionKindIsSlideRight}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.SlideFromRight}" />
                    <MenuItem Header="모션: 슬라이드 ↑(위에서)"
                              IsChecked="{Binding TransitionKindIsSlideUp}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.SlideFromTop}" />
                    <MenuItem Header="모션: 슬라이드 ↓(아래에서)"
                              IsChecked="{Binding TransitionKindIsSlideDown}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.SlideFromBottom}" />
                    <MenuItem Header="모션: 줌 인"
                              IsChecked="{Binding TransitionKindIsZoomIn}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.ZoomIn}" />
                    <MenuItem Header="모션: 줌 아웃"
                              IsChecked="{Binding TransitionKindIsZoomOut}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.ZoomOut}" />
                    <MenuItem Header="모션: 회전"
                              IsChecked="{Binding TransitionKindIsSpin}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Spin}" />
                    <MenuItem Header="모션: 뒤집기(가로)"
                              IsChecked="{Binding TransitionKindIsFlipH}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.FlipHorizontal}" />
                    <MenuItem Header="모션: 뒤집기(세로)"
                              IsChecked="{Binding TransitionKindIsFlipV}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.FlipVertical}" />
                    <MenuItem Header="모션: 원형 리빌"
                              IsChecked="{Binding TransitionKindIsRevealCircle}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.RevealCircle}" />
                    <MenuItem Header="모션: 사각 리빌"
                              IsChecked="{Binding TransitionKindIsRevealRectangle}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.RevealRectangle}" />
                    <MenuItem Header="모션: 와이프 →"
                              IsChecked="{Binding TransitionKindIsWipeRight}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeRight}" />
                    <MenuItem Header="모션: 와이프 ←"
                              IsChecked="{Binding TransitionKindIsWipeLeft}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeLeft}" />
                    <MenuItem Header="모션: 와이프 ↓"
                              IsChecked="{Binding TransitionKindIsWipeDown}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeDown}" />
                    <MenuItem Header="모션: 와이프 ↑"
                              IsChecked="{Binding TransitionKindIsWipeUp}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WipeUp}" />
                    <MenuItem Header="모션: 블라인드(가로)"
                              IsChecked="{Binding TransitionKindIsBlindsH}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BlindsHorizontal}" />
                    <MenuItem Header="모션: 블라인드(세로)"
                              IsChecked="{Binding TransitionKindIsBlindsV}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BlindsVertical}" />
                    <MenuItem Header="모션: 체커보드"
                              IsChecked="{Binding TransitionKindIsCheckerboard}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Checkerboard}" />
                    <MenuItem Header="모션: 다이아몬드"
                              IsChecked="{Binding TransitionKindIsDiamond}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Diamond}" />
                    <MenuItem Header="모션: 양문 열기"
                              IsChecked="{Binding TransitionKindIsDoorsOpen}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.DoorsOpen}" />
                    <MenuItem Header="모션: 양문 닫기"
                              IsChecked="{Binding TransitionKindIsDoorsClose}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.DoorsClose}" />
                    <MenuItem Header="모션: 별"
                              IsChecked="{Binding TransitionKindIsStar}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Star}" />
                    <MenuItem Header="모션: 십자(2-레이어)"
                              IsChecked="{Binding TransitionKindIsCross}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Cross}" />
                    <MenuItem Header="모션: 나비넥타이(2-레이어)"
                              IsChecked="{Binding TransitionKindIsBowTie}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.BowTie}" />
                    <MenuItem Header="모션: 하트(2-레이어)"
                              IsChecked="{Binding TransitionKindIsHeart}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Heart}" />
                    <MenuItem Header="모션: 시계 와이프"
                              IsChecked="{Binding TransitionKindIsWedge}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Wedge}" />
                    <MenuItem Header="모션: 나선"
                              IsChecked="{Binding TransitionKindIsSpiral}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.Spiral}" />
                    <MenuItem Header="모션: 바람개비"
                              IsChecked="{Binding TransitionKindIsWindMill}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.WindMill}" />
                    <MenuItem Header="모션: 부채 펼침"
                              IsChecked="{Binding TransitionKindIsFanUp}"
                              Command="{Binding ApplyTransitionKindCommand}"
                              CommandParameter="{x:Static settings:LyricsTransitionKind.FanUp}" />
                    <Separator />
                    <MenuItem Header="빠르게 (150ms)"
                              IsChecked="{Binding TransitionIsFast}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>150</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="보통 (250ms)"
                              IsChecked="{Binding TransitionIsNormal}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>250</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="느리게 (500ms)"
                              IsChecked="{Binding TransitionIsSlow}"
                              Command="{Binding ApplyTransitionDurationCommand}">
                        <MenuItem.CommandParameter>
                            <sys:Int32>500</sys:Int32>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <!-- 배경 이미지(FrmMain Images 탭 — 배경 적용). 선택은 파일 대화상자(코드-비하인드), 해제는 커맨드. -->
                <MenuItem Header="배경 이미지">
                    <MenuItem Header="갤러리에서 선택..."
                              Click="OpenImageLibrary_Click" />
                    <MenuItem Header="이미지 선택..."
                              Click="SelectOutputBackgroundImage_Click" />
                    <MenuItem Header="배경 지우기"
                              Command="{Binding ClearOutputBackgroundImageCommand}" />
                    <Separator />
                    <!-- 배경 이미지 표시 모드(레거시 Def_ImageMode: Tile/Centre/BestFit). 기본 채움=UniformToFill. -->
                    <MenuItem Header="표시 모드: 채움(가득)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsFill}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Fill}" />
                    <MenuItem Header="표시 모드: 맞춤(전체 보임)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsFit}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Fit}" />
                    <MenuItem Header="표시 모드: 가운데(원본 크기)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsCenter}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Center}" />
                    <MenuItem Header="표시 모드: 타일(반복)"
                              IsCheckable="True"
                              IsChecked="{Binding BackgroundModeIsTile}"
                              Command="{Binding ApplyBackgroundModeCommand}"
                              CommandParameter="{x:Static settings:LyricsBackgroundMode.Tile}" />
                </MenuItem>
                <!-- 배경 2색 그라데이션 방향(레거시 Def_BackColour 패턴) — 2색 배경일 때 방향 선택. 기본 세로(위→아래). -->
                <MenuItem Header="그라데이션 방향">
                    <MenuItem Header="세로 (위→아래)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsVertical}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.Vertical}" />
                    <MenuItem Header="가로 (좌→우)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsHorizontal}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.Horizontal}" />
                    <MenuItem Header="대각선 ↘ (좌상→우하)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsDiagonalDown}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalDown}" />
                    <MenuItem Header="대각선 ↗ (좌하→우상)"
                              IsCheckable="True"
                              IsChecked="{Binding GradientDirectionIsDiagonalUp}"
                              Command="{Binding ApplyGradientDirectionCommand}"
                              CommandParameter="{x:Static settings:LyricsGradientDirection.DiagonalUp}" />
                </MenuItem>
                <!-- 이중 언어 영역 표시(레거시 Def_ShowRegion1/2/Both) — 둘 다/Region1만/Region2만. 단일 언어 곡엔 영향 없음. -->
                <MenuItem Header="이중 언어 영역 표시">
                    <MenuItem Header="둘 다"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsBoth}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Both}" />
                    <MenuItem Header="Region 1만(주 언어)"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsRegion1Only}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Region1Only}" />
                    <MenuItem Header="Region 2만(보조 언어)"
                              IsCheckable="True"
                              IsChecked="{Binding RegionDisplayIsRegion2Only}"
                              Command="{Binding ApplyRegionDisplayCommand}"
                              CommandParameter="{x:Static settings:LyricsRegionDisplay.Region2Only}" />
                </MenuItem>
                <!-- 코드/악상 표시(FrmMain Def_Notations) — on 이면 송출 가사에 코드 줄을 함께 그린다. 조옮김은 이게 켜져야 의미 있다. -->
                <MenuItem Header="코드 표시"
                          IsChecked="{Binding ActiveLyricsNotations}"
                          Command="{Binding ToggleLyricsNotationsCommand}"
                          ToolTip="송출 가사에 코드(악보 기호) 줄을 함께 표시(레거시 Def_Notations). 아래 조옮김은 이게 켜져야 적용됨." />
                <!-- 코드 조옮김(FrmMain Transpose Up/Down Semi-Tone, To Capo 0) — "코드 표시" on 일 때 송출 코드를 이동.
                     라이브 곡에 즉시 반영(재송출). 새 곡을 송출하면 원조로 초기화된다. -->
                <MenuItem Header="코드 조옮김">
                    <MenuItem Header="{Binding LiveTransposeLabel}" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="반음 올림 ▲"
                              Command="{Binding TransposeLiveUpCommand}" />
                    <MenuItem Header="반음 내림 ▼"
                              Command="{Binding TransposeLiveDownCommand}" />
                    <MenuItem Header="원조 복귀"
                              Command="{Binding TransposeLiveResetCommand}" />
                </MenuItem>
                <Separator />
                <!-- 전 항목에 전역 기본 서식 적용(FrmMain "Apply to All Except InfoScreens") — 모든 항목의 개별 서식을 끄고
                     운영 기본(인스펙터) 서식으로 송출하게 한다. 곡·성경 텍스트에만 영향. -->
                <MenuItem Header="전 항목에 전역 서식 적용"
                          Command="{Binding ApplyGlobalFormatToAllCommand}"
                          ToolTip="모든 예배 순서 항목의 '개별 서식'을 끄고 전역 기본(인스펙터) 서식으로 통일(레거시 Apply to All)." />
                <Separator />
                <!-- 가사 정렬(FrmMain Align Left/Centre/Right) — 기존 인-셸 정렬 명령 재사용. -->
                <MenuItem Header="가사 정렬">
                    <MenuItem Header="왼쪽"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Left}" />
                    <MenuItem Header="가운데"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Center}" />
                    <MenuItem Header="오른쪽"
                              Command="{Binding ApplyLyricsAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsTextAlignment.Right}" />
                </MenuItem>
                <!-- 세로 정렬(FrmMain Vertical Alignment Top/Centre/Bottom). -->
                <MenuItem Header="가사 세로 정렬">
                    <MenuItem Header="위"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}" />
                    <MenuItem Header="가운데"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}" />
                    <MenuItem Header="아래"
                              Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                              CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}" />
                </MenuItem>
                <Separator />
                <!-- 글자 크기·줄 간격(FrmMain 글자 크기/줄 간격) — 기존 인-셸 명령 재사용. -->
                <MenuItem Header="글자 크게" Command="{Binding IncreaseLyricsFontSizeCommand}" />
                <MenuItem Header="글자 작게" Command="{Binding DecreaseLyricsFontSizeCommand}" />
                <MenuItem Header="줄 간격 늘림" Command="{Binding IncreaseLyricsLineSpacingCommand}" />
                <MenuItem Header="줄 간격 줄임" Command="{Binding DecreaseLyricsLineSpacingCommand}" />
                <Separator />
                <!-- 본문 여백(FrmMain ShowLeftMargin/ShowRightMargin/ShowBottomMargin) — 본문을 가장자리에서 안쪽으로 들여쓴다. -->
                <MenuItem Header="본문 여백">
                    <MenuItem Header="{Binding ActiveLyricsLeftMargin, StringFormat=왼쪽 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="왼쪽 여백 넓게" Command="{Binding IncreaseLyricsLeftMarginCommand}" />
                    <MenuItem Header="왼쪽 여백 좁게" Command="{Binding DecreaseLyricsLeftMarginCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ActiveLyricsRightMargin, StringFormat=오른쪽 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="오른쪽 여백 넓게" Command="{Binding IncreaseLyricsRightMarginCommand}" />
                    <MenuItem Header="오른쪽 여백 좁게" Command="{Binding DecreaseLyricsRightMarginCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ActiveLyricsBottomMargin, StringFormat=아래 여백: {0}px}" IsEnabled="False" />
                    <MenuItem Header="아래 여백 넓게" Command="{Binding IncreaseLyricsBottomMarginCommand}" />
                    <MenuItem Header="아래 여백 좁게" Command="{Binding DecreaseLyricsBottomMarginCommand}" />
                    <Separator />
                    <!-- 이중 언어 영역 간 세로 간격(FrmMain Ind_Reg2TopUpDown) — 원문(Region1)과 번역(Region2) 사이 간격. -->
                    <MenuItem Header="{Binding ActiveRegionGap, StringFormat=영역 간 간격: {0}px}" IsEnabled="False" />
                    <MenuItem Header="영역 간격 넓게" Command="{Binding IncreaseRegionGapCommand}" />
                    <MenuItem Header="영역 간격 좁게" Command="{Binding DecreaseRegionGapCommand}" />
                    <Separator />
                    <!-- 본문 세로 위치(FrmMain Ind_Reg1TopUpDown) — 정렬 유지한 채 본문을 위/아래로 미세 이동. -->
                    <MenuItem Header="{Binding ActiveBodyVerticalOffset, StringFormat=본문 세로 위치: {0}px}" IsEnabled="False" />
                    <MenuItem Header="본문 위로 ▲" Command="{Binding MoveBodyUpCommand}" />
                    <MenuItem Header="본문 아래로 ▼" Command="{Binding MoveBodyDownCommand}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="도구">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                <MenuItem Header="가져오기·내보내기" Click="OpenImportExport_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ExportRtf}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="외부 파일 복사·이동" Click="OpenExternalFiles_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="예배 순서 관리" Click="OpenManageWorshipLists_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.WorshipList}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="성경 버전 관리" Click="OpenBibleVersionManager_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Bible}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="찬양집 색인..." Click="OpenPraiseBookIndex_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="공지 화면(InfoScreen)..." Click="OpenNoticeScreen_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="세션 메모..." Click="OpenSessionNotes_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionEdit}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 예배 순서 검증 — 라이브 송출 전 깨진 PPT·미디어 파일을 미리 거른다(레거시 ValidateWorshipListItems). -->
                <MenuItem Header="예배 순서 검증"
                          Command="{Binding ValidateWorshipListCommand}"
                          ToolTip="라이브 송출 전 깨진 PowerPoint·미디어 파일이 없는지 점검합니다.">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.StatusCheck}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 데이터베이스 압축·정리(레거시 Tools Compact & Repair) — 백업 후 VACUUM. -->
                <MenuItem Header="데이터베이스 압축·정리"
                          Command="{Binding Library.CompactDatabaseCommand}"
                          ToolTip="곡 데이터베이스의 빈 공간을 회수해 파일을 줄입니다(백업을 먼저 만듭니다).">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Template}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="도움말">
                <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Help}" /></MenuItem.Icon>
                <MenuItem Header="도움말" Click="OpenHelp_Click" InputGestureText="F1">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Help}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="등록 안내" Click="OpenRegistration_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.StatusCheck}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="정보" Click="OpenAbout_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="{x:Static theme:EsIcons.Info}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <composites:LiveBar DockPanel.Dock="Top"
                            DataContext="{Binding LiveBar}" />

        <!-- 하단 상태바(FrmMain StatusStrip 파리티) — 예배 순서 항목 수·현재 절 위치·운영 상태·출력 모니터.
             기존 VM 상태만 바인딩(Queue.Count·LyricsPageLabel·StatusText·SelectedOutputDisplay). 가장 아래에 깔린다. -->
        <Border DockPanel.Dock="Bottom"
                x:Name="StatusBar"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Subtle}"
                Padding="12,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Queue.Count, StringFormat='예배 순서 {0}개'}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               AutomationProperties.Name="예배 순서 항목 수" />
                    <TextBlock Text="{Binding LyricsPageLabel}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               AutomationProperties.Name="현재 절 위치" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding SelectedOutputDisplay.Name}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           AutomationProperties.Name="출력 모니터" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                Background="{DynamicResource Brush.Surface.Card}"
                Padding="{StaticResource Thickness.Md}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowNew24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 열기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                            <TextBlock Text="출력 닫기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoLiveCommand}"
                            Style="{StaticResource EsButton.Primary}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="VideoClip24" Margin="0,0,6,0" />
                            <TextBlock Text="LIVE" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BlackScreenCommand}"
                            Style="{StaticResource EsButton.Danger}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,6,0" />
                            <TextBlock Text="Black" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding HideOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="가사/콘텐츠 숨김(배경 유지)"
                            AutomationProperties.Name="출력 숨김"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,6,0" />
                            <TextBlock Text="숨김" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="가사/콘텐츠를 비우고 배경만 송출(검은 화면과 구별)"
                            AutomationProperties.Name="화면 비우기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                            <TextBlock Text="비우기" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RestoreOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="숨김/검은 화면/비우기에서 직전 송출로 복귀"
                            AutomationProperties.Name="출력 복귀"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eye24" Margin="0,0,6,0" />
                            <TextBlock Text="복귀" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RestartCurrentItemCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="현재 라이브 항목을 처음(첫 절/첫 슬라이드)으로 되돌려 재송출"
                            AutomationProperties.Name="현재 항목 처음으로"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" Margin="0,0,6,0" />
                            <TextBlock Text="처음으로" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshOutputCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="출력 화면을 다시 그린다(디스플레이 글리치 복구)"
                            AutomationProperties.Name="출력 새로고침"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                            <TextBlock Text="새로고침" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsAutoRotating, Mode=OneWay}"
                                  Command="{Binding ToggleAutoRotateCommand}"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,0,8,0"
                                  ToolTip="라이브 중 절/슬라이드를 일정 간격으로 자동 전환(§7.3-B)"
                                  AutomationProperties.Name="자동 회전 토글">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Margin="0,0,6,0" />
                            <TextBlock Text="자동회전" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- 자동 회전 모드(레거시 One/One-Repeat/Group/Group-Repeat) — 끝 절/슬라이드에서의 동작 선택. -->
                    <ComboBox ItemsSource="{Binding AutoRotateModeOptions}"
                              SelectedValue="{Binding AutoRotateModeInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              MinHeight="36"
                              MinWidth="120"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"
                              ToolTip="자동 회전 모드 — 현재 항목 반복 / 한 항목만(끝나면 정지) / 그룹(다음 항목으로) / 그룹 반복"
                              AutomationProperties.Name="자동 회전 모드" />
                    <!-- 우측 인스펙터 접기/펼치기(§7.4 가변 패널) — 접으면 중앙 미리보기가 넓어진다. -->
                    <ToggleButton IsChecked="{Binding IsInspectorExpanded, Mode=TwoWay}"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,0,8,0"
                                  Content="인스펙터"
                                  ToolTip="우측 출력 모양 인스펙터 접기/펼치기"
                                  AutomationProperties.Name="인스펙터 접기 토글" />
                    <!-- 라이브러리·성경·외부파일·I/O·도움말·등록·정보 런처는 ⌘K 명령 팔레트로 흡수(§7.4 적극 정리).
                         바에는 자주 쓰는 파일·순서·검색·설정만 남긴다. 핸들러는 BindWindowLaunchers 가 참조. -->
                    <!-- 명령 팔레트 진입(발견가능성) — 마우스 운영자도 ⌘K 없이 클릭으로 모든 명령/창을 검색·실행. -->
                    <Button Command="{Binding CommandPalette.OpenCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="모든 명령·창 검색 (Ctrl+K)"
                            AutomationProperties.Name="명령 팔레트 열기"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="명령 ⌘K" />
                        </StackPanel>
                    </Button>
                    <Button Click="AddExternalFile_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="PowerPoint/미디어 파일을 예배 순서에 추가"
                            AutomationProperties.Name="파일 추가"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                            <TextBlock Text="파일" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenManageWorshipLists_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="예배 순서 저장/불러오기"
                            AutomationProperties.Name="예배 순서 관리"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                            <TextBlock Text="순서" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSearchUsage_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="Search and usage"
                            AutomationProperties.Name="Search and usage"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSettings_Click"
                            Style="{StaticResource EsButton.Secondary}"
                            ToolTip="설정 열기"
                            AutomationProperties.Name="설정 열기">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
                            <TextBlock Text="설정" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="{StaticResource Thickness.Xl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <!-- 우측 인스펙터 컬럼: Auto — 인스펙터를 접으면(Visibility=Collapsed) 0 으로 줄어 중앙이 넓어진다(§7.4 가변 패널). -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 상단 콘텐츠 브라우저(라이브러리/성경 탭) + 하단 예배 순서(항상 표시) — FrmMain식 멀티페인.
                 곡·성경을 찾으면서 예배 순서를 동시에 보도록 탭 전환을 없앤다(§7.4 단일 콘솔 통합).
                 GridSplitter 로 두 패널 높이를 운영자가 조절. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            x:Name="LeftBrowserTabs"
                            SelectionChanged="LeftBrowserTabs_SelectionChanged"
                            BorderThickness="0"
                            Background="Transparent">
                    <TabItem Header="라이브러리"
                             Tag="Library">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button Command="{Binding Library.LoadCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Margin="0,0,8,0"
                                    Content="불러오기"
                                    AutomationProperties.Name="라이브러리 불러오기" />
                            <Button Command="{Binding AddSelectedLibrarySongCommand}"
                                    Style="{StaticResource EsButton.Primary}"
                                    Content="예배 순서에 추가"
                                    AutomationProperties.Name="선택 곡을 예배 순서에 추가" />
                        </StackPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Library.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 Margin="0,0,0,8"
                                 ToolTip="제목·가사·분류 검색"
                                 AutomationProperties.Name="곡 검색" />

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Library.Folders}"
                                      SelectedItem="{Binding Library.SelectedFolder, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      MinHeight="34"
                                      AutomationProperties.Name="폴더 선택" />
                            <!-- 곡 목록 정렬(FrmMain 곡 목록 정렬) — 원래순서/제목순/곡번호순. 데이터 재조회 없이 표시만 재정렬. -->
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding Library.SortOptions}"
                                      SelectedValue="{Binding Library.SortMode, Mode=TwoWay}"
                                      SelectedValuePath="Mode"
                                      DisplayMemberPath="Label"
                                      MinWidth="110"
                                      MinHeight="34"
                                      ToolTip="곡 목록 정렬 방식"
                                      AutomationProperties.Name="곡 목록 정렬" />
                        </Grid>

                        <!-- A/B/C(초성) 점프 바 — 표시된 곡의 머리글자를 눌러 그 글자로 시작하는 첫 곡으로 이동(FrmMain 곡 목록 점프).
                             곡이 없으면 머리글자도 없어 빈 줄이 된다. -->
                        <ItemsControl Grid.Row="3"
                                      ItemsSource="{Binding Library.AvailableInitials}"
                                      Margin="0,0,0,8"
                                      AutomationProperties.Name="머리글자 점프 바">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.Library.JumpToInitialCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource EsButton.Secondary}"
                                            MinWidth="30"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            ToolTip="이 머리글자로 시작하는 첫 곡으로 이동" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListBox Grid.Row="4"
                                 x:Name="LibrarySongList"
                                 ItemsSource="{Binding Library.Songs}"
                                 SelectedItem="{Binding Library.SelectedSong, Mode=TwoWay}"
                                 AutomationProperties.Name="곡 목록">
                            <!-- 곡 한 줄 표시: "곡 번호 표시"(Use Song Numbering) on 이면 "번호. 제목", off 면 제목만.
                                 곡번호표시 값은 ListBox 의 DataContext(Library)에서 읽어, 토글하면 모든 줄이 즉시 갱신된다. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SongRowDisplay}">
                                                <Binding Path="Title" />
                                                <Binding Path="SongNumber" />
                                                <Binding Path="DataContext.Library.UseSongNumbering"
                                                         RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.InputBindings>
                                <!-- 더블클릭으로 예배 순서에 추가(선택 후 추가). -->
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding AddSelectedLibrarySongCommand}" />
                            </ListBox.InputBindings>
                        </ListBox>

                        <TextBlock Grid.Row="5"
                                   Text="{Binding Library.StatusMessage}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <TabItem Header="성경"
                         Tag="Bible">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 버전·책 선택 + 검색 — BibleWindow 와 동일 재사용 컴포지트(DataContext=Bible 로 국한). -->
                        <composites:BibleVerseFinder Grid.Row="0"
                                                     DataContext="{Binding Bible}" />

                        <!-- 구절 직접 입력 점프(typed-reference) — 예: "창 1:1-2:3". Enter 또는 "이동"으로 즉시 추가. -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="BibleReferenceBox"
                                     Text="{Binding Bible.TypedReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="BibleReferenceBox_KeyDown"
                                     MinHeight="36"
                                     ToolTip="구절을 직접 입력해 바로 추가 (예: 창 1:1-2:3, John 3:16)"
                                     AutomationProperties.Name="성경 구절 직접 입력" />
                            <Button Grid.Column="2"
                                    Click="JumpBibleReference_Click"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Content="이동"
                                    ToolTip="입력한 구절로 이동해 예배 순서에 추가"
                                    AutomationProperties.Name="입력한 성경 구절로 이동" />
                        </Grid>

                        <!-- 본문 — 구절 범위를 드래그 선택한 뒤 아래 "선택 구절 추가" 또는 우클릭 메뉴 사용. -->
                        <TextBox Grid.Row="2"
                                 x:Name="BiblePassageBox"
                                 Text="{Binding Bible.PassageText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,8,0,0"
                                 PreviewMouseLeftButtonDown="BiblePassageBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="BiblePassageBox_PreviewMouseMove"
                                 AutomationProperties.Name="성경 본문">
                            <!-- 본문 우클릭 메뉴(레거시 Bible 우클릭) — 전체 선택/복사 + 선택 구절을 예배 순서·공지 화면으로. -->
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="전체 선택" Click="SelectAllBiblePassage_Click" />
                                    <MenuItem Header="복사" Click="CopyBiblePassage_Click" />
                                    <Separator />
                                    <MenuItem Header="선택 구절 예배 순서에 추가" Click="AddBibleVerse_Click" />
                                    <!-- 레거시 인라인 성경 우클릭 "Add Region 2" — 선택 구절을 고른 보조 버전과 함께(이중 언어) 추가.
                                         후보는 현재 주 버전을 뺀 나머지 버전들(Region2VersionOptions). PlacementTarget 경유로 VM 에 접근. -->
                                    <MenuItem Header="선택 구절 Region 2(이중 언어)와 함께 추가"
                                              ItemsSource="{Binding PlacementTarget.DataContext.Bible.Region2VersionOptions, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <EventSetter Event="Click" Handler="AddBibleVerseWithRegion2_Click" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="선택 구절 공지 화면으로..." Click="CopyBibleToInfoScreen_Click" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <Button Grid.Row="3"
                                Click="AddBibleVerse_Click"
                                Style="{StaticResource EsButton.Primary}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Content="선택 구절 추가"
                                AutomationProperties.Name="선택한 성경 구절을 예배 순서에 추가" />

                        <TextBlock Grid.Row="4"
                                   Text="{Binding Bible.SelectedPassageTitle}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Row="5"
                                   Text="{Binding Bible.StatusMessage}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                </TabItem>
                <!-- 검색 탭(§7.4 단일 콘솔 통합 — SearchUsageWindow 의 곡/제목/사용을 좌측 레일에 인라인 흡수).
                     서브탭: 곡(폴더 가로지르는 다중 필드 검색) · 제목(제목으로 빠르게 찾기) · 사용(송출 이력 읽기전용).
                     곡·제목 결과는 더블클릭/버튼으로 예배 순서에 추가. 삭제/RTF 내보내기 같은 무거운 관리 기능은
                     기존 SearchUsageWindow 에 남겨 두고 명령 팔레트(⌘K)로 연다. -->
                <TabItem Header="검색"
                         Tag="Search">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0"
                                    x:Name="SearchModeTabs"
                                    BorderThickness="0"
                                    Background="Transparent">
                            <!-- 곡: 폴더 가로지르는 다중 필드 검색 -->
                            <TabItem Header="곡"
                                     Tag="SearchSongs">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <Button Command="{Binding Search.SearchSongsCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="교차 검색"
                                                AutomationProperties.Name="전체 폴더에서 곡 검색" />
                                        <Button Command="{Binding AddSearchedSongCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Content="예배 순서에 추가"
                                                AutomationProperties.Name="선택한 검색 결과를 예배 순서에 추가" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,0,0,8"
                                             ToolTip="제목·가사·번호로 검색 (Enter 로 실행)"
                                             AutomationProperties.Name="검색어">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding Search.SearchSongsCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <!-- 검색 범위(기본 제목+가사+번호). 폴더는 기본 전체 선택 → 폴더 가로지름. -->
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <CheckBox Content="제목"
                                                  IsChecked="{Binding Search.SearchTitle}"
                                                  Margin="0,0,12,0"
                                                  AutomationProperties.Name="제목 검색" />
                                        <CheckBox Content="가사"
                                                  IsChecked="{Binding Search.SearchLyrics}"
                                                  Margin="0,0,12,0"
                                                  AutomationProperties.Name="가사 검색" />
                                        <CheckBox Content="번호"
                                                  IsChecked="{Binding Search.SearchSongNumber}"
                                                  AutomationProperties.Name="곡 번호 검색" />
                                    </StackPanel>
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding Search.SearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                             AutomationProperties.Name="검색 결과 목록">
                                        <ListBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding AddSearchedSongCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding FolderName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                            <!-- 제목: 제목/별칭으로 빠르게 찾기(가사 본문 검색 없이). 결과를 예배 순서에 추가. -->
                            <TabItem Header="제목"
                                     Tag="SearchTitles">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <Button Command="{Binding Search.LookupTitlesCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="제목 조회"
                                                AutomationProperties.Name="제목으로 곡 조회" />
                                        <Button Command="{Binding AddLookupTitleCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Content="예배 순서에 추가"
                                                AutomationProperties.Name="선택한 제목을 예배 순서에 추가" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,0,0,8"
                                             ToolTip="제목 일부 (Enter 로 조회)"
                                             AutomationProperties.Name="제목 검색어">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding Search.LookupTitlesCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Search.LookupCandidates}"
                                             SelectedItem="{Binding SelectedTitleCandidate, Mode=TwoWay}"
                                             AutomationProperties.Name="제목 조회 결과 목록">
                                        <ListBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding AddLookupTitleCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding FolderName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                            <!-- 사용: 송출 이력(언제 어떤 곡을 썼는지) 읽기전용. 기간을 정해 불러온다. -->
                            <TabItem Header="사용"
                                     Tag="SearchUsage">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <WrapPanel Margin="0,0,0,8">
                                        <DatePicker SelectedDate="{Binding Search.UsageFrom}"
                                                    Width="120"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="사용 시작일" />
                                        <DatePicker SelectedDate="{Binding Search.UsageTo}"
                                                    Width="120"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="사용 종료일" />
                                    </WrapPanel>
                                    <Button Grid.Row="1"
                                            Command="{Binding Search.RefreshUsageCommand}"
                                            Style="{StaticResource EsButton.Secondary}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="이력 불러오기"
                                            AutomationProperties.Name="사용 이력 불러오기" />
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding Search.UsageRecords}"
                                             AutomationProperties.Name="사용 이력 목록">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding SongTitle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <TextBlock Text="{Binding WorshipDate, StringFormat=yyyy-MM-dd}"
                                                               Style="{StaticResource Type.Caption.Style}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- 곡/제목/사용 공통 피드백. 경고(ValidationMessage)는 빨강, 일반 상태(건수·안내)는 흐린 글자.
                             ValidationMessage 도 함께 보여야 "DB 경로 미준비" 같은 가드가 침묵하지 않는다(인라인 흡수 시 사각지대 제거). -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,8,0,0">
                            <!-- 경고는 비어 있으면 공백(기존 SearchUsageWindow 와 동일 패턴 — 별도 가시성 컨버터 없이). -->
                            <TextBlock Text="{Binding Search.ValidationMessage}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Status.Danger}" />
                            <TextBlock Text="{Binding Search.StatusMessage}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="Transparent"
                              AutomationProperties.Name="브라우저/예배 순서 높이 조절" />

                <!-- 예배 순서 — 항상 보이는 하단 패널(FrmMain 좌측 하단 송출 큐). 재사용 컴포지트(§5.2, DataContext 상속). -->
                <composites:WorshipListPanel Grid.Row="2" />
            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Xl}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="현재 항목"
                                   Style="{StaticResource Type.Title2.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding SelectedItem.Title}"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,20,0,20"
                            Background="{DynamicResource Brush.Surface.Page}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Small}">
                        <!-- 중앙 미리보기 — 선택 항목 종류에 맞춰 SelectedIndex 가 자동 전환(곡=Preview/PPT=PowerPoint/미디어=Media).
                             운영자가 탭을 수동으로 누르지 않아도 알맞은 미리보기가 보인다(FrmMain식 멀티페인 §7.4). -->
                        <TabControl BorderThickness="0"
                                    Background="Transparent"
                                    SelectedIndex="{Binding SelectedContentTabIndex, Mode=TwoWay}">
                            <TabItem Header="Preview">
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <rendering:SlidePreviewControl Grid.Row="0"
                                                                   Title="{Binding SelectedItem.Title}"
                                                                   Kind="{Binding SelectedItem.Kind}"
                                                                   Source="{Binding SelectedItem.PreviewSource}"
                                                                   FillMode="{Binding SelectedItem.PreviewFillMode}"
                                                                   SlideNumber="{Binding SelectedItem.SlideNumber}"
                                                                   ShowSlideNumber="True"
                                                                   IsSelected="True" />

                                    <!-- 선택 곡의 실제 가사 표시(라이브 큐 콘텐츠 plumbing — LiveQueueItem.Lyrics). 가사 없으면 비어 표시. -->
                                    <ScrollViewer Grid.Row="1"
                                                  MaxHeight="140"
                                                  Margin="0,12,0,0"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding SelectedItem.Lyrics}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   AutomationProperties.Name="선택 곡 가사" />
                                    </ScrollViewer>

                                    <!-- 절 이동 영역(Row 2): 절 라벨 직접 점프 버튼 + 순차 이전/다음 절 네비. -->
                                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                        <!-- 절 라벨 직접 점프(레거시 FrmInfoScreen 절 버튼 1~9·c·b) — 곡에 라벨이 있을 때만
                                             버튼이 생긴다(AvailableSectionLabels 가 비면 아무것도 안 보임). 클릭 시 그 라벨의 첫 절로 즉시 이동. -->
                                        <ItemsControl x:Name="SectionJumpBar"
                                                      ItemsSource="{Binding AvailableSectionLabels}"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Command="{Binding DataContext.JumpToLyricsSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EsButton.Secondary}"
                                                            MinWidth="36"
                                                            Margin="3,0"
                                                            AutomationProperties.Name="{Binding StringFormat='{}{0} 절로 이동'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 절 단위 페이지네이션 — 이전 절 / 현재 페이지 표시 / 다음 절 (PR B).
                                             곡 항목이고 절이 2개 이상일 때만 유효(LyricsPageCount>1). -->
                                        <StackPanel x:Name="LyricsPagePanel"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Command="{Binding PreviousLyricsPageCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Margin="0,0,8,0"
                                                    Content="◀ 이전 절"
                                                    AutomationProperties.Name="이전 절" />
                                            <TextBlock Text="{Binding LyricsPageLabel}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="40"
                                                       TextAlignment="Center"
                                                       Style="{StaticResource Type.Body.Style}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <Button Command="{Binding NextLyricsPageCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Margin="8,0,0,0"
                                                    Content="다음 절 ▶"
                                                    AutomationProperties.Name="다음 절" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="PowerPoint"
                                     Visibility="{Binding IsPowerPointTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- PPT 미리보기 — PowerPointPreviewViewModel(PowerPoint) 바인딩(G1 / gap-analysis.md §4 G-α).
                                     렌더된 슬라이드 이미지를 표시(미적재 시 상태·덱 정보). placeholder "Decks: N" 대체. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0"
                                           Source="{Binding PowerPoint.PreviewImage}"
                                           Stretch="Uniform"
                                           AutomationProperties.Name="PowerPoint 슬라이드 미리보기" />

                                    <!-- 덱 전체 슬라이드 썸네일 스트립 — 클릭으로 해당 슬라이드 이동(라이브 중이면 출력도 갱신). -->
                                    <ScrollViewer Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding PowerPoint.Thumbnails}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.GoToSlideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding SlideNumber}"
                                                            Margin="2,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding SlideNumber, StringFormat=슬라이드 {0}}"
                                                            AutomationProperties.Name="{Binding SlideNumber, StringFormat=슬라이드 {0}}">
                                                        <Border BorderThickness="2"
                                                                CornerRadius="{StaticResource CornerRadius.Small}"
                                                                Padding="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="{Binding Image}"
                                                                   Width="120"
                                                                   Height="68"
                                                                   Stretch="Uniform" />
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center">
                                        <!-- 슬라이드 이동 — 라이브 송출 중이면 출력도 즉시 갱신(G1.2 라이브 슬라이드 이동). -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">
                                            <Button Command="{Binding PreviousSlideCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Margin="0,0,8,0"
                                                    Content="◀ 이전"
                                                    AutomationProperties.Name="이전 슬라이드" />
                                            <Button Command="{Binding NextSlideCommand}"
                                                    Style="{StaticResource EsButton.Secondary}"
                                                    Content="다음 ▶"
                                                    AutomationProperties.Name="다음 슬라이드" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PowerPoint.StatusText}"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding PowerPointFileCount, StringFormat={}덱: {0}}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Media"
                                     Visibility="{Binding IsMediaTabVisible, Converter={StaticResource BoolToVis}}">
                                <!-- 미디어 재생 컨트롤 — MediaPlaybackViewModel(Media) 바인딩(G1.2 / gap-analysis.md §4 G-α).
                                     placeholder 텍스트를 실제 컨트롤 표면으로 대체. 백엔드 NoOp 상태에선 상태·컨트롤이 비활성으로 표시. -->
                                <Grid Margin="{StaticResource Thickness.Lg}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Media.StatusText}"
                                                   Style="{StaticResource Type.Title3.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Media.Source}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Type.BodyLarge.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Run Text="{Binding Media.PositionText, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Media.DurationText, Mode=OneWay}" />
                                    </TextBlock>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Button Command="{Binding Media.FastReverseCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="◀◀"
                                                AutomationProperties.Name="되감기" />
                                        <Button Command="{Binding Media.PlayPauseCommand}"
                                                Style="{StaticResource EsButton.Primary}"
                                                Margin="0,0,8,0"
                                                Content="{Binding Media.PlayPauseLabel}"
                                                AutomationProperties.Name="재생/일시정지" />
                                        <Button Command="{Binding Media.StopCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="■"
                                                AutomationProperties.Name="정지" />
                                        <Button Command="{Binding Media.FastForwardCommand}"
                                                Style="{StaticResource EsButton.Secondary}"
                                                Margin="0,0,8,0"
                                                Content="▶▶"
                                                AutomationProperties.Name="빨리감기" />
                                        <ToggleButton IsChecked="{Binding Media.IsMuted, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleMuteCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Margin="0,0,8,0"
                                                      Content="음소거"
                                                      AutomationProperties.Name="음소거 토글" />
                                        <ToggleButton IsChecked="{Binding Media.IsRepeatEnabled, Mode=OneWay}"
                                                      Command="{Binding Media.ToggleRepeatCommand}"
                                                      MinHeight="36"
                                                      Padding="10,0"
                                                      Content="반복"
                                                      AutomationProperties.Name="반복 토글" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="미디어 폴더"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding MediaDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding LiveCameraSource}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding FirstItemCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,8,0"
                                Content="처음"
                                ToolTip="예배 순서의 첫 항목으로"
                                AutomationProperties.Name="처음 항목" />
                        <Button Command="{Binding PreviousItemCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,8,0"
                                Content="이전" />
                        <Button Command="{Binding NextItemCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Margin="0,0,8,0"
                                Content="다음" />
                        <Button Command="{Binding LastItemCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Content="마지막"
                                ToolTip="예배 순서의 마지막 항목으로"
                                AutomationProperties.Name="마지막 항목" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Width="340"
                    Visibility="{Binding IsInspectorExpanded, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <StackPanel>
                    <TextBlock Text="운영 상태"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="출력"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding OutputDisplays}"
                              SelectedItem="{Binding SelectedOutputDisplay, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="출력 모니터 선택"
                              MinHeight="36"
                              Margin="0,4,0,16" />

                    <TextBlock Text="송출"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding LiveBar.State}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,2,0,16" />

                    <TextBlock Text="선택"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{Binding SelectedItem.Kind}"
                               Style="{StaticResource Type.BodyLarge.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,16" />

                    <!-- 인-셸 출력 모양 인스펙터(§7.5 P0) — 별도 Settings 모달 없이 글자색·배경을 즉시 적용,
                         설정→출력 VM 경로로 라이브 반영. 세분 색 편집은 후속. -->
                    <TextBlock Text="출력 모양"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ItemsControl ItemsSource="{Binding OutputAppearancePresets}"
                                  Margin="0,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ApplyOutputAppearanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,4"
                                        Padding="6"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 미리보기 스와치: 배경 위에 글자색 'Aa' -->
                                        <Border Width="34"
                                                Height="22"
                                                CornerRadius="3"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="Aa"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding TextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ActiveAppearanceName, StringFormat=현재: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <!-- 세분 색 직접 지정(§7.3-A) — 프리셋 너머 임의 hex 색. Enter 또는 적용 버튼으로 반영. -->
                    <TextBlock Text="색 직접 지정 (#RRGGBB)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="글자"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="TextColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveTextColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="글자색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyTextColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=TextColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyTextColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=TextColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="글자색 적용" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="배경"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox x:Name="BackgroundColorHexBox"
                                 Grid.Column="1"
                                 Text="{Binding ActiveBackgroundColorHex, Mode=OneWay}"
                                 MinHeight="30"
                                 AutomationProperties.Name="배경색 hex">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ApplyBackgroundColorHexCommand}"
                                            CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyBackgroundColorHexCommand}"
                                CommandParameter="{Binding Text, ElementName=BackgroundColorHexBox}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="배경색 적용" />
                    </Grid>

                    <!-- 인-셸 가사 정렬(§7.3-A) — 모달 없이 좌/중/우 즉시 적용, 라이브 출력에 반영. -->
                    <TextBlock Text="가사 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="가사 왼쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="가사 오른쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsAlignmentLabel, StringFormat=현재 정렬: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 세로 정렬(§7.3-A) — 위/가운데/아래. -->
                    <TextBlock Text="가사 세로 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Top}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="위"
                                AutomationProperties.Name="가사 위쪽 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="가사 세로 가운데 정렬" />
                        <Button Command="{Binding ApplyLyricsVerticalAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsVerticalAlignment.Bottom}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="아래"
                                AutomationProperties.Name="가사 아래쪽 정렬" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLyricsVerticalAlignmentLabel, StringFormat=현재 세로: {0}}"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />

                    <!-- 인-셸 가사 폰트 크기(§7.3-A) — 작게(-)/크게(+) 단계 조절. -->
                    <TextBlock Text="가사 크기"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="A−"
                                ToolTip="가사 글자 작게"
                                AutomationProperties.Name="가사 글자 작게" />
                        <Button Command="{Binding IncreaseLyricsFontSizeCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="A+"
                                ToolTip="가사 글자 크게"
                                AutomationProperties.Name="가사 글자 크게" />
                        <!-- 직접 수치 입력(FrmMain NumericUpDown 대응) — 범위 밖 값은 자동 클램프, 입력 후 포커스 이동 시 적용. -->
                        <TextBox Text="{Binding LyricsFontSizeInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="가사 글자 크기 직접 입력 (24~120px) — 숫자가 아니면 빨간 테두리로 표시"
                                 AutomationProperties.Name="가사 글자 크기 직접 입력" />
                        <TextBlock Text="px"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 출력 가사 전역 글꼴(FrmMain Def_FontName) — 편집 가능 콤보라 목록 밖 글꼴명도 직접 입력 가능. 비우면 테마 기본 글꼴. 곡별 글꼴(43)이 있으면 그 곡 우선. -->
                    <TextBlock Text="출력 글꼴 (비우면 기본)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding LyricsFontFamilyOptions}"
                              Text="{Binding LyricsFontFamilyInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              Margin="0,4,0,0"
                              ToolTip="회중 출력 가사의 기본 글꼴. 목록에서 고르거나 글꼴명을 직접 입력하세요. 비우면 테마 기본 글꼴을 씁니다. 곡별 글꼴이 지정된 곡은 그 글꼴이 우선합니다."
                              AutomationProperties.Name="출력 가사 전역 글꼴" />

                    <!-- 보조 영역(Region2) 폰트 크기(FrmMain Ind_Reg2SizeUpDown) — 이중 언어 곡의 번역 영역 크기. 0=본문과 동일. -->
                    <TextBlock Text="보조영역 크기 (0=본문과 동일)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <TextBox Text="{Binding LyricsFontSize2Input, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="이중 언어 곡의 보조 영역(Region2) 글자 크기. 0=본문과 동일, 그 외 24~120px. 숫자가 아니면 빨간 테두리"
                                 AutomationProperties.Name="보조영역 글자 크기 직접 입력" />
                        <TextBlock Text="px"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 보조 영역(Region2) 전역 글꼴(FrmMain Ind_Reg2Font) — 비우면 본문 글꼴 추종. 곡별 글꼴(44)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 글꼴 (비우면 본문과 동일)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding LyricsFontFamilyOptions}"
                              Text="{Binding LyricsFontFamily2Input, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 기본 글꼴. 비우면 본문(Region1) 글꼴을 따릅니다. 곡별 글꼴이 지정된 곡은 그 글꼴이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 글꼴" />

                    <!-- 보조 영역(Region2) 전역 글자색 — 본문과 동일(추종) 또는 별도 색. 곡별 색(30)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 글자색 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsTextColor2Presets}"
                              SelectedValue="{Binding LyricsTextColor2Input, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 글자색. '본문과 동일'이면 본문(Region1) 색을 따릅니다. 곡별 색이 지정된 곡은 그 색이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 글자색" />

                    <!-- 보조 영역(Region2) 전역 가로 정렬 — 본문과 동일(추종) 또는 별도 정렬. 곡별 정렬(32)이 있으면 그 곡 우선. -->
                    <TextBlock Text="보조영역 정렬 (본문과 동일=추종)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding LyricsRegion2AlignmentPresets}"
                              SelectedValue="{Binding LyricsRegion2AlignmentInput, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Key"
                              Margin="0,4,0,0"
                              ToolTip="이중 언어 곡의 보조 영역(번역) 가로 정렬. '본문과 동일'이면 본문(Region1) 정렬을 따릅니다. 곡별 정렬이 지정된 곡은 그 정렬이 우선합니다."
                              AutomationProperties.Name="보조영역 전역 정렬" />

                    <!-- 인-셸 가사 줄 간격(§7.3-A) — 폰트 대비 % 로 −/+ 조절. -->
                    <TextBlock Text="줄 간격"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DecreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,6,0"
                                Content="−"
                                ToolTip="줄 간격 좁게"
                                AutomationProperties.Name="줄 간격 좁게" />
                        <Button Command="{Binding IncreaseLyricsLineSpacingCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="44"
                                Margin="0,0,8,0"
                                Content="＋"
                                ToolTip="줄 간격 넓게"
                                AutomationProperties.Name="줄 간격 넓게" />
                        <!-- 직접 수치 입력(FrmMain NumericUpDown 대응) — 범위 밖 값은 자동 클램프, 입력 후 포커스 이동 시 적용. -->
                        <TextBox Text="{Binding LyricsLineSpacingInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="가사 줄 간격 직접 입력 (100~220%) — 숫자가 아니면 빨간 테두리로 표시"
                                 AutomationProperties.Name="가사 줄 간격 직접 입력" />
                        <TextBlock Text="%"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- 본문 여백(FrmMain ShowLeftMargin/ShowRightMargin/ShowBottomMargin) — 본문을 가장자리에서 안쪽으로
                         들여쓴다. 좌/우/아래 3종 직접 수치 입력(0~400px, 범위 밖은 클램프·비숫자는 빨간 테두리). -->
                    <TextBlock Text="본문 여백(px)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 왼쪽 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="왼쪽"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding LyricsLeftMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 왼쪽 여백 (0~400px)"
                                 AutomationProperties.Name="본문 왼쪽 여백 직접 입력" />
                        <!-- 오른쪽 -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="오른쪽"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding LyricsRightMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 오른쪽 여백 (0~400px)"
                                 AutomationProperties.Name="본문 오른쪽 여백 직접 입력" />
                        <!-- 아래 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="아래"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource Type.Body.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding LyricsBottomMarginInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                 MinWidth="48" TextAlignment="Right" VerticalContentAlignment="Center"
                                 ToolTip="본문 아래 여백 (0~400px)"
                                 AutomationProperties.Name="본문 아래 여백 직접 입력" />
                    </Grid>

                    <!-- 인-셸 가사 폰트 효과(§7.3-A) — 굵게/기울임/그림자 토글. 그림자는 어두운/영상 배경 가독성. -->
                    <TextBlock Text="가사 효과"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <ToggleButton IsChecked="{Binding ActiveLyricsBold, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsBoldCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontWeight="Bold"
                                      Content="가"
                                      ToolTip="가사 굵게"
                                      AutomationProperties.Name="가사 굵게 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsItalic, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsItalicCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      FontStyle="Italic"
                                      Content="가"
                                      ToolTip="가사 기울임"
                                      AutomationProperties.Name="가사 기울임 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsUnderline, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsUnderlineCommand}"
                                      MinHeight="36"
                                      MinWidth="48"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      Content="가"
                                      ToolTip="가사 밑줄"
                                      AutomationProperties.Name="가사 밑줄 토글">
                            <ToggleButton.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextDecorations="Underline" />
                                </DataTemplate>
                            </ToggleButton.ContentTemplate>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ActiveLyricsShadow, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsShadowCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="그림자"
                                      ToolTip="가사 그림자(어두운 배경 가독성)"
                                      AutomationProperties.Name="가사 그림자 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsPositionIndicator, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsPositionIndicatorCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="N/M"
                                      ToolTip="절/슬라이드 위치 인디케이터 표시(출력 우하단)"
                                      AutomationProperties.Name="위치 인디케이터 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsTitleHeading, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsTitleHeadingCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Margin="0,0,6,0"
                                      Content="제목"
                                      ToolTip="곡 제목을 가사 위 상단 배너로 표시(§7.3-A)"
                                      AutomationProperties.Name="제목 헤딩 토글" />
                        <ToggleButton IsChecked="{Binding ActiveLyricsOutline, Mode=OneWay}"
                                      Command="{Binding ToggleLyricsOutlineCommand}"
                                      MinHeight="36"
                                      Padding="10,0"
                                      Content="외곽선"
                                      ToolTip="가사 글자에 외곽선(Outline) — 어두운/영상 배경 위 가독성(§7.3-A)"
                                      AutomationProperties.Name="외곽선 효과 토글" />
                    </StackPanel>

                    <!-- 제목 헤딩 정렬(§7.3-A Heading Align) — 헤딩 표시 시 곡 제목을 좌/중/우로. -->
                    <TextBlock Text="제목 정렬"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Left}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="왼쪽"
                                AutomationProperties.Name="제목 왼쪽 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Center}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Margin="0,0,6,0"
                                Content="가운데"
                                AutomationProperties.Name="제목 가운데 정렬" />
                        <Button Command="{Binding ApplyTitleHeadingAlignmentCommand}"
                                CommandParameter="{x:Static settings:LyricsTextAlignment.Right}"
                                Style="{StaticResource EsButton.Secondary}"
                                MinWidth="56"
                                Content="오른쪽"
                                AutomationProperties.Name="제목 오른쪽 정렬" />
                    </StackPanel>
                    <!-- 제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A Heading At First Screen Only). -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFirstScreenOnly, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFirstScreenOnlyCommand}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="첫 절만"
                                  ToolTip="제목 헤딩을 곡 첫 절(첫 화면)에만 표시(§7.3-A)"
                                  AutomationProperties.Name="제목 헤딩 첫 화면만 토글" />
                    <!-- 헤딩이 본문(Region1) 정렬을 따름(FrmMain Def_HeadAlign AsR1) — on 이면 위 제목 정렬(좌/중/우) 무시. -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFollowBody, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFollowBodyCommand}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="본문 정렬 따름"
                                  ToolTip="제목 헤딩이 본문(Region1) 가로 정렬을 그대로 따름(FrmMain AsR1). 켜면 위 좌/중/우 설정은 무시"
                                  AutomationProperties.Name="제목 헤딩 본문 정렬 따름 토글" />
                    <!-- 헤딩이 보조 영역(Region2) 정렬을 따름(FrmMain Def_HeadAlign AsR2) — 이중 언어 곡에서 번역 영역 정렬 추종. AsR1 보다 우선. -->
                    <ToggleButton IsChecked="{Binding ActiveTitleHeadingFollowRegion2, Mode=OneWay}"
                                  Command="{Binding ToggleTitleHeadingFollowRegion2Command}"
                                  HorizontalAlignment="Left"
                                  MinHeight="36"
                                  Padding="10,0"
                                  Margin="0,6,0,0"
                                  Content="보조영역 정렬 따름"
                                  ToolTip="제목 헤딩이 보조 영역(Region2) 가로 정렬을 따름(FrmMain AsR2). 이중 언어 곡용. 켜면 본문 정렬 따름·좌/중/우 설정보다 우선"
                                  AutomationProperties.Name="제목 헤딩 보조영역 정렬 따름 토글" />

                    <!-- 출력 모양 설정 템플릿(§7.3-A) — 현재 모양을 이름으로 저장, 콤보에서 골라 적용/삭제. -->
                    <TextBlock Text="모양 템플릿"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewAppearanceTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="30"
                                 ToolTip="새 템플릿 이름"
                                 AutomationProperties.Name="새 모양 템플릿 이름" />
                        <Button Grid.Column="1"
                                Command="{Binding SaveAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="저장"
                                AutomationProperties.Name="모양 템플릿 저장" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AppearanceTemplateNames}"
                                  SelectedItem="{Binding SelectedAppearanceTemplate, Mode=TwoWay}"
                                  MinHeight="30"
                                  ToolTip="저장된 템플릿"
                                  AutomationProperties.Name="저장된 모양 템플릿" />
                        <Button Grid.Column="1"
                                Command="{Binding ApplyAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="적용"
                                AutomationProperties.Name="모양 템플릿 적용" />
                        <Button Grid.Column="2"
                                Command="{Binding DeleteAppearanceTemplateCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="6,0,0,0"
                                Content="삭제"
                                AutomationProperties.Name="모양 템플릿 삭제" />
                    </Grid>
                    <!-- 출력 모양 기본값 복원(FrmMain Default Layout) — 색·정렬·폰트·효과·여백·패널·그라데이션 등 전체를 기본값으로. -->
                    <Button Command="{Binding ResetOutputAppearanceCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            HorizontalAlignment="Left"
                            MinHeight="32"
                            Padding="12,0"
                            Margin="0,8,0,0"
                            Content="기본값으로 복원"
                            ToolTip="출력 모양(색·정렬·폰트·효과·여백·패널·그라데이션 등) 전체를 기본값으로 되돌립니다(레거시 Default Layout)."
                            AutomationProperties.Name="출력 모양 기본값 복원" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

        <!-- 명령 팔레트 오버레이(§7.4) — CommandPalette.IsOpen 일 때만 표시. 반투명 배경 + 중앙 검색 패널.
             키 처리(↑↓/Enter/Esc·열림 시 포커스)는 코드비하인드(MainWindow.xaml.cs)가 담당한다. -->
        <Border x:Name="CommandPaletteOverlay"
                Background="#99000000"
                Visibility="{Binding CommandPalette.IsOpen, Converter={StaticResource BoolToVis}}"
                MouseDown="CommandPaletteOverlay_MouseDown"
                Panel.ZIndex="100">
            <Border Width="560"
                    MaxHeight="420"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <DockPanel>
                    <TextBox x:Name="CommandPaletteSearchBox"
                             DockPanel.Dock="Top"
                             Text="{Binding CommandPalette.Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown"
                             FontSize="16"
                             Padding="8,6"
                             Margin="0,0,0,8"
                             AutomationProperties.Name="명령 검색" />
                    <ListBox ItemsSource="{Binding CommandPalette.Results}"
                             SelectedItem="{Binding CommandPalette.SelectedCommand, Mode=TwoWay}"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             MaxHeight="320"
                             BorderThickness="0"
                             AutomationProperties.Name="명령 결과 목록">
                        <!-- 항목 레벨 접근성 이름 — 스크린리더가 "명령명, [위험,] 분류"를 한 호흡에 읽게 한다.
                             BasedOn 으로 wpfui 의 기본 ListBoxItem 테마(선택·호버 비주얼)를 보존한 채 이름만 덧입힌다. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding AccessibleName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 좌: 명령 이름/분류, 우: 위험 배지(라이브 송출에 영향 주는 주의 명령). -->
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource Type.Body.Style}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Category}"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>

                                    <!-- 위험 명령(라이브 중지·검은 화면·출력 닫기·화면 비우기·출력 숨김·Go Live)만 빨간 "위험" 배지.
                                         한 사람이 라이브 운영 중 실수로 송출을 끊는 일을 줄이려 눈에 띄게 한다(§7.4 후속). -->
                                    <!-- 배지는 순수 시각 표시. 위험 정보는 항목(ListBoxItem)의 AutomationProperties.Name
                                         (AccessibleName)이 전달하므로, 배지에는 명시적 AutomationProperties.Name 을 두지 않아
                                         항목을 읽을 때 "위험 명령"이 중복 발화되지 않게 한다(WPF 엔 AccessibilityView=Raw 가 없음). -->
                                    <Border Grid.Column="1"
                                            Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource Brush.Status.Danger}"
                                            CornerRadius="{StaticResource CornerRadius.Small}"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="라이브 출력에 영향을 주는 주의 명령">
                                        <!-- Foreground 는 흰색 리터럴 — 배지 배경이 양 테마 모두 진한 빨강이라
                                             테마 토큰(Inverse: 다크에서 검정)보다 흰색이 대비에 안전. -->
                                        <TextBlock Text="위험"
                                                   FontFamily="{DynamicResource Font.Primary}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
