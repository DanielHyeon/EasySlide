<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 신규 WPF 프로젝트 — Sprint 0 PoC 단계. 정식 마이그레이션 산출물의 출발점. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Easislides.Wpf</RootNamespace>
    <!-- 산출물 분리(§9.4/ADR-0007): 신규 WPF 빌드는 EasislidesNext.exe. legacy 는 Easislides.exe.
         RootNamespace 는 그대로 두어 코드 네임스페이스(Easislides.Wpf)는 바뀌지 않는다.
         주의: pack://...;component URI 는 AssemblyName 을 사용하므로 EasislidesNext 로 맞춰야 한다. -->
    <AssemblyName>EasislidesNext</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms=true 사유: (1) HookManager가 System.Windows.Forms.MouseEventArgs 등 사용, (2) Strangler Fig 패턴으로 마이그레이션 기간 동안 WindowsFormsHost로 legacy 폼 임베드 가능성 보존. Sprint 9에서 HookManager를 별도 라이브러리(Easislides.HookManager.csproj)로 추출한 뒤 이 플래그 제거 검토. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 테스트 어셈블리에 internal 멤버 노출(순수 헬퍼 단위 테스트용 — 예: OutputWindow.ShouldClearClip). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Easislides.Wpf.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0001: Fluent 2 컨트롤 라이브러리. EasiDS 토큰으로 비주얼 오버라이딩. -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- MVVM 소스 제너레이터 (ObservableObject, RelayCommand) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- DI 컨테이너 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <!-- PoC-B: PowerPoint COM 호출용. NetOffice 타입이 transitively 전파됨. -->
    <ProjectReference Include="..\OfficeLib\OfficeLib.csproj" />
    <!-- EasiDS 디자인 토큰 강제 분석기 (계획서 §9.2). 실행 어셈블리가 아닌 컴파일러 분석기로만 참조. -->
    <ProjectReference Include="..\Easislides.Analyzers\Easislides.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ADR-0004 PoC-A: HookManager 소스를 file-link로 공유 (복사 X). Sprint 9에 라이브러리로 추출 후 ProjectReference로 교체 예정. -->
  <ItemGroup>
    <Compile Include="..\Easislides\HookManager\HookManager.cs">
      <Link>External\HookManager\HookManager.cs</Link>
    </Compile>
    <Compile Include="..\Easislides\HookManager\HookManager.Callbacks.cs">
      <Link>External\HookManager\HookManager.Callbacks.cs</Link>
    </Compile>
    <Compile Include="..\Easislides\HookManager\HookManager.Windows.cs">
      <Link>External\HookManager\HookManager.Windows.cs</Link>
    </Compile>
    <Compile Include="..\Easislides\HookManager\HookManager.Structures.cs">
      <Link>External\HookManager\HookManager.Structures.cs</Link>
    </Compile>
    <Compile Include="..\Easislides\HookManager\GlobalEventProvider.cs">
      <Link>External\HookManager\GlobalEventProvider.cs</Link>
    </Compile>
    <Compile Include="..\Easislides\HookManager\MouseEventExtArgs.cs">
      <Link>External\HookManager\MouseEventExtArgs.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- 폰트 자산 (ADR-0003 / Q4). Pretendard Variable v1.3.9 번들. OFL 1.1 라이선스 동봉 의무. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\PretendardVariable.ttf" />
    <Content Include="Assets\Fonts\Pretendard-OFL-1.1-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
