<Window x:Class="Easislides.Wpf.Support.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides 정보"
        Width="680"
        Height="620"
        MinWidth="560"
        MinHeight="520"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding ProductName}"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding VersionLabel}"
                       Style="{StaticResource Type.Body.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding Copyright}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="등록 사용자"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding RegistrationUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="등록 사용자"
                         Margin="0,4,0,16"
                         MinHeight="36" />

                <TextBlock Text="웹사이트"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBlock Text="{Binding WebsiteUrl}"
                           Style="{StaticResource Type.Body.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,4,0,16" />

                <TextBlock Text="라이선스"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding EulaText}"
                         AutomationProperties.Name="라이선스 본문"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="220"
                         Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2"
                   Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding OpenWebsiteCommand}"
                        Style="{StaticResource EsButton.Secondary}"
                        ToolTip="EasiSlides 웹사이트 열기"
                        AutomationProperties.Name="EasiSlides 웹사이트 열기"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                        <TextBlock Text="웹사이트" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSystemInfoCommand}"
                        Style="{StaticResource EsButton.Secondary}"
                        ToolTip="Windows 시스템 정보 열기"
                        AutomationProperties.Name="Windows 시스템 정보 열기"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                        <TextBlock Text="시스템 정보" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveRegistrationUserCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="등록 사용자 저장"
                        AutomationProperties.Name="등록 사용자 저장"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="저장" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="정보 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
