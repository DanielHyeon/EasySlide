<Window x:Class="Easislides.Wpf.Library.ExternalFileOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="외부 파일 복사/이동"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="외부 파일 복사/이동"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding WorkingFolder}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="파일 종류"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding ItemKinds}"
                          SelectedItem="{Binding ItemKind, Mode=TwoWay}"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="외부 파일 종류" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="작업"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding OperationKinds}"
                          SelectedItem="{Binding OperationKind, Mode=TwoWay}"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="외부 파일 작업" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="대상"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding DestinationKinds}"
                          SelectedItem="{Binding DestinationKind, Mode=TwoWay}"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="외부 파일 대상 종류" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.ColumnSpan="3"
                       Margin="0,0,0,8">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource EsButton.Secondary}"
                        Click="AddFiles_Click"
                        ToolTip="처리할 외부 파일 추가"
                        AutomationProperties.Name="외부 파일 추가"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                        <TextBlock Text="파일 추가" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left"
                        Command="{Binding RemoveSourceFileCommand}"
                        Style="{StaticResource EsButton.Secondary}"
                        ToolTip="선택 파일 제거"
                        AutomationProperties.Name="외부 파일 제거">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="제거" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      AutomationProperties.Name="외부 파일 목록"
                      ItemsSource="{Binding SourceFiles}"
                      SelectedItem="{Binding SelectedSourceFile, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="파일"
                                        Binding="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="경로"
                                        Binding="{Binding Path}"
                                        IsReadOnly="True"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2"
                        Grid.Row="1">
                <TextBlock Text="외부 대상 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ListBox ItemsSource="{Binding ExternalFolders}"
                         SelectedItem="{Binding SelectedExternalFolder, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         MinHeight="180"
                         Margin="0,4,0,16"
                         AutomationProperties.Name="외부 대상 폴더" />

                <TextBlock Text="곡 대상 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ListBox ItemsSource="{Binding SongFolders}"
                         SelectedItem="{Binding SelectedSongFolder, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         MinHeight="180"
                         Margin="0,4,0,0"
                         IsEnabled="{Binding CanUseSongFolderDestination}"
                         AutomationProperties.Name="곡 대상 폴더" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding ExecuteCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="외부 파일 처리 실행"
                        AutomationProperties.Name="외부 파일 처리 실행"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowExport24" Margin="0,0,6,0" />
                        <TextBlock Text="실행" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="외부 파일 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
