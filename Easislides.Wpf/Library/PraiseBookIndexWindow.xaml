<Window x:Class="Easislides.Wpf.Library.PraiseBookIndexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="찬양집 — 색인 · 저장/불러오기"
        Width="560"
        Height="620"
        MinWidth="460"
        MinHeight="460"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="곡 목록을 머리글자(ㄱ~ㅎ · A~Z · # · 기타)별로 묶어 보여 주고, 이름 붙여 찬양집으로 저장·불러올 수 있습니다."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- 찬양집 저장/불러오기 줄 — 저장된 찬양집 선택 + 열기/삭제 + 현재 목록 저장. -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="찬양집"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      x:Name="SavedBooksCombo"
                      ItemsSource="{Binding SavedBooks}"
                      VerticalContentAlignment="Center"
                      AutomationProperties.Name="저장된 찬양집 목록" />
            <Button Grid.Column="2"
                    Click="OpenBook_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="8,0,0,0"
                    Content="열기"
                    AutomationProperties.Name="선택 찬양집 열기" />
            <Button Grid.Column="3"
                    Click="DeleteBook_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="8,0,0,0"
                    Content="삭제"
                    AutomationProperties.Name="선택 찬양집 삭제" />
            <Button Grid.Column="4"
                    Click="SaveBook_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="8,0,0,0"
                    Content="현재 목록 저장..."
                    AutomationProperties.Name="현재 목록을 찬양집으로 저장" />
        </Grid>

        <!-- 머리글자 그룹 → 각 그룹의 곡 제목. ItemsControl 중첩으로 색인 형태로 표시. -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      BorderBrush="{DynamicResource Brush.Border.Default}"
                      BorderThickness="1">
            <ItemsControl ItemsSource="{Binding Groups}"
                          Margin="8"
                          AutomationProperties.Name="찬양집 색인 그룹">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Key}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Margin="0,0,0,4" />
                            <Border Height="1"
                                    Background="{DynamicResource Brush.Border.Default}"
                                    Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Number}"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Click="Close_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Content="닫기"
                    AutomationProperties.Name="닫기" />
        </StackPanel>
    </Grid>
</Window>
