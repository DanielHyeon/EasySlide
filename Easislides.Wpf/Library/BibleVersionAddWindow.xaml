<Window x:Class="Easislides.Wpf.Library.BibleVersionAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="성경 버전 추가"
        Width="440"
        Height="420"
        MinWidth="380"
        MinHeight="340"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="추가할 성경 파일을 고르고 표시 이름을 입력하세요(HolyBibles 폴더의 파일)."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- 추가 후보 목록: 숨김 복구 + 신규 파일. 선택 시 이름칸을 제안 이름으로 채운다. -->
        <ListBox Grid.Row="1"
                 x:Name="CandidateList"
                 SelectionChanged="CandidateList_SelectionChanged"
                 AutomationProperties.Name="추가 가능한 성경 파일 목록"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SuggestedName}"
                                       Style="{StaticResource Type.Body.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <!-- 숨김 복구/신규를 색뿐 아니라 텍스트로도 구분(접근성). -->
                            <TextBlock Text="숨김 복구"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   Text="표시 이름:"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="0,10,0,4" />

        <TextBox Grid.Row="3"
                 x:Name="NameBox"
                 Style="{StaticResource EsTextBox.Default}"
                 TextChanged="NameBox_TextChanged"
                 AutomationProperties.Name="추가할 버전 이름" />

        <!-- 빈 이름·중복일 때만 빨간 안내가 보인다. -->
        <TextBlock Grid.Row="4"
                   x:Name="ErrorText"
                   Foreground="{DynamicResource Brush.Status.Danger}"
                   Style="{StaticResource Type.Caption.Style}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="취소"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="취소" />
            <Button x:Name="OkButton"
                    Content="추가"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Ok_Click"
                    Style="{StaticResource EsButton.Primary}"
                    AutomationProperties.Name="성경 버전 추가 확인" />
        </StackPanel>
    </Grid>
</Window>
