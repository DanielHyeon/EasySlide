<Window x:Class="Easislides.Wpf.Library.BibleVersionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="성경 버전 관리"
        Width="460"
        Height="440"
        MinWidth="380"
        MinHeight="360"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="성경 버전 이름을 바꿀 수 있습니다(본문은 그대로)."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,0,0,8" />

        <!-- 버전 목록 — 이름 표시. -->
        <ListBox Grid.Row="1"
                 x:Name="VersionList"
                 ItemsSource="{Binding Versions}"
                 DisplayMemberPath="Name"
                 AutomationProperties.Name="성경 버전 목록"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1" />

        <!-- 검증/상태 메시지(이름 변경 결과·중복 안내). -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Status.Danger}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Click="Rename_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="0,0,8,0"
                    Content="이름 변경"
                    AutomationProperties.Name="선택 버전 이름 변경" />
            <Button Click="Close_Click"
                    Style="{StaticResource EsButton.Primary}"
                    Content="닫기"
                    AutomationProperties.Name="닫기" />
        </StackPanel>
    </Grid>
</Window>
