<Window x:Class="Easislides.Wpf.Library.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="폴더 편집"
        Width="500"
        Height="360"
        MinWidth="460"
        MinHeight="320"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="폴더 편집"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding FolderNo, StringFormat=Folder {0}}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="폴더 번호"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding FolderNo}"
                         IsReadOnly="True"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="폴더 번호" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,14">
                <TextBlock Text="폴더 이름"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="폴더 이름" />
            </StackPanel>

            <CheckBox Grid.Row="2"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                      Content="사용"
                      AutomationProperties.Name="폴더 사용 여부" />
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="폴더 저장"
                        AutomationProperties.Name="폴더 저장"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="저장" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="폴더 편집 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
