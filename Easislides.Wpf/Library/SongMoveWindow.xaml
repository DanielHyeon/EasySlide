<Window x:Class="Easislides.Wpf.Library.SongMoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="곡 이동"
        Width="520"
        Height="360"
        MinWidth="480"
        MinHeight="320"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="곡 이동"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding SongTitle}"
                       Style="{StaticResource Type.BodyLarge.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="현재 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding SourceFolderName}"
                         IsReadOnly="True"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="현재 폴더" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="대상 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding TargetFolders}"
                          SelectedItem="{Binding SelectedTargetFolder, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="대상 폴더" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding MoveCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="선택 곡 이동"
                        AutomationProperties.Name="선택 곡 이동"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,6,0" />
                        <TextBlock Text="이동" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="곡 이동 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
