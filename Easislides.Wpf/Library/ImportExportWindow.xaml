<Window x:Class="Easislides.Wpf.Library.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Import/Export"
        Width="1080"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="{StaticResource Thickness.Lg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Import/Export"
                           Style="{StaticResource Type.H2.Style}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource EsButton.Secondary}"
                    Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" Margin="0,0,6,0" />
                    <TextBlock Text="Reload" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1"
                    Margin="0,16,0,0">
            <TabItem Header="Import">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Source"
                               Style="{StaticResource Type.Caption.Style}" />
                    <DockPanel Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Margin="0,4,0,12">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0">
                            <Button Click="BrowseImportFile_Click"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.DocumentWord}" Margin="0,0,6,0" />
                                    <TextBlock Text="File" />
                                </StackPanel>
                            </Button>
                            <Button Click="BrowseImportFolder_Click"
                                    Style="{StaticResource EsButton.Secondary}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" Margin="0,0,6,0" />
                                    <TextBlock Text="Folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox AutomationProperties.Name="가져오기 원본 경로"
                                 Text="{Binding ImportSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Margin="0,0,0,12"
                          Visibility="{Binding IsAccessImportSource, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Access Table"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Column="1"
                                   Text="Title"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Column="2"
                                   Text="Lyrics Merge"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Column="3"
                                   Text="Alt Title"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Column="4"
                                   Text="Song No."
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Column="5"
                                   Text="Writer"
                                   Style="{StaticResource Type.Caption.Style}" />

                        <DockPanel Grid.Row="1"
                                   Margin="0,4,8,10">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadAccessSchemaCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Margin="6,0,0,0"
                                    ToolTip="Load MDB schema">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" />
                            </Button>
                            <ComboBox AutomationProperties.Name="Access 테이블 선택"
                                      ItemsSource="{Binding AccessTables}"
                                      SelectedItem="{Binding SelectedAccessTable}"
                                      DisplayMemberPath="Name"
                                      MinHeight="36" />
                        </DockPanel>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  AutomationProperties.Name="제목 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessTitleColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,10" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 AutomationProperties.Name="가사 병합 열 매핑"
                                 Text="{Binding AccessLyricsColumnsText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 Margin="0,4,8,10" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="3"
                                  AutomationProperties.Name="대체 제목 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessAlternateTitleColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,10" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="4"
                                  AutomationProperties.Name="찬송 번호 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessSongNumberColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,10" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="5"
                                  AutomationProperties.Name="작사작곡 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessWriterColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,0,10" />

                        <TextBlock Grid.Row="2"
                                   Text="Copyright"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Key"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="Timing"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="Book Ref."
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="4"
                                   Text="User Ref."
                                   Style="{StaticResource Type.Caption.Style}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="5"
                                   Text="Admin"
                                   Style="{StaticResource Type.Caption.Style}" />

                        <ComboBox Grid.Row="3"
                                  AutomationProperties.Name="저작권 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessCopyrightColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,0" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="1"
                                  AutomationProperties.Name="조(Key) 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessKeyColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,0" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="2"
                                  AutomationProperties.Name="타이밍 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessTimingColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,0" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="3"
                                  AutomationProperties.Name="교단 참조 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessBookReferenceColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,0" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="4"
                                  AutomationProperties.Name="사용자 참조 열 매핑"
                                  ItemsSource="{Binding AccessColumns}"
                                  Text="{Binding AccessUserReferenceColumn, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  Margin="0,4,8,0" />
                        <Grid Grid.Row="3"
                              Grid.Column="5"
                              Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox AutomationProperties.Name="라이선스 관리자1 열 매핑"
                                      ItemsSource="{Binding AccessColumns}"
                                      Text="{Binding AccessLicenceAdmin1Column, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      MinHeight="36"
                                      Margin="0,0,4,0" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="라이선스 관리자2 열 매핑"
                                      ItemsSource="{Binding AccessColumns}"
                                      Text="{Binding AccessLicenceAdmin2Column, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      MinHeight="36" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Grid.Column="0">
                        <TextBlock Text="Source Folders"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <DataGrid AutomationProperties.Name="가져오기 원본 폴더 목록"
                                  ItemsSource="{Binding ImportSourceFolders}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Margin="0,4,12,0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header=""
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="48" />
                                <DataGridTextColumn Header="Folder"
                                                    Binding="{Binding Name}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Songs"
                                                    Binding="{Binding SongCount}"
                                                    Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Target"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <ComboBox AutomationProperties.Name="가져오기 대상 폴더"
                                  ItemsSource="{Binding Folders}"
                                  SelectedItem="{Binding SelectedTargetFolder}"
                                  DisplayMemberPath="Name"
                                  MinHeight="36"
                                  Margin="0,4,0,12" />
                        <TextBlock Text="Duplicates"
                                   Style="{StaticResource Type.Caption.Style}" />
                        <ComboBox AutomationProperties.Name="중복 처리 정책"
                                  ItemsSource="{Binding DuplicatePolicies}"
                                  SelectedItem="{Binding ImportDuplicatePolicy}"
                                  MinHeight="36"
                                  Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Grid.Column="2">
                        <Button Command="{Binding PreviewImportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" Margin="0,0,6,0" />
                                <TextBlock Text="Preview" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCommand}"
                                Style="{StaticResource EsButton.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionAdd}" Margin="0,0,6,0" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Export">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Folder"
                               Style="{StaticResource Type.Caption.Style}" />
                    <TextBlock Grid.Column="1"
                               Text="Format"
                               Style="{StaticResource Type.Caption.Style}" />
                    <ComboBox Grid.Row="1"
                              AutomationProperties.Name="내보내기 폴더"
                              ItemsSource="{Binding Folders}"
                              SelectedItem="{Binding SelectedExportFolder}"
                              DisplayMemberPath="Name"
                              MinHeight="36"
                              Margin="0,4,12,12" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              AutomationProperties.Name="내보내기 형식"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}"
                              MinHeight="36"
                              Margin="0,4,12,12" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding RefreshExportCandidatesCommand}"
                            Style="{StaticResource EsButton.Secondary}"
                            Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" Margin="0,0,6,0" />
                            <TextBlock Text="Find" />
                        </StackPanel>
                    </Button>

                    <GroupBox Grid.Row="2"
                              Grid.ColumnSpan="3"
                              Header="Praise Book Options"
                              Margin="0,0,0,12">
                        <WrapPanel Margin="8,6,8,8">
                            <CheckBox Content="No."
                                      IsChecked="{Binding ExportIncludeSongNumber}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Title"
                                      IsChecked="{Binding ExportIncludeTitle}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Copyright"
                                      IsChecked="{Binding ExportIncludeCopyright}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Book Ref."
                                      IsChecked="{Binding ExportIncludeBookReference}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="User Ref."
                                      IsChecked="{Binding ExportIncludeUserReference}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Key"
                                      IsChecked="{Binding ExportIncludeKey}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Capo"
                                      IsChecked="{Binding ExportIncludeCapo}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Timing"
                                      IsChecked="{Binding ExportIncludeTiming}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Chords"
                                      IsChecked="{Binding ExportIncludeNotations}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Index"
                                      IsChecked="{Binding ExportIncludeIndex}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                            <CheckBox Content="Page per song"
                                      IsChecked="{Binding ExportOneSongPerPage}"
                                      Margin="0,0,16,6"
                                      MinHeight="28" />
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="3"
                              Grid.ColumnSpan="3"
                              AutomationProperties.Name="내보내기 후보 목록"
                              ItemsSource="{Binding ExportCandidates}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="48" />
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Folder"
                                                Binding="{Binding FolderName}"
                                                Width="*" />
                            <DataGridTextColumn Header="No"
                                                Binding="{Binding SongNumber}"
                                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4"
                               Grid.ColumnSpan="3"
                               Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right"
                                Click="BrowseExportPath_Click"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.FolderOpen}" Margin="0,0,6,0" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ExportRtf}" Margin="0,0,6,0" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                        <TextBox AutomationProperties.Name="내보내기 출력 경로"
                                 Text="{Binding ExportOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource Brush.Status.Danger}"
                           Style="{StaticResource Type.Caption.Style}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Style="{StaticResource Type.Caption.Style}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Click="Close_Click"
                    Style="{StaticResource EsButton.Secondary}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                    <TextBlock Text="Close" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
