<Window x:Class="Easislides.Wpf.Library.SearchUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        Title="검색 및 사용 현황"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="검색 및 사용 현황"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    VerticalAlignment="Top"
                    ToolTip="검색 데이터 새로고침"
                    AutomationProperties.Name="검색 데이터 새로고침">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                    <TextBlock Text="새로고침" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="곡">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 곡 검색 쿼리 폼 — 재사용 컴포지트로 분리(§5.2). DataContext 상속. -->
                    <composites:SongSearchQueryPanel />

                    <DataGrid Grid.Column="2"
                              AutomationProperties.Name="검색 결과 목록"
                              ItemsSource="{Binding SearchResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="폴더" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="번호" Binding="{Binding SongNumber}" Width="70" />
                            <DataGridTextColumn Header="키" Binding="{Binding Key}" Width="70" />
                            <DataGridTextColumn Header="일치 항목" Binding="{Binding MatchingFields[0]}" Width="110" />
                            <DataGridTextColumn Header="발췌" Binding="{Binding Snippet}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="제목">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="320"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="제목 검색어"
                                 Margin="0,0,10,0" />
                        <Button Command="{Binding LookupTitlesCommand}"
                                Style="{StaticResource EsButton.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                <TextBlock Text="조회" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              AutomationProperties.Name="제목 조회 결과"
                              ItemsSource="{Binding LookupCandidates}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="다른 제목" Binding="{Binding AlternateTitle}" Width="2*" />
                            <DataGridTextColumn Header="폴더" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="교단 참조" Binding="{Binding BookReference}" Width="*" />
                            <DataGridTextColumn Header="사용자 참조" Binding="{Binding UserReference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="사용 현황">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <DatePicker SelectedDate="{Binding UsageFrom}" Width="150" Margin="0,0,8,8" />
                        <DatePicker SelectedDate="{Binding UsageTo}" Width="150" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding UsageSessions}"
                                  SelectedItem="{Binding SelectedUsageSession}"
                                  AutomationProperties.Name="사용 세션 선택"
                                  Width="180"
                                  Margin="0,0,8,8" />
                        <Button Command="{Binding RefreshUsageCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                                <TextBlock Text="불러오기" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectedUsageCommand}"
                                Style="{StaticResource EsButton.Danger}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                <TextBlock Text="삭제" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseUsageReport_Click"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="사용 보고서 저장 경로 찾아보기"
                                AutomationProperties.Name="사용 보고서 경로 찾아보기"
                                Margin="0,0,8,8">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>
                        <Button Command="{Binding ExportUsageReportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="사용 보고서를 RTF로 내보내기"
                                AutomationProperties.Name="RTF 내보내기"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0" />
                                <TextBlock Text="RTF 내보내기" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid AutomationProperties.Name="사용 기록 목록"
                                  ItemsSource="{Binding UsageRecords}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="46" />
                                <DataGridTextColumn Header="날짜" Binding="{Binding WorshipDate, StringFormat=yyyy-MM-dd}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="예배 순서" Binding="{Binding WorshipList}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="제목" Binding="{Binding SongTitle}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="번호" Binding="{Binding SongNumber}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="2"
                                  AutomationProperties.Name="사용 요약"
                                  ItemsSource="{Binding UsageSummary}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="횟수" Binding="{Binding Occurrences}" Width="80" />
                                <DataGridTextColumn Header="제목" Binding="{Binding SongTitle}" Width="*" />
                                <DataGridTextColumn Header="번호" Binding="{Binding SongNumber}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource Brush.Status.Danger}"
                       Style="{StaticResource Type.Caption.Style}"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Style="{StaticResource Type.Caption.Style}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <Button Click="Close_Click"
                        Style="{StaticResource EsButton.Secondary}">
                    <TextBlock Text="닫기" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
