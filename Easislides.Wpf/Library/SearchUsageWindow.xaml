<Window x:Class="Easislides.Wpf.Library.SearchUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Search and Usage"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Search and Usage"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    VerticalAlignment="Top"
                    ToolTip="Refresh search data"
                    AutomationProperties.Name="Refresh search data">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Songs">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Medium}"
                            Padding="{StaticResource Thickness.Lg}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Query"
                                           Style="{StaticResource Type.Title3.Style}"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="검색어"
                                         Margin="0,10,0,12" />
                                <UniformGrid Columns="2">
                                    <CheckBox Content="Title" IsChecked="{Binding SearchTitle}" Margin="0,0,8,8" />
                                    <CheckBox Content="Lyrics" IsChecked="{Binding SearchLyrics}" Margin="0,0,8,8" />
                                    <CheckBox Content="No." IsChecked="{Binding SearchSongNumber}" Margin="0,0,8,8" />
                                    <CheckBox Content="Book" IsChecked="{Binding SearchBookReference}" Margin="0,0,8,8" />
                                    <CheckBox Content="User" IsChecked="{Binding SearchUserReference}" Margin="0,0,8,8" />
                                    <CheckBox Content="Admin" IsChecked="{Binding SearchLicenceAdmin}" Margin="0,0,8,8" />
                                    <CheckBox Content="Writer" IsChecked="{Binding SearchWriter}" Margin="0,0,8,8" />
                                    <CheckBox Content="Copyright" IsChecked="{Binding SearchCopyright}" Margin="0,0,8,8" />
                                </UniformGrid>
                                <TextBlock Text="Key"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBox Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="조(Key) 검색"
                                         Margin="0,4,0,10" />
                                <TextBlock Text="Timing"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBox Text="{Binding SearchTiming, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="타이밍 검색"
                                         Margin="0,4,0,10" />
                                <CheckBox Content="With notations"
                                          IsChecked="{Binding NotationsOnly}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Media items"
                                          IsChecked="{Binding MediaOnly}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Modified date"
                                          IsChecked="{Binding UseModifiedDates}"
                                          Margin="0,0,0,8" />
                                <DatePicker SelectedDate="{Binding ModifiedFrom}" Margin="0,0,0,6" />
                                <DatePicker SelectedDate="{Binding ModifiedTo}" Margin="0,0,0,14" />
                                <TextBlock Text="Folders"
                                           Style="{StaticResource Type.Title3.Style}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SearchFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding SearchSongsCommand}"
                                        Style="{StaticResource EsButton.Primary}"
                                        Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                        <TextBlock Text="Search" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <DataGrid Grid.Column="2"
                              AutomationProperties.Name="검색 결과 목록"
                              ItemsSource="{Binding SearchResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="No." Binding="{Binding SongNumber}" Width="70" />
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="70" />
                            <DataGridTextColumn Header="Match" Binding="{Binding MatchingFields[0]}" Width="110" />
                            <DataGridTextColumn Header="Snippet" Binding="{Binding Snippet}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Titles">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="320"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="제목 검색어"
                                 Margin="0,0,10,0" />
                        <Button Command="{Binding LookupTitlesCommand}"
                                Style="{StaticResource EsButton.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                <TextBlock Text="Lookup" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              AutomationProperties.Name="제목 조회 결과"
                              ItemsSource="{Binding LookupCandidates}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Alt" Binding="{Binding AlternateTitle}" Width="2*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="*" />
                            <DataGridTextColumn Header="Book" Binding="{Binding BookReference}" Width="*" />
                            <DataGridTextColumn Header="User" Binding="{Binding UserReference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Usage">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <DatePicker SelectedDate="{Binding UsageFrom}" Width="150" Margin="0,0,8,8" />
                        <DatePicker SelectedDate="{Binding UsageTo}" Width="150" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding UsageSessions}"
                                  SelectedItem="{Binding SelectedUsageSession}"
                                  AutomationProperties.Name="사용 세션 선택"
                                  Width="180"
                                  Margin="0,0,8,8" />
                        <Button Command="{Binding RefreshUsageCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                                <TextBlock Text="Load" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectedUsageCommand}"
                                Style="{StaticResource EsButton.Danger}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseUsageReport_Click"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="사용 보고서 저장 경로 찾아보기"
                                AutomationProperties.Name="사용 보고서 경로 찾아보기"
                                Margin="0,0,8,8">
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </Button>
                        <Button Command="{Binding ExportUsageReportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0" />
                                <TextBlock Text="RTF" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid AutomationProperties.Name="사용 기록 목록"
                                  ItemsSource="{Binding UsageRecords}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="46" />
                                <DataGridTextColumn Header="Date" Binding="{Binding WorshipDate, StringFormat=yyyy-MM-dd}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="List" Binding="{Binding WorshipList}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Title" Binding="{Binding SongTitle}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="No." Binding="{Binding SongNumber}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="2"
                                  AutomationProperties.Name="사용 요약"
                                  ItemsSource="{Binding UsageSummary}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Count" Binding="{Binding Occurrences}" Width="80" />
                                <DataGridTextColumn Header="Title" Binding="{Binding SongTitle}" Width="*" />
                                <DataGridTextColumn Header="No." Binding="{Binding SongNumber}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource Brush.Status.Danger}"
                       Style="{StaticResource Type.Caption.Style}"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Style="{StaticResource Type.Caption.Style}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <Button Click="Close_Click"
                        Style="{StaticResource EsButton.Secondary}">
                    <TextBlock Text="Close" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
