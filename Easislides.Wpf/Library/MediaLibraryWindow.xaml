<Window x:Class="Easislides.Wpf.Library.MediaLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="미디어 폴더 찾아보기"
        Width="560"
        Height="540"
        MinWidth="440"
        MinHeight="400"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="폴더의 동영상·오디오 파일을 골라 예배 순서에 추가합니다."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FolderPath}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource Brush.Border.Default}"
                     BorderThickness="1"
                     AutomationProperties.Name="미디어 폴더 경로" />
            <Button Grid.Column="1"
                    Click="ChangeFolder_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="8,0,8,0"
                    Content="폴더 변경..."
                    AutomationProperties.Name="미디어 폴더 변경" />
            <Button Grid.Column="2"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="새로고침"
                    AutomationProperties.Name="목록 새로고침" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox VerticalAlignment="Center"
                      IsChecked="{Binding IncludeSubfolders}"
                      Content="하위 폴더 포함"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      AutomationProperties.Name="하위 폴더 포함" />
            <!-- 검색 상자 — 파일명으로 빠르게 거르기(대소문자 무시, 비우면 전부). 입력 즉시 목록 갱신. -->
            <TextBox Grid.Column="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="16,0,0,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource Brush.Border.Default}"
                     BorderThickness="1"
                     ToolTip="파일명으로 검색(대소문자 무시). 비우면 전체 보기."
                     AutomationProperties.Name="미디어 파일 검색" />
        </Grid>

        <ListBox Grid.Row="3"
                 x:Name="MediaList"
                 ItemsSource="{Binding MediaFiles}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 DisplayMemberPath="FileName"
                 MouseDoubleClick="MediaList_MouseDoubleClick"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 AutomationProperties.Name="미디어 파일 목록" />

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Command="{Binding AddSelectedCommand}"
                    Style="{StaticResource EsButton.Primary}"
                    Margin="0,0,8,0"
                    Content="예배 순서에 추가"
                    AutomationProperties.Name="선택 미디어를 예배 순서에 추가" />
            <Button Click="Close_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="닫기"
                    AutomationProperties.Name="닫기" />
        </StackPanel>
    </Grid>
</Window>
