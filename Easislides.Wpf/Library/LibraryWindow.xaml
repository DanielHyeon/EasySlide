<Window x:Class="Easislides.Wpf.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EasiSlides 라이브러리"
        Width="1060"
        Height="700"
        MinWidth="920"
        MinHeight="600"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="라이브러리"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DatabasePath}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    ToolTip="라이브러리 새로 고침"
                    AutomationProperties.Name="라이브러리 새로 고침"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                    <TextBlock Text="새로 고침" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" />
                            <TextBlock Text="폴더"
                                       Style="{StaticResource Type.Title3.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Click="NewFolder_Click"
                                ToolTip="폴더 추가"
                                AutomationProperties.Name="폴더 추가"
                                Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="Add24" />
                        </Button>

                        <Button Grid.Column="2"
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Click="EditFolder_Click"
                                ToolTip="선택 폴더 편집"
                                AutomationProperties.Name="선택 폴더 편집">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </Button>
                        <Button Grid.Column="3"
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Command="{Binding MoveSelectedFolderUpCommand}"
                                ToolTip="Move folder up"
                                AutomationProperties.Name="Move folder up"
                                Margin="6,0,6,0">
                            <ui:SymbolIcon Symbol="ArrowUp24" />
                        </Button>
                        <Button Grid.Column="4"
                                Width="34"
                                Height="34"
                                Style="{StaticResource EsButton.Secondary}"
                                Command="{Binding MoveSelectedFolderDownCommand}"
                                ToolTip="Move folder down"
                                AutomationProperties.Name="Move folder down">
                            <ui:SymbolIcon Symbol="ArrowDown24" />
                        </Button>
                    </Grid>

                    <ListBox x:Name="FolderList"
                             ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="Reorder_PreviewMouseLeftButtonDown"
                             MouseMove="FolderList_MouseMove"
                             DragOver="Reorder_DragOver"
                             Drop="FolderList_Drop"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="42"
                                      Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Type.BodyLarge.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderNo, StringFormat=Folder {0}}"
                                                   Style="{StaticResource Type.Caption.Style}"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SongCount}"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                     VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayedSongCount, StringFormat={}{0}곡 표시}"
                                       Style="{StaticResource Type.Title3.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Orientation="Horizontal">
                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="NewSong_Click"
                                    ToolTip="새 곡 만들기"
                                    AutomationProperties.Name="새 곡 만들기"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                    <TextBlock Text="새 곡" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="EditSong_Click"
                                    ToolTip="선택 곡 편집"
                                    AutomationProperties.Name="선택 곡 편집"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                                    <TextBlock Text="편집" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="CopySong_Click"
                                    ToolTip="선택 곡 복사"
                                    AutomationProperties.Name="선택 곡 복사"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" />
                                    <TextBlock Text="복사" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="MoveSong_Click"
                                    ToolTip="선택 곡 이동"
                                    AutomationProperties.Name="선택 곡 이동"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,6,0" />
                                    <TextBlock Text="이동" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Command="{Binding MoveSelectedSongUpCommand}"
                                    ToolTip="Move song up"
                                    AutomationProperties.Name="Move song up"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUp24" Margin="0,0,6,0" />
                                    <TextBlock Text="Up" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Command="{Binding MoveSelectedSongDownCommand}"
                                    ToolTip="Move song down"
                                    AutomationProperties.Name="Move song down"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDown24" Margin="0,0,6,0" />
                                    <TextBlock Text="Down" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Danger}"
                                    Click="DeleteSong_Click"
                                    ToolTip="선택 곡 삭제"
                                    AutomationProperties.Name="선택 곡 삭제"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                    <TextBlock Text="삭제" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource EsButton.Secondary}"
                                    Click="RecoverSong_Click"
                                    ToolTip="삭제 곡 복구"
                                    AutomationProperties.Name="삭제 곡 복구"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUndo24" Margin="0,0,6,0" />
                                    <TextBlock Text="복구" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Margin="0,0,0,12"
                             ToolTip="제목, 분류, 가사 검색"
                             AutomationProperties.Name="라이브러리 검색" />

                    <DataGrid x:Name="SongsGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding Songs}"
                              SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="Reorder_PreviewMouseLeftButtonDown"
                              MouseMove="SongsGrid_MouseMove"
                              DragOver="Reorder_DragOver"
                              Drop="SongsGrid_Drop"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="번호"
                                                Binding="{Binding SongNumber}"
                                                Width="70" />
                            <DataGridTextColumn Header="제목"
                                                Binding="{Binding Title}"
                                                Width="2*" />
                            <DataGridTextColumn Header="대체 제목"
                                                Binding="{Binding AlternateTitle}"
                                                Width="*" />
                            <DataGridTextColumn Header="분류"
                                                Binding="{Binding Category}"
                                                Width="*" />
                            <DataGridTextColumn Header="키"
                                                Binding="{Binding Key}"
                                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Padding="{StaticResource Thickness.Lg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="선택 항목"
                               Style="{StaticResource Type.Title3.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedSong.Title}"
                                   Style="{StaticResource Type.BodyLarge.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedSong.Category}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedSong.Lyrics}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="{DynamicResource Brush.Surface.Page}" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource EsButton.Secondary}"
                    Click="Close_Click"
                    ToolTip="닫기"
                    AutomationProperties.Name="라이브러리 창 닫기"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                    <TextBlock Text="닫기" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
