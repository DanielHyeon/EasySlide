<Window x:Class="Easislides.Wpf.Library.SongMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="스마트 병합"
        Width="820"
        Height="620"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="스마트 병합"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding DatabasePath}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Source A"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedSourceFolderA, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="Source A 폴더" />
                <CheckBox Content="대체 제목으로 매칭"
                          IsChecked="{Binding UseSourceAAlternateTitle, Mode=TwoWay}"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Source A 대체 제목 매칭" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Source B"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedSourceFolderB, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="Source B 폴더" />
                <CheckBox Content="대체 제목으로 매칭"
                          IsChecked="{Binding UseSourceBAlternateTitle, Mode=TwoWay}"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Source B 대체 제목 매칭" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="대상 폴더"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedTargetFolder, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinHeight="36"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="대상 폴더" />
                <CheckBox Content="Source B 제목을 병합 제목에 추가"
                          IsChecked="{Binding AppendSourceBTitleToMergedTitle, Mode=TwoWay}"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Source B 제목 추가" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <CheckBox DockPanel.Dock="Left"
                          Content="전체 선택"
                          IsChecked="{Binding AreAllCandidatesSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="병합 후보 전체 선택" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding RefreshMatchesCommand}"
                        Style="{StaticResource EsButton.Secondary}"
                        ToolTip="병합 후보 조회"
                        AutomationProperties.Name="병합 후보 조회"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                        <TextBlock Text="후보 조회" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      AutomationProperties.Name="병합 후보 목록"
                      ItemsSource="{Binding Candidates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="48" />
                    <DataGridTextColumn Header="병합 제목"
                                        Binding="{Binding MergeTitle}"
                                        IsReadOnly="True"
                                        Width="2*" />
                    <DataGridTextColumn Header="Source A"
                                        Binding="{Binding SourceATitle}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Source B"
                                        Binding="{Binding SourceBTitle}"
                                        IsReadOnly="True"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="3"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding MergeCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="선택 후보 병합"
                        AutomationProperties.Name="선택 후보 병합"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" />
                        <TextBlock Text="병합" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="스마트 병합 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
