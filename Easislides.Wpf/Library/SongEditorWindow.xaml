<Window x:Class="Easislides.Wpf.Library.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="곡 편집"
        Width="720"
        Height="640"
        MinWidth="620"
        MinHeight="540"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="곡 편집"
                       Style="{StaticResource Type.Title1.Style}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding FolderName, StringFormat=폴더: {0}}"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3"
                        Margin="0,0,0,14">
                <TextBlock Text="제목"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="곡 제목" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,14">
                <TextBlock Text="대체 제목"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding AlternateTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="대체 제목" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,14">
                <TextBlock Text="번호"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding SongNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="곡 번호" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,0,14">
                <TextBlock Text="분류"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="분류" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,0,14">
                <TextBlock Text="키"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="키" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Grid.ColumnSpan="3">
                <TextBlock Text="가사"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBox Text="{Binding Lyrics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="260"
                         Margin="0,4,0,0"
                         AutomationProperties.Name="가사" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="곡 저장"
                        AutomationProperties.Name="곡 저장"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="저장" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="곡 편집 창 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
