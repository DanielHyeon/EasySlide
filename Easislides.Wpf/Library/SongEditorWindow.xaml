<Window x:Class="Easislides.Wpf.Library.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="곡 편집기"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="곡 편집기"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding FolderName, StringFormat=폴더: {0}}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{DynamicResource Brush.Surface.Subtle}"
                    BorderBrush="{DynamicResource Brush.Status.Warning}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveEditWarningVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24"
                                   Foreground="{DynamicResource Brush.Status.Warning}"
                                   Margin="0,0,8,0" />
                    <TextBlock Text="라이브 출력 중입니다. 저장하려면 확인이 필요합니다."
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="3"
                                    Margin="0,0,0,14">
                            <TextBlock x:Name="LblTitle"
                                       Text="제목"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblTitle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,14">
                            <TextBlock x:Name="LblAlternateTitle"
                                       Text="다른 제목"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBox Text="{Binding AlternateTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblAlternateTitle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,0,0,14">
                            <TextBlock x:Name="LblNumber"
                                       Text="번호"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBox Text="{Binding SongNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,0,14">
                            <TextBlock x:Name="LblCategory"
                                       Text="분류"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblCategory}" />
                        </StackPanel>

                        <Grid Grid.Row="2"
                              Grid.Column="2"
                              Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblKey"
                                           Text="키"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblKey}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblCapo"
                                           Text="카포"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBox Text="{Binding Capo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Margin="0,4,0,0"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LblCapo}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="LblLyrics"
                                   Text="가사"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding Lyrics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="280"
                                 Margin="0,4,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblLyrics}" />
                    </StackPanel>

                    <Expander Header="추가 정보(레거시)"
                              IsExpanded="True"
                              Margin="0,0,0,8">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="LblWriter"
                                               Text="작사·작곡"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Writer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblWriter}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblCopyright"
                                               Text="저작권"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Copyright, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblCopyright}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblTiming"
                                               Text="타이밍"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding Timing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblTiming}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblBookReference"
                                               Text="교단 참조"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding BookReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblBookReference}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,0,0,12">
                                    <TextBlock x:Name="LblUserReference"
                                               Text="사용자 참조"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding UserReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="34"
                                             Margin="0,4,0,0"
                                             AutomationProperties.LabeledBy="{Binding ElementName=LblUserReference}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="라이선스 관리자"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LicenceAdmin1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="34"
                                                 AutomationProperties.Name="라이선스 관리자 1" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LicenceAdmin2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="34"
                                                 AutomationProperties.Name="라이선스 관리자 2" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="절 순서 / 코드 표기 / 포맷 데이터"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       Margin="0,2,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Sequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="절 순서(Sequence)"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="78" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding Notations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="코드 표기(Notations)"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="78" />
                            </Grid>
                            <TextBox Text="{Binding FormatData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="포맷 데이터"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="72"
                                     Margin="0,8,0,0" />
                            <TextBox Text="{Binding SongSettingsData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="노래 설정 데이터"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="72"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    CornerRadius="{StaticResource CornerRadius.Medium}"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="미리보기"
                                   Style="{StaticResource Type.Title3.Style}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding PreviewFormatStatus}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding PreviewFontFamilyOptions}"
                                      SelectedItem="{Binding PreviewFontFamilyName, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 글꼴" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding PreviewFontSizeOptions}"
                                      SelectedItem="{Binding PreviewMainFontSize, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 가사 글자 크기" />
                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding PreviewFontSizeOptions}"
                                      SelectedItem="{Binding PreviewNotationFontSize, Mode=TwoWay}"
                                      MinHeight="32"
                                      AutomationProperties.Name="미리보기 보조(메타·코드) 글자 크기" />
                        </Grid>

                        <!-- 코드 조옮김(레거시 Transpose Up/Down Semi-Tone) — 미리보기 코드만 ±반음 이동, 저장 가사 불변. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="조옮김"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource Type.Caption.Style}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <Button Command="{Binding TransposeDownCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="36"
                                    Content="♭ −"
                                    AutomationProperties.Name="반음 내림" />
                            <TextBlock Text="{Binding TransposeLabel}"
                                       VerticalAlignment="Center"
                                       MinWidth="40"
                                       Margin="8,0"
                                       TextAlignment="Center"
                                       Style="{StaticResource Type.Body.Style}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <Button Command="{Binding TransposeUpCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    MinWidth="36"
                                    Margin="0,0,8,0"
                                    Content="♯ +"
                                    AutomationProperties.Name="반음 올림" />
                            <Button Command="{Binding ResetTransposeCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Margin="0,0,8,0"
                                    Content="원조"
                                    AutomationProperties.Name="조옮김 원조로" />
                            <Button Command="{Binding ToCapoZeroCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    Content="To Capo 0"
                                    ToolTip="카포 없이 치는 실제 코드로 표시"
                                    AutomationProperties.Name="To Capo 0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{Binding PreviewBackgroundHex}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Small}"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding PreviewTitle}"
                                       FontFamily="{Binding PreviewFontFamilyName}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding PreviewForegroundHex}" />
                            <!-- 가사 줄 단위 렌더(리치 per-line 1차): 본문은 메인 크기, '»' 뒤 코드/노테이션은 작게·흐리게.
                                 폰트/색은 TextElement 상속, 코드 크기만 노테이션 크기로 덮는다. 코드가 없으면 코드 칸은 숨김. -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding PreviewLyricLines}"
                                          TextElement.FontFamily="{Binding PreviewFontFamilyName}"
                                          TextElement.FontSize="{Binding PreviewMainFontSize}"
                                          TextElement.Foreground="{Binding PreviewForegroundHex}"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Notation}"
                                                       FontSize="{Binding DataContext.PreviewNotationFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Opacity="0.72"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <!-- 코드/노테이션이 없는 줄은 코드 칸을 숨겨 군더더기 여백 제거. -->
                                                            <DataTrigger Binding="{Binding Notation}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding PreviewMetadata}"
                                       FontFamily="{Binding PreviewFontFamilyName}"
                                       FontSize="{Binding PreviewNotationFontSize}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72"
                                       Foreground="{Binding PreviewForegroundHex}"
                                       Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Danger}" />
                <!-- 중복 절 라벨 경고(저장은 막지 않는 비차단 안내). 비면 공백. -->
                <TextBlock Text="{Binding SectionWarning}"
                           TextWrapping="Wrap"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Status.Warning}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        ToolTip="곡 저장"
                        AutomationProperties.Name="곡 저장"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                        <TextBlock Text="저장" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EsButton.Secondary}"
                        Click="Close_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="곡 편집기 닫기">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="닫기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
