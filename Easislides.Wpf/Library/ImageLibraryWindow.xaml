<Window x:Class="Easislides.Wpf.Library.ImageLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 갤러리 — 출력 배경"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="폴더의 이미지를 골라 출력 회중 화면의 배경으로 적용합니다(곡별 배경이 있으면 그 곡은 곡별 배경이 우선)."
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- 폴더 경로 + 폴더 변경/새로고침. -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FolderPath}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource Brush.Border.Default}"
                     BorderThickness="1"
                     AutomationProperties.Name="이미지 폴더 경로" />
            <Button Grid.Column="1"
                    Click="ChangeFolder_Click"
                    Style="{StaticResource EsButton.Secondary}"
                    Margin="8,0,8,0"
                    Content="폴더 변경..."
                    AutomationProperties.Name="이미지 폴더 변경" />
            <Button Grid.Column="2"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="새로고침"
                    AutomationProperties.Name="이미지 목록 새로고침" />
        </Grid>

        <!-- 하위 폴더 포함 + 카테고리(Scenery/Tiles 등 하위 폴더) 필터 — FrmMain Images 의 카테고리 구분 대응. -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Content="하위 폴더 포함"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      AutomationProperties.Name="하위 폴더 포함" />
            <TextBlock Text="카테고리:"
                       VerticalAlignment="Center"
                       Margin="20,0,6,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      MinWidth="140"
                      VerticalAlignment="Center"
                      ToolTip="하위 폴더(Scenery/Tiles 등)로 이미지를 거릅니다. '전체'면 모두 표시."
                      AutomationProperties.Name="이미지 카테고리 필터" />
            <TextBlock Text="검색:"
                       VerticalAlignment="Center"
                       Margin="20,0,6,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <!-- 검색 상자 — 파일명으로 빠르게 거르기(카테고리 필터와 함께 AND, 대소문자 무시, 비우면 카테고리만). 입력 즉시 갱신. -->
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="160"
                     VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource Brush.Border.Default}"
                     BorderThickness="1"
                     ToolTip="파일명으로 검색(대소문자 무시). 비우면 카테고리 필터만 적용."
                     AutomationProperties.Name="이미지 파일 검색" />
        </StackPanel>

        <!-- 썸네일 갤러리 — WrapPanel 로 흐름 배치. 더블클릭으로 즉시 배경 적용. -->
        <ListBox Grid.Row="3"
                 x:Name="ImageList"
                 ItemsSource="{Binding Images}"
                 SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="ImageList_MouseDoubleClick"
                 PreviewMouseRightButtonDown="ImageList_PreviewMouseRightButtonDown"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 AutomationProperties.Name="이미지 썸네일 목록">
            <!-- 우클릭 메뉴(FrmMain Images 우클릭 배경 적용) — 우클릭한 썸네일을 선택 후 그 이미지에 동작.
                 ContextMenu 는 별도 트리라 PlacementTarget(ListBox)의 DataContext(VM)로 바인딩한다. -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="배경으로 적용"
                              Command="{Binding PlacementTarget.DataContext.ApplyAsBackgroundCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="배경 해제"
                              Command="{Binding PlacementTarget.DataContext.ClearBackgroundCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="148" Margin="6">
                        <Border Width="140"
                                Height="92"
                                Background="{DynamicResource Brush.Surface.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   Margin="2" />
                        </Border>
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   Style="{StaticResource Type.Caption.Style}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,8,0,0" />

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Command="{Binding ClearBackgroundCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    Content="배경 지우기"
                    AutomationProperties.Name="출력 배경 이미지 지우기" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding ApplyAsBackgroundCommand}"
                        Style="{StaticResource EsButton.Primary}"
                        Margin="0,0,8,0"
                        Content="배경으로 적용"
                        AutomationProperties.Name="선택 이미지를 출력 배경으로 적용" />
                <Button Click="Close_Click"
                        Style="{StaticResource EsButton.Secondary}"
                        Content="닫기"
                        AutomationProperties.Name="닫기" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
