<!--
    다크 모드 색 토큰 (무대/라이브 운영) — 계획서 §4.1
    Q3 확정: 다크 = Solid 강제. Mica/Acrylic 사용 금지.
    무대 산란광 최소화를 위해 거의 검정에 가까운 베이스.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surface — 다크는 거의 검정. Elevation은 색 변화로만 표현. -->
    <Color x:Key="Color.Surface.Page">#0A0A0A</Color>
    <Color x:Key="Color.Surface.Card">#171717</Color>
    <Color x:Key="Color.Surface.Subtle">#262626</Color>
    <SolidColorBrush x:Key="Brush.Surface.Page" Color="{StaticResource Color.Surface.Page}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}" />

    <!-- Text — 다크에서 본문 굵기 400 유지 (불필요한 굵게 자제 — 가독성) -->
    <Color x:Key="Color.Text.Primary">#F5F5F5</Color>
    <Color x:Key="Color.Text.Secondary">#A3A3A3</Color>
    <Color x:Key="Color.Text.Tertiary">#737373</Color>
    <Color x:Key="Color.Text.Inverse">#0A0A0A</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />

    <!-- Border — 다크에서 보일 수 있게 -->
    <Color x:Key="Color.Border.Default">#404040</Color>
    <Color x:Key="Color.Border.Strong">#525252</Color>
    <Color x:Key="Color.Border.Focus">#60A5FA</Color>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}" />

    <!-- Accent — 다크용 (대비 7.2:1 AA+) -->
    <Color x:Key="Color.Accent.Primary">#60A5FA</Color>
    <Color x:Key="Color.Accent.PrimaryHover">#93BBFB</Color>
    <Color x:Key="Color.Accent.PrimaryPressed">#3B82F6</Color>
    <Color x:Key="Color.Accent.PrimaryDisabled">#1E3A8A</Color>
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryHover" Color="{StaticResource Color.Accent.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryPressed" Color="{StaticResource Color.Accent.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryDisabled" Color="{StaticResource Color.Accent.PrimaryDisabled}" />

    <!-- Live — 어둠 속 가독성 강화 -->
    <Color x:Key="Color.Live.Active">#EF4444</Color>
    <Color x:Key="Color.Live.Standby">#FBBF24</Color>
    <Color x:Key="Color.Live.Hidden">#27272A</Color>
    <SolidColorBrush x:Key="Brush.Live.Active" Color="{StaticResource Color.Live.Active}" />
    <SolidColorBrush x:Key="Brush.Live.Standby" Color="{StaticResource Color.Live.Standby}" />
    <SolidColorBrush x:Key="Brush.Live.Hidden" Color="{StaticResource Color.Live.Hidden}" />

    <!-- Status — 다크 변형 -->
    <Color x:Key="Color.Status.Success">#22C55E</Color>
    <Color x:Key="Color.Status.Warning">#F59E0B</Color>
    <Color x:Key="Color.Status.Danger">#EF4444</Color>
    <Color x:Key="Color.Status.Info">#38BDF8</Color>
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}" />

</ResourceDictionary>
