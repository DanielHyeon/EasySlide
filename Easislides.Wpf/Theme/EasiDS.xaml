<!--
    EasiDS — EasiSlides Design System
    계획서 §4 디자인 토큰 단일 진실(Single Source of Truth)

    구조:
      EasiDS.xaml (이 파일)
        ├── Tokens/Colors.Light.xaml  ← ThemeService.ApplyTheme(Light) 시 활성
        ├── Tokens/Colors.Dark.xaml   ← ThemeService.ApplyTheme(Dark) 시 활성
        ├── Tokens/Typography.xaml
        ├── Tokens/Spacing.xaml
        ├── Tokens/Radius.xaml
        └── Tokens/Motion.xaml

    런타임 테마 전환 (ADR-0006):
      App.Current.Resources의 MergedDictionaries에서 Colors.Light↔Dark 스왑.
      Typography는 ScaleFactor(1.0/1.2/1.4)를 곱해 FontSize 토큰만 갱신.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- 기본은 Light. ThemeService가 런타임에 Dark로 교체. -->
        <ResourceDictionary Source="Tokens/Colors.Light.xaml" />
        <ResourceDictionary Source="Tokens/Typography.xaml" />
        <ResourceDictionary Source="Tokens/Spacing.xaml" />
        <ResourceDictionary Source="Tokens/Radius.xaml" />
        <ResourceDictionary Source="Tokens/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
