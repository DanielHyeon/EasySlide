<!--
    EsCard — 계획서 §5.1
    변종:
      - EsCard.Flat        : Elevation.0, 보더만 (다크 베이스 추천)
      - EsCard.Elevated    : Elevation.4, 그림자 (라이트 모드에서 강조)
      - EsCard.Interactive : hover/pressed 상태 + Cursor=Hand (클릭 가능 카드)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="EsCard.Flat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Medium}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Lg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EsCard.Elevated" TargetType="Border" BasedOn="{StaticResource EsCard.Flat}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                  Opacity="0.12" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsCard.Interactive" TargetType="Border" BasedOn="{StaticResource EsCard.Flat}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
