<!--
    EsDataGrid — 계획서 §5.1
    변종:
      - EsDataGrid        : Fluent 2 기본 (행 hover, 선택 강조). 행/헤더 스타일 자동 연결.
      - EsDataGrid.Zebra  : 위 + 교대 행 배경(zebra) 옵션.

    모든 색은 EasiDS 토큰을 DynamicResource로 참조 → 라이트/다크 테마 전환에 따라감.
    (StaticResource 토큰은 단독 로드 시 깨질 수 있어 색은 전부 DynamicResource 사용.)

    스타일 연결 순서: Row·ColumnHeader·Cell 을 먼저 정의한 뒤 EsDataGrid 가 StaticResource 로 참조.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 행 — hover/선택 시각 피드백 (Fluent 2) -->
    <Style x:Key="EsDataGrid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 셀 — 포커스 사각형 제거(행 단위 강조로 충분), 좌우 여백 -->
    <Style x:Key="EsDataGrid.Cell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="{DynamicResource Thickness.Sm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 열 헤더 — 보조 표면 + 보조 텍스트, 가벼운 강조 -->
    <Style x:Key="EsDataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.Sm}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- 기본 그리드 -->
    <Style x:Key="EsDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RowStyle" Value="{StaticResource EsDataGrid.Row}" />
        <Setter Property="CellStyle" Value="{StaticResource EsDataGrid.Cell}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EsDataGrid.ColumnHeader}" />
    </Style>

    <!-- zebra(교대 행 배경) 변종 -->
    <Style x:Key="EsDataGrid.Zebra" TargetType="DataGrid" BasedOn="{StaticResource EsDataGrid}">
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface.Subtle}" />
    </Style>

</ResourceDictionary>
