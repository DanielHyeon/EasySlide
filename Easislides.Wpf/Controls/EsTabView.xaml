<!--
    EsTabView — 계획서 §5.1
    변종:
      - EsTabView.Underlined : 탭 하단 액센트 라인 (Fluent 2 디폴트)
      - EsTabView.Pills      : 알약 모양 (액센트 채움)
      - EsTabView.Sidebar    : 좌측 세로 탭 (FrmOptions Settings 페이지용, §6.4)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =============== Underlined Tab (Fluent 2 디폴트) =============== -->
    <Style x:Key="EsTabView.UnderlinedItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" />
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Underline"
                                Height="2"
                                Background="{DynamicResource Brush.Accent.Primary}"
                                VerticalAlignment="Bottom"
                                Margin="12,0"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.Underlined" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EsTabView.UnderlinedItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True"
                                      Background="Transparent" />
                        </Border>
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============== Pills Tab (알약 모양) =============== -->
    <Style x:Key="EsTabView.FrmMainBottomItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="#FFEFEFEF"
                            BorderBrush="#FFB8B8B8"
                            BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="White" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF707070" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFF8F8F8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.FrmMainBottom" TargetType="TabControl">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EsTabView.FrmMainBottomItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local"
                          ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="#FFF3F3F3"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1,0,1,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.FrmMainContentSwitch" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            KeyboardNavigation.TabNavigation="Local"
                            ClipToBounds="True">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.PillsItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="{StaticResource CornerRadius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.Pills" TargetType="TabControl" BasedOn="{StaticResource EsTabView.Underlined}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource EsTabView.PillsItem}" />
    </Style>

    <!-- =============== Sidebar Tab (좌측 세로 — Settings 페이지 §6.4) =============== -->
    <Style x:Key="EsTabView.SidebarItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{StaticResource CornerRadius.Small}" />
                        <Border x:Name="LeftAccent"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent.Primary}"
                                CornerRadius="2,0,0,2"
                                Visibility="Collapsed" />
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                            <Setter TargetName="LeftAccent" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EsTabView.Sidebar" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EsTabView.SidebarItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource Brush.Surface.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="0,0,1,0"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Padding="{StaticResource Thickness.Xl}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
