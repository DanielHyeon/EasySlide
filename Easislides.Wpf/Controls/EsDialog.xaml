<!--
    EsDialog — 계획서 §5.1
    변종:
      - EsDialog.Modal   : 중앙 모달 다이얼로그 (확인/취소)
      - EsDialog.Drawer  : 우측 슬라이드 드로어 (설정 일부 등)
      - EsDialog.Sheet   : 하단 슬라이드 시트 (모바일 친화 — 데스크톱에서도 사용 가능)

    Dialog 자체는 Window/ContentDialog 베이스. 본 스타일은 Window 외형 + Border 컨테이너 정의.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modal Dialog 컨테이너 (Window 안에 Border로 사용) -->
    <Style x:Key="EsDialog.Modal" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Large}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Xl}" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drawer 컨테이너 (우측 슬라이드) -->
    <Style x:Key="EsDialog.Drawer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Xl}" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="-3" Direction="180" Opacity="0.20" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sheet 컨테이너 (하단 슬라이드) -->
    <Style x:Key="EsDialog.Sheet" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="12,12,0,0" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Xl}" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="-4" Direction="90" Opacity="0.20" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 다이얼로그 백그라운드 (모달 효과 — Black 반투명 dim) -->
    <Style x:Key="EsDialog.Backdrop" TargetType="Border">
        <Setter Property="Background" Value="#80000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
