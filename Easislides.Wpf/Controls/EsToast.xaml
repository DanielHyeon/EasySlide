<!--
    EsToast 기본 템플릿 — 좌측 색 띠 + 제목 + 메시지 + 닫기 X.
    Kind별 좌측 색: Info=Accent, Success=Status.Success, Warning=Status.Warning, Error=Status.Danger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Easislides.Wpf.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style TargetType="{x:Type controls:EsToast}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EsToast}">
                    <Border Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Medium}"
                            Padding="0"
                            Margin="0,0,24,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.20" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 좌측 색 띠 — Kind에 따라 변경 -->
                            <Border x:Name="AccentBar" Grid.Column="0"
                                    CornerRadius="6,0,0,6"
                                    Background="{DynamicResource Brush.Status.Info}" />
                            <Grid Grid.Column="1" Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="KindIcon"
                                               Grid.Column="0"
                                               Symbol="Info24"
                                               FontSize="20"
                                               Foreground="{DynamicResource Brush.Status.Info}"
                                               VerticalAlignment="Top"
                                               Margin="0,2,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Style="{StaticResource Type.Title3.Style}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{TemplateBinding Message}"
                                               Style="{StaticResource Type.Body.Style}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2"
                                               Symbol="Dismiss24"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               VerticalAlignment="Top"
                                               Margin="8,2,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="KindIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Status.Warning}" />
                            <Setter TargetName="KindIcon" Property="Symbol" Value="Warning24" />
                            <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Status.Danger}" />
                            <Setter TargetName="KindIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
