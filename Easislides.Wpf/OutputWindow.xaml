<Window x:Class="Easislides.Wpf.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasiSlides Output"
        Width="1280"
        Height="720"
        Background="{Binding SceneBackgroundBrush}"
        Foreground="{Binding SceneForegroundBrush}"
        WindowStartupLocation="Manual">
    <Grid Background="{Binding SceneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MinHeight="36"
                Background="{DynamicResource Brush.Live.Active}"
                Visibility="{Binding LyricsAlertVisibility}">
            <TextBlock Text="{Binding StatusLabel}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Surface.Page}" />
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding DisplayTitle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="72"
                   FontWeight="SemiBold"
                   Foreground="{Binding SceneForegroundBrush}"
                   MaxWidth="1100" />

        <Grid Grid.Row="2"
              Margin="{StaticResource Thickness.Xl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding OutputMonitorName}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{Binding SceneForegroundBrush}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusLabel}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Title3.Style}"
                       Foreground="{DynamicResource Brush.Live.Active}"
                       Visibility="{Binding NotationVisibility}" />
        </Grid>
    </Grid>
</Window>
