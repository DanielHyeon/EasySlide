<UserControl x:Class="Easislides.Wpf.Composites.DeviceCheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource Thickness.Xl}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="카메라" Style="{DynamicResource Type.Title3.Style}"/>
                <ComboBox x:Name="CameraList" DisplayMemberPath="DisplayName" Margin="0,8,0,0"
                          Style="{DynamicResource EsComboBox.Default}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.Name="점검할 카메라" SelectionChanged="CameraSelectionChanged"/>
                <Border Height="160" Margin="0,8,0,0" CornerRadius="4"
                        Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <Image x:Name="Video" Stretch="Uniform" AutomationProperties.Name="카메라 점검 영상"/>
                        <Image x:Name="SharedVideo" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="사용 중인 카메라 미리보기"/>
                    </Grid>
                </Border>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CameraButton" Content="영상 확인" Click="Camera_Click"
                            Style="{DynamicResource EsButton.Secondary}" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshDevices" Style="{DynamicResource EsButton.Secondary}"
                            Content="장치 목록 새로고침" Click="Refresh_Click"/>
                </WrapPanel>
                <TextBlock x:Name="CameraStatus" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="마이크" Style="{DynamicResource Type.Title3.Style}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MicrophoneList" DisplayMemberPath="DisplayName"
                              Style="{DynamicResource EsComboBox.Default}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                              AutomationProperties.Name="점검할 마이크" SelectionChanged="MicrophoneSelectionChanged"/>
                    <Button x:Name="MicButton" Grid.Column="1" Content="입력 확인" Click="Microphone_Click"
                            Style="{DynamicResource EsButton.Secondary}" Margin="8,0,0,0"/>
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="LevelText" DockPanel.Dock="Right" MinWidth="44" TextAlignment="Right"/>
                    <ProgressBar x:Name="Level" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center"
                                 AutomationProperties.Name="마이크 입력 레벨"/>
                </DockPanel>

                <TextBlock x:Name="MicStatus" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                <Separator Margin="0,16,0,12"/>
                <TextBlock Text="OBS Studio" Style="{DynamicResource Type.Title3.Style}"/>
                <TextBlock x:Name="ObsAddress" Margin="0,8,0,0"/>
                <TextBlock x:Name="ObsStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ObsSceneText" TextWrapping="Wrap"/>
                <Label Content="점검용 암호 (선택)" Target="{Binding ElementName=ObsPassword}" Padding="0" Margin="0,8,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ObsPassword" AutomationProperties.Name="OBS 점검용 암호"
                                 ToolTip="비워 두면 현재 연결 또는 저장된 암호를 사용합니다."/>
                    <Button x:Name="ObsButton" Grid.Column="1" Content="연결 확인" Click="Obs_Click"
                            Style="{DynamicResource EsButton.Secondary}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="ObsResult" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
