<UserControl x:Class="Easislides.Wpf.Composites.BibleVerseFinder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Easislides.Wpf.Theme"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        BibleVerseFinder — 계획서 §5.2 재사용 컴포지트.
        성경 버전·책 선택 + 검색어 + 불러오기/검색 동작 바.
        DataContext 는 호스트(BibleWindow 등)에서 상속된 BibleViewModel 을 그대로 사용한다
        (View만 분리, ViewModel·바인딩 동일 — 동작 동등성 우선).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="버전"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
            <ComboBox ItemsSource="{Binding Versions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      MinHeight="36"
                      Margin="0,4,0,0"
                      AutomationProperties.Name="성경 버전" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="책"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
            <ComboBox ItemsSource="{Binding Books}"
                      SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      MinHeight="36"
                      Margin="0,4,0,0"
                      AutomationProperties.Name="성경 책" />
        </StackPanel>

        <StackPanel Grid.Column="4">
            <TextBlock Text="검색"
                       Style="{StaticResource Type.Caption.Style}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="36"
                     Margin="0,4,0,0"
                     AutomationProperties.Name="성경 검색어" />
        </StackPanel>

        <StackPanel Grid.Column="6"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom">
            <Button Command="{Binding LoadSelectedBookCommand}"
                    Style="{StaticResource EsButton.Secondary}"
                    ToolTip="선택한 책 불러오기"
                    AutomationProperties.Name="성경 책 불러오기"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionRefresh}" Margin="0,0,6,0" />
                    <TextBlock Text="불러오기" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SearchCommand}"
                    Style="{StaticResource EsButton.Primary}"
                    ToolTip="성경 검색"
                    AutomationProperties.Name="성경 검색">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static theme:EsIcons.ActionFind}" Margin="0,0,6,0" />
                    <TextBlock Text="검색" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
