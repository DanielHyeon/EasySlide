<Window x:Class="Easislides.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:composites="clr-namespace:Easislides.Wpf.Composites"
        Title="EasiSlides 설정"
        Width="1040"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource EsButton.Secondary}"
                        ToolTip="현재 저장된 설정 다시 읽기"
                        AutomationProperties.Name="설정 다시 읽기"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                        <TextBlock Text="새로고침" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreDefaultsCommand}"
                        Style="{StaticResource EsButton.Danger}"
                        ToolTip="설정을 기본값으로 복원"
                        AutomationProperties.Name="설정 기본값 복원">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                        <TextBlock Text="기본값" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="설정"
                           Style="{StaticResource Type.Title1.Style}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Type.Caption.Style}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Background="{DynamicResource Brush.Surface.Page}"
                    BorderBrush="{DynamicResource Brush.Border.Default}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0" />
                        <TextBlock Text="일반" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Thickness.Xl}">
                        <TextBlock x:Name="LblLanguage"
                                   Text="언어"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EsTextBox.Default}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblLanguage}"
                                 Margin="0,4,0,16" />

                        <TextBlock x:Name="LblWorkingFolder"
                                   Text="작업 폴더"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EsTextBox.Default}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblWorkingFolder}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseWorkingFolderCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    ToolTip="작업 폴더 선택"
                                    AutomationProperties.Name="작업 폴더 선택">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                    <TextBlock Text="찾기" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="Layer24" Margin="0,0,8,0" />
                        <TextBlock Text="화면" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="{StaticResource Thickness.Xl}">
                    <TextBlock x:Name="LblTheme"
                               Text="테마"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding Theme, Mode=TwoWay}"
                              Style="{StaticResource EsComboBox.Default}"
                              AutomationProperties.LabeledBy="{Binding ElementName=LblTheme}"
                              Margin="0,4,0,16" />

                    <TextBlock x:Name="LblInterfaceSize"
                               Text="인터페이스 크기"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <ComboBox ItemsSource="{Binding InterfaceSizeOptions}"
                              SelectedItem="{Binding InterfaceSize, Mode=TwoWay}"
                              Style="{StaticResource EsComboBox.Default}"
                              AutomationProperties.LabeledBy="{Binding ElementName=LblInterfaceSize}"
                              Margin="0,4,0,16" />
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="DualScreen24" Margin="0,0,8,0" />
                        <TextBlock Text="송출" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Thickness.Xl}">
                        <TextBlock Text="기본 출력 모니터 ID"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBox Text="{Binding DefaultOutputMonitorId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EsTextBox.Default}"
                                 AutomationProperties.Name="기본 출력 모니터"
                                 Margin="0,4,0,16" />

                        <CheckBox IsChecked="{Binding UseSafetyConfirmations}"
                                  Content="라이브 중 위험 액션 확인"
                                  AutomationProperties.Name="라이브 안전 확인"
                                  MinHeight="{DynamicResource Spacing.TargetMin}" />
                        <CheckBox IsChecked="{Binding ShowLyricsMonitorAlertBox}"
                                  Content="가사 모니터 알림 표시"
                                  AutomationProperties.Name="가사 모니터 알림 표시"
                                  MinHeight="{DynamicResource Spacing.TargetMin}" />
                        <CheckBox IsChecked="{Binding AdvanceNextItem}"
                                  Content="항목 끝에서 다음 항목 진행"
                                  AutomationProperties.Name="다음 항목 자동 진행"
                                  MinHeight="{DynamicResource Spacing.TargetMin}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="간격 화면"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <ComboBox ItemsSource="{Binding GapItemModeOptions}"
                                  SelectedItem="{Binding GapItemOption, Mode=TwoWay}"
                                  Style="{StaticResource EsComboBox.Default}"
                                  AutomationProperties.Name="간격 화면 방식"
                                  Margin="0,4,0,12" />
                        <TextBox Text="{Binding GapItemLogoFile, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EsTextBox.Default}"
                                 AutomationProperties.Name="간격 화면 로고 파일"
                                 Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding GapItemUseFade}"
                                  Content="간격 화면 페이드 전환"
                                  AutomationProperties.Name="간격 화면 페이드 전환"
                                  MinHeight="{DynamicResource Spacing.TargetMin}"
                                  Margin="0,0,0,16" />

                        <!-- 출력 배치(보조 모니터 우선 + 수동 위치) — 재사용 컴포지트로 분리(§5.2). DataContext 상속. -->
                        <composites:OutputPlacementEditor />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="가사 글자 ARGB"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBox Text="{Binding LyricsMonitorTextColorArgb, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EsTextBox.Default}"
                                         AutomationProperties.Name="가사 모니터 글자색" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="가사 배경 ARGB"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBox Text="{Binding LyricsMonitorBackgroundColorArgb, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EsTextBox.Default}"
                                         AutomationProperties.Name="가사 모니터 배경색" />
                            </StackPanel>
                        </Grid>
                        <CheckBox IsChecked="{Binding LyricsMonitorShowNotations}"
                                  Content="가사 모니터 코드 표기"
                                  AutomationProperties.Name="가사 모니터 코드 표기"
                                  MinHeight="{DynamicResource Spacing.TargetMin}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="SlideLayout24" Margin="0,0,8,0" />
                        <TextBlock Text="PowerPoint" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="{StaticResource Thickness.Xl}">
                    <CheckBox IsChecked="{Binding UsePowerPointTab}"
                              Content="PowerPoint 탭 표시"
                              AutomationProperties.Name="PowerPoint 탭 표시"
                              MinHeight="{DynamicResource Spacing.TargetMin}" />
                    <CheckBox IsChecked="{Binding NoPowerPointPanelOverlay}"
                              Content="PowerPoint 송출 패널 오버레이 숨김"
                              AutomationProperties.Name="PowerPoint 패널 오버레이 숨김"
                              MinHeight="{DynamicResource Spacing.TargetMin}"
                              Margin="0,0,0,16" />
                    <TextBlock Text="렌더 타임아웃(초)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBox Text="{Binding PowerPointRenderTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EsTextBox.Default}"
                             AutomationProperties.Name="PowerPoint 렌더 타임아웃"
                             Margin="0,4,0,16" />
                    <TextBlock Text="썸네일 캐시(MB)"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBox Text="{Binding ThumbnailCacheMegabytes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EsTextBox.Default}"
                             AutomationProperties.Name="썸네일 캐시"
                             Margin="0,4,0,16" />
                    <TextBlock x:Name="LblPowerPointMaxFiles"
                               Text="PowerPoint 최대 파일 수"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBox Text="{Binding PowerPointMaxFiles, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EsTextBox.Default}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblPowerPointMaxFiles}"
                             Margin="0,4,0,16" />
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="Video24" Margin="0,0,8,0" />
                        <TextBlock Text="미디어" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="{StaticResource Thickness.Xl}">
                    <CheckBox IsChecked="{Binding UseMediaTab}"
                              Content="미디어 탭 표시"
                              AutomationProperties.Name="미디어 탭 표시"
                              MinHeight="{DynamicResource Spacing.TargetMin}" />
                    <CheckBox IsChecked="{Binding NoMediaPanelOverlay}"
                              Content="미디어 송출 패널 오버레이 숨김"
                              AutomationProperties.Name="미디어 패널 오버레이 숨김"
                              MinHeight="{DynamicResource Spacing.TargetMin}"
                              Margin="0,0,0,16" />
                    <TextBlock x:Name="LblMediaFolder"
                               Text="미디어 폴더"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBox Text="{Binding MediaDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EsTextBox.Default}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblMediaFolder}"
                             Margin="0,4,0,16" />
                    <TextBlock Text="볼륨"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <Slider Value="{Binding MediaVolume, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="1"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="미디어 볼륨"
                            Margin="0,4,0,16" />
                    <TextBlock Text="좌우 밸런스"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <Slider Value="{Binding MediaBalance, Mode=TwoWay}"
                            Minimum="-1"
                            Maximum="1"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="미디어 밸런스"
                            Margin="0,4,0,16" />
                    <CheckBox IsChecked="{Binding MediaMuted}"
                              Content="음소거"
                              AutomationProperties.Name="미디어 음소거"
                              MinHeight="{DynamicResource Spacing.TargetMin}"
                              Margin="0,0,0,16" />
                    <TextBlock x:Name="LblLiveCameraNumber"
                               Text="라이브 카메라 번호"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBox Text="{Binding LiveCameraNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EsTextBox.Default}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblLiveCameraNumber}"
                             Margin="0,4,0,16" />
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,8,0" />
                        <TextBlock Text="단축키" />
                    </StackPanel>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding ShortcutItems}"
                         Margin="{StaticResource Thickness.Xl}"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         AutomationProperties.Name="단축키 편집 목록">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource Type.Body.Style}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding CommandId}"
                                               Style="{StaticResource Type.Caption.Style}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ScopeText}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Type.Caption.Style}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DefaultGesture}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Type.Body.Style}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding CustomGesture, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EsTextBox.Default}"
                                         AutomationProperties.Name="사용자 단축키"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="4"
                                        Command="{Binding DataContext.SaveShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        AutomationProperties.Name="단축키 저장"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                        <TextBlock Text="저장" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5"
                                        Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource EsButton.Secondary}"
                                        AutomationProperties.Name="단축키 기본값 복원">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                                        <TextBlock Text="복원" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" />
                        <TextBlock Text="데이터" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Thickness.Xl}">
                        <TextBlock Text="AdminDB 경로"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AdminDatabasePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EsTextBox.Default}"
                                     AutomationProperties.Name="AdminDB 경로"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseAdminDatabaseCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    ToolTip="AdminDB 파일 선택"
                                    AutomationProperties.Name="AdminDB 파일 선택">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                    <TextBlock Text="찾기" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Command="{Binding AnalyzeDatabaseCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                AutomationProperties.Name="DB 분석">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                <TextBlock Text="DB 분석" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding DatabaseAnalysisSummary}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,12,0,16" />

                        <TextBlock Text="백업 루트"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DataBackupRoot, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EsTextBox.Default}"
                                     AutomationProperties.Name="데이터 백업 루트"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseDataBackupRootCommand}"
                                    Style="{StaticResource EsButton.Secondary}"
                                    ToolTip="백업 루트 선택"
                                    AutomationProperties.Name="백업 루트 선택">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                    <TextBlock Text="찾기" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Command="{Binding RunOperationalDataRehearsalCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                AutomationProperties.Name="운영 데이터 리허설">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                <TextBlock Text="운영 데이터 리허설" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding OperationalRehearsalSummary}"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,12,0,16" />

                        <ListBox ItemsSource="{Binding DatabaseTables}"
                                 DisplayMemberPath="Name"
                                 MinHeight="120"
                                 AutomationProperties.Name="DB 테이블 목록" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="DocumentArrowDown24" Margin="0,0,8,0" />
                        <TextBlock Text="가져오기/내보내기" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="{StaticResource Thickness.Xl}">
                    <TextBlock Text="설정 파일 경로"
                               Style="{StaticResource Type.Caption.Style}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SettingsTransferPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EsTextBox.Default}"
                                 AutomationProperties.Name="설정 파일 경로"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Command="{Binding BrowseSettingsImportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="가져오기 파일 선택"
                                AutomationProperties.Name="가져오기 파일 선택"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                <TextBlock Text="열기" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding BrowseSettingsExportCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                ToolTip="내보내기 위치 선택"
                                AutomationProperties.Name="내보내기 위치 선택">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                <TextBlock Text="저장 위치" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ExportSettingsCommand}"
                                Style="{StaticResource EsButton.Secondary}"
                                AutomationProperties.Name="설정 내보내기"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                <TextBlock Text="내보내기" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportSettingsCommand}"
                                Style="{StaticResource EsButton.Primary}"
                                AutomationProperties.Name="설정 가져오기">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,6,0" />
                                <TextBlock Text="가져오기" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="180">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" />
                        <TextBlock Text="고급" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="{StaticResource Thickness.Xl}">
                    <CheckBox IsChecked="{Binding EnableDiagnostics}"
                              Content="진단 로그 활성화"
                              AutomationProperties.Name="진단 로그 활성화"
                              MinHeight="{DynamicResource Spacing.TargetMin}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Medium}"
                Padding="{StaticResource Thickness.Md}">
            <ItemsControl ItemsSource="{Binding ValidationMessages}"
                          AutomationProperties.Name="설정 검증 메시지">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Type.Caption.Style}"
                                   Foreground="{DynamicResource Brush.Status.Danger}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
