<!-- The caption screens' colours and type for a host without the WPF app's theme (Dark): the keys the caption XAML
     uses, with the values of the app's EasiDS tokens (Axicultus\Theme\Tokens). Put on an element with CaptionTheme.Apply. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="Brush.Surface.Page" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#171717" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#262626" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#737373" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#404040" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#525252" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryHover" Color="#93BBFB" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryPressed" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Live.Active" Color="#EF4444" />
    <SolidColorBrush x:Key="Brush.Live.Standby" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Live.Hidden" Color="#27272A" />
    <SolidColorBrush x:Key="Brush.Live.OnActive" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.Live.OnStandby" Color="#0A0A0A" />
    <SolidColorBrush x:Key="Brush.Live.OnHidden" Color="#FAFAFA" />
    <!-- the app's Font.Primary without its bundled font, which is a resource of the app's own assembly -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <sys:Double x:Key="Type.Title3.FontSize">18</sys:Double>
    <sys:Double x:Key="Type.BodyLarge.FontSize">16</sys:Double>
    <sys:Double x:Key="Type.Body.FontSize">11</sys:Double>
    <sys:Double x:Key="Type.Button.FontSize">11</sys:Double>
</ResourceDictionary>
