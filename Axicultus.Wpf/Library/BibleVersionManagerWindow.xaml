<Window x:Class="Axicultus.Wpf.Library.BibleVersionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:library="clr-namespace:Axicultus.Wpf.Library"
        Title="성경 버전 관리"
        Width="460"
        Height="440"
        MinWidth="380"
        MinHeight="360"
        Background="{DynamicResource Brush.Surface.Page}"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Button DockPanel.Dock="Bottom" Click="Close_Click" Content="닫기" HorizontalAlignment="Right"
                Style="{StaticResource EsButton.Primary}" Margin="0,0,12,12" />
        <library:BibleVersionPanel />
    </DockPanel>
</Window>
