<Window x:Class="Axicultus.Wpf.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:composites="clr-namespace:Axicultus.Wpf.Composites" xmlns:options="clr-namespace:Axicultus.Wpf.Controls" xmlns:library="clr-namespace:Axicultus.Wpf.Library" x:Name="OptionsWindow" Title="Axicultus 설정" Width="1040" Height="720" MinWidth="800" MinHeight="620" Background="{DynamicResource Brush.Surface.Page}" WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource Thickness.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="현재 저장된 설정 다시 읽기" AutomationProperties.Name="설정 다시 읽기" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                        <TextBlock Text="새로고침" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource EsButton.Danger}" ToolTip="설정을 기본값으로 복원" AutomationProperties.Name="설정 기본값 복원">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                        <TextBlock Text="기본값" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="설정" Style="{StaticResource Type.Title1.Style}" Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <TabControl x:Name="OptionsTabs" Grid.Row="1" TabStripPlacement="Top" SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="9,6" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabEdge" Background="{DynamicResource Brush.Surface.Page}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabEdge" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                        <Setter TargetName="TabEdge" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabEdge" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabNavigation="Local" />
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Default}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="메인 화면">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="최대 개수" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblBibleSequentialLimit" Text="연속 성경 구절" />
                                    <TextBox Text="{Binding BibleSequentialLimit}" AutomationProperties.LabeledBy="{Binding ElementName=LblBibleSequentialLimit}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblBibleAdHocLimit" Text="비연속 성경 구절" />
                                    <TextBox Text="{Binding BibleAdHocLimit}" AutomationProperties.LabeledBy="{Binding ElementName=LblBibleAdHocLimit}" Margin="0,2,0,8" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="미리보기 텍스트" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox Content="코드 표기" IsChecked="{Binding PreviewAreaShowNotations, Mode=TwoWay}" />
                                    <options:OperatorOptionPanel Group="Preview" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="폴더 바로가기" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblJumpToA" Text="폴더 A" />
                                    <ComboBox ItemsSource="{Binding ElementName=OptionsWindow, Path=JumpFolders}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding JumpToA}" AutomationProperties.LabeledBy="{Binding ElementName=LblJumpToA}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblJumpToB" Text="폴더 B" />
                                    <ComboBox ItemsSource="{Binding ElementName=OptionsWindow, Path=JumpFolders}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding JumpToB}" AutomationProperties.LabeledBy="{Binding ElementName=LblJumpToB}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblJumpToC" Text="폴더 C" />
                                    <ComboBox ItemsSource="{Binding ElementName=OptionsWindow, Path=JumpFolders}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding JumpToC}" AutomationProperties.LabeledBy="{Binding ElementName=LblJumpToC}" Margin="0,2,0,8" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="PowerPoint" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UsePowerPointTab, Mode=TwoWay}" Content="PowerPoint 탭 표시" AutomationProperties.Name="PowerPoint 탭 표시" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <TextBlock x:Name="LblPowerPointMaxFiles" Text="PowerPoint 최대 파일 수" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding PowerPointMaxFiles, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblPowerPointMaxFiles}" Margin="0,4,0,16" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="미디어 파일" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UseMediaTab, Mode=TwoWay}" Content="미디어 탭 표시" AutomationProperties.Name="미디어 탭 표시" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <TextBlock x:Name="LblMediaFolder" Text="미디어 폴더" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <DockPanel Margin="0,4,0,8">
                                        <Button DockPanel.Dock="Right" Click="BrowseMediaFolder_Click" Content="찾기…" AutomationProperties.Name="미디어 폴더 찾기" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding MediaDirectory}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblMediaFolder}" />
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="기타" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ShowLyricsMonitorAlertBox, Mode=TwoWay}" Content="가사 모니터 알림 표시" AutomationProperties.Name="가사 모니터 알림 표시" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="송출">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="텍스트" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox Content="자동 텍스트 넘김" IsChecked="{Binding AutoTextOverflow, Mode=TwoWay}" />
                                    <CheckBox Content="텍스트 파일의 각 문단을 한 화면에 맞춤" IsChecked="{Binding FitTextFileParagraphs, Mode=TwoWay}" />
                                    <options:OperatorOptionPanel Group="Video" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="회중 가사 서식" Padding="10" Margin="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="가사 글자 ARGB" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBox Text="{Binding LyricsMonitorTextColorArgb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="가사 모니터 글자색" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="가사 배경 ARGB" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBox Text="{Binding LyricsMonitorBackgroundColorArgb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="가사 모니터 배경색" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding LyricsMonitorBackgroundIsGradient, Mode=TwoWay}" Content="가사 배경 세로 그라데이션 사용" AutomationProperties.Name="가사 배경 그라데이션 사용" Margin="0,8,0,0" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="가사 배경 그라데이션 끝색 ARGB (그라데이션 사용 시 배경색→끝색)" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBox Text="{Binding LyricsMonitorBackgroundColor2Argb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="가사 모니터 배경 그라데이션 끝색" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding LyricsMonitorShowNotations, Mode=TwoWay}" Content="회중 화면 코드 표기" AutomationProperties.Name="가사 모니터 코드 표기" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                    <TextBlock x:Name="LblLyricsMonitorFontSize" Text="글자 크기" />
                                    <TextBox Text="{Binding LyricsMonitorFontSize}" AutomationProperties.LabeledBy="{Binding ElementName=LblLyricsMonitorFontSize}" Margin="0,2,0,8" />
                                    <CheckBox Content="굵게" IsChecked="{Binding LyricsMonitorBold, Mode=TwoWay}" />
                                    <CheckBox Content="기울임" IsChecked="{Binding LyricsMonitorItalic, Mode=TwoWay}" />
                                    <CheckBox Content="밑줄" IsChecked="{Binding LyricsMonitorUnderline, Mode=TwoWay}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="항목 사이 간격" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="간격 화면" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <ComboBox ItemsSource="{Binding GapItemModeOptions}" SelectedItem="{Binding GapItemOption, Mode=TwoWay}" Style="{StaticResource EsComboBox.Default}" AutomationProperties.Name="간격 화면 방식" Margin="0,4,0,12" />
                                    <DockPanel Margin="0,4,0,8">
                                        <Button DockPanel.Dock="Right" Click="BrowseGapLogo_Click" Content="찾기…" AutomationProperties.Name="간격 화면 로고 선택" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding GapItemLogoFile}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="간격 화면 로고 파일" />
                                    </DockPanel>
                                    <CheckBox IsChecked="{Binding GapItemUseFade, Mode=TwoWay}" Content="간격 화면 페이드 전환" AutomationProperties.Name="간격 화면 페이드 전환" MinHeight="{DynamicResource Spacing.TargetMin}" Margin="0,0,0,16" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="기타 송출 설정" Padding="10" Margin="4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AdvanceNextItem, Mode=TwoWay}" Content="항목 끝에서 다음 항목 진행" AutomationProperties.Name="다음 항목 자동 진행" MinHeight="{DynamicResource Spacing.TargetMin}" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding NoPowerPointPanelOverlay, Mode=TwoWay}" Content="PowerPoint 송출 패널 오버레이 숨김" AutomationProperties.Name="PowerPoint 패널 오버레이 숨김" MinHeight="{DynamicResource Spacing.TargetMin}" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding NoMediaPanelOverlay, Mode=TwoWay}" Content="미디어 송출 패널 오버레이 숨김" AutomationProperties.Name="미디어 패널 오버레이 숨김" MinHeight="{DynamicResource Spacing.TargetMin}" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding UseSafetyConfirmations, Mode=TwoWay}" Content="라이브 중 위험 액션 확인" AutomationProperties.Name="라이브 안전 확인" MinHeight="{DynamicResource Spacing.TargetMin}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="모니터">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="송출 모니터" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblDefaultOutputMonitorId" Text="송출 모니터 선택" />
                                    <ComboBox ItemsSource="{Binding ElementName=OptionsWindow, Path=DisplayChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DefaultOutputMonitorId}" AutomationProperties.LabeledBy="{Binding ElementName=LblDefaultOutputMonitorId}" Margin="0,2,0,8" />
                                    <composites:OutputPlacementEditor />
                                    <options:OperatorOptionPanel Group="Audience" IsEnabled="{Binding UseCustomOutputBounds}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="가사 모니터 배치" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblPreviewMonitorId" Text="가사 모니터 선택" />
                                    <ComboBox ItemsSource="{Binding ElementName=OptionsWindow, Path=DisplayChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PreviewMonitorId}" AutomationProperties.LabeledBy="{Binding ElementName=LblPreviewMonitorId}" Margin="0,2,0,8" />
                                    <options:OperatorOptionPanel Group="Stage" />
                                    <TextBlock Text="{Binding StageHeight, StringFormat=가사 모니터 높이 {0} px}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="라이브 카메라" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblLiveCameraNumber" Text="라이브 카메라 번호" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBox Text="{Binding LiveCameraNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblLiveCameraNumber}" Margin="0,4,0,16" />
                                    <options:OperatorOptionPanel Group="Camera" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="가사 모니터" Padding="10" Margin="4">
                                <StackPanel>
                                    <options:OperatorOptionPanel Group="StageVisual" />
                                    <TextBlock Text="강조색 ARGB" />
                                    <TextBox Text="{Binding LyricsMonitorHighlightColorArgb}" AutomationProperties.Name="가사 모니터 강조색" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="알림">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="회중 메시지" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblMessageAlertDuration" Text="지속 시간(초)" />
                                    <TextBox Text="{Binding MessageAlertDuration}" AutomationProperties.LabeledBy="{Binding ElementName=LblMessageAlertDuration}" Margin="0,2,0,8" />
                                    <CheckBox Content="스크롤" IsChecked="{Binding MessageAlertScroll, Mode=TwoWay}" />
                                    <CheckBox Content="깜박임" IsChecked="{Binding MessageAlertFlash, Mode=TwoWay}" />
                                    <CheckBox Content="투명 배경" IsChecked="{Binding MessageAlertTransparent, Mode=TwoWay}" />
                                    <options:OperatorOptionPanel Group="Message" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="보호자 호출" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblParentalAlertHeading" Text="호출 머리말" />
                                    <TextBox Text="{Binding ParentalAlertHeading}" AutomationProperties.LabeledBy="{Binding ElementName=LblParentalAlertHeading}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblParentalAlertDuration" Text="지속 시간(초)" />
                                    <TextBox Text="{Binding ParentalAlertDuration}" AutomationProperties.LabeledBy="{Binding ElementName=LblParentalAlertDuration}" Margin="0,2,0,8" />
                                    <CheckBox Content="스크롤" IsChecked="{Binding ParentalAlertScroll, Mode=TwoWay}" />
                                    <CheckBox Content="깜박임" IsChecked="{Binding ParentalAlertFlash, Mode=TwoWay}" />
                                    <CheckBox Content="투명 배경" IsChecked="{Binding ParentalAlertTransparent, Mode=TwoWay}" />
                                    <options:OperatorOptionPanel Group="Parental" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="새 항목 참조 표시" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock x:Name="LblReferenceAlertSource" Text="참조 원본" />
                                    <ComboBox ItemsSource="{Binding ReferenceSources}" SelectedIndex="{Binding ReferenceAlertSource}" AutomationProperties.LabeledBy="{Binding ElementName=LblReferenceAlertSource}" />
                                    <TextBlock x:Name="LblReferenceAlertDurationSeconds" Text="지속 시간(초)" />
                                    <TextBox Text="{Binding ReferenceAlertDurationSeconds}" AutomationProperties.LabeledBy="{Binding ElementName=LblReferenceAlertDurationSeconds}" Margin="0,2,0,8" />
                                    <CheckBox Content="스크롤" IsChecked="{Binding ReferenceAlertScroll, Mode=TwoWay}" />
                                    <CheckBox Content="깜박임" IsChecked="{Binding ReferenceAlertFlash, Mode=TwoWay}" />
                                    <CheckBox Content="투명 배경" IsChecked="{Binding ReferenceAlertTransparent, Mode=TwoWay}" />
                                    <CheckBox Content="지정 문자열 찾기" IsChecked="{Binding ReferenceAlertUsePick, Mode=TwoWay}" />
                                    <CheckBox Content="찾지 못하면 비우기" IsChecked="{Binding ReferenceAlertBlankIfPickNotFound, Mode=TwoWay}" />
                                    <TextBlock x:Name="LblReferenceAlertPickName" Text="찾을 문자열" />
                                    <TextBox Text="{Binding ReferenceAlertPickName}" AutomationProperties.LabeledBy="{Binding ElementName=LblReferenceAlertPickName}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblReferenceAlertPickSubstitute" Text="대체 문자열" />
                                    <TextBox Text="{Binding ReferenceAlertPickSubstitute}" AutomationProperties.LabeledBy="{Binding ElementName=LblReferenceAlertPickSubstitute}" Margin="0,2,0,8" />
                                    <TextBlock x:Name="LblReferenceAlertPickSeparator" Text="구분 기호" />
                                    <TextBox Text="{Binding ReferenceAlertPickSeparator}" AutomationProperties.LabeledBy="{Binding ElementName=LblReferenceAlertPickSeparator}" Margin="0,2,0,8" />
                                    <options:OperatorOptionPanel Group="Reference" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="폴더">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="FolderStatus" TextWrapping="Wrap" />
                        <Button Content="선택한 폴더 편집…" Click="EditFolder_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                    <ListBox x:Name="FolderList" DisplayMemberPath="Name" AutomationProperties.Name="찬양 폴더" Loaded="FolderList_Loaded" />
                </DockPanel>
            </TabItem>
            <TabItem Header="성경">
                <library:BibleVersionPanel x:Name="BiblePanel" />
            </TabItem>
            <TabItem Header="라이선스">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <StackPanel Margin="16">
                        <TextBlock Text="라이선스 관리자" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="관리자 이름" />
                            <TextBlock Grid.Column="1" Text="번호" />
                            <TextBlock Grid.Column="2" Text="표시 미리보기" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LicenceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditName}" Margin="0,0,8,0" AutomationProperties.Name="관리자 이름" />
                                        <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditNumber}" Margin="0,0,8,0" AutomationProperties.Name="라이선스 번호" />
                                        <TextBlock Grid.Column="2" Text="{Binding Preview}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="곡의 첫 화면에 라이선스 표시" IsChecked="{Binding LicenceOnFirstPage, Mode=TwoWay}" />
                        <TextBlock Text="번호 앞에 표시할 기호" Margin="0,8,0,0" />
                        <TextBox Text="{Binding LicenceNumberSymbol, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="번호 기호" HorizontalAlignment="Left" MinWidth="80" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="키보드">
                <DockPanel><Expander Header="키보드 배열 및 전역 키" DockPanel.Dock="Top" Margin="8">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <options:OperatorOptionPanel Group="Keyboard" />
                        <TextBlock Text="{Binding KeyboardLayoutGuide}" Margin="0,6" TextWrapping="Wrap" />
                    </StackPanel></ScrollViewer>
                </Expander>
                <ListBox ItemsSource="{Binding ShortcutItems}" Margin="{StaticResource Thickness.Xl}" BorderBrush="{DynamicResource Brush.Border.Default}" AutomationProperties.Name="단축키 편집 목록">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Type.Body.Style}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding CommandId}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ScopeText}" VerticalAlignment="Center" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Grid.Column="2" Text="{Binding DefaultGesture}" VerticalAlignment="Center" Style="{StaticResource Type.Body.Style}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBox Grid.Column="3" Text="{Binding CustomGesture, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="사용자 단축키" Margin="0,0,8,0" />
                                <Button Grid.Column="4" Command="{Binding DataContext.SaveShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource EsButton.Secondary}" AutomationProperties.Name="단축키 저장" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                        <TextBlock Text="저장" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource EsButton.Secondary}" AutomationProperties.Name="단축키 기본값 복원">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" />
                                        <TextBlock Text="복원" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></DockPanel>
            </TabItem>
            <TabItem Header="WPF 설정">
                <TabControl Margin="8">
                    <TabItem Header="일반 및 화면">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <GroupBox Header="일반" Padding="10" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="LblLanguage" Text="언어" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblLanguage}" Margin="0,4,0,16" />
                                            <TextBlock x:Name="LblWorkingFolder" Text="작업 폴더" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <Grid Margin="0,4,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblWorkingFolder}" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Command="{Binding BrowseWorkingFolderCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="작업 폴더 선택" AutomationProperties.Name="작업 폴더 선택">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                                        <TextBlock Text="찾기" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <GroupBox Header="화면" Padding="10" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="LblTheme" Text="테마" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" Style="{StaticResource EsComboBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblTheme}" Margin="0,4,0,16" />
                                            <TextBlock x:Name="LblInterfaceSize" Text="인터페이스 크기" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <ComboBox ItemsSource="{Binding InterfaceSizeOptions}" SelectedItem="{Binding InterfaceSize, Mode=TwoWay}" Style="{StaticResource EsComboBox.Default}" AutomationProperties.LabeledBy="{Binding ElementName=LblInterfaceSize}" Margin="0,4,0,16" />
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="PowerPoint 및 미디어">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <GroupBox Header="PowerPoint 렌더링" Padding="10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="렌더 타임아웃(초)" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBox Text="{Binding PowerPointRenderTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="PowerPoint 렌더 타임아웃" Margin="0,4,0,16" />
                                            <TextBlock Text="썸네일 캐시(MB)" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBox Text="{Binding ThumbnailCacheMegabytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="썸네일 캐시" Margin="0,4,0,16" />
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <GroupBox Header="미디어 재생" Padding="10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="볼륨" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <Slider Value="{Binding MediaVolume, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="미디어 볼륨" Margin="0,4,0,16" />
                                            <TextBlock Text="좌우 밸런스" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <Slider Value="{Binding MediaBalance, Mode=TwoWay}" Minimum="-1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="미디어 밸런스" Margin="0,4,0,16" />
                                            <CheckBox IsChecked="{Binding MediaMuted, Mode=TwoWay}" Content="음소거" AutomationProperties.Name="미디어 음소거" MinHeight="{DynamicResource Spacing.TargetMin}" Margin="0,0,0,16" />
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="데이터">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="{StaticResource Thickness.Xl}">
                                    <TextBlock Text="AdminDB 경로" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <Grid Margin="0,4,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AdminDatabasePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="AdminDB 경로" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Command="{Binding BrowseAdminDatabaseCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="AdminDB 파일 선택" AutomationProperties.Name="AdminDB 파일 선택">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                                <TextBlock Text="찾기" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button Command="{Binding AnalyzeDatabaseCommand}" Style="{StaticResource EsButton.Secondary}" AutomationProperties.Name="DB 분석">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                            <TextBlock Text="DB 분석" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding DatabaseAnalysisSummary}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,12,0,16" />
                                    <TextBlock Text="백업 루트" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <Grid Margin="0,4,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DataBackupRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="데이터 백업 루트" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Command="{Binding BrowseDataBackupRootCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="백업 루트 선택" AutomationProperties.Name="백업 루트 선택">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                                <TextBlock Text="찾기" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button Command="{Binding RunOperationalDataRehearsalCommand}" Style="{StaticResource EsButton.Primary}" AutomationProperties.Name="운영 데이터 리허설">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                            <TextBlock Text="운영 데이터 리허설" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding OperationalRehearsalSummary}" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,12,0,16" />
                                    <ListBox ItemsSource="{Binding DatabaseTables}" DisplayMemberPath="Name" MinHeight="120" AutomationProperties.Name="DB 테이블 목록" />
                                </StackPanel>
                            </ScrollViewer>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="가져오기·내보내기">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <StackPanel Margin="{StaticResource Thickness.Xl}">
                                <TextBlock Text="설정 파일 경로" Style="{StaticResource Type.Caption.Style}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SettingsTransferPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EsTextBox.Default}" AutomationProperties.Name="설정 파일 경로" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Command="{Binding BrowseSettingsImportCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="가져오기 파일 선택" AutomationProperties.Name="가져오기 파일 선택" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                            <TextBlock Text="열기" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding BrowseSettingsExportCommand}" Style="{StaticResource EsButton.Secondary}" ToolTip="내보내기 위치 선택" AutomationProperties.Name="내보내기 위치 선택">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                            <TextBlock Text="저장 위치" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ExportSettingsCommand}" Style="{StaticResource EsButton.Secondary}" AutomationProperties.Name="설정 내보내기" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                                            <TextBlock Text="내보내기" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ImportSettingsCommand}" Style="{StaticResource EsButton.Primary}" AutomationProperties.Name="설정 가져오기">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,6,0" />
                                            <TextBlock Text="가져오기" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="고급">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <StackPanel Margin="{StaticResource Thickness.Xl}">
                                <CheckBox IsChecked="{Binding EnableDiagnostics, Mode=TwoWay}" Content="진단 로그 활성화" AutomationProperties.Name="진단 로그 활성화" MinHeight="{DynamicResource Spacing.TargetMin}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="장치 점검" x:Name="DeviceCheckTab" AutomationProperties.Name="장치 점검">
                <composites:DeviceCheckPanel x:Name="DeviceCheck" />
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button IsDefault="True" Content="확인" Click="Confirm_Click" MinWidth="84" Style="{StaticResource EsButton.Primary}" Margin="8,0" />
                <Button IsCancel="True" Content="취소" MinWidth="84" Style="{StaticResource EsButton.Secondary}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ValidationMessages}" AutomationProperties.Name="설정 검증 메시지" />
        </DockPanel>
    </Grid>
</Window>
