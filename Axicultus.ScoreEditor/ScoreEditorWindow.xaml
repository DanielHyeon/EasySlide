<Window x:Class="Axicultus.ScoreEditor.ScoreEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="악보 편집" Width="940" Height="650" MinWidth="590" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="8">
            <Button Content="새 악보" Click="NewClick" Padding="10,4"/>
            <Button Content="열기…" Click="OpenClick" Padding="10,4"/>
            <Button Content="저장" Click="SaveClick" Padding="10,4"/>
            <Button Content="다른 이름으로 저장…" Click="SaveAsClick" Padding="10,4"/>
            <Button Content="PPTX 내보내기…" Click="ExportClick" Padding="10,4"/>
            <Button x:Name="UndoButton" Content="실행 취소" Click="UndoClick" Padding="10,4"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,8" VerticalAlignment="Center">
            <CheckBox x:Name="ClickToEnter" Content="오선에 입력" ToolTip="오선을 클릭한 높이에 음표 입력 (N)" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Label Target="{Binding ElementName=NotePitch}" Content="음높이"/>
            <ComboBox x:Name="NotePitch" MinWidth="68" AutomationProperties.Name="음높이"/>
            <Label Target="{Binding ElementName=NoteLength}" Content="음가"/>
            <ComboBox x:Name="NoteLength" MinWidth="74" AutomationProperties.Name="음가"/>
            <CheckBox x:Name="Dot" Content="점음표" Margin="8,0" VerticalAlignment="Center"/>
            <Label Target="{Binding ElementName=Lyrics}" Content="가사"/>
            <TextBox x:Name="Lyrics" MinWidth="110" MaxLength="48" VerticalContentAlignment="Center" KeyDown="LyricKey"/>
            <Button Content="음표 입력" Click="NoteClick" Padding="8,4"/>
            <Button Content="쉼표 입력" Click="RestClick" Padding="8,4"/>
            <Button Content="가사만 적용" Click="LyricsClick" Padding="8,4"/>
            <Button Content="마디 추가" Click="MeasureClick" Padding="8,4"/>
        </WrapPanel>
        <TextBlock x:Name="Position" DockPanel.Dock="Bottom" Margin="10,5"/>
        <ScrollViewer x:Name="Viewport" Margin="8,0" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel x:Name="Systems"/>
        </ScrollViewer>
    </DockPanel>
</Window>
