<Window x:Class="Axicultus.ScoreEditor.NativeScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseScore 악보 편집" Width="1000" Height="740" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Loaded="LoadScore">
    <DockPanel Margin="8">
        <ToolBar DockPanel.Dock="Top" x:Name="Tools">
            <Button Content="저장" Click="SaveClick"/>
            <Button Content="다른 이름으로 저장…" Click="SaveAsClick"/>
            <Button Content="PPTX 내보내기…" Click="ExportClick"/>
            <Separator/>
            <Button x:Name="Undo" Content="실행 취소" Click="UndoClick"/>
        </ToolBar>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="2,6" Text="악보를 여는 중…"/>
        <Grid x:Name="Editor">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="Previous" Content="이전 페이지" Click="PreviousClick"/>
                    <TextBlock x:Name="PageNumber" VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="Next" Content="다음 페이지" Click="NextClick"/>
                </StackPanel>
                <ScrollViewer Background="#EEEEEE" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="White" VerticalAlignment="Top"><Image x:Name="Page" Stretch="Uniform"
                        MouseLeftButtonDown="SelectPageNote" ToolTip="수정할 음표를 선택하세요."/></Border>
                </ScrollViewer>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6">
                    <Label Content="음높이" Target="{Binding ElementName=Pitch}"/>
                    <ComboBox x:Name="Pitch" AutomationProperties.Name="음높이"/>
                    <Label Content="1절 가사" Target="{Binding ElementName=Lyric}"/>
                    <TextBox x:Name="Lyric" AutomationProperties.Name="1절 가사"/>
                    <Button x:Name="Apply" Content="선택한 음표에 적용" Click="ApplyClick" Margin="0,8,0,0"/>
                </StackPanel>
                <DataGrid x:Name="Notes" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                          CanUserAddRows="False" SelectionChanged="NoteChanged" AutomationProperties.Name="악보의 음표">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="단" Binding="{Binding Staff}"/>
                        <DataGridTextColumn Header="마디" Binding="{Binding Measure}"/>
                        <DataGridTextColumn Header="성부" Binding="{Binding Voice}"/>
                        <DataGridTextColumn Header="음높이" Binding="{Binding Pitch}"/>
                        <DataGridTextColumn Header="1절 가사" Binding="{Binding LyricText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
