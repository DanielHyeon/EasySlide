<Project Sdk="Microsoft.NET.Sdk">

  <!-- OCR helper for the caption console. It targets the Windows 10 SDK for Windows.Media.Ocr, which the main app
       (net11.0-windows7.0) cannot reference; the app runs it as a separate process from its ocr\ folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
